// Tungsten Standard Library - Algebraic Effects
// Abstract capabilities decoupled from execution runtimes

// Input/Output effect
effect IO {
    fn print(msg: String) -> ();
    fn read_line() -> String;
}

// Pseudo-Random Number Generation effect
effect Random {
    fn next_u64() -> u64;
    fn between(min: i64, max: i64) -> i64;
}

// Stateful computation effect
effect State {
    fn get() -> i64;
    fn set(val: i64) -> ();
}

// Cooperative concurrency yield effect
effect Yield {
    fn yield_now() -> ();
}

// Time and Clock effect
effect Time {
    fn now_ms() -> u64;
    fn sleep_ms(duration: u64) -> ();
}

// Filesystem effect
effect FS {
    fn read_file(path: String) -> String;
    fn read_file_in(path: String, arena: *mut u8) -> String;
    fn write_file(path: String, content: String) -> bool;
    fn file_exists(path: String) -> bool;
    fn file_size(path: String) -> i64;
    fn delete_file(path: String) -> bool;
}

// Process management and command execution effect
effect Process {
    fn spawn(cmd: String, args: String) -> i64;
}

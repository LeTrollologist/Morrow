// Tungsten Standard Library - Colorless Networking
// Zero-cost networking via algebraic effects without async/await coloring

effect Net {
    fn listen(port: Port) -> i64;
    fn accept(listener: i64) -> i64;
    fn connect(host: String, port: Port) -> i64;
    fn read(conn: i64, max_bytes: i64) -> String;
    fn write(conn: i64, data: String) -> i64;
    fn close(conn: i64) -> i64;
}

struct TcpListener {
    socket_id: i64,
    port: Port,
}

struct TcpStream {
    socket_id: i64,
}

fn tcp_listen(port: Port) -> TcpListener yields [Net] {
    let fd = perform Net.listen(port);
    TcpListener {
        socket_id: fd,
        port: port,
    }
}

fn tcp_accept(listener: &TcpListener) -> TcpStream yields [Net] {
    let conn_fd = perform Net.accept(listener.socket_id);
    TcpStream {
        socket_id: conn_fd,
    }
}

fn tcp_connect(host: String, port: Port) -> TcpStream yields [Net] {
    let conn_fd = perform Net.connect(host, port);
    TcpStream {
        socket_id: conn_fd,
    }
}

fn tcp_read(stream: &TcpStream, max_len: i64) -> String yields [Net] {
    perform Net.read(stream.socket_id, max_len)
}

fn tcp_write(stream: &TcpStream, msg: String) -> i64 yields [Net] {
    perform Net.write(stream.socket_id, msg)
}

fn tcp_close(stream: &TcpStream) yields [Net] {
    perform Net.close(stream.socket_id);
}

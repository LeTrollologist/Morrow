// Tungsten Standard Library - Collections
// Generic data structures for region and heap memory

extern "C" {
    fn morrow_alloc(size: usize, align: usize) -> *mut u8;
    fn morrow_region_alloc(arena: *mut u8, size: usize, align: usize) -> *mut u8;
    fn morrow_region_grow(arena: *mut u8, ptr: *mut u8, old_sz: usize, new_sz: usize, align: usize) -> *mut u8;
    fn free(ptr: *mut u8);
    fn strcmp(s1: *const u8, s2: *const u8) -> i32;
    fn strlen(s: *const u8) -> usize;
    fn memset(dest: *mut u8, val: i32, len: usize) -> *mut u8;
}

// -----------------------------------------------------------------------------
// Vec<T> - Dynamically sized, contiguous growable array
// Supports both heap allocation (vec_new) and region allocation (vec_new_in)
// with O(1) in-place tail growth when backed by a Region arena.
//
// Failure contract (validated at runtime, no invalid memory access):
// - vec_get/vec_pop with an out-of-range or negative index return 0-as-T.
// - vec_set with an out-of-range or negative index is a no-op.
// - vec_push on a failed/zero-capacity allocation is a no-op.
// - vec_free is idempotent and safe on an empty Vec.
// -----------------------------------------------------------------------------

struct Vec<T> {
    data: *mut T,
    len: i64,
    cap: i64,
    arena: *mut u8,
}

fn collections_max_cap() -> i64 { 1073741824 }

fn vec_new<T>() -> Vec<T> {
    let initial_cap: i64 = 8;
    let null_arena: *mut u8 = 0 as *mut u8;
    let raw_buf = unsafe {
        morrow_alloc(initial_cap * 8, 8)
    };
    if raw_buf == (0 as *mut u8) {
        return Vec {
            data: 0 as *mut T,
            len: 0,
            cap: 0,
            arena: null_arena,
        };
    }
    Vec {
        data: raw_buf as *mut T,
        len: 0,
        cap: initial_cap,
        arena: null_arena,
    }
}

fn vec_with_capacity<T>(initial_cap: i64) -> Vec<T> {
    let mut cap: i64 = initial_cap;
    if cap < 4 {
        cap = 4;
    }
    if cap > collections_max_cap() {
        cap = 0;
    }
    if cap == 0 {
        return Vec {
            data: 0 as *mut T,
            len: 0,
            cap: 0,
            arena: 0 as *mut u8,
        };
    }
    let null_arena: *mut u8 = 0 as *mut u8;
    let raw_buf = unsafe {
        morrow_alloc(cap * 8, 8)
    };
    if raw_buf == (0 as *mut u8) {
        cap = 0;
    }
    Vec {
        data: raw_buf as *mut T,
        len: 0,
        cap: cap,
        arena: null_arena,
    }
}

fn vec_new_in<T>(arena: *mut u8) -> Vec<T> {
    let initial_cap: i64 = 8;
    let raw_buf = unsafe {
        morrow_region_alloc(arena, initial_cap * 8, 8)
    };
    let mut cap = initial_cap;
    if raw_buf == (0 as *mut u8) {
        cap = 0;
    }
    Vec {
        data: raw_buf as *mut T,
        len: 0,
        cap: cap,
        arena: arena,
    }
}

fn vec_with_capacity_in<T>(arena: *mut u8, initial_cap: i64) -> Vec<T> {
    let mut cap: i64 = initial_cap;
    if cap < 4 {
        cap = 4;
    }
    if cap > collections_max_cap() {
        cap = 0;
    }
    let mut raw_buf: *mut u8 = 0 as *mut u8;
    if cap > 0 {
        raw_buf = unsafe { morrow_region_alloc(arena, cap * 8, 8) };
        if raw_buf == (0 as *mut u8) {
            cap = 0;
        }
    }
    Vec {
        data: raw_buf as *mut T,
        len: 0,
        cap: cap,
        arena: arena,
    }
}

fn vec_len<T>(v: &Vec<T>) -> i64 {
    v.len
}

fn vec_cap<T>(v: &Vec<T>) -> i64 {
    v.cap
}

fn vec_is_empty<T>(v: &Vec<T>) -> bool {
    v.len == 0
}

fn vec_push<T>(v: &mut Vec<T>, item: T) {
    if v.data == (0 as *mut T) || v.cap <= 0 || v.len < 0 || v.len > v.cap {
        return;
    }
    if v.len == v.cap {
        if v.cap > collections_max_cap() {
            return;
        }
        let old_sz = v.cap * 8;
        let new_cap = v.cap * 2;
        let new_sz = new_cap * 8;
        let old_buf = v.data as *mut u8;
        let new_buf = unsafe {
            morrow_region_grow(v.arena, old_buf, old_sz, new_sz, 8)
        };
        if new_buf == (0 as *mut u8) {
            return;
        }
        v.data = new_buf as *mut T;
        v.cap = new_cap;
    }
    unsafe {
        v.data[v.len] = item;
    }
    v.len = v.len + 1;
}

fn vec_pop<T>(v: &mut Vec<T>) -> T {
    if v.len <= 0 || v.data == (0 as *mut T) {
        return 0 as T;
    }
    let new_len = v.len - 1;
    v.len = new_len;
    unsafe {
        v.data[new_len]
    }
}

fn vec_get<T>(v: &Vec<T>, index: i64) -> T {
    if v.data == (0 as *mut T) || index < 0 || index >= v.len {
        return 0 as T;
    }
    unsafe {
        v.data[index]
    }
}

fn vec_set<T>(v: &mut Vec<T>, index: i64, item: T) {
    if v.data == (0 as *mut T) || index < 0 || index >= v.len {
        return;
    }
    unsafe {
        v.data[index] = item;
    }
}

fn vec_free<T>(v: &mut Vec<T>) {
    let null_arena: *mut u8 = 0 as *mut u8;
    if v.arena == null_arena && v.data != (0 as *mut T) {
        unsafe {
            free(v.data as *mut u8);
        }
    }
    v.data = 0 as *mut T;
    v.len = 0;
    v.cap = 0;
}

// -----------------------------------------------------------------------------
// Safe StringBuffer Type - Backed by contiguous UTF-8 byte buffer
// -----------------------------------------------------------------------------

struct StringBuffer {
    buf: *mut u8,
    len: i64,
    cap: i64,
    arena: *mut u8,
}

fn string_buffer_new() -> StringBuffer {
    let initial_cap: i64 = 16;
    let null_arena: *mut u8 = 0 as *mut u8;
    let raw_buf = unsafe {
        morrow_alloc(initial_cap, 8)
    };
    StringBuffer {
        buf: raw_buf,
        len: 0,
        cap: initial_cap,
        arena: null_arena,
    }
}

fn string_buffer_new_in(arena: *mut u8) -> StringBuffer {
    let initial_cap: i64 = 16;
    let raw_buf = unsafe {
        morrow_region_alloc(arena, initial_cap, 8)
    };
    StringBuffer {
        buf: raw_buf,
        len: 0,
        cap: initial_cap,
        arena: arena,
    }
}

fn string_buffer_len(s: &StringBuffer) -> i64 {
    s.len
}

fn string_buffer_cap(s: &StringBuffer) -> i64 {
    s.cap
}

fn string_buffer_is_empty(s: &StringBuffer) -> bool {
    s.len == 0
}

fn string_buffer_as_ptr(s: &StringBuffer) -> *const u8 {
    s.buf as *const u8
}

fn string_buffer_push_byte(s: &mut StringBuffer, byte: u8) {
    if s.len == s.cap {
        let old_sz = s.cap;
        let new_cap = s.cap * 2;
        let new_sz = new_cap;
        let new_buf = unsafe {
            morrow_region_grow(s.arena, s.buf, old_sz, new_sz, 8)
        };
        s.buf = new_buf;
        s.cap = new_cap;
    }
    unsafe {
        s.buf[s.len] = byte;
    }
    s.len = s.len + 1;
}

fn string_buffer_push_str(s: &mut StringBuffer, text: *const u8, text_len: i64) {
    // Older call sites (and the examples) pass only (buffer, text) because call
    // arity is not validated; in that case text_len arrives as 0/garbage, so fall
    // back to strlen to keep the 2-argument form working.
    let mut len = text_len;
    if len <= 0 {
        len = unsafe { strlen(text) } as i64;
    }
    let mut i: i64 = 0;
    while i < len {
        let b = unsafe { text[i] };
        string_buffer_push_byte(s, b);
        i = i + 1;
    }
}

fn string_validate_utf8(ptr: *const u8, len: i64) -> bool {
    let mut i: i64 = 0;
    while i < len {
        let b = unsafe { ptr[i] as i64 };
        if b < 128 {
            i = i + 1;
        } else if b >= 192 && b < 224 {
            if i + 1 >= len {
                return false;
            }
            let b1 = unsafe { ptr[i + 1] as i64 };
            if b1 < 128 || b1 >= 192 {
                return false;
            }
            i = i + 2;
        } else if b >= 224 && b < 240 {
            if i + 2 >= len {
                return false;
            }
            let c1 = unsafe { ptr[i + 1] as i64 };
            let c2 = unsafe { ptr[i + 2] as i64 };
            if c1 < 128 || c1 >= 192 || c2 < 128 || c2 >= 192 {
                return false;
            }
            i = i + 3;
        } else if b >= 240 && b < 248 {
            if i + 3 >= len {
                return false;
            }
            let d1 = unsafe { ptr[i + 1] as i64 };
            let d2 = unsafe { ptr[i + 2] as i64 };
            let d3 = unsafe { ptr[i + 3] as i64 };
            if d1 < 128 || d1 >= 192 || d2 < 128 || d2 >= 192 || d3 < 128 || d3 >= 192 {
                return false;
            }
            i = i + 4;
        } else {
            return false;
        }
    }
    true
}

fn string_buffer_from_utf8(ptr: *const u8, len: i64) -> StringBuffer {
    let mut s = string_buffer_new();
    if string_validate_utf8(ptr, len) {
        string_buffer_push_str(&mut s, ptr, len);
    }
    s
}

fn string_buffer_from_utf8_in(arena: *mut u8, ptr: *const u8, len: i64) -> StringBuffer {
    let mut s = string_buffer_new_in(arena);
    if string_validate_utf8(ptr, len) {
        string_buffer_push_str(&mut s, ptr, len);
    }
    s
}

fn string_buffer_free(s: &mut StringBuffer) {
    let null_arena: *mut u8 = 0 as *mut u8;
    if s.arena == null_arena {
        unsafe {
            free(s.buf);
        }
    }
    s.len = 0;
    s.cap = 0;
}

// Aliases for compatibility with earlier String buffer APIs
fn string_new() -> StringBuffer { string_buffer_new() }
fn string_new_in(arena: *mut u8) -> StringBuffer { string_buffer_new_in(arena) }
fn string_len(s: &StringBuffer) -> i64 { string_buffer_len(s) }
fn string_cap(s: &StringBuffer) -> i64 { string_buffer_cap(s) }
fn string_is_empty(s: &StringBuffer) -> bool { string_buffer_is_empty(s) }
fn string_as_ptr(s: &StringBuffer) -> *const u8 { s.buf as *const u8 }
fn string_push_byte(s: &mut StringBuffer, byte: u8) { string_buffer_push_byte(s, byte) }
fn string_push_str(s: &mut StringBuffer, text: *const u8, text_len: i64) { string_buffer_push_str(s, text, text_len) }
fn string_from_utf8(ptr: *const u8, len: i64) -> StringBuffer { string_buffer_from_utf8(ptr, len) }
fn string_from_utf8_in(arena: *mut u8, ptr: *const u8, len: i64) -> StringBuffer { string_buffer_from_utf8_in(arena, ptr, len) }
fn string_free(s: &mut StringBuffer) { string_buffer_free(s) }

// -----------------------------------------------------------------------------
// Robin Hood HashMap - High performance open-addressing hash table
// Uses Probe Sequence Length (PSL) tracking and backward-shift deletion.
// Supports both heap allocation (hashmap_new) and region allocation (hashmap_new_in).
// -----------------------------------------------------------------------------
// HashMap - Cache-conscious Robin Hood Hash Table
// Structure-of-Arrays (SoA) layout for high performance & safe scalar indexing.
// Supports both heap allocation (hashmap_new) and region allocation (hashmap_new_in).
// -----------------------------------------------------------------------------

pub struct HashMap {
    keys: *mut String,
    len: i64,
    cap: i64,
    arena: *mut u8,
    vals: *mut i64,
    hashes: *mut i64,
    psls: *mut i64,
    occupied: *mut i64,
}

pub fn hash_str(s: String) -> i64 {
    let ptr = s as *const u8;
    let len = unsafe { strlen(ptr) } as i64;
    let mut h: i64 = 1469598103934665603;
    let mut i: i64 = 0;
    while i < len {
        let b = unsafe { ptr[i] } as i64;
        h = (h * 31 + b) * 1099511628211;
        i = i + 1;
    }
    if h < 0 {
        return 0 - h;
    }
    h
}

// HashMap failure contract:
// - hashmap_get returns -1 for a missing key or an invalid/empty map.
// - hashmap_contains/remove return false for a missing key or invalid map.
// - hashmap_insert is a no-op when the map is invalid or growth cannot allocate.
// - negative capacities produce an empty map; hashmap_free is idempotent.
fn hashmap_empty() -> HashMap {
    HashMap {
        keys: 0 as *mut String,
        len: 0,
        cap: 0,
        arena: 0 as *mut u8,
        vals: 0 as *mut i64,
        hashes: 0 as *mut i64,
        psls: 0 as *mut i64,
        occupied: 0 as *mut i64,
    }
}

pub fn hashmap_new() -> HashMap {
    let initial_cap: i64 = 16;
    let bytes = (initial_cap * 8) as usize;
    let keys_ptr = unsafe { morrow_alloc(bytes, 8) as *mut String };
    let vals_ptr = unsafe { morrow_alloc(bytes, 8) as *mut i64 };
    let hashes_ptr = unsafe { morrow_alloc(bytes, 8) as *mut i64 };
    let psls_raw = unsafe { morrow_alloc(bytes, 8) };
    let occ_raw = unsafe { morrow_alloc(bytes, 8) };
    if keys_ptr == (0 as *mut String) || vals_ptr == (0 as *mut i64) || hashes_ptr == (0 as *mut i64) ||
       psls_raw == (0 as *mut u8) || occ_raw == (0 as *mut u8) {
        unsafe {
            free(keys_ptr as *mut u8);
            free(vals_ptr as *mut u8);
            free(hashes_ptr as *mut u8);
            free(psls_raw);
            free(occ_raw);
        }
        return hashmap_empty();
    }
    unsafe { memset(psls_raw, 0, bytes); }
    let psls_ptr = psls_raw as *mut i64;
    unsafe { memset(occ_raw, 0, bytes); }
    let occ_ptr = occ_raw as *mut i64;

    let null_arena: *mut u8 = 0 as *mut u8;
    HashMap {
        keys: keys_ptr,
        len: 0,
        cap: initial_cap,
        arena: null_arena,
        vals: vals_ptr,
        hashes: hashes_ptr,
        psls: psls_ptr,
        occupied: occ_ptr,
    }
}

pub fn hashmap_new_in(arena: *mut u8, initial_cap: i64) -> HashMap {
    if initial_cap < 0 {
        return hashmap_empty();
    }
    let mut cap = initial_cap;
    if cap < 16 {
        cap = 16;
    }
    if cap > collections_max_cap() {
        return hashmap_empty();
    }
    let bytes = (cap * 8) as usize;
    let keys_ptr = unsafe { morrow_region_alloc(arena, bytes, 8) as *mut String };
    let vals_ptr = unsafe { morrow_region_alloc(arena, bytes, 8) as *mut i64 };
    let hashes_ptr = unsafe { morrow_region_alloc(arena, bytes, 8) as *mut i64 };
    let psls_raw = unsafe { morrow_region_alloc(arena, bytes, 8) };
    let occ_raw = unsafe { morrow_region_alloc(arena, bytes, 8) };
    if keys_ptr == (0 as *mut String) || vals_ptr == (0 as *mut i64) || hashes_ptr == (0 as *mut i64) ||
       psls_raw == (0 as *mut u8) || occ_raw == (0 as *mut u8) {
        return hashmap_empty();
    }

    unsafe { memset(psls_raw, 0, bytes); }
    let psls_ptr = psls_raw as *mut i64;
    unsafe { memset(occ_raw, 0, bytes); }
    let occ_ptr = occ_raw as *mut i64;

    HashMap {
        keys: keys_ptr,
        len: 0,
        cap: cap,
        arena: arena,
        vals: vals_ptr,
        hashes: hashes_ptr,
        psls: psls_ptr,
        occupied: occ_ptr,
    }
}

pub fn hashmap_len(map: &HashMap) -> i64 {
    map.len
}

pub fn hashmap_is_empty(map: &HashMap) -> bool {
    map.len == 0
}

pub fn hashmap_insert(map: &mut HashMap, key: String, val: i64) {
    if map.cap <= 0 || map.keys == (0 as *mut String) || map.occupied == (0 as *mut i64) {
        return;
    }
    if (map.len + 1) * 10 >= map.cap * 7 {
        hashmap_grow(map);
        if map.cap <= 0 || map.len >= map.cap {
            return;
        }
    }

    let mut k = key;
    let mut v = val;
    let mut h = hash_str(k);
    let mut curr_psl: i64 = 0;
    let mut idx = h - (h / map.cap) * map.cap;
    if idx < 0 {
        idx = idx + map.cap;
    }

    loop {
        let occ = unsafe { map.occupied[idx] };
        if occ == 0 {
            unsafe {
                map.keys[idx] = k;
                map.vals[idx] = v;
                map.hashes[idx] = h;
                map.psls[idx] = curr_psl;
                map.occupied[idx] = 1;
            }
            map.len = map.len + 1;
            return;
        }

        let curr_h = unsafe { map.hashes[idx] };
        if curr_h == h {
            let existing_k = unsafe { map.keys[idx] };
            if unsafe { strcmp(existing_k as *const u8, k as *const u8) == 0 } {
                unsafe {
                    map.vals[idx] = v;
                }
                return;
            }
        }

        let psl = unsafe { map.psls[idx] };
        if psl < curr_psl {
            let tmp_k = unsafe { map.keys[idx] };
            let tmp_v = unsafe { map.vals[idx] };
            let tmp_h = curr_h;
            let tmp_psl = psl;

            unsafe {
                map.keys[idx] = k;
                map.vals[idx] = v;
                map.hashes[idx] = h;
                map.psls[idx] = curr_psl;
            }

            k = tmp_k;
            v = tmp_v;
            h = tmp_h;
            curr_psl = tmp_psl;
        }

        idx = idx + 1;
        if idx >= map.cap {
            idx = 0;
        }
        curr_psl = curr_psl + 1;
    }
}

pub fn hashmap_get(map: &HashMap, key: String) -> i64 {
    if map.cap <= 0 || map.keys == (0 as *mut String) || map.occupied == (0 as *mut i64) {
        return 0 - 1;
    }
    let h = hash_str(key);
    let mut idx = h - (h / map.cap) * map.cap;
    if idx < 0 {
        idx = idx + map.cap;
    }
    let mut curr_psl: i64 = 0;

    loop {
        let occ = unsafe { map.occupied[idx] };
        let psl = unsafe { map.psls[idx] };
        if occ == 0 || psl < curr_psl {
            return 0 - 1;
        }

        let curr_h = unsafe { map.hashes[idx] };
        if curr_h == h {
            let existing_k = unsafe { map.keys[idx] };
            if unsafe { strcmp(existing_k as *const u8, key as *const u8) == 0 } {
                return unsafe { map.vals[idx] };
            }
        }

        idx = idx + 1;
        if idx >= map.cap {
            idx = 0;
        }
        curr_psl = curr_psl + 1;
    }
    return 0 - 1;
}

pub fn hashmap_contains(map: &HashMap, key: String) -> bool {
    if map.cap <= 0 || map.keys == (0 as *mut String) || map.occupied == (0 as *mut i64) {
        return false;
    }
    let h = hash_str(key);
    let mut idx = h - (h / map.cap) * map.cap;
    if idx < 0 {
        idx = idx + map.cap;
    }
    let mut curr_psl: i64 = 0;

    loop {
        let occ = unsafe { map.occupied[idx] };
        let psl = unsafe { map.psls[idx] };
        if occ == 0 || psl < curr_psl {
            return false;
        }

        let curr_h = unsafe { map.hashes[idx] };
        if curr_h == h {
            let existing_k = unsafe { map.keys[idx] };
            if unsafe { strcmp(existing_k as *const u8, key as *const u8) == 0 } {
                return true;
            }
        }

        idx = idx + 1;
        if idx >= map.cap {
            idx = 0;
        }
        curr_psl = curr_psl + 1;
    }
    return false;
}

fn hashmap_shift_back(map: &mut HashMap, start: i64) {
    let mut curr = start;
    loop {
        let mut next = curr + 1;
        if next >= map.cap {
            next = 0;
        }
        let next_occ = unsafe { map.occupied[next] };
        let next_psl = unsafe { map.psls[next] };
        if next_occ == 0 || next_psl == 0 {
            unsafe {
                map.occupied[curr] = 0;
                map.psls[curr] = 0;
            }
            return;
        }

        unsafe {
            map.keys[curr] = map.keys[next];
            map.vals[curr] = map.vals[next];
            map.hashes[curr] = map.hashes[next];
            map.psls[curr] = next_psl - 1;
            map.occupied[curr] = 1;
        }
        curr = next;
    }
}

pub fn hashmap_remove(map: &mut HashMap, key: String) -> bool {
    if map.cap <= 0 || map.keys == (0 as *mut String) || map.occupied == (0 as *mut i64) {
        return false;
    }
    let h = hash_str(key);
    let mut idx = h - (h / map.cap) * map.cap;
    if idx < 0 {
        idx = idx + map.cap;
    }
    let mut curr_psl: i64 = 0;

    loop {
        let occ = unsafe { map.occupied[idx] };
        let psl = unsafe { map.psls[idx] };
        if occ == 0 || psl < curr_psl {
            return false;
        }

        let curr_h = unsafe { map.hashes[idx] };
        if curr_h == h {
            let existing_k = unsafe { map.keys[idx] };
            if unsafe { strcmp(existing_k as *const u8, key as *const u8) == 0 } {
                hashmap_shift_back(map, idx);
                map.len = map.len - 1;
                return true;
            }
        }

        idx = idx + 1;
        if idx >= map.cap {
            idx = 0;
        }
        curr_psl = curr_psl + 1;
    }
    return false;
}

pub fn hashmap_grow(map: &mut HashMap) {
    let old_cap = map.cap;
    if old_cap <= 0 || old_cap > collections_max_cap() {
        return;
    }
    let old_keys = map.keys;
    let old_vals = map.vals;
    let old_hashes = map.hashes;
    let old_psls = map.psls;
    let old_occ = map.occupied;

    let null_arena: *mut u8 = 0 as *mut u8;
    let mut new_keys: *mut String = 0 as *mut String;
    let mut new_vals: *mut i64 = 0 as *mut i64;
    let mut new_hashes: *mut i64 = 0 as *mut i64;
    let mut new_psls: *mut i64 = 0 as *mut i64;
    let mut new_occ: *mut i64 = 0 as *mut i64;

    let mut psls_raw: *mut u8 = 0 as *mut u8;
    let mut occ_raw: *mut u8 = 0 as *mut u8;

    let new_cap = old_cap * 2;
    if new_cap <= 0 || new_cap > collections_max_cap() {
        return;
    }
    let bytes = (new_cap * 8) as usize;

    if map.arena == null_arena {
        new_keys = unsafe { morrow_alloc(bytes, 8) as *mut String };
        new_vals = unsafe { morrow_alloc(bytes, 8) as *mut i64 };
        new_hashes = unsafe { morrow_alloc(bytes, 8) as *mut i64 };
        psls_raw = unsafe { morrow_alloc(bytes, 8) };
        new_psls = psls_raw as *mut i64;
        occ_raw = unsafe { morrow_alloc(bytes, 8) };
        new_occ = occ_raw as *mut i64;
    } else {
        new_keys = unsafe { morrow_region_alloc(map.arena, bytes, 8) as *mut String };
        new_vals = unsafe { morrow_region_alloc(map.arena, bytes, 8) as *mut i64 };
        new_hashes = unsafe { morrow_region_alloc(map.arena, bytes, 8) as *mut i64 };
        psls_raw = unsafe { morrow_region_alloc(map.arena, bytes, 8) };
        new_psls = psls_raw as *mut i64;
        occ_raw = unsafe { morrow_region_alloc(map.arena, bytes, 8) };
        new_occ = occ_raw as *mut i64;
    }

    if new_keys == (0 as *mut String) || new_vals == (0 as *mut i64) ||
       new_hashes == (0 as *mut i64) || psls_raw == (0 as *mut u8) ||
       occ_raw == (0 as *mut u8) {
        if map.arena == null_arena {
            unsafe {
                free(new_keys as *mut u8);
                free(new_vals as *mut u8);
                free(new_hashes as *mut u8);
                free(psls_raw);
                free(occ_raw);
            }
        }
        return;
    }

    unsafe {
        memset(new_psls as *mut u8, 0, bytes);
        memset(new_occ as *mut u8, 0, bytes);
    }
    map.keys = new_keys;
    map.vals = new_vals;
    map.hashes = new_hashes;
    map.psls = new_psls;
    map.occupied = new_occ;
    map.cap = new_cap;
    map.len = 0;

    let mut i: i64 = 0;
    while i < old_cap {
        let occ = unsafe { old_occ[i] };
        if occ != 0 {
            let k = unsafe { old_keys[i] };
            let v = unsafe { old_vals[i] };
            hashmap_insert(map, k, v);
        }
        i = i + 1;
    }

    if map.arena == null_arena {
        unsafe {
            free(old_keys as *mut u8);
            free(old_vals as *mut u8);
            free(old_hashes as *mut u8);
            free(old_psls as *mut u8);
            free(old_occ as *mut u8);
        }
    }
}

pub fn hashmap_free(map: &mut HashMap) {
    let null_arena: *mut u8 = 0 as *mut u8;
    if map.arena == null_arena && map.keys != (0 as *mut String) {
        unsafe {
            free(map.keys as *mut u8);
            free(map.vals as *mut u8);
            free(map.hashes as *mut u8);
            free(map.psls as *mut u8);
            free(map.occupied as *mut u8);
        }
    }
    map.keys = 0 as *mut String;
    map.vals = 0 as *mut i64;
    map.hashes = 0 as *mut i64;
    map.psls = 0 as *mut i64;
    map.occupied = 0 as *mut i64;
    map.len = 0;
    map.cap = 0;
}

// =============================================================================
// Tungsten Standard Library — Safe High-Level SQLite Driver (Phase C)
// Combines C-ABI FFI, Region-Based Memory Management, and Algebraic Effects.
// =============================================================================

import std::collections;

extern "C" {
    fn tungsten_alloc(size: usize, align: usize) -> *mut u8;
    fn tungsten_region_alloc(arena: *mut u8, size: usize, align: usize) -> *mut u8;
    fn free(ptr: *mut u8);
    fn strlen(s: *const u8) -> usize;
    fn strcmp(s1: *const u8, s2: *const u8) -> i32;

    fn sqlite3_open(filename: *const u8, ppDb: *mut *mut u8) -> i32;
    fn sqlite3_close_v2(pDb: *mut u8) -> i32;
    fn sqlite3_exec(pDb: *mut u8, sql: *const u8, callback: *mut u8, arg: *mut u8, errmsg: *mut *mut u8) -> i32;
    fn sqlite3_prepare_v2(pDb: *mut u8, zSql: *const u8, nByte: i32, ppStmt: *mut *mut u8, pzTail: *mut *const u8) -> i32;
    fn sqlite3_step(pStmt: *mut u8) -> i32;
    fn sqlite3_column_count(pStmt: *mut u8) -> i32;
    fn sqlite3_column_name(pStmt: *mut u8, N: i32) -> *const u8;
    fn sqlite3_column_text(pStmt: *mut u8, iCol: i32) -> *const u8;
    fn sqlite3_column_bytes(pStmt: *mut u8, iCol: i32) -> i32;
    fn sqlite3_column_int64(pStmt: *mut u8, iCol: i32) -> i64;
    fn sqlite3_column_double(pStmt: *mut u8, iCol: i32) -> f64;
    fn sqlite3_finalize(pStmt: *mut u8) -> i32;
    fn sqlite3_errmsg(pDb: *mut u8) -> *const u8;
    fn sqlite3_changes(pDb: *mut u8) -> i32;
    fn sqlite3_total_changes(pDb: *mut u8) -> i32;
    fn sqlite3_bind_text(pStmt: *mut u8, iCol: i32, zData: *const u8, nData: i32, xDel: *mut u8) -> i32;
    fn sqlite3_bind_int64(pStmt: *mut u8, iCol: i32, iValue: i64) -> i32;
    fn sqlite3_bind_null(pStmt: *mut u8, iCol: i32) -> i32;
    fn sqlite3_reset(pStmt: *mut u8) -> i32;
    fn sqlite3_clear_bindings(pStmt: *mut u8) -> i32;
}

// -----------------------------------------------------------------------------
// Core Database Types
// -----------------------------------------------------------------------------

pub struct SqliteDb {
    db_handle: *mut u8,
    is_open: bool,
}

// Optimized Result Set: Schema (column names) allocated ONCE in the region,
// and cell values sequentially stored with O(1) stride access.
pub struct SqliteResultSet {
    columns: Vec<String>,
    cells: Vec<String>,
    num_cols: i64,
    num_rows: i64,
}

// Lightweight row view referencing the parent result set
pub struct SqliteRow {
    rs: *const SqliteResultSet,
    row_idx: i64,
}

// -----------------------------------------------------------------------------
// Database Lifecycle & Mutation
// -----------------------------------------------------------------------------

pub fn sqlite_open(path: String) -> SqliteDb {
    let ptr_slot = unsafe { tungsten_alloc(8, 8) as *mut *mut u8 };
    let rc = unsafe { sqlite3_open(path as *const u8, ptr_slot) };
    let mut h: *mut u8 = 0 as *mut u8;
    if rc == 0 {
        h = unsafe { ptr_slot[0] };
    }
    unsafe { free(ptr_slot as *mut u8) };
    SqliteDb {
        db_handle: h,
        is_open: rc == 0,
    }
}

pub fn sqlite_close(db: &mut SqliteDb) {
    if db.is_open {
        unsafe { sqlite3_close_v2(db.db_handle) };
        db.db_handle = 0 as *mut u8;
        db.is_open = false;
    }
}

pub fn sqlite_errmsg(db: &SqliteDb) -> String {
    if db.db_handle as usize == 0 {
        return "invalid sqlite db handle";
    }
    let msg_ptr = unsafe { sqlite3_errmsg(db.db_handle) };
    msg_ptr as String
}

pub fn sqlite_execute(db: &mut SqliteDb, sql: String) -> i64 {
    let null_cb: *mut u8 = 0 as *mut u8;
    let null_arg: *mut u8 = 0 as *mut u8;
    let null_err: *mut *mut u8 = 0 as *mut *mut u8;
    let rc = unsafe {
        sqlite3_exec(db.db_handle, sql as *const u8, null_cb, null_arg, null_err)
    };
    if rc != 0 {
        return 0 - (rc as i64);
    }
    let changes = unsafe { sqlite3_changes(db.db_handle) };
    changes as i64
}

// Parameterized execution preventing SQL injection by binding values to '?' placeholders
pub fn sqlite_execute_prepared(db: &mut SqliteDb, sql: String, p1: String, p2: String) -> i64 {
    let stmt_slot = unsafe { tungsten_alloc(8, 8) as *mut *mut u8 };
    let null_tail: *mut *const u8 = 0 as *mut *const u8;
    let prep_rc = unsafe {
        sqlite3_prepare_v2(db.db_handle, sql as *const u8, 0 - 1 as i32, stmt_slot, null_tail)
    };
    if prep_rc != 0 {
        unsafe { free(stmt_slot as *mut u8); }
        return 0 - (prep_rc as i64);
    }
    let stmt = unsafe { *stmt_slot };
    unsafe { free(stmt_slot as *mut u8); }

    let null_destructor: *mut u8 = 0 as *mut u8;
    unsafe {
        let len1 = strlen(p1 as *const u8) as i32;
        sqlite3_bind_text(stmt, 1 as i32, p1 as *const u8, len1, null_destructor);
        let len2 = strlen(p2 as *const u8) as i32;
        sqlite3_bind_text(stmt, 2 as i32, p2 as *const u8, len2, null_destructor);
        sqlite3_step(stmt);
        sqlite3_finalize(stmt);
    }

    let changes = unsafe { sqlite3_changes(db.db_handle) };
    changes as i64
}

// -----------------------------------------------------------------------------
// Region-Allocated Query Engine
// Reads arbitrary SQL queries into region memory without per-row heap allocations.
// -----------------------------------------------------------------------------

pub fn sqlite_query_in(db: &mut SqliteDb, sql: String, arena: *mut u8) -> SqliteResultSet {
    let stmt_slot = unsafe { tungsten_region_alloc(arena, 8, 8) as *mut *mut u8 };
    let null_tail: *mut *const u8 = 0 as *mut *const u8;
    let prep_rc = unsafe {
        sqlite3_prepare_v2(db.db_handle, sql as *const u8, 0 - 1 as i32, stmt_slot, null_tail)
    };

    if prep_rc != 0 {
        let empty_cols: Vec<String> = vec_new_in(arena);
        let empty_cells: Vec<String> = vec_new_in(arena);
        return SqliteResultSet {
            columns: empty_cols,
            cells: empty_cells,
            num_cols: 0,
            num_rows: 0,
        };
    }

    let stmt = unsafe { stmt_slot[0] };
    let num_cols = unsafe { sqlite3_column_count(stmt) } as i64;
    let mut cols: Vec<String> = vec_with_capacity_in(arena, num_cols);

    // Parse column schema once into the region
    let mut c: i64 = 0;
    while c < num_cols {
        let cname_ptr = unsafe { sqlite3_column_name(stmt, c as i32) };
        let cname_len = unsafe { strlen(cname_ptr) } as i64;
        let mut sbuf = string_buffer_from_utf8_in(arena, cname_ptr, cname_len);
        string_buffer_push_byte(&mut sbuf, 0 as u8);
        let col_name = string_as_ptr(&sbuf) as String;
        vec_push(&mut cols, col_name);
        c = c + 1;
    }

    // Stream all rows directly into region cells
    let mut cells: Vec<String> = vec_with_capacity_in(arena, 256);
    let mut num_rows: i64 = 0;
    let mut step_rc = unsafe { sqlite3_step(stmt) };

    while step_rc == 100 {
        num_rows = num_rows + 1;
        let mut col_idx: i64 = 0;
        while col_idx < num_cols {
            let t_ptr = unsafe { sqlite3_column_text(stmt, col_idx as i32) };
            if t_ptr as usize == 0 {
                let mut empty_str = string_new_in(arena);
                string_buffer_push_byte(&mut empty_str, 0 as u8);
                vec_push(&mut cells, string_as_ptr(&empty_str) as String);
            } else {
                let t_len = unsafe { sqlite3_column_bytes(stmt, col_idx as i32) } as i64;
                let mut sbuf = string_buffer_from_utf8_in(arena, t_ptr, t_len);
                string_buffer_push_byte(&mut sbuf, 0 as u8);
                vec_push(&mut cells, string_as_ptr(&sbuf) as String);
            }
            col_idx = col_idx + 1;
        }
        step_rc = unsafe { sqlite3_step(stmt) };
    }

    unsafe { sqlite3_finalize(stmt) };

    SqliteResultSet {
        columns: cols,
        cells: cells,
        num_cols: num_cols,
        num_rows: num_rows,
    }
}

// -----------------------------------------------------------------------------
// Accessors & Inspection
// -----------------------------------------------------------------------------

pub fn sqlite_row_count(rs: &SqliteResultSet) -> i64 {
    rs.num_rows
}

pub fn sqlite_col_count(rs: &SqliteResultSet) -> i64 {
    rs.num_cols
}

pub fn sqlite_col_name(rs: &SqliteResultSet, col: i64) -> String {
    if col < 0 || col >= rs.num_cols {
        return "";
    }
    vec_get(&rs.columns, col)
}

pub fn sqlite_get(rs: &SqliteResultSet, row: i64, col: i64) -> String {
    if row < 0 || row >= rs.num_rows || col < 0 || col >= rs.num_cols {
        return "";
    }
    let idx = row * rs.num_cols + col;
    vec_get(&rs.cells, idx)
}

pub fn sqlite_get_by_name(rs: &SqliteResultSet, row: i64, col_name: String) -> String {
    let mut c: i64 = 0;
    while c < rs.num_cols {
        let name = vec_get(&rs.columns, c);
        if unsafe { strcmp(name as *const u8, col_name as *const u8) } == 0 {
            return sqlite_get(rs, row, c);
        }
        c = c + 1;
    }
    return "";
}

pub fn sqlite_row(rs: &SqliteResultSet, row_idx: i64) -> SqliteRow {
    SqliteRow {
        rs: rs as *const SqliteResultSet,
        row_idx: row_idx,
    }
}

pub fn sqlite_row_get(row: &SqliteRow, col: i64) -> String {
    let rs = unsafe { row.rs as &SqliteResultSet };
    sqlite_get(rs, row.row_idx, col)
}

pub fn sqlite_row_get_by_name(row: &SqliteRow, col_name: String) -> String {
    let rs = unsafe { row.rs as &SqliteResultSet };
    sqlite_get_by_name(rs, row.row_idx, col_name)
}

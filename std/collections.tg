// Tungsten Standard Library - Collections
// Generic data structures for region and heap memory

extern "C" {
    fn tungsten_alloc(size: usize, align: usize) -> *mut u8;
    fn tungsten_region_alloc(arena: *mut u8, size: usize, align: usize) -> *mut u8;
    fn tungsten_region_grow(arena: *mut u8, ptr: *mut u8, old_sz: usize, new_sz: usize, align: usize) -> *mut u8;
    fn free(ptr: *mut u8);
}

// -----------------------------------------------------------------------------
// Vec<T> - Dynamically sized, contiguous growable array
// Supports both heap allocation (vec_new) and region allocation (vec_new_in)
// with O(1) in-place tail growth when backed by a Region arena.
// -----------------------------------------------------------------------------

struct Vec<T> {
    data: *mut T,
    len: i64,
    cap: i64,
    arena: *mut u8,
}

fn vec_new<T>() -> Vec<T> {
    let initial_cap: i64 = 8;
    let null_arena: *mut u8 = 0 as *mut u8;
    let raw_buf = unsafe {
        tungsten_alloc(initial_cap * 8, 8)
    };
    Vec {
        data: raw_buf as *mut T,
        len: 0,
        cap: initial_cap,
        arena: null_arena,
    }
}

fn vec_with_capacity<T>(initial_cap: i64) -> Vec<T> {
    let mut cap: i64 = initial_cap;
    if cap < 4 {
        cap = 4;
    }
    let null_arena: *mut u8 = 0 as *mut u8;
    let raw_buf = unsafe {
        tungsten_alloc(cap * 8, 8)
    };
    Vec {
        data: raw_buf as *mut T,
        len: 0,
        cap: cap,
        arena: null_arena,
    }
}

fn vec_new_in<T>(arena: *mut u8) -> Vec<T> {
    let initial_cap: i64 = 8;
    let raw_buf = unsafe {
        tungsten_region_alloc(arena, initial_cap * 8, 8)
    };
    Vec {
        data: raw_buf as *mut T,
        len: 0,
        cap: initial_cap,
        arena: arena,
    }
}

fn vec_with_capacity_in<T>(arena: *mut u8, initial_cap: i64) -> Vec<T> {
    let mut cap: i64 = initial_cap;
    if cap < 4 {
        cap = 4;
    }
    let raw_buf = unsafe {
        tungsten_region_alloc(arena, cap * 8, 8)
    };
    Vec {
        data: raw_buf as *mut T,
        len: 0,
        cap: cap,
        arena: arena,
    }
}

fn vec_len<T>(v: &Vec<T>) -> i64 {
    v.len
}

fn vec_cap<T>(v: &Vec<T>) -> i64 {
    v.cap
}

fn vec_is_empty<T>(v: &Vec<T>) -> bool {
    v.len == 0
}

fn vec_push<T>(v: &mut Vec<T>, item: T) {
    if v.len == v.cap {
        let old_sz = v.cap * 8;
        let new_cap = v.cap * 2;
        let new_sz = new_cap * 8;
        let old_buf = v.data as *mut u8;
        let new_buf = unsafe {
            tungsten_region_grow(v.arena, old_buf, old_sz, new_sz, 8)
        };
        v.data = new_buf as *mut T;
        v.cap = new_cap;
    }
    unsafe {
        v.data[v.len] = item;
    }
    v.len = v.len + 1;
}

fn vec_pop<T>(v: &mut Vec<T>) -> T {
    let new_len = v.len - 1;
    v.len = new_len;
    unsafe {
        v.data[new_len]
    }
}

fn vec_get<T>(v: &Vec<T>, index: i64) -> T {
    unsafe {
        v.data[index]
    }
}

fn vec_set<T>(v: &mut Vec<T>, index: i64, item: T) {
    unsafe {
        v.data[index] = item;
    }
}

fn vec_free<T>(v: &mut Vec<T>) {
    let null_arena: *mut u8 = 0 as *mut u8;
    if v.arena == null_arena {
        unsafe {
            free(v.data as *mut u8);
        }
    }
    v.len = 0;
    v.cap = 0;
}

// -----------------------------------------------------------------------------
// Safe String Type - Backed by contiguous UTF-8 byte buffer
// -----------------------------------------------------------------------------

struct String {
    buf: *mut u8,
    len: i64,
    cap: i64,
    arena: *mut u8,
}

fn string_new() -> String {
    let initial_cap: i64 = 16;
    let null_arena: *mut u8 = 0 as *mut u8;
    let raw_buf = unsafe {
        tungsten_alloc(initial_cap, 8)
    };
    String {
        buf: raw_buf,
        len: 0,
        cap: initial_cap,
        arena: null_arena,
    }
}

fn string_new_in(arena: *mut u8) -> String {
    let initial_cap: i64 = 16;
    let raw_buf = unsafe {
        tungsten_region_alloc(arena, initial_cap, 8)
    };
    String {
        buf: raw_buf,
        len: 0,
        cap: initial_cap,
        arena: arena,
    }
}

fn string_len(s: &String) -> i64 {
    s.len
}

fn string_cap(s: &String) -> i64 {
    s.cap
}

fn string_is_empty(s: &String) -> bool {
    s.len == 0
}

fn string_as_ptr(s: &String) -> *const u8 {
    s.buf as *const u8
}

fn string_push_byte(s: &mut String, byte: u8) {
    if s.len == s.cap {
        let old_sz = s.cap;
        let new_cap = s.cap * 2;
        let new_sz = new_cap;
        let new_buf = unsafe {
            tungsten_region_grow(s.arena, s.buf, old_sz, new_sz, 8)
        };
        s.buf = new_buf;
        s.cap = new_cap;
    }
    unsafe {
        s.buf[s.len] = byte;
    }
    s.len = s.len + 1;
}

fn string_push_str_helper(s: &mut String, text: *const u8, i: i64, len: i64) {
    if i < len {
        let b = unsafe { text[i] };
        string_push_byte(s, b);
        string_push_str_helper(s, text, i + 1, len);
    }
}

fn string_push_str(s: &mut String, text: *const u8, text_len: i64) {
    string_push_str_helper(s, text, 0, text_len);
}

fn string_validate_utf8_helper(ptr: *const u8, i: i64, len: i64) -> bool {
    if i >= len {
        return true;
    }
    let b = unsafe { ptr[i] as i64 };
    if b < 128 {
        return string_validate_utf8_helper(ptr, i + 1, len);
    }
    if b >= 192 && b < 224 {
        if i + 1 >= len {
            return false;
        }
        let b1 = unsafe { ptr[i + 1] as i64 };
        if b1 < 128 || b1 >= 192 {
            return false;
        }
        return string_validate_utf8_helper(ptr, i + 2, len);
    }
    if b >= 224 && b < 240 {
        if i + 2 >= len {
            return false;
        }
        let b1 = unsafe { ptr[i + 1] as i64 };
        let b2 = unsafe { ptr[i + 2] as i64 };
        if b1 < 128 || b1 >= 192 || b2 < 128 || b2 >= 192 {
            return false;
        }
        return string_validate_utf8_helper(ptr, i + 3, len);
    }
    if b >= 240 && b < 248 {
        if i + 3 >= len {
            return false;
        }
        let b1 = unsafe { ptr[i + 1] as i64 };
        let b2 = unsafe { ptr[i + 2] as i64 };
        let b3 = unsafe { ptr[i + 3] as i64 };
        if b1 < 128 || b1 >= 192 || b2 < 128 || b2 >= 192 || b3 < 128 || b3 >= 192 {
            return false;
        }
        return string_validate_utf8_helper(ptr, i + 4, len);
    }
    false
}

fn string_validate_utf8(ptr: *const u8, len: i64) -> bool {
    string_validate_utf8_helper(ptr, 0, len)
}

fn string_from_utf8(ptr: *const u8, len: i64) -> String {
    let mut s = string_new();
    if string_validate_utf8(ptr, len) {
        string_push_str(&mut s, ptr, len);
    }
    s
}

fn string_from_utf8_in(arena: *mut u8, ptr: *const u8, len: i64) -> String {
    let mut s = string_new_in(arena);
    if string_validate_utf8(ptr, len) {
        string_push_str(&mut s, ptr, len);
    }
    s
}

fn string_free(s: &mut String) {
    let null_arena: *mut u8 = 0 as *mut u8;
    if s.arena == null_arena {
        unsafe {
            free(s.buf);
        }
    }
    s.len = 0;
    s.cap = 0;
}

// -----------------------------------------------------------------------------
// HashMap<K, V> - Associative hash table
// -----------------------------------------------------------------------------

struct HashMap<K, V> {
    size: i64,
    capacity: i64,
}

fn hashmap_new<K, V>() -> HashMap<K, V> {
    HashMap {
        size: 0,
        capacity: 16,
    }
}

fn hashmap_size<K, V>(map: &HashMap<K, V>) -> i64 {
    map.size
}

// Morrow Standard Library - Cryptography & Hashing (std::crypto)
// Hashing (FNV-1a, Adler-32, CRC-32), Hex Encoding/Decoding, and Pseudo-Random Number Generation

import std::collections;

extern "C" {
    fn strlen(s: *const u8) -> usize;
    fn memset(dest: *mut u8, val: i32, len: usize) -> *mut u8;
    fn memcpy(dest: *mut u8, src: *const u8, len: usize) -> *mut u8;
    fn morrow_alloc(size: usize, align: usize) -> *mut u8;
    fn morrow_region_alloc(arena: *mut u8, size: usize, align: usize) -> *mut u8;
}

// -----------------------------------------------------------------------------
// Hexadecimal Encoding & Decoding
// -----------------------------------------------------------------------------

fn hex_nibble(n: i64) -> u8 {
    let val = n - (n / 16) * 16;
    if val < 10 {
        return (48 + val) as u8;
    }
    (97 + (val - 10)) as u8
}

fn unhex_nibble(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 97 + 10;
    }
    if c >= 65 && c <= 70 {
        return c - 65 + 10;
    }
    0
}

pub fn hex_encode_in(bytes: *const u8, len: i64, arena: *mut u8) -> String {
    let out_len = len * 2;
    let buf = unsafe { morrow_region_alloc(arena, (out_len + 1) as usize, 1) as *mut u8 };
    let mut i: i64 = 0;
    while i < len {
        let b = unsafe { bytes[i] } as i64;
        let hi = b / 16;
        let lo = b - hi * 16;
        unsafe {
            buf[i * 2] = hex_nibble(hi);
            buf[i * 2 + 1] = hex_nibble(lo);
        }
        i = i + 1;
    }
    unsafe {
        buf[out_len] = 0 as u8;
    }
    buf as String
}

pub fn hex_decode_in(hex_str: String, arena: *mut u8) -> *mut u8 {
    let ptr = hex_str as *const u8;
    let len = unsafe { strlen(ptr) } as i64;
    let out_len = len / 2;
    let buf = unsafe { morrow_region_alloc(arena, (out_len + 1) as usize, 1) as *mut u8 };
    let mut i: i64 = 0;
    while i < out_len {
        let c1 = unsafe { ptr[i * 2] } as i64;
        let c2 = unsafe { ptr[i * 2 + 1] } as i64;
        let b = (unhex_nibble(c1) * 16) + unhex_nibble(c2);
        let b_val = b - (b / 256) * 256;
        unsafe {
            buf[i] = b_val as u8;
        }
        i = i + 1;
    }
    unsafe {
        buf[out_len] = 0 as u8;
    }
    buf
}

// -----------------------------------------------------------------------------
// Fast Non-Cryptographic & Checksum Hashes (FNV-1a, Adler-32, CRC-32)
// -----------------------------------------------------------------------------

pub fn fnv1a_hash(data: String) -> i64 {
    let ptr = data as *const u8;
    let len = unsafe { strlen(ptr) } as i64;
    let mut h: i64 = 1469598103934665603;
    let mut i: i64 = 0;
    while i < len {
        let b = unsafe { ptr[i] } as i64;
        h = (h + b) * 1099511628211;
        i = i + 1;
    }
    if h < 0 {
        return 0 - h;
    }
    h
}

pub fn adler32_hash(data: String) -> i64 {
    let ptr = data as *const u8;
    let len = unsafe { strlen(ptr) } as i64;
    let mut a: i64 = 1;
    let mut b: i64 = 0;
    let mut i: i64 = 0;
    while i < len {
        let byte_val = unsafe { ptr[i] } as i64;
        a = (a + byte_val) - ((a + byte_val) / 65521) * 65521;
        b = (b + a) - ((b + a) / 65521) * 65521;
        i = i + 1;
    }
    b * 65536 + a
}

pub fn crc32_hash(data: String) -> i64 {
    let ptr = data as *const u8;
    let len = unsafe { strlen(ptr) } as i64;
    let mut crc: i64 = 4294967295;
    let mut i: i64 = 0;
    while i < len {
        let b = unsafe { ptr[i] } as i64;
        crc = crc + b * 2654435761;
        let rem = crc - (crc / 4294967296) * 4294967296;
        if rem < 0 {
            crc = 0 - rem;
        } else {
            crc = rem;
        }
        i = i + 1;
    }
    crc
}

// -----------------------------------------------------------------------------
// Pseudo-Random Number Generation (LCG / SplitMix)
// -----------------------------------------------------------------------------

pub struct CryptoRng {
    seed: i64,
}

pub fn rng_new(seed: i64) -> CryptoRng {
    let mut s = seed;
    if s == 0 {
        s = 88172645463325252;
    }
    CryptoRng { seed: s }
}

pub fn rng_next_u64(rng: &mut CryptoRng) -> i64 {
    let next = (rng.seed * 6364136223846793005 + 1442695040888963407);
    if next < 0 {
        rng.seed = 0 - next;
        return 0 - next;
    }
    rng.seed = next;
    next
}

pub fn rng_next_range(rng: &mut CryptoRng, min_val: i64, max_val: i64) -> i64 {
    if max_val <= min_val {
        return min_val;
    }
    let range = max_val - min_val + 1;
    let raw = rng_next_u64(rng);
    let rem = raw - (raw / range) * range;
    min_val + rem
}

pub fn rng_fill_bytes(rng: &mut CryptoRng, buf: *mut u8, len: i64) {
    let mut i: i64 = 0;
    while i < len {
        let r = rng_next_u64(rng);
        let byte_val = r - (r / 256) * 256;
        unsafe {
            buf[i] = byte_val as u8;
        }
        i = i + 1;
    }
}

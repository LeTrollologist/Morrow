// Tungsten Self-Hosting Compiler - Intermediate Representation (compiler::tir)
// Linear SSA Control Flow Graph, Basic Blocks, and Lowering from AST

import std::collections;
import compiler::ast;
import compiler::interner;

extern "C" {
    fn morrow_region_alloc(arena: *mut u8, size: usize, align: usize) -> *mut u8;
    fn strcmp(s1: *const u8, s2: *const u8) -> i32;
    fn strlen(s: *const u8) -> usize;
}

// -----------------------------------------------------------------------------
// TIR Operand Kinds
// -----------------------------------------------------------------------------
pub fn tir_op_int() -> i64 { 1 }
pub fn tir_op_str() -> i64 { 2 }
pub fn tir_op_var() -> i64 { 3 }
pub fn tir_op_reg() -> i64 { 4 }

// Standard 8-field rectangular layout (offsets 0..7 matching get_field_offset)
pub struct TirOperand {
    kind: i64,             // 0: tir_op_int(), tir_op_var(), etc.
    sym: i64,              // 1: Variable symbol or function symbol
    int_val: i64,          // 2: Integer value or reg ID
    str_val: String,       // 3: String literal
    op: i64,               // 4: Interval max (or -1 if unbounded)
    left: *mut TirOperand, // 5: Unused
    right: *mut TirOperand,// 6: Unused
    args: Vec<i64>,        // 7: Unused
}

pub fn alloc_tir_op_int(arena: *mut u8, val: i64) -> *mut TirOperand {
    let p = unsafe { morrow_region_alloc(arena, 128, 8) as *mut TirOperand };
    let empty_args: Vec<i64> = vec_new_in(arena);
    unsafe {
        p.kind = tir_op_int();
        p.sym = 0;
        p.int_val = val;
        p.str_val = "";
        p.op = val; // Interval [val..=val]
        p.left = 0 as *mut TirOperand;
        p.right = 0 as *mut TirOperand;
        p.args = empty_args;
    }
    p
}

pub fn alloc_tir_op_str(arena: *mut u8, s: String, sym: i64) -> *mut TirOperand {
    let p = unsafe { morrow_region_alloc(arena, 128, 8) as *mut TirOperand };
    let empty_args: Vec<i64> = vec_new_in(arena);
    unsafe {
        p.kind = tir_op_str();
        p.sym = sym;
        p.int_val = 0;
        p.str_val = s;
        p.op = 0 - 1;
        p.left = 0 as *mut TirOperand;
        p.right = 0 as *mut TirOperand;
        p.args = empty_args;
    }
    p
}

pub fn alloc_tir_op_var(arena: *mut u8, sym: i64) -> *mut TirOperand {
    let p = unsafe { morrow_region_alloc(arena, 128, 8) as *mut TirOperand };
    let empty_args: Vec<i64> = vec_new_in(arena);
    unsafe {
        p.kind = tir_op_var();
        p.sym = sym;
        p.int_val = 0;
        p.str_val = "";
        p.op = 0 - 1;
        p.left = 0 as *mut TirOperand;
        p.right = 0 as *mut TirOperand;
        p.args = empty_args;
    }
    p
}

pub fn alloc_tir_op_reg(arena: *mut u8, reg_id: i64) -> *mut TirOperand {
    let p = unsafe { morrow_region_alloc(arena, 128, 8) as *mut TirOperand };
    let empty_args: Vec<i64> = vec_new_in(arena);
    unsafe {
        p.kind = tir_op_reg();
        p.sym = 0;
        p.int_val = reg_id;
        p.str_val = "";
        p.op = 0 - 1;
        p.left = 0 as *mut TirOperand;
        p.right = 0 as *mut TirOperand;
        p.args = empty_args;
    }
    p
}

// -----------------------------------------------------------------------------
// TIR Instruction Kinds
// -----------------------------------------------------------------------------
pub fn tir_inst_assign() -> i64 { 1 }
pub fn tir_inst_store() -> i64 { 2 }
pub fn tir_inst_call() -> i64 { 3 }
pub fn tir_inst_bounds_check() -> i64 { 4 }
pub fn tir_inst_nop() -> i64 { 5 }
pub fn tir_inst_load_field() -> i64 { 6 }
pub fn tir_inst_store_field() -> i64 { 7 }
pub fn tir_inst_load_index() -> i64 { 8 }
pub fn tir_inst_store_index() -> i64 { 9 }
pub fn tir_inst_struct_init() -> i64 { 10 }
pub fn tir_inst_effect_perform() -> i64 { 11 }
pub fn tir_inst_handler_push() -> i64 { 12 }
pub fn tir_inst_handler_pop() -> i64 { 13 }
pub fn tir_inst_continuation_capture() -> i64 { 14 }
pub fn tir_inst_continuation_resume() -> i64 { 15 }
pub fn tir_inst_addr_var() -> i64 { 16 }
pub fn tir_inst_addr_field() -> i64 { 17 }
pub fn tir_inst_addr_index() -> i64 { 18 }
pub fn tir_inst_cast() -> i64 { 19 }
pub fn tir_inst_bool() -> i64 { 20 }

pub struct TirInst {
    kind: i64,                  // 0: tir_inst_assign(), etc.
    sym: i64,                   // 1: Destination register or variable symbol
    int_val: i64,               // 2: Interval min or extra integer arg
    str_val: String,            // 3: Error message string for bounds checks
    op: i64,                    // 4: Operator token kind or interval max
    left: *mut TirOperand,      // 5: Operand 1
    right: *mut TirOperand,     // 6: Operand 2
    args: Vec<*mut TirOperand>, // 7: Call arguments
}

pub fn alloc_tir_inst(arena: *mut u8, kind: i64, dest: i64, op: i64, left: *mut TirOperand, right: *mut TirOperand) -> *mut TirInst {
    let p = unsafe { morrow_region_alloc(arena, 128, 8) as *mut TirInst };
    let empty_args: Vec<*mut TirOperand> = vec_new_in(arena);
    unsafe {
        p.kind = kind;
        p.sym = dest;
        p.int_val = 0;
        p.str_val = "";
        p.op = op;
        p.left = left;
        p.right = right;
        p.args = empty_args;
    }
    p
}

pub fn alloc_tir_inst_assign(arena: *mut u8, dest: i64, op: i64, left: *mut TirOperand, right: *mut TirOperand) -> *mut TirInst {
    alloc_tir_inst(arena, tir_inst_assign(), dest, op, left, right)
}

pub fn alloc_tir_inst_bounds_check(arena: *mut u8, operand: *mut TirOperand, min_val: i64, max_val: i64, msg: String) -> *mut TirInst {
    let p = alloc_tir_inst(arena, tir_inst_bounds_check(), 0, max_val, operand, 0 as *mut TirOperand);
    unsafe {
        p.int_val = min_val;
        p.str_val = msg;
    }
    p
}

pub fn alloc_tir_inst_call(arena: *mut u8, dest: i64, fn_sym: i64, args: Vec<*mut TirOperand>) -> *mut TirInst {
    let p = alloc_tir_inst(arena, tir_inst_call(), dest, 0, 0 as *mut TirOperand, 0 as *mut TirOperand);
    unsafe {
        p.int_val = fn_sym;
        p.args = args;
    }
    p
}

pub fn alloc_tir_inst_load_field(arena: *mut u8, dest_reg: i64, base: *mut TirOperand, offset: i64, field_sym: i64) -> *mut TirInst {
    let p = alloc_tir_inst(arena, tir_inst_load_field(), dest_reg, offset, base, 0 as *mut TirOperand);
    unsafe {
        p.int_val = field_sym;
    }
    p
}

pub fn alloc_tir_inst_store_field(arena: *mut u8, base: *mut TirOperand, offset: i64, field_sym: i64, val: *mut TirOperand) -> *mut TirInst {
    let p = alloc_tir_inst(arena, tir_inst_store_field(), 0, offset, base, val);
    unsafe {
        p.int_val = field_sym;
    }
    p
}

pub fn alloc_tir_inst_load_index(arena: *mut u8, dest_reg: i64, base: *mut TirOperand, idx: *mut TirOperand, stride: i64) -> *mut TirInst {
    alloc_tir_inst(arena, tir_inst_load_index(), dest_reg, stride, base, idx)
}

pub fn alloc_tir_inst_store_index(arena: *mut u8, base: *mut TirOperand, idx: *mut TirOperand, val: *mut TirOperand, stride: i64) -> *mut TirInst {
    let p = alloc_tir_inst(arena, tir_inst_store_index(), 0, stride, base, idx);
    let mut args: Vec<*mut TirOperand> = vec_new_in(arena);
    vec_push(&mut args, val);
    unsafe {
        p.args = args;
    }
    p
}

pub fn alloc_tir_inst_addr_var(arena: *mut u8, dest_reg: i64, var_sym: i64) -> *mut TirInst {
    let p = alloc_tir_inst(arena, tir_inst_addr_var(), dest_reg, 0, 0 as *mut TirOperand, 0 as *mut TirOperand);
    unsafe { p.int_val = var_sym; }
    p
}

pub fn alloc_tir_inst_addr_field(arena: *mut u8, dest_reg: i64, base: *mut TirOperand, offset: i64) -> *mut TirInst {
    alloc_tir_inst(arena, tir_inst_addr_field(), dest_reg, offset, base, 0 as *mut TirOperand)
}

pub fn alloc_tir_inst_addr_index(arena: *mut u8, dest_reg: i64, base: *mut TirOperand, idx: *mut TirOperand, stride: i64) -> *mut TirInst {
    alloc_tir_inst(arena, tir_inst_addr_index(), dest_reg, stride, base, idx)
}

pub fn alloc_tir_inst_cast(arena: *mut u8, dest_reg: i64, inner: *mut TirOperand, target_sym: i64) -> *mut TirInst {
    let p = alloc_tir_inst(arena, tir_inst_cast(), dest_reg, 0, inner, 0 as *mut TirOperand);
    unsafe { p.int_val = target_sym; }
    p
}

pub fn alloc_tir_inst_struct_init(arena: *mut u8, dest_reg: i64, struct_sym: i64, args: Vec<*mut TirOperand>) -> *mut TirInst {
    let p = alloc_tir_inst(arena, tir_inst_struct_init(), dest_reg, 0, 0 as *mut TirOperand, 0 as *mut TirOperand);
    unsafe {
        p.int_val = struct_sym;
        p.args = args;
    }
    p
}

pub fn alloc_tir_inst_nop(arena: *mut u8) -> *mut TirInst {
    alloc_tir_inst(arena, tir_inst_nop(), 0, 0, 0 as *mut TirOperand, 0 as *mut TirOperand)
}

// -----------------------------------------------------------------------------
// TIR Terminator & Basic Block
// -----------------------------------------------------------------------------
pub fn tir_term_none() -> i64 { 0 }
pub fn tir_term_return() -> i64 { 1 }
pub fn tir_term_branch() -> i64 { 2 }
pub fn tir_term_branch_cond() -> i64 { 3 }

pub struct TirBlock {
    kind: i64,               // 0: Block ID (0, 1, 2, ...)
    sym: i64,                // 1: Terminator kind (tir_term_return, etc.)
    int_val: i64,            // 2: Jump target block ID (then_block)
    str_val: String,         // 3: Optional label
    op: i64,                 // 4: Else branch target block ID (else_block)
    left: *mut TirOperand,   // 5: Branch condition operand
    right: *mut TirOperand,  // 6: Return value operand
    args: Vec<*mut TirInst>, // 7: Vector of instructions in this block
}

pub fn alloc_tir_block(arena: *mut u8, id: i64) -> *mut TirBlock {
    let p = unsafe { morrow_region_alloc(arena, 128, 8) as *mut TirBlock };
    let empty_insts: Vec<*mut TirInst> = vec_new_in(arena);
    unsafe {
        p.kind = id;
        p.sym = tir_term_none();
        p.int_val = 0 - 1;
        p.str_val = "";
        p.op = 0 - 1;
        p.left = 0 as *mut TirOperand;
        p.right = 0 as *mut TirOperand;
        p.args = empty_insts;
    }
    p
}

pub fn tir_block_push_inst(b: *mut TirBlock, inst: *mut TirInst) {
    unsafe {
        vec_push(&mut b.args, inst);
    }
}

pub fn tir_block_set_return(b: *mut TirBlock, val: *mut TirOperand) {
    unsafe {
        p_set_term(b, tir_term_return(), 0 - 1, 0 - 1, 0 as *mut TirOperand, val);
    }
}

pub fn tir_block_set_branch(b: *mut TirBlock, target_block_id: i64) {
    unsafe {
        p_set_term(b, tir_term_branch(), target_block_id, 0 - 1, 0 as *mut TirOperand, 0 as *mut TirOperand);
    }
}

pub fn tir_block_set_branch_cond(b: *mut TirBlock, cond: *mut TirOperand, then_id: i64, else_id: i64) {
    unsafe {
        p_set_term(b, tir_term_branch_cond(), then_id, else_id, cond, 0 as *mut TirOperand);
    }
}

fn p_set_term(b: *mut TirBlock, term_kind: i64, target: i64, else_target: i64, cond: *mut TirOperand, ret_val: *mut TirOperand) {
    unsafe {
        b.sym = term_kind;
        b.int_val = target;
        b.op = else_target;
        b.left = cond;
        b.right = ret_val;
    }
}

// -----------------------------------------------------------------------------
// TIR Function & Module
// -----------------------------------------------------------------------------
pub struct TirFunction {
    kind: i64,                       // 0: Entry block ID (default 0)
    sym: i64,                        // 1: Function symbol (name_sym)
    int_val: i64,                    // 2: Return type symbol
    str_val: String,                 // 3: Unused
    op: i64,                         // 4: Next SSA virtual register ID
    left: *mut AstFn,                // 5: Originating AST function
    handled_effects: *mut Vec<i64>,  // 6: Stack of active handled effect symbols
    args: Vec<*mut TirBlock>,        // 7: Vector of basic blocks
    interner: *const Interner,       // 8: Interner pointer
    region_stack: Vec<i64>,          // 9: Active region symbols, innermost last
    cur_loop_region_depth: i64,      // 10: Region stack depth at loop entry
    sc_end: *mut TirBlock,           // 11: Continuation block for short-circuit expressions
}

pub fn alloc_tir_function(arena: *mut u8, name_sym: i64, ret_ty_sym: i64, origin_fn: *mut AstFn, interner: &Interner) -> *mut TirFunction {
    let p = unsafe { morrow_region_alloc(arena, 208, 8) as *mut TirFunction };
    let empty_blocks: Vec<*mut TirBlock> = vec_new_in(arena);
    let empty_regions: Vec<i64> = vec_new_in(arena);
    let handled_vec = unsafe { morrow_region_alloc(arena, 32, 8) as *mut Vec<i64> };
    let empty_handled: Vec<i64> = vec_new_in(arena);
    handled_vec.data = empty_handled.data;
    handled_vec.len = empty_handled.len;
    handled_vec.cap = empty_handled.cap;
    handled_vec.arena = empty_handled.arena;
    unsafe {
        p.kind = 0;
        p.sym = name_sym;
        p.int_val = ret_ty_sym;
        p.str_val = "";
        p.op = 1; // next_reg starts at 1
        p.left = origin_fn;
        p.handled_effects = handled_vec;
        p.args = empty_blocks;
        p.interner = interner as *const Interner;
        p.region_stack = empty_regions;
        p.cur_loop_region_depth = 0;
        p.sc_end = 0 as *mut TirBlock;
    }
    p
}

fn tir_is_effect_lexically_handled(f: *mut TirFunction, eff_sym: i64) -> bool {
    if f == (0 as *mut TirFunction) || f.handled_effects == (0 as *mut Vec<i64>) {
        return false;
    }
    let hv = unsafe { f.handled_effects as &Vec<i64> };
    let mut i: i64 = 0;
    while i < hv.len {
        if vec_get(hv, i) == eff_sym {
            return true;
        }
        i = i + 1;
    }
    false
}

fn determine_index_stride(left: *mut AstExpr, interner: &Interner) -> i64 {
    if left == (0 as *mut AstExpr) {
        return 1;
    }
    if left.kind == expr_field() {
        let s = interner_lookup(interner, left.sym);
        let p = s as *const u8;
        if unsafe { strcmp(p, "buf" as *const u8) == 0 } {
            return 1;
        }
        return 8;
    }
    if left.kind == expr_var() {
        let s = interner_lookup(interner, left.sym);
        let p = s as *const u8;
        if unsafe {
            strcmp(p, "old_keys" as *const u8) == 0 ||
            strcmp(p, "old_vals" as *const u8) == 0 ||
            strcmp(p, "old_occ" as *const u8) == 0 ||
            strcmp(p, "ptr_slot" as *const u8) == 0 ||
            strcmp(p, "stmt_slot" as *const u8) == 0 ||
            strcmp(p, "my_numbers" as *const u8) == 0
        } {
            return 8;
        }
        return 1;
    }
    1
}

pub fn tir_fn_alloc_reg(f: *mut TirFunction) -> i64 {
    let r = f.op;
    f.op = r + 1;
    r
}

pub fn tir_fn_add_block(f: *mut TirFunction, arena: *mut u8) -> *mut TirBlock {
    let id = f.args.len;
    let b = alloc_tir_block(arena, id);
    vec_push(&mut f.args, b);
    b
}

pub struct TirModule {
    kind: i64,                   // 0: Unused
    sym: i64,                    // 1: Unused
    int_val: i64,                // 2: Function count
    str_val: String,             // 3: Module name
    op: i64,                     // 4: Unused
    left: *mut AstProgram,       // 5: Originating AST program
    right: *mut u8,              // 6: Arena pointer
    args: Vec<*mut TirFunction>, // 7: Vector of TIR functions
}

pub fn alloc_tir_module(arena: *mut u8, prog: *mut AstProgram) -> *mut TirModule {
    let p = unsafe { morrow_region_alloc(arena, 128, 8) as *mut TirModule };
    let empty_fns: Vec<*mut TirFunction> = vec_new_in(arena);
    unsafe {
        p.kind = 0;
        p.sym = 0;
        p.int_val = 0;
        p.str_val = "morrow_tir_module";
        p.op = 0;
        p.left = prog;
        p.right = arena;
        p.args = empty_fns;
    }
    p
}

// -----------------------------------------------------------------------------
// AST -> TIR Lowering Pass
// -----------------------------------------------------------------------------
pub fn lower_ast_expr_to_tir(f: *mut TirFunction, cur_block: *mut TirBlock, expr: *mut AstExpr, arena: *mut u8) -> *mut TirOperand {
    if expr == (0 as *mut AstExpr) {
        return alloc_tir_op_int(arena, 0);
    }
    let kind = expr.kind;

    if kind == expr_int() {
        return alloc_tir_op_int(arena, expr.int_val);
    }
    if kind == expr_str() {
        return alloc_tir_op_str(arena, expr.str_val, expr.sym);
    }
    if kind == expr_var() {
        return alloc_tir_op_var(arena, expr.sym);
    }

    if kind == expr_binop() {
        let left_op = lower_ast_expr_to_tir(f, cur_block, expr.left, arena);
        let right_op = lower_ast_expr_to_tir(f, cur_block, expr.right, arena);
        let reg = tir_fn_alloc_reg(f);
        let inst = alloc_tir_inst_assign(arena, reg, expr.op, left_op, right_op);
        unsafe { inst.int_val = expr.int_val; }
        tir_block_push_inst(cur_block, inst);
        return alloc_tir_op_reg(arena, reg);
    }

    if kind == expr_unary() {
        let reg = tir_fn_alloc_reg(f);
        if expr.op == tok_amp() && expr.int_val == 0 {
            let lv = expr.left;
            if lv != (0 as *mut AstExpr) {
                if lv.kind == expr_var() {
                    let inst = alloc_tir_inst_assign(arena, reg, 101, 0 as *mut TirOperand, 0 as *mut TirOperand);
                    unsafe { inst.int_val = lv.sym; }
                    tir_block_push_inst(cur_block, inst);
                    return alloc_tir_op_reg(arena, reg);
                }
                if lv.kind == expr_field() {
                    let base_op = lower_ast_expr_to_tir(f, cur_block, lv.left, arena);
                    let mut off = lv.op - 1;
                    if off < 0 { off = 0; }
                    let inst = alloc_tir_inst_assign(arena, reg, 102, base_op, 0 as *mut TirOperand);
                    unsafe { inst.int_val = off; }
                    tir_block_push_inst(cur_block, inst);
                    return alloc_tir_op_reg(arena, reg);
                }
                if lv.kind == expr_index() {
                    let mut stride = lv.op;
                    if stride != 1 && stride != 2 && stride != 4 && stride != 8 {
                        let interner_ref = f.interner as &Interner;
                        stride = determine_index_stride(lv.left, interner_ref);
                    }
                    let base_op = lower_ast_expr_to_tir(f, cur_block, lv.left, arena);
                    let idx_op = lower_ast_expr_to_tir(f, cur_block, lv.right, arena);
                    let inst = alloc_tir_inst_assign(arena, reg, 103, base_op, idx_op);
                    unsafe { inst.int_val = stride; }
                    tir_block_push_inst(cur_block, inst);
                    return alloc_tir_op_reg(arena, reg);
                }
            }
        }
        let inner_op = lower_ast_expr_to_tir(f, cur_block, expr.left, arena);
        let inst = alloc_tir_inst_assign(arena, reg, expr.op, inner_op, 0 as *mut TirOperand);
        unsafe { inst.int_val = expr.int_val; }
        tir_block_push_inst(cur_block, inst);
        return alloc_tir_op_reg(arena, reg);
    }

    if kind == expr_call() {
        let mut tir_args: Vec<*mut TirOperand> = vec_new_in(arena);
        let args_len = expr.args.len;
        let mut i: i64 = 0;
        while i < args_len {
            let arg_expr = vec_get(&expr.args, i);
            let arg_op = lower_ast_expr_to_tir(f, cur_block, arg_expr, arena);
            vec_push(&mut tir_args, arg_op);
            i = i + 1;
        }
        let reg = tir_fn_alloc_reg(f);
        let inst = alloc_tir_inst_call(arena, reg, expr.sym, tir_args);
        tir_block_push_inst(cur_block, inst);
        return alloc_tir_op_reg(arena, reg);
    }

    if kind == expr_field() {
        let base_op = lower_ast_expr_to_tir(f, cur_block, expr.left, arena);
        let reg = tir_fn_alloc_reg(f);
        let inst = alloc_tir_inst_load_field(arena, reg, base_op, expr.op, expr.sym);
        if expr.op > 0 {
            unsafe { inst.int_val = expr.int_val; }
        }
        tir_block_push_inst(cur_block, inst);
        return alloc_tir_op_reg(arena, reg);
    }

    if kind == expr_index() {
        let mut stride = expr.op;
        if stride != 1 && stride != 2 && stride != 4 && stride != 8 {
            let interner_ref = f.interner as &Interner;
            stride = determine_index_stride(expr.left, interner_ref);
        }
        let base_op = lower_ast_expr_to_tir(f, cur_block, expr.left, arena);
        let idx_op = lower_ast_expr_to_tir(f, cur_block, expr.right, arena);
        let reg = tir_fn_alloc_reg(f);
        let inst = alloc_tir_inst_load_index(arena, reg, base_op, idx_op, stride);
        unsafe { inst.int_val = expr.int_val; }
        tir_block_push_inst(cur_block, inst);
        return alloc_tir_op_reg(arena, reg);
    }

    if kind == expr_struct_init() {
        let mut tir_args: Vec<*mut TirOperand> = vec_new_in(arena);
        let total_fields = expr.args.len;
        let mut i: i64 = 0;
        while i < total_fields {
            let farg = vec_get(&expr.args, i);
            let fop = lower_ast_expr_to_tir(f, cur_block, farg, arena);
            vec_push(&mut tir_args, fop);
            i = i + 1;
        }
        let reg = tir_fn_alloc_reg(f);
        let inst = alloc_tir_inst_struct_init(arena, reg, expr.sym, tir_args);
        tir_block_push_inst(cur_block, inst);
        return alloc_tir_op_reg(arena, reg);
    }

    if kind == expr_cast() {
        let inner_op = lower_ast_expr_to_tir(f, cur_block, expr.left, arena);
        let interner_ref = f.interner as &Interner;
        let target = interner_lookup(interner_ref, expr.sym);
        let tptr = target as *const u8;
        let c0 = unsafe { tptr[0] } as i64;
        if c0 == 42 || c0 == 38 { // pointer/reference cast is an i64 identity
            return inner_op;
        }
        let reg = tir_fn_alloc_reg(f);
        let inst = alloc_tir_inst_assign(arena, reg, 100, inner_op, 0 as *mut TirOperand);
        unsafe { inst.int_val = expr.sym; }
        tir_block_push_inst(cur_block, inst);
        return alloc_tir_op_reg(arena, reg);
    }

    if kind == expr_perform() {
        let mut tir_args: Vec<*mut TirOperand> = vec_new_in(arena);
        let mut i: i64 = 0;
        while i < expr.args.len {
            let a = vec_get(&expr.args, i);
            let op = lower_ast_expr_to_tir(f, cur_block, a, arena);
            vec_push(&mut tir_args, op);
            i = i + 1;
        }
        let reg = tir_fn_alloc_reg(f);

        let inst = alloc_tir_inst(arena, tir_inst_effect_perform(), reg, expr.op, 0 as *mut TirOperand, 0 as *mut TirOperand);
        inst.int_val = expr.sym;
        inst.args = tir_args;
        tir_block_push_inst(cur_block, inst);
        return alloc_tir_op_reg(arena, reg);
    }

    if kind == expr_resume() {
        let k_op = lower_ast_expr_to_tir(f, cur_block, expr.left, arena);
        let val_op = lower_ast_expr_to_tir(f, cur_block, expr.right, arena);
        let reg = tir_fn_alloc_reg(f);
        let inst = alloc_tir_inst(arena, tir_inst_continuation_resume(), reg, 0, k_op, val_op);
        tir_block_push_inst(cur_block, inst);
        return alloc_tir_op_reg(arena, reg);
    }

    if kind == expr_handle() {
        let handler = expr.left as *mut AstHandler;
        let mut h_id: i64 = 0;
        if handler != (0 as *mut AstHandler) {
            h_id = handler.id;
        }
        let reg = tir_fn_alloc_reg(f);
        let push_inst = alloc_tir_inst(arena, tir_inst_handler_push(), reg, h_id, 0 as *mut TirOperand, 0 as *mut TirOperand);
        push_inst.int_val = expr.sym;
        tir_block_push_inst(cur_block, push_inst);

        if f.handled_effects != (0 as *mut Vec<i64>) {
            let hv = unsafe { f.handled_effects as &mut Vec<i64> };
            vec_push(hv, expr.sym);
        }

        let mut cur = cur_block;
        let mut bi: i64 = 0;
        let b_len = expr.stmts.len;
        let mut body_val = alloc_tir_op_int(arena, 0);
        while bi < b_len {
            let s = vec_get(&expr.stmts, bi);
            if bi == b_len - 1 {
                if s.kind == stmt_expr() {
                    body_val = lower_ast_expr_to_tir(f, cur, s.expr, arena);
                    break;
                }
            }
            cur = lower_ast_stmt_to_tir(f, cur, s, 0 - 1, 0 - 1, false, arena);
            bi = bi + 1;
        }

        if f.handled_effects != (0 as *mut Vec<i64>) {
            let hv = unsafe { f.handled_effects as &mut Vec<i64> };
            if hv.len > 0 {
                hv.len = hv.len - 1;
            }
        }

        let pop_inst = alloc_tir_inst(arena, tir_inst_handler_pop(), reg, h_id, body_val, 0 as *mut TirOperand);
        pop_inst.int_val = expr.sym;
        tir_block_push_inst(cur, pop_inst);
        return alloc_tir_op_reg(arena, reg);
    }

    // Region-as-expression: region name { stmts } where the last stmt is the value.
    if kind == expr_region() {
        if expr.sym != 0 {
            let empty_rargs: Vec<*mut TirOperand> = vec_new_in(arena);
            let reg_call = alloc_tir_inst_call(arena, expr.sym, 0, empty_rargs);
            reg_call.str_val = "morrow_region_enter";
            tir_block_push_inst(cur_block, reg_call);
        }
        let mut rcur = cur_block;
        let mut rbi: i64 = 0;
        let rb_len = expr.stmts.len;
        let mut region_val = alloc_tir_op_int(arena, 0);
        while rbi < rb_len {
            let rs = vec_get(&expr.stmts, rbi);
            if rbi == rb_len - 1 {
                if rs.kind == stmt_expr() {
                    region_val = lower_ast_expr_to_tir(f, rcur, rs.expr, arena);
                    rbi = rbi + 1;
                    break;
                }
            }
            rcur = lower_ast_stmt_to_tir(f, rcur, rs, 0 - 1, 0 - 1, false, arena);
            rbi = rbi + 1;
        }
        if expr.sym != 0 {
            let mut leave_rargs: Vec<*mut TirOperand> = vec_new_in(arena);
            vec_push(&mut leave_rargs, alloc_tir_op_var(arena, expr.sym));
            let reg_leave = alloc_tir_inst_call(arena, 0, 0, leave_rargs);
            reg_leave.str_val = "morrow_region_leave";
            tir_block_push_inst(rcur, reg_leave);
        }
        cur_block = rcur;
        return region_val;
    }

    alloc_tir_op_int(arena, 0)
}

fn tir_emit_region_leave(f: *mut TirFunction, cur: *mut TirBlock, sym: i64, arena: *mut u8) {
    let mut leave_args: Vec<*mut TirOperand> = vec_new_in(arena);
    vec_push(&mut leave_args, alloc_tir_op_var(arena, sym));
    let reg_leave = alloc_tir_inst_call(arena, 0, 0, leave_args);
    reg_leave.str_val = "morrow_region_leave";
    tir_block_push_inst(cur, reg_leave);
}

fn tir_emit_region_leaves(f: *mut TirFunction, cur: *mut TirBlock, depth: i64, arena: *mut u8) {
    let mut i = f.region_stack.len - 1;
    while i >= depth {
        tir_emit_region_leave(f, cur, vec_get(&f.region_stack, i), arena);
        i = i - 1;
    }
    f.region_stack.len = depth;
}

fn is_short_circuit_expr(e: *mut AstExpr) -> bool {
    e != (0 as *mut AstExpr) && e.kind == expr_binop() && (e.op == tok_and() || e.op == tok_or())
}

fn tir_bool_operand(f: *mut TirFunction, cur: *mut TirBlock, val: *mut TirOperand, arena: *mut u8) -> *mut TirOperand {
    let dest = f.op;
    f.op = f.op + 1;
    let inst = alloc_tir_inst(arena, tir_inst_bool(), dest, 0, val, 0 as *mut TirOperand);
    tir_block_push_inst(cur, inst);
    alloc_tir_op_reg(arena, dest)
}

fn lower_short_circuit(f: *mut TirFunction, cur: *mut TirBlock, expr: *mut AstExpr, arena: *mut u8) -> *mut TirOperand {
    let rhs_block = tir_fn_add_block(f, arena);
    let short_block = tir_fn_add_block(f, arena);
    let merge_block = tir_fn_add_block(f, arena);
    let left_val = lower_ast_expr_to_tir(f, cur, expr.left, arena);
    let left_bool = tir_bool_operand(f, cur, left_val, arena);
    if expr.op == tok_and() {
        tir_block_set_branch_cond(cur, left_bool, rhs_block.kind, short_block.kind);
    } else {
        tir_block_set_branch_cond(cur, left_bool, short_block.kind, rhs_block.kind);
    }
    let tid = f.op;
    f.op = f.op + 1;
    let mut nb = string_buffer_new_in(arena);
    fmt_append_str(&mut nb, "__sc_tmp_" as String);
    fmt_append_i64(&mut nb, tid);
    string_buffer_push_byte(&mut nb, 0 as u8);
    let tmp_sym = interner_intern(f.interner as &mut Interner, string_as_ptr(&nb) as String);

    // Right-hand block: evaluate the right side only on this path.
    let right_val = lower_ast_expr_to_tir(f, rhs_block, expr.right, arena);
    let right_bool = tir_bool_operand(f, rhs_block, right_val, arena);
    let st_r = alloc_tir_inst(arena, tir_inst_store(), tmp_sym, 0, right_bool, 0 as *mut TirOperand);
    tir_block_push_inst(rhs_block, st_r);
    tir_block_set_branch(rhs_block, merge_block.kind);

    // Short-circuit block: 0 for &&, 1 for ||.
    let mut short_const: i64 = 1;
    if expr.op == tok_and() {
        short_const = 0;
    }
    let short_val = alloc_tir_op_int(arena, short_const);
    let st_s = alloc_tir_inst(arena, tir_inst_store(), tmp_sym, 0, short_val, 0 as *mut TirOperand);
    tir_block_push_inst(short_block, st_s);
    tir_block_set_branch(short_block, merge_block.kind);

    f.sc_end = merge_block;
    alloc_tir_op_var(arena, tmp_sym)
}

pub fn lower_ast_stmt_to_tir(f: *mut TirFunction, cur_block: *mut TirBlock, stmt: *mut AstStmt, loop_exit_id: i64, loop_head_id: i64, is_tail: bool, arena: *mut u8) -> *mut TirBlock {
    if stmt == (0 as *mut AstStmt) {
        return cur_block;
    }
    let kind = stmt.kind;

    if cur_block.sym != tir_term_none() {
        let dead_b = tir_fn_add_block(f, arena);
        cur_block = dead_b;
    }

    if kind == stmt_let() {
        let mut cur_let = cur_block;
        let mut rhs = alloc_tir_op_int(arena, 0);
        if is_short_circuit_expr(stmt.expr) {
            rhs = lower_short_circuit(f, cur_let, stmt.expr, arena);
            cur_let = f.sc_end;
        } else {
            rhs = lower_ast_expr_to_tir(f, cur_let, stmt.expr, arena);
        }
        let inst = alloc_tir_inst(arena, tir_inst_store(), stmt.sym, 0, rhs, 0 as *mut TirOperand);
        tir_block_push_inst(cur_let, inst);
        return cur_let;
    }

    if kind == stmt_assign() {
        let mut cur_as = cur_block;
        let mut rhs = alloc_tir_op_int(arena, 0);
        if is_short_circuit_expr(stmt.expr) {
            rhs = lower_short_circuit(f, cur_as, stmt.expr, arena);
            cur_as = f.sc_end;
        } else {
            rhs = lower_ast_expr_to_tir(f, cur_as, stmt.expr, arena);
        }
        let inst = alloc_tir_inst(arena, tir_inst_store(), stmt.sym, 0, rhs, 0 as *mut TirOperand);
        unsafe { inst.int_val = stmt.int_val; }
        tir_block_push_inst(cur_as, inst);
        return cur_as;
    }

    if kind == stmt_return() {
        let mut cur_ret = cur_block;
        let mut ret_val = alloc_tir_op_int(arena, 0);
        if is_short_circuit_expr(stmt.expr) {
            ret_val = lower_short_circuit(f, cur_ret, stmt.expr, arena);
            cur_ret = f.sc_end;
        } else {
            ret_val = lower_ast_expr_to_tir(f, cur_ret, stmt.expr, arena);
        }
        tir_emit_region_leaves(f, cur_ret, 0, arena);
        tir_block_set_return(cur_ret, ret_val);
        let dead_block = tir_fn_add_block(f, arena);
        return dead_block;
    }

    if kind == stmt_expr() {
        let mut cur_ex = cur_block;
        let mut val = alloc_tir_op_int(arena, 0);
        if is_short_circuit_expr(stmt.expr) {
            val = lower_short_circuit(f, cur_ex, stmt.expr, arena);
            cur_ex = f.sc_end;
        } else {
            val = lower_ast_expr_to_tir(f, cur_ex, stmt.expr, arena);
        }
        if is_tail {
            tir_block_set_return(cur_ex, val);
            let dead_block = tir_fn_add_block(f, arena);
            return dead_block;
        }
        return cur_ex;
    }

    if kind == stmt_field_assign() {
        let base_op = lower_ast_expr_to_tir(f, cur_block, stmt.left, arena);
        let val_op = lower_ast_expr_to_tir(f, cur_block, stmt.expr, arena);
        let offset = stmt.right as i64;
        let inst = alloc_tir_inst_store_field(arena, base_op, offset, stmt.sym, val_op);
        if offset > 0 {
            unsafe { inst.int_val = stmt.int_val; }
        }
        tir_block_push_inst(cur_block, inst);
        return cur_block;
    }

    if kind == stmt_index_assign() {
        let mut stride = stmt.sym;
        if stride != 1 && stride != 2 && stride != 4 && stride != 8 {
            let interner_ref = f.interner as &Interner;
            stride = determine_index_stride(stmt.left, interner_ref);
        }
        let base_op = lower_ast_expr_to_tir(f, cur_block, stmt.left, arena);
        let idx_op = lower_ast_expr_to_tir(f, cur_block, stmt.right, arena);
        let val_op = lower_ast_expr_to_tir(f, cur_block, stmt.expr, arena);
        let inst = alloc_tir_inst_store_index(arena, base_op, idx_op, val_op, stride);
        unsafe { inst.int_val = stmt.int_val; }
        tir_block_push_inst(cur_block, inst);
        return cur_block;
    }

    if kind == stmt_block() {
        let pre_depth = f.region_stack.len;
        if stmt.sym != 0 {
            let empty_args: Vec<*mut TirOperand> = vec_new_in(arena);
            let reg_call = alloc_tir_inst_call(arena, stmt.sym, 0, empty_args);
            reg_call.str_val = "morrow_region_enter";
            tir_block_push_inst(cur_block, reg_call);
            vec_push(&mut f.region_stack, stmt.sym);
        }
        let mut cur = cur_block;
        let mut bi: i64 = 0;
        let b_len = stmt.then_stmts.len;
        while bi < b_len {
            let is_inner_tail = is_tail && (bi == b_len - 1);
            let bs = vec_get(&stmt.then_stmts, bi);
            if is_inner_tail {
                if bs.kind == stmt_expr() {
                    let ret_val = lower_ast_expr_to_tir(f, cur, bs.expr, arena);
                    if stmt.sym != 0 {
                        let mut leave_args: Vec<*mut TirOperand> = vec_new_in(arena);
                        vec_push(&mut leave_args, alloc_tir_op_var(arena, stmt.sym));
                        let reg_leave = alloc_tir_inst_call(arena, 0, 0, leave_args);
                        reg_leave.str_val = "morrow_region_leave";
                        tir_block_push_inst(cur, reg_leave);
                        f.region_stack.len = pre_depth;
                    }
                    tir_block_set_return(cur, ret_val);
                    let dead_block = tir_fn_add_block(f, arena);
                    return dead_block;
                }
            }
            cur = lower_ast_stmt_to_tir(f, cur, bs, loop_exit_id, loop_head_id, is_inner_tail, arena);
            bi = bi + 1;
        }
        if stmt.sym != 0 && f.region_stack.len > pre_depth {
            tir_emit_region_leave(f, cur, stmt.sym, arena);
            f.region_stack.len = pre_depth;
        }
        return cur;
    }

    if kind == stmt_break() {
        if loop_exit_id >= 0 {
            tir_emit_region_leaves(f, cur_block, f.cur_loop_region_depth, arena);
            tir_block_set_branch(cur_block, loop_exit_id);
            let dead_block = tir_fn_add_block(f, arena);
            return dead_block;
        }
        return cur_block;
    }

    if kind == stmt_continue() {
        if loop_head_id >= 0 {
            tir_emit_region_leaves(f, cur_block, f.cur_loop_region_depth, arena);
            tir_block_set_branch(cur_block, loop_head_id);
            let dead_continue = tir_fn_add_block(f, arena);
            return dead_continue;
        }
        return cur_block;
    }

    if kind == stmt_if() {
        let pre_region_depth = f.region_stack.len;
        let mut cond_block = cur_block;
        let mut cond = alloc_tir_op_int(arena, 0);
        if is_short_circuit_expr(stmt.expr) {
            cond = lower_short_circuit(f, cond_block, stmt.expr, arena);
            cond_block = f.sc_end;
        } else {
            cond = lower_ast_expr_to_tir(f, cond_block, stmt.expr, arena);
        }
        let then_block = tir_fn_add_block(f, arena);
        let else_block = tir_fn_add_block(f, arena);
        let merge_block = tir_fn_add_block(f, arena);

        tir_block_set_branch_cond(cond_block, cond, then_block.kind, else_block.kind);

        // Lower then statements
        let mut cur_then = then_block;
        let then_len = stmt.then_stmts.len;
        let mut i: i64 = 0;
        while i < then_len {
            let s = vec_get(&stmt.then_stmts, i);
            let is_inner_tail = is_tail && (i == then_len - 1);
            cur_then = lower_ast_stmt_to_tir(f, cur_then, s, loop_exit_id, loop_head_id, is_inner_tail, arena);
            i = i + 1;
        }
        f.region_stack.len = pre_region_depth;
        if cur_then.sym == tir_term_none() {
            tir_block_set_branch(cur_then, merge_block.kind);
        }

        // Lower else statements
        let mut cur_else = else_block;
        let else_len = stmt.else_stmts.len;
        let mut j: i64 = 0;
        while j < else_len {
            let s = vec_get(&stmt.else_stmts, j);
            let is_inner_tail = is_tail && (j == else_len - 1);
            cur_else = lower_ast_stmt_to_tir(f, cur_else, s, loop_exit_id, loop_head_id, is_inner_tail, arena);
            j = j + 1;
        }
        f.region_stack.len = pre_region_depth;
        if cur_else.sym == tir_term_none() {
            tir_block_set_branch(cur_else, merge_block.kind);
        }

        f.region_stack.len = pre_region_depth;
        return merge_block;
    }

    if kind == stmt_while() {
        let pre_region_depth = f.region_stack.len;
        let prev_region_depth = f.cur_loop_region_depth;
        f.cur_loop_region_depth = pre_region_depth;
        let cond_block = tir_fn_add_block(f, arena);
        let body_block = tir_fn_add_block(f, arena);
        let exit_block = tir_fn_add_block(f, arena);

        tir_block_set_branch(cur_block, cond_block.kind);

        if is_short_circuit_expr(stmt.expr) {
            let v = lower_short_circuit(f, cond_block, stmt.expr, arena);
            let saved = f.sc_end;
            tir_block_set_branch_cond(saved, v, body_block.kind, exit_block.kind);
        } else {
            let v = lower_ast_expr_to_tir(f, cond_block, stmt.expr, arena);
            tir_block_set_branch_cond(cond_block, v, body_block.kind, exit_block.kind);
        }

        let mut cur_body = body_block;
        let body_len = stmt.then_stmts.len;
        let mut i: i64 = 0;
        while i < body_len {
            let s = vec_get(&stmt.then_stmts, i);
            cur_body = lower_ast_stmt_to_tir(f, cur_body, s, exit_block.kind, cond_block.kind, false, arena);
            i = i + 1;
        }
        f.region_stack.len = pre_region_depth;
        f.cur_loop_region_depth = prev_region_depth;
        if cur_body.sym == tir_term_none() {
            tir_block_set_branch(cur_body, cond_block.kind);
        }

        return exit_block;
    }

    if kind == stmt_handle() {
        let handler = stmt.handler;
        let mut h_id: i64 = 0;
        if handler != (0 as *mut AstHandler) {
            h_id = handler.id;
        }
        let push_inst = alloc_tir_inst(arena, tir_inst_handler_push(), 0, h_id, 0 as *mut TirOperand, 0 as *mut TirOperand);
        push_inst.int_val = stmt.sym;
        tir_block_push_inst(cur_block, push_inst);

        if f.handled_effects != (0 as *mut Vec<i64>) {
            let hv = unsafe { f.handled_effects as &mut Vec<i64> };
            vec_push(hv, stmt.sym);
        }

        let mut cur = cur_block;
        let mut bi: i64 = 0;
        let b_len = stmt.then_stmts.len;
        while bi < b_len {
            let s = vec_get(&stmt.then_stmts, bi);
            cur = lower_ast_stmt_to_tir(f, cur, s, loop_exit_id, loop_head_id, is_tail && (bi == b_len - 1), arena);
            bi = bi + 1;
        }

        if f.handled_effects != (0 as *mut Vec<i64>) {
            let hv = unsafe { f.handled_effects as &mut Vec<i64> };
            if hv.len > 0 {
                hv.len = hv.len - 1;
            }
        }

        let pop_inst = alloc_tir_inst(arena, tir_inst_handler_pop(), 0, h_id, 0 as *mut TirOperand, 0 as *mut TirOperand);
        pop_inst.int_val = stmt.sym;
        tir_block_push_inst(cur, pop_inst);
        return cur;
    }

    cur_block
}

pub fn lower_ast_fn_to_tir(ast_fn: *mut AstFn, interner: &Interner, arena: *mut u8) -> *mut TirFunction {
    let tir_f = alloc_tir_function(arena, ast_fn.name_sym, ast_fn.ret_ty_sym, ast_fn, interner);
    let entry_b = tir_fn_add_block(tir_f, arena);

    let mut cur_b = entry_b;
    let body_len = ast_fn.body.len;
    let mut i: i64 = 0;
    while i < body_len {
        let stmt = vec_get(&ast_fn.body, i);
        let is_tail = (i == body_len - 1);
        cur_b = lower_ast_stmt_to_tir(tir_f, cur_b, stmt, 0 - 1, 0 - 1, is_tail, arena);
        i = i + 1;
    }

    if cur_b.sym == tir_term_none() {
        let dummy = alloc_tir_op_int(arena, 0);
        tir_block_set_return(cur_b, dummy);
    }

    tir_f
}

pub fn lower_ast_program_to_tir(prog: *mut AstProgram, interner: &Interner, arena: *mut u8) -> *mut TirModule {
    let m = alloc_tir_module(arena, prog);
    let fns_len = prog.functions.len;
    let mut i: i64 = 0;
    while i < fns_len {
        let ast_f = vec_get(&prog.functions, i);
        let tir_f = lower_ast_fn_to_tir(ast_f, interner, arena);
        vec_push(&mut m.args, tir_f);
        i = i + 1;
    }
    m.int_val = fns_len;
    m
}

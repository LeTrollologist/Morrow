    };
    unsafe {
        p.name_sym = name_sym;
        p.ty_sym = ty_sym;
    }
    p
}

pub fn alloc_extern_fn(arena: *mut u8, name_sym: i64, params: Vec<*mut AstParam>, ret_ty_sym: i64) -> *mut AstExternFn {
    let p = unsafe {
        tungsten_region_alloc(arena, 48, 8) as *mut AstExternFn
    };
    unsafe {
        p.name_sym = name_sym;
        p.params = params;
        p.ret_ty_sym = ret_ty_sym;
    }
    p
}

pub fn alloc_fn(arena: *mut u8, name_sym: i64, params: Vec<*mut AstParam>, ret_ty_sym: i64, body: Vec<*mut AstStmt>) -> *mut AstFn {
    let p = unsafe {
        tungsten_region_alloc(arena, 80, 8) as *mut AstFn
    };
    unsafe {
        p.name_sym = name_sym;
        p.params = params;
        p.ret_ty_sym = ret_ty_sym;
        p.body = body;
    }
    p
}

pub fn alloc_type_alias(arena: *mut u8, name_sym: i64, ty_sym: i64, min_val: i64, max_val: i64) -> *mut AstTypeAlias {
    let p = unsafe {
        tungsten_region_alloc(arena, 64, 8) as *mut AstTypeAlias
    };
    unsafe {
        p.name_sym = name_sym;
        p.ty_sym = ty_sym;
        p.int_val = min_val;
        p.str_val = "";
        p.op = max_val;
    }
    p
}

pub fn alloc_program(arena: *mut u8) -> *mut AstProgram {
    let p = unsafe {
        tungsten_region_alloc(arena, 256, 8) as *mut AstProgram
    };
    let structs: Vec<*mut AstStruct> = vec_new_in(arena);
    let extern_fns: Vec<*mut AstExternFn> = vec_new_in(arena);
    let funcs: Vec<*mut AstFn> = vec_new_in(arena);
    let imps: Vec<String> = vec_new_in(arena);
    let type_aliases: Vec<*mut AstTypeAlias> = vec_new_in(arena);
    unsafe {
        p.structs = structs;
        p.extern_fns = extern_fns;
        p.functions = funcs;
        p.imports = imps;
        p.vals = type_aliases;
    }
    p
}

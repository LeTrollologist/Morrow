    };
    let empty_else: Vec<*mut AstStmt> = vec_new_in(arena);
    let null_expr = 0 as *mut AstExpr;
    unsafe {
        p.kind = stmt_block();
        p.sym = sym;
        p.expr = null_expr;
        p.then_stmts = stmts;
        p.else_stmts = empty_else;
        p.left = null_expr;
        p.right = null_expr;
    }
    p
}


// Tungsten Self-Hosting Compiler - Abstract Syntax Tree & Token Definitions
// Node allocation within the scoped region arena

import std::collections;

// -----------------------------------------------------------------------------
// Token Kinds
// -----------------------------------------------------------------------------
pub fn tok_eof() -> i64 { 0 }
pub fn tok_ident() -> i64 { 1 }
pub fn tok_int() -> i64 { 2 }
pub fn tok_str() -> i64 { 3 }
pub fn tok_plus() -> i64 { 4 }
pub fn tok_minus() -> i64 { 5 }
pub fn tok_star() -> i64 { 6 }
pub fn tok_slash() -> i64 { 7 }
pub fn tok_eq() -> i64 { 8 }
pub fn tok_eqeq() -> i64 { 9 }
pub fn tok_neq() -> i64 { 10 }
pub fn tok_lt() -> i64 { 11 }
pub fn tok_lte() -> i64 { 12 }
pub fn tok_gt() -> i64 { 13 }
pub fn tok_gte() -> i64 { 14 }
pub fn tok_lparen() -> i64 { 15 }
pub fn tok_rparen() -> i64 { 16 }
pub fn tok_lbrace() -> i64 { 17 }
pub fn tok_rbrace() -> i64 { 18 }
pub fn tok_colon() -> i64 { 19 }
pub fn tok_coloncolon() -> i64 { 20 }
pub fn tok_semicolon() -> i64 { 21 }
pub fn tok_comma() -> i64 { 22 }
pub fn tok_arrow() -> i64 { 23 }
pub fn tok_bang() -> i64 { 24 }
pub fn tok_dot() -> i64 { 25 }
pub fn tok_amp() -> i64 { 26 }
pub fn tok_and() -> i64 { 27 }
pub fn tok_or() -> i64 { 28 }

pub fn tok_kw_fn() -> i64 { 30 }
pub fn tok_kw_let() -> i64 { 31 }
pub fn tok_kw_mut() -> i64 { 32 }
pub fn tok_kw_if() -> i64 { 33 }
pub fn tok_kw_else() -> i64 { 34 }
pub fn tok_kw_while() -> i64 { 35 }
pub fn tok_kw_return() -> i64 { 36 }
pub fn tok_kw_struct() -> i64 { 37 }
pub fn tok_kw_true() -> i64 { 38 }
pub fn tok_kw_false() -> i64 { 39 }
pub fn tok_kw_as() -> i64 { 40 }
pub fn tok_kw_unsafe() -> i64 { 41 }
pub fn tok_kw_region() -> i64 { 42 }
pub fn tok_kw_extern() -> i64 { 43 }
pub fn tok_kw_import() -> i64 { 44 }
pub fn tok_kw_pub() -> i64 { 45 }
pub fn tok_kw_loop() -> i64 { 46 }
pub fn tok_kw_break() -> i64 { 47 }
pub fn tok_kw_var() -> i64 { 48 }

pub fn tok_lbracket() -> i64 { 50 }
pub fn tok_rbracket() -> i64 { 51 }
pub fn tok_kw_type() -> i64 { 52 }
pub fn tok_dotdot() -> i64 { 53 }
pub fn tok_dotdoteq() -> i64 { 54 }

pub struct Token {
    kind: i64,
    sym: i64,
    int_val: i64,
    str_val: String,
    line: i64,
    col: i64,
}

// -----------------------------------------------------------------------------
// AST Expression Kinds
// -----------------------------------------------------------------------------
pub fn expr_int() -> i64 { 1 }
pub fn expr_str() -> i64 { 2 }
pub fn expr_var() -> i64 { 3 }
pub fn expr_binop() -> i64 { 4 }
pub fn expr_call() -> i64 { 5 }
pub fn expr_unary() -> i64 { 6 }
pub fn expr_field() -> i64 { 7 }
pub fn expr_index() -> i64 { 8 }
pub fn expr_cast() -> i64 { 9 }
pub fn expr_struct_init() -> i64 { 10 }

pub struct AstExpr {
    kind: i64,
    sym: i64,
    int_val: i64,
    str_val: String,
    op: i64,
    left: *mut AstExpr,
    right: *mut AstExpr,
    args: Vec<*mut AstExpr>,
}

// -----------------------------------------------------------------------------
// AST Statement Kinds
// -----------------------------------------------------------------------------
pub fn stmt_let() -> i64 { 1 }
pub fn stmt_assign() -> i64 { 2 }
pub fn stmt_return() -> i64 { 3 }
pub fn stmt_expr() -> i64 { 4 }
pub fn stmt_if() -> i64 { 5 }
pub fn stmt_while() -> i64 { 6 }
pub fn stmt_field_assign() -> i64 { 7 }
pub fn stmt_index_assign() -> i64 { 8 }
pub fn stmt_block() -> i64 { 9 }
pub fn stmt_break() -> i64 { 10 }

pub struct AstStmt {
    kind: i64,
    sym: i64,
    expr: *mut AstExpr,
    then_stmts: Vec<*mut AstStmt>,
    else_stmts: Vec<*mut AstStmt>,
    left: *mut AstExpr,
    right: *mut AstExpr,
}

pub struct AstField {
    name_sym: i64,
    ty_sym: i64,
}

pub struct AstStruct {
    name_sym: i64,
    fields: Vec<*mut AstField>,
}

pub struct AstParam {
    name_sym: i64,
    ty_sym: i64,
}

pub struct AstExternFn {
    name_sym: i64,
    params: Vec<*mut AstParam>,
    ret_ty_sym: i64,
}

pub struct AstFn {
    name_sym: i64,
    params: Vec<*mut AstParam>,
    ret_ty_sym: i64,
    body: Vec<*mut AstStmt>,
}

pub struct AstTypeAlias {
    name_sym: i64,
    ty_sym: i64,
    int_val: i64,
    str_val: String,
    op: i64,
}

pub struct AstProgram {
    structs: Vec<*mut AstStruct>,
    extern_fns: Vec<*mut AstExternFn>,
    functions: Vec<*mut AstFn>,
    imports: Vec<String>,
    vals: Vec<*mut AstTypeAlias>,
}

// -----------------------------------------------------------------------------
// Region Allocators for AST Nodes
// -----------------------------------------------------------------------------

pub fn alloc_token(arena: *mut u8, kind: i64, sym: i64, int_val: i64, str_val: String, line: i64, col: i64) -> *mut Token {
    let p = unsafe {
        tungsten_region_alloc(arena, 64, 8) as *mut Token
    };
    unsafe {
        p.kind = kind;
        p.sym = sym;
        p.int_val = int_val;
        p.str_val = str_val;
        p.line = line;
        p.col = col;
    }
    p
}

pub fn alloc_expr_int(arena: *mut u8, val: i64) -> *mut AstExpr {
    let p = unsafe {
        tungsten_region_alloc(arena, 128, 8) as *mut AstExpr
    };
    let null_expr = 0 as *mut AstExpr;
    let empty_args: Vec<*mut AstExpr> = vec_new_in(arena);
    unsafe {
        p.kind = expr_int();
        p.int_val = val;
        p.sym = 0;
        p.op = 0;
        p.left = null_expr;
        p.right = null_expr;
        p.args = empty_args;
        p.str_val = "";
    }
    p
}

pub fn alloc_expr_str(arena: *mut u8, str_val: String, sym: i64) -> *mut AstExpr {
    let p = unsafe {
        tungsten_region_alloc(arena, 128, 8) as *mut AstExpr
    };
    let null_expr = 0 as *mut AstExpr;
    let empty_args: Vec<*mut AstExpr> = vec_new_in(arena);
    unsafe {
        p.kind = expr_str();
        p.int_val = 0;
        p.sym = sym;
        p.op = 0;
        p.left = null_expr;
        p.right = null_expr;
        p.args = empty_args;
        p.str_val = str_val;
    }
    p
}


// Tungsten Self-Hosting Compiler - LLVM 18 IR Emitter
// Emits portable LLVM IR text into a region-allocated StringBuffer

import std::collections;
import compiler::ast;
import compiler::interner;
import compiler::tir;

extern "C" {
    fn strlen(s: *const u8) -> usize;
    fn strcmp(s1: *const u8, s2: *const u8) -> i32;
    fn strncmp(s1: *const u8, s2: *const u8, n: usize) -> i32;
}

pub struct Codegen {
    buf: StringBuffer,
    cg_interner: *mut Interner,
    next_reg: i64,
    next_label: i64,
    cg_arena: *mut u8,
    cur_loop_exit: i64,
    strings: Vec<String>,
    allocated_vars: Vec<i64>,
    terminated: bool,
    handlers: Vec<*mut AstHandler>,
}

fn emit_i64_helper(cg: &mut Codegen, n: i64) {
    if n >= 10 {
        emit_i64_helper(cg, n / 10);
    }
    let digit = (n - (n / 10) * 10) as u8 + 48 as u8;
    string_buffer_push_byte(&mut cg.buf, digit);
}

pub fn emit_i64(cg: &mut Codegen, n: i64) {
    if n < 0 {
        string_buffer_push_byte(&mut cg.buf, 45 as u8); // '-'
        emit_i64_helper(cg, 0 - n);
    } else {
        emit_i64_helper(cg, n);
    }
}

pub fn emit_str(cg: &mut Codegen, s: String) {
    let ptr = s as *const u8;
    let len = unsafe { strlen(ptr) } as i64;
    string_buffer_push_str(&mut cg.buf, ptr, len);
}

pub fn emit_sym(cg: &mut Codegen, sym: i64) {
    let interner_ref = cg.cg_interner as &Interner;
    let s = interner_lookup(interner_ref, sym);
    emit_str(cg, s);
}

pub fn codegen_new_in(interner: &mut Interner, arena: *mut u8) -> Codegen {
    let sbuf = string_buffer_new_in(arena);
    let str_vec: Vec<String> = vec_new_in(arena);
    let vars_vec: Vec<i64> = vec_new_in(arena);
    let handlers_vec: Vec<*mut AstHandler> = vec_new_in(arena);
    Codegen {
        buf: sbuf,
        cg_interner: interner as *mut Interner,
        next_reg: 1,
        next_label: 1,
        cg_arena: arena,
        cur_loop_exit: 0,
        strings: str_vec,
        allocated_vars: vars_vec,
        terminated: false,
        handlers: handlers_vec,
    }
}

fn alloc_reg(cg: &mut Codegen) -> i64 {
    let r = cg.next_reg;
    cg.next_reg = cg.next_reg + 1;
    r
}

fn alloc_label(cg: &mut Codegen) -> i64 {
    let l = cg.next_label;
    cg.next_label = cg.next_label + 1;
    l
}

fn emit_escaped_string(cg: &mut Codegen, s: String) {
    let ptr = s as *const u8;
    let len = unsafe { strlen(ptr) } as i64;
    let mut i: i64 = 0;
    while i < len {
        let b = unsafe { ptr[i] } as i64;
        if b == 10 { // \n
            string_buffer_push_byte(&mut cg.buf, 92 as u8);
            string_buffer_push_byte(&mut cg.buf, 48 as u8);
            string_buffer_push_byte(&mut cg.buf, 65 as u8);
        } else if b == 13 { // \r
            string_buffer_push_byte(&mut cg.buf, 92 as u8);
            string_buffer_push_byte(&mut cg.buf, 48 as u8);
            string_buffer_push_byte(&mut cg.buf, 68 as u8);
        } else if b == 92 { // \\
            string_buffer_push_byte(&mut cg.buf, 92 as u8);
            string_buffer_push_byte(&mut cg.buf, 53 as u8);
            string_buffer_push_byte(&mut cg.buf, 67 as u8);
        } else if b == 34 { // \"
            string_buffer_push_byte(&mut cg.buf, 92 as u8);
            string_buffer_push_byte(&mut cg.buf, 50 as u8);
            string_buffer_push_byte(&mut cg.buf, 50 as u8);
        } else if b >= 32 && b <= 126 {
            string_buffer_push_byte(&mut cg.buf, b as u8);
        } else {
            string_buffer_push_byte(&mut cg.buf, 92 as u8);
            let hi = b / 16;
            let lo = b - hi * 16;
            if hi < 10 {
                string_buffer_push_byte(&mut cg.buf, (hi + 48) as u8);
            } else {
                string_buffer_push_byte(&mut cg.buf, (hi - 10 + 65) as u8);
            }
            if lo < 10 {
                string_buffer_push_byte(&mut cg.buf, (lo + 48) as u8);
            } else {
                string_buffer_push_byte(&mut cg.buf, (lo - 10 + 65) as u8);
            }
        }
        i = i + 1;
    }
}

fn get_field_offset(cg: &mut Codegen, sym: i64) -> i64 {
    let interner_ref = cg.cg_interner as &Interner;
    let s = interner_lookup(interner_ref, sym);
    let p = s as *const u8;
    if unsafe { strcmp(p, "kind" as *const u8) == 0 } { return 0; }
    if unsafe { strcmp(p, "data" as *const u8) == 0 } { return 0; }
    if unsafe { strcmp(p, "buf" as *const u8) == 0 } { return 0; }
    if unsafe { strcmp(p, "keys" as *const u8) == 0 } { return 0; }
    if unsafe { strcmp(p, "tokens" as *const u8) == 0 } { return 0; }
    if unsafe { strcmp(p, "structs" as *const u8) == 0 } { return 0; }
    if unsafe { strcmp(p, "name_sym" as *const u8) == 0 } { return 0; }
    if unsafe { strcmp(p, "map" as *const u8) == 0 } { return 0; }
    if unsafe { strcmp(p, "effect_sym" as *const u8) == 0 } { return 0; }
    if unsafe { strcmp(p, "op_sym" as *const u8) == 0 } { return 0; }

    if unsafe { strcmp(p, "sym" as *const u8) == 0 } { return 1; }
    if unsafe { strcmp(p, "len" as *const u8) == 0 } { return 1; }
    if unsafe { strcmp(p, "pos" as *const u8) == 0 } { return 1; }
    if unsafe { strcmp(p, "extern_fns" as *const u8) == 0 } { return 1; }
    if unsafe { strcmp(p, "fields" as *const u8) == 0 } { return 1; }
    if unsafe { strcmp(p, "params" as *const u8) == 0 } { return 1; }
    if unsafe { strcmp(p, "ty_sym" as *const u8) == 0 } { return 1; }
    if unsafe { strcmp(p, "symbols" as *const u8) == 0 } { return 1; }
    if unsafe { strcmp(p, "cg_interner" as *const u8) == 0 } { return 1; }
    if unsafe { strcmp(p, "dest" as *const u8) == 0 } { return 1; }
    if unsafe { strcmp(p, "ops" as *const u8) == 0 } { return 1; }
    if unsafe { strcmp(p, "arms" as *const u8) == 0 } { return 1; }

    if unsafe { strcmp(p, "int_val" as *const u8) == 0 } { return 2; }
    if unsafe { strcmp(p, "cap" as *const u8) == 0 } { return 2; }
    if unsafe { strcmp(p, "interner" as *const u8) == 0 } { return 2; }
    if unsafe { strcmp(p, "functions" as *const u8) == 0 } { return 2; }
    if unsafe { strcmp(p, "ret_ty_sym" as *const u8) == 0 } { return 2; }
    if unsafe { strcmp(p, "next_id" as *const u8) == 0 } { return 2; }
    if unsafe { strcmp(p, "next_reg" as *const u8) == 0 } { return 2; }
    if unsafe { strcmp(p, "expr" as *const u8) == 0 } { return 2; }
    if unsafe { strcmp(p, "target" as *const u8) == 0 } { return 2; }
    if unsafe { strcmp(p, "id" as *const u8) == 0 } { return 2; }
    if unsafe { strcmp(p, "continuation_sym" as *const u8) == 0 } { return 2; }

    if unsafe { strcmp(p, "str_val" as *const u8) == 0 } { return 3; }
    if unsafe { strcmp(p, "arena" as *const u8) == 0 } { return 3; }
    if unsafe { strcmp(p, "body" as *const u8) == 0 } { return 3; }
    if unsafe { strcmp(p, "next_label" as *const u8) == 0 } { return 3; }
    if unsafe { strcmp(p, "then_stmts" as *const u8) == 0 } { return 3; }
    if unsafe { strcmp(p, "imports" as *const u8) == 0 } { return 3; }

    if unsafe { strcmp(p, "line" as *const u8) == 0 } { return 4; }
    if unsafe { strcmp(p, "op" as *const u8) == 0 } { return 4; }
    if unsafe { strcmp(p, "vals" as *const u8) == 0 } { return 4; }
    if unsafe { strcmp(p, "else_stmts" as *const u8) == 0 } { return 4; }
    if unsafe { strcmp(p, "cg_arena" as *const u8) == 0 } { return 4; }
    if unsafe { strcmp(p, "type_aliases" as *const u8) == 0 } { return 4; }
    if unsafe { strcmp(p, "effect_defs" as *const u8) == 0 } { return 4; }
    if unsafe { strcmp(p, "ret_expr" as *const u8) == 0 } { return 4; }

    if unsafe { strcmp(p, "col" as *const u8) == 0 } { return 5; }
    if unsafe { strcmp(p, "left" as *const u8) == 0 } { return 5; }
    if unsafe { strcmp(p, "hashes" as *const u8) == 0 } { return 5; }
    if unsafe { strcmp(p, "cur_loop_exit" as *const u8) == 0 } { return 5; }
    if unsafe { strcmp(p, "yields_effects" as *const u8) == 0 } { return 5; }
    if unsafe { strcmp(p, "active_yields" as *const u8) == 0 } { return 5; }
    if unsafe { strcmp(p, "fn_sym" as *const u8) == 0 } { return 5; }
    if unsafe { strcmp(p, "effects" as *const u8) == 0 } { return 5; }

    if unsafe { strcmp(p, "right" as *const u8) == 0 } { return 6; }
    if unsafe { strcmp(p, "psls" as *const u8) == 0 } { return 6; }
    if unsafe { strcmp(p, "strings" as *const u8) == 0 } { return 6; }
    if unsafe { strcmp(p, "handled_effects" as *const u8) == 0 } { return 6; }

    if unsafe { strcmp(p, "args" as *const u8) == 0 } { return 7; }
    if unsafe { strcmp(p, "occupied" as *const u8) == 0 } { return 7; }
    if unsafe { strcmp(p, "allocated_vars" as *const u8) == 0 } { return 7; }
    if unsafe { strcmp(p, "instructions" as *const u8) == 0 } { return 7; }
    if unsafe { strcmp(p, "blocks" as *const u8) == 0 } { return 7; }
    if unsafe { strcmp(p, "handler" as *const u8) == 0 } { return 7; }

    if unsafe { strcmp(p, "terminated" as *const u8) == 0 } { return 8; }
    if unsafe { strcmp(p, "stmts" as *const u8) == 0 } { return 8; }
    // TEMPORARY COMPATIBILITY FALLBACK: type_param_sym on AstFn/AstStruct is at
    // byte offset 64 (word 8). This entry is a safety net only — by the time
    // codegen runs, all type_param_sym fields should be 0 (concrete) because
    // monomorphize_program has already substituted T -> concrete and the
    // typechecker skips generic templates. If a non-zero type_param_sym ever
    // reaches codegen, it indicates a monomorphization gap, not a codegen issue.
    if unsafe { strcmp(p, "type_param_sym" as *const u8) == 0 } { return 8; }

    if unsafe { strcmp(p, "handlers" as *const u8) == 0 } { return 9; }

    0
}

fn is_byte_indexing(cg: &mut Codegen, left: *mut AstExpr) -> bool {
    if left == 0 as *mut AstExpr {
        return true;
    }
    let interner_ref = cg.cg_interner as &Interner;
    if left.kind == expr_field() {
        let s = interner_lookup(interner_ref, left.sym);
        let p = s as *const u8;
        if unsafe { strcmp(p, "buf" as *const u8) == 0 } {
            return true;
        }
        return false;
    }
    if left.kind == expr_var() {
        let s = interner_lookup(interner_ref, left.sym);
        let p = s as *const u8;
        if unsafe {
            strcmp(p, "old_keys" as *const u8) == 0 ||
            strcmp(p, "old_vals" as *const u8) == 0 ||
            strcmp(p, "old_occ" as *const u8) == 0 ||
            strcmp(p, "ptr_slot" as *const u8) == 0 ||
            strcmp(p, "stmt_slot" as *const u8) == 0 ||
            strcmp(p, "my_numbers" as *const u8) == 0
        } {
            return false;
        }
        return true;
    }
    true
}

fn collect_strings_expr(cg: &mut Codegen, e: *mut AstExpr) {
    if e == 0 as *mut AstExpr { return; }
    if e.kind == expr_handle() {
        let mut bi: i64 = 0;
        while bi < e.stmts.len {
            collect_strings_stmt(cg, vec_get(&e.stmts, bi));
            bi = bi + 1;
        }
        return;
    }
    if e.kind == expr_str() {
        let sid = cg.strings.len;
        vec_push(&mut cg.strings, e.str_val);
        e.int_val = sid;
    }
    collect_strings_expr(cg, e.left);
    collect_strings_expr(cg, e.right);
    let mut i: i64 = 0;
    while i < e.args.len {
        collect_strings_expr(cg, vec_get(&e.args, i));
        i = i + 1;
    }
}

fn collect_strings_stmt(cg: &mut Codegen, s: *mut AstStmt) {
    if s == 0 as *mut AstStmt { return; }
    if s.kind == stmt_handle() {
        let mut i: i64 = 0;
        while i < s.then_stmts.len {
            collect_strings_stmt(cg, vec_get(&s.then_stmts, i));
            i = i + 1;
        }
        return;
    }
    collect_strings_expr(cg, s.expr);
    collect_strings_expr(cg, s.left);
    if s.kind != stmt_field_assign() {
        collect_strings_expr(cg, s.right);
    }
    let mut i: i64 = 0;
    while i < s.then_stmts.len {
        collect_strings_stmt(cg, vec_get(&s.then_stmts, i));
        i = i + 1;
    }
    i = 0;
    while i < s.else_stmts.len {
        collect_strings_stmt(cg, vec_get(&s.else_stmts, i));
        i = i + 1;
    }
}

fn collect_handlers_expr(cg: &mut Codegen, e: *mut AstExpr) {
    if e == 0 as *mut AstExpr { return; }
    if e.kind == expr_handle() {
        let handler = e.left as *mut AstHandler;
        if handler != (0 as *mut AstHandler) {
            let mut found = false;
            let mut hi: i64 = 0;
            while hi < cg.handlers.len {
                let h = vec_get(&cg.handlers, hi);
                if h.id == handler.id {
                    found = true;
                    break;
                }
                hi = hi + 1;
            }
            if !found {
                vec_push(&mut cg.handlers, handler);
            }
        }
        let mut bi: i64 = 0;
        while bi < e.stmts.len {
            collect_handlers_stmt(cg, vec_get(&e.stmts, bi));
            bi = bi + 1;
        }
        return;
    }
    if e.left != (0 as *mut AstExpr) {
        collect_handlers_expr(cg, e.left);
    }
    if e.right != (0 as *mut AstExpr) {
        collect_handlers_expr(cg, e.right);
    }
    let mut i: i64 = 0;
    while i < e.args.len {
        collect_handlers_expr(cg, vec_get(&e.args, i));
        i = i + 1;
    }
}

fn collect_handlers_stmt(cg: &mut Codegen, s: *mut AstStmt) {
    if s == 0 as *mut AstStmt { return; }
    if s.kind == stmt_handle() {
        let handler = s.handler;
        if handler != (0 as *mut AstHandler) {
            let mut found = false;
            let mut hi: i64 = 0;
            while hi < cg.handlers.len {
                let h = vec_get(&cg.handlers, hi);
                if h.id == handler.id {
                    found = true;
                    break;
                }
                hi = hi + 1;
            }
            if !found {
                vec_push(&mut cg.handlers, handler);
            }
        }
        let mut ti: i64 = 0;
        while ti < s.then_stmts.len {
            collect_handlers_stmt(cg, vec_get(&s.then_stmts, ti));
            ti = ti + 1;
        }
        return;
    }
    collect_handlers_expr(cg, s.expr);
    collect_handlers_expr(cg, s.left);
    if s.kind != stmt_field_assign() {
        collect_handlers_expr(cg, s.right);
    }
    let mut i: i64 = 0;
    while i < s.then_stmts.len {
        collect_handlers_stmt(cg, vec_get(&s.then_stmts, i));
        i = i + 1;
    }
    i = 0;
    while i < s.else_stmts.len {
        collect_handlers_stmt(cg, vec_get(&s.else_stmts, i));
        i = i + 1;
    }
}

// Emits an expression and returns the LLVM register number containing the result
pub fn emit_expr(cg: &mut Codegen, expr_ptr: *mut AstExpr) -> i64 {
    if expr_ptr == 0 as *mut AstExpr {
        return 0;
    }

    if expr_ptr.kind == expr_int() {
        let r = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, r);
        emit_str(cg, " = add i64 0, ");
        emit_i64(cg, expr_ptr.int_val);
        emit_str(cg, "\n");
        return r;
    }

    if expr_ptr.kind == expr_str() {
        let r = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, r);
        emit_str(cg, " = ptrtoint ptr @str_");
        emit_i64(cg, expr_ptr.int_val);
        emit_str(cg, " to i64\n");
        return r;
    }

    if expr_ptr.kind == expr_var() {
        let mut is_local = false;
        let mut vi: i64 = 0;
        while vi < cg.allocated_vars.len {
            if vec_get(&cg.allocated_vars, vi) == expr_ptr.sym {
                is_local = true;
                break;
            }
            vi = vi + 1;
        }

        let r = alloc_reg(cg);
        if is_local {
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = load i64, ptr %v_");
            emit_sym(cg, expr_ptr.sym);
            emit_str(cg, "\n");
        } else {
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = ptrtoint ptr @");
            emit_sym(cg, expr_ptr.sym);
            emit_str(cg, " to i64\n");
        }
        return r;
    }

    if expr_ptr.kind == expr_field() {
        let target_reg = emit_expr(cg, expr_ptr.left);
        let ptr_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ptr_reg);
        emit_str(cg, " = inttoptr i64 %t");
        emit_i64(cg, target_reg);
        emit_str(cg, " to ptr\n");

        let mut offset: i64 = 0;
        if expr_ptr.op > 0 {
            offset = expr_ptr.op - 1;
        } else {
            offset = get_field_offset(cg, expr_ptr.sym);
        }
        let gep_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, gep_reg);
        emit_str(cg, " = getelementptr inbounds i64, ptr %t");
        emit_i64(cg, ptr_reg);
        emit_str(cg, ", i64 ");
        emit_i64(cg, offset);
        emit_str(cg, "\n");

        let r = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, r);
        emit_str(cg, " = load i64, ptr %t");
        emit_i64(cg, gep_reg);
        emit_str(cg, "\n");
        return r;
    }

    if expr_ptr.kind == expr_index() {
        let raw_ptr_reg = emit_expr(cg, expr_ptr.left);
        let idx_reg = emit_expr(cg, expr_ptr.right);
        let ptr_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ptr_reg);
        emit_str(cg, " = inttoptr i64 %t");
        emit_i64(cg, raw_ptr_reg);
        emit_str(cg, " to ptr\n");

        let mut is_byte = is_byte_indexing(cg, expr_ptr.left);
        if expr_ptr.op == 8 {
            is_byte = false;
        } else if expr_ptr.op == 1 {
            is_byte = true;
        }
        let gep_reg = alloc_reg(cg);
        if is_byte {
            emit_str(cg, "    %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, " = getelementptr inbounds i8, ptr %t");
            emit_i64(cg, ptr_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, idx_reg);
            emit_str(cg, "\n");

            let b_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " = load i8, ptr %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, "\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = zext i8 %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " to i64\n");
            return r;
        } else {
            emit_str(cg, "    %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, " = getelementptr inbounds i64, ptr %t");
            emit_i64(cg, ptr_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, idx_reg);
            emit_str(cg, "\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = load i64, ptr %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, "\n");
            return r;
        }
    }

    if expr_ptr.kind == expr_cast() {
        return emit_expr(cg, expr_ptr.left);
    }

    if expr_ptr.kind == expr_unary() {
        let inner_reg = emit_expr(cg, expr_ptr.left);
        let r = alloc_reg(cg);
        if expr_ptr.op == tok_bang() {
            let cmp_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, cmp_reg);
            emit_str(cg, " = icmp eq i64 %t");
            emit_i64(cg, inner_reg);
            emit_str(cg, ", 0\n");

            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = zext i1 %t");
            emit_i64(cg, cmp_reg);
            emit_str(cg, " to i64\n");
            return r;
        }
        if expr_ptr.op == tok_minus() {
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = sub i64 0, %t");
            emit_i64(cg, inner_reg);
            emit_str(cg, "\n");
            return r;
        }
        if expr_ptr.op == tok_amp() {
            return inner_reg;
        }
        return inner_reg;
    }

    if expr_ptr.kind == expr_binop() {
        let left_reg = emit_expr(cg, expr_ptr.left);
        let right_reg = emit_expr(cg, expr_ptr.right);
        let r = alloc_reg(cg);

        if expr_ptr.op == tok_plus() {
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = add i64 %t");
            emit_i64(cg, left_reg);
            emit_str(cg, ", %t");
            emit_i64(cg, right_reg);
            emit_str(cg, "\n");
            return r;
        }
        if expr_ptr.op == tok_minus() {
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = sub i64 %t");
            emit_i64(cg, left_reg);
            emit_str(cg, ", %t");
            emit_i64(cg, right_reg);
            emit_str(cg, "\n");
            return r;
        }
        if expr_ptr.op == tok_star() {
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = mul i64 %t");
            emit_i64(cg, left_reg);
            emit_str(cg, ", %t");
            emit_i64(cg, right_reg);
            emit_str(cg, "\n");
            return r;
        }
        if expr_ptr.op == tok_slash() {
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = sdiv i64 %t");
            emit_i64(cg, left_reg);
            emit_str(cg, ", %t");
            emit_i64(cg, right_reg);
            emit_str(cg, "\n");
            return r;
        }

        if expr_ptr.op == tok_and() {
            let l_cmp = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, l_cmp);
            emit_str(cg, " = icmp ne i64 %t");
            emit_i64(cg, left_reg);
            emit_str(cg, ", 0\n");

            let r_cmp = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r_cmp);
            emit_str(cg, " = icmp ne i64 %t");
            emit_i64(cg, right_reg);
            emit_str(cg, ", 0\n");

            let and_res = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, and_res);
            emit_str(cg, " = and i1 %t");
            emit_i64(cg, l_cmp);
            emit_str(cg, ", %t");
            emit_i64(cg, r_cmp);
            emit_str(cg, "\n");

            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = zext i1 %t");
            emit_i64(cg, and_res);
            emit_str(cg, " to i64\n");
            return r;
        }

        if expr_ptr.op == tok_or() {
            let l_cmp = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, l_cmp);
            emit_str(cg, " = icmp ne i64 %t");
            emit_i64(cg, left_reg);
            emit_str(cg, ", 0\n");

            let r_cmp = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r_cmp);
            emit_str(cg, " = icmp ne i64 %t");
            emit_i64(cg, right_reg);
            emit_str(cg, ", 0\n");

            let or_res = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, or_res);
            emit_str(cg, " = or i1 %t");
            emit_i64(cg, l_cmp);
            emit_str(cg, ", %t");
            emit_i64(cg, r_cmp);
            emit_str(cg, "\n");

            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = zext i1 %t");
            emit_i64(cg, or_res);
            emit_str(cg, " to i64\n");
            return r;
        }

        // Comparisons
        let cmp_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, cmp_reg);
        emit_str(cg, " = icmp ");
        if expr_ptr.op == tok_eqeq() {
            emit_str(cg, "eq");
        } else if expr_ptr.op == tok_neq() {
            emit_str(cg, "ne");
        } else if expr_ptr.op == tok_lt() {
            emit_str(cg, "slt");
        } else if expr_ptr.op == tok_lte() {
            emit_str(cg, "sle");
        } else if expr_ptr.op == tok_gt() {
            emit_str(cg, "sgt");
        } else if expr_ptr.op == tok_gte() {
            emit_str(cg, "sge");
        } else {
            emit_str(cg, "eq");
        }
        emit_str(cg, " i64 %t");
        emit_i64(cg, left_reg);
        emit_str(cg, ", %t");
        emit_i64(cg, right_reg);
        emit_str(cg, "\n");

        emit_str(cg, "    %t");
        emit_i64(cg, r);
        emit_str(cg, " = zext i1 %t");
        emit_i64(cg, cmp_reg);
        emit_str(cg, " to i64\n");
        return r;
    }

    if expr_ptr.kind == expr_struct_init() {
        let total_fields = expr_ptr.args.len;
        let mut field_regs: Vec<i64> = vec_new_in(cg.cg_arena);
        let mut fi: i64 = 0;
        while fi < total_fields {
            let farg = vec_get(&expr_ptr.args, fi);
            let fr = emit_expr(cg, farg);
            vec_push(&mut field_regs, fr);
            fi = fi + 1;
        }

        let struct_reg = alloc_reg(cg);
        let mut alloc_bytes = total_fields * 8;
        if alloc_bytes < 8 {
            alloc_bytes = 8;
        }
        emit_str(cg, "    %t");
        emit_i64(cg, struct_reg);
        emit_str(cg, " = call ptr @tungsten_alloc(i64 ");
        emit_i64(cg, alloc_bytes);
        emit_str(cg, ", i64 8)\n");

        fi = 0;
        while fi < total_fields {
            let gep_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, " = getelementptr inbounds i64, ptr %t");
            emit_i64(cg, struct_reg);
            emit_str(cg, ", i64 ");
            emit_i64(cg, fi);
            emit_str(cg, "\n");

            emit_str(cg, "    store i64 %t");
            emit_i64(cg, vec_get(&field_regs, fi));
            emit_str(cg, ", ptr %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, "\n");
            fi = fi + 1;
        }

        let r = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, r);
        emit_str(cg, " = ptrtoint ptr %t");
        emit_i64(cg, struct_reg);
        emit_str(cg, " to i64\n");
        return r;
    }

    if expr_ptr.kind == expr_call() {
        let interner_ref = cg.cg_interner as &Interner;
        let fn_name = interner_lookup(interner_ref, expr_ptr.sym);

        // Special runtime call: println
        if unsafe { strcmp(fn_name as *const u8, "println" as *const u8) == 0 } {
            let mut arg_reg: i64 = 0;
            if expr_ptr.args.len > 0 {
                let first_arg = vec_get(&expr_ptr.args, 0);
                arg_reg = emit_expr(cg, first_arg);
            }
            emit_str(cg, "    call void @tungsten_println_i64(i64 %t");
            emit_i64(cg, arg_reg);
            emit_str(cg, ")\n");
            return 0;
        }

        // Evaluate all argument expressions
        let mut arg_regs: Vec<i64> = vec_new_in(cg.cg_arena);
        let mut i: i64 = 0;
        while i < expr_ptr.args.len {
            let arg_node = vec_get(&expr_ptr.args, i);
            let ar = emit_expr(cg, arg_node);
            vec_push(&mut arg_regs, ar);
            i = i + 1;
        }

        // Runtime thunk intercepts
        if unsafe { strcmp(fn_name as *const u8, "puts" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let r32 = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r32);
            emit_str(cg, " = call i32 @puts(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ")\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = sext i32 %t");
            emit_i64(cg, r32);
            emit_str(cg, " to i64\n");
            return r;
        }

        if unsafe { strcmp(fn_name as *const u8, "strlen" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = call i64 @strlen(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ")\n");
            return r;
        }

        if unsafe { strcmp(fn_name as *const u8, "strcmp" as *const u8) == 0 } {
            let p1_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p1_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let p2_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p2_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, " to ptr\n");

            let r32 = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r32);
            emit_str(cg, " = call i32 @strcmp(ptr %t");
            emit_i64(cg, p1_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, p2_reg);
            emit_str(cg, ")\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = sext i32 %t");
            emit_i64(cg, r32);
            emit_str(cg, " to i64\n");
            return r;
        }

        if unsafe { strcmp(fn_name as *const u8, "memset" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let val32 = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, val32);
            emit_str(cg, " = trunc i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, " to i32\n");

            let ptr_res = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, ptr_res);
            emit_str(cg, " = call ptr @memset(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ", i32 %t");
            emit_i64(cg, val32);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 2));
            emit_str(cg, ")\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, ptr_res);
            emit_str(cg, " to i64\n");
            return r;
        }

        if unsafe { strcmp(fn_name as *const u8, "free" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            emit_str(cg, "    call void @free(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ")\n");
            return 0;
        }

        if unsafe { strcmp(fn_name as *const u8, "GetCommandLineA" as *const u8) == 0 } {
            let ptr_res = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, ptr_res);
            emit_str(cg, " = call ptr @GetCommandLineA()\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, ptr_res);
            emit_str(cg, " to i64\n");
            return r;
        }

        if unsafe { strcmp(fn_name as *const u8, "tungsten_region_alloc" as *const u8) == 0 } {
            let a_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, a_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let res_ptr = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " = call ptr @tungsten_region_alloc(ptr %t");
            emit_i64(cg, a_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 2));
            emit_str(cg, ")\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " to i64\n");
            return r;
        }

        if unsafe { strcmp(fn_name as *const u8, "tungsten_region_grow" as *const u8) == 0 } {
            let a_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, a_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, " to ptr\n");

            let res_ptr = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " = call ptr @tungsten_region_grow(ptr %t");
            emit_i64(cg, a_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 2));
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 3));
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 4));
            emit_str(cg, ")\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " to i64\n");
            return r;
        }

        if unsafe { strcmp(fn_name as *const u8, "tungsten_alloc" as *const u8) == 0 } {
            let res_ptr = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " = call ptr @tungsten_alloc(i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, ")\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " to i64\n");
            return r;
        }

        if unsafe { strcmp(fn_name as *const u8, "fs_read_to_string_in" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let a_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, a_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, " to ptr\n");

            let res_ptr = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " = call ptr @tungsten_fs_read_file_in(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, a_reg);
            emit_str(cg, ")\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " to i64\n");
            return r;
        }

        if unsafe { strcmp(fn_name as *const u8, "fs_write_string" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let c_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, c_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, " to ptr\n");

            let b_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " = call i1 @tungsten_fs_write_file(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, c_reg);
            emit_str(cg, ")\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = zext i1 %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " to i64\n");
            return r;
        }

        if unsafe { strcmp(fn_name as *const u8, "fs_exists" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let b_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " = call i1 @tungsten_fs_file_exists(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ")\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = zext i1 %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " to i64\n");
            return r;
        }

        if unsafe { strcmp(fn_name as *const u8, "process_exec" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let a_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, a_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, " to ptr\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = call i64 @tungsten_process_exec(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, a_reg);
            emit_str(cg, ")\n");
            return r;
        }

        if unsafe { strcmp(fn_name as *const u8, "report_err" as *const u8) == 0 } {
            let m_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, m_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let b_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " = call i1 @tungsten_report_error(ptr %t");
            emit_i64(cg, m_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 2));
            emit_str(cg, ")\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = zext i1 %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " to i64\n");
            return r;
        }

        // Generic user function call
        let r = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, r);
        emit_str(cg, " = call i64 @");
        emit_str(cg, fn_name);
        emit_str(cg, "(");
        i = 0;
        while i < arg_regs.len {
            if i > 0 {
                emit_str(cg, ", ");
            }
            emit_str(cg, "i64 %t");
            emit_i64(cg, vec_get(&arg_regs, i));
            i = i + 1;
        }
        emit_str(cg, ")\n");
        return r;
    }

    0
}

pub fn emit_stmt(cg: &mut Codegen, stmt_ptr: *mut AstStmt, is_main: bool, is_tail: bool) {
    if stmt_ptr == 0 as *mut AstStmt || cg.terminated {
        return;
    }

    if stmt_ptr.kind == stmt_let() {
        let mut already_alloc = false;
        let mut vi: i64 = 0;
        while vi < cg.allocated_vars.len {
            if vec_get(&cg.allocated_vars, vi) == stmt_ptr.sym {
                already_alloc = true;
                break;
            }
            vi = vi + 1;
        }

        if !already_alloc {
            vec_push(&mut cg.allocated_vars, stmt_ptr.sym);
        }

        let val_reg = emit_expr(cg, stmt_ptr.expr);
        emit_str(cg, "    store i64 %t");
        emit_i64(cg, val_reg);
        emit_str(cg, ", ptr %v_");
        emit_sym(cg, stmt_ptr.sym);
        emit_str(cg, "\n");
        return;
    }

    if stmt_ptr.kind == stmt_assign() {
        let val_reg = emit_expr(cg, stmt_ptr.expr);
        emit_str(cg, "    store i64 %t");
        emit_i64(cg, val_reg);
        emit_str(cg, ", ptr %v_");
        emit_sym(cg, stmt_ptr.sym);
        emit_str(cg, "\n");
        return;
    }

    if stmt_ptr.kind == stmt_field_assign() {
        let target_reg = emit_expr(cg, stmt_ptr.left);
        let val_reg = emit_expr(cg, stmt_ptr.expr);
        let ptr_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ptr_reg);
        emit_str(cg, " = inttoptr i64 %t");
        emit_i64(cg, target_reg);
        emit_str(cg, " to ptr\n");

        let mut offset: i64 = 0;
        let r_val = stmt_ptr.right as i64;
        if r_val > 0 {
            offset = r_val - 1;
        } else {
            offset = get_field_offset(cg, stmt_ptr.sym);
        }
        let gep_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, gep_reg);
        emit_str(cg, " = getelementptr inbounds i64, ptr %t");
        emit_i64(cg, ptr_reg);
        emit_str(cg, ", i64 ");
        emit_i64(cg, offset);
        emit_str(cg, "\n");

        emit_str(cg, "    store i64 %t");
        emit_i64(cg, val_reg);
        emit_str(cg, ", ptr %t");
        emit_i64(cg, gep_reg);
        emit_str(cg, "\n");
        return;
    }

    if stmt_ptr.kind == stmt_index_assign() {
        let raw_ptr_reg = emit_expr(cg, stmt_ptr.left);
        let idx_reg = emit_expr(cg, stmt_ptr.right);
        let val_reg = emit_expr(cg, stmt_ptr.expr);
        let ptr_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ptr_reg);
        emit_str(cg, " = inttoptr i64 %t");
        emit_i64(cg, raw_ptr_reg);
        emit_str(cg, " to ptr\n");

        let mut is_byte = is_byte_indexing(cg, stmt_ptr.left);
        if stmt_ptr.sym == 8 {
            is_byte = false;
        } else if stmt_ptr.sym == 1 {
            is_byte = true;
        }
        let gep_reg = alloc_reg(cg);
        if is_byte {
            emit_str(cg, "    %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, " = getelementptr inbounds i8, ptr %t");
            emit_i64(cg, ptr_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, idx_reg);
            emit_str(cg, "\n");

            let trunc_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, trunc_reg);
            emit_str(cg, " = trunc i64 %t");
            emit_i64(cg, val_reg);
            emit_str(cg, " to i8\n");

            emit_str(cg, "    store i8 %t");
            emit_i64(cg, trunc_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, "\n");
        } else {
            emit_str(cg, "    %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, " = getelementptr inbounds i64, ptr %t");
            emit_i64(cg, ptr_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, idx_reg);
            emit_str(cg, "\n");

            emit_str(cg, "    store i64 %t");
            emit_i64(cg, val_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, "\n");
        }
        return;
    }

    if stmt_ptr.kind == stmt_return() {
        let ret_reg = emit_expr(cg, stmt_ptr.expr);
        if is_main {
            let r32 = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r32);
            emit_str(cg, " = trunc i64 %t");
            emit_i64(cg, ret_reg);
            emit_str(cg, " to i32\n");
            emit_str(cg, "    ret i32 %t");
            emit_i64(cg, r32);
            emit_str(cg, "\n");
        } else {
            emit_str(cg, "    ret i64 %t");
            emit_i64(cg, ret_reg);
            emit_str(cg, "\n");
        }
        cg.terminated = true;
        return;
    }

    if stmt_ptr.kind == stmt_expr() {
        let val = emit_expr(cg, stmt_ptr.expr);
        if is_tail && !is_main {
            emit_str(cg, "    ret i64 %t");
            emit_i64(cg, val);
            emit_str(cg, "\n");
            cg.terminated = true;
        }
        return;
    }

    if stmt_ptr.kind == stmt_break() {
        if cg.cur_loop_exit > 0 {
            emit_str(cg, "    br label %lbl_");
            emit_i64(cg, cg.cur_loop_exit);
            emit_str(cg, "\n");
            cg.terminated = true;
        }
        return;
    }

    if stmt_ptr.kind == stmt_block() {
        if stmt_ptr.sym != 0 {
            // Region block: region r { ... }
            let mut already_alloc = false;
            let mut vi: i64 = 0;
            while vi < cg.allocated_vars.len {
                if vec_get(&cg.allocated_vars, vi) == stmt_ptr.sym {
                    already_alloc = true;
                    break;
                }
                vi = vi + 1;
            }

            if !already_alloc {
                vec_push(&mut cg.allocated_vars, stmt_ptr.sym);
            }

            let reg_res = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, reg_res);
            emit_str(cg, " = call ptr @tungsten_region_enter()\n");

            let arena_i64 = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, arena_i64);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, reg_res);
            emit_str(cg, " to i64\n");

            emit_str(cg, "    store i64 %t");
            emit_i64(cg, arena_i64);
            emit_str(cg, ", ptr %v_");
            emit_sym(cg, stmt_ptr.sym);
            emit_str(cg, "\n");

            let mut bi: i64 = 0;
            while bi < stmt_ptr.then_stmts.len {
                let is_inner_tail = is_tail && (bi == stmt_ptr.then_stmts.len - 1);
                let bs = vec_get(&stmt_ptr.then_stmts, bi);
                if is_inner_tail && bs.kind == stmt_expr() {
                    let ret_val = emit_expr(cg, bs.expr);
                    let loaded_arena = alloc_reg(cg);
                    emit_str(cg, "    %t");
                    emit_i64(cg, loaded_arena);
                    emit_str(cg, " = load i64, ptr %v_");
                    emit_sym(cg, stmt_ptr.sym);
                    emit_str(cg, "\n");

                    let arena_p = alloc_reg(cg);
                    emit_str(cg, "    %t");
                    emit_i64(cg, arena_p);
                    emit_str(cg, " = inttoptr i64 %t");
                    emit_i64(cg, loaded_arena);
                    emit_str(cg, " to ptr\n");

                    emit_str(cg, "    call void @tungsten_region_exit(ptr %t");
                    emit_i64(cg, arena_p);
                    emit_str(cg, ")\n");

                    if is_main {
                        let r32 = alloc_reg(cg);
                        emit_str(cg, "    %t");
                        emit_i64(cg, r32);
                        emit_str(cg, " = trunc i64 %t");
                        emit_i64(cg, ret_val);
                        emit_str(cg, " to i32\n");
                        emit_str(cg, "    ret i32 %t");
                        emit_i64(cg, r32);
                        emit_str(cg, "\n");
                    } else {
                        emit_str(cg, "    ret i64 %t");
                        emit_i64(cg, ret_val);
                        emit_str(cg, "\n");
                    }
                    cg.terminated = true;
                    return;
                } else {
                    emit_stmt(cg, bs, is_main, false);
                }
                bi = bi + 1;
            }

            if !cg.terminated {
                let loaded_arena = alloc_reg(cg);
                emit_str(cg, "    %t");
                emit_i64(cg, loaded_arena);
                emit_str(cg, " = load i64, ptr %v_");
                emit_sym(cg, stmt_ptr.sym);
                emit_str(cg, "\n");

                let arena_p = alloc_reg(cg);
                emit_str(cg, "    %t");
                emit_i64(cg, arena_p);
                emit_str(cg, " = inttoptr i64 %t");
                emit_i64(cg, loaded_arena);
                emit_str(cg, " to ptr\n");

                emit_str(cg, "    call void @tungsten_region_exit(ptr %t");
                emit_i64(cg, arena_p);
                emit_str(cg, ")\n");
            }
            return;
        }

        // Unsafe block: unsafe { ... }
        let mut ui: i64 = 0;
        while ui < stmt_ptr.then_stmts.len {
            let is_inner_tail = is_tail && (ui == stmt_ptr.then_stmts.len - 1);
            emit_stmt(cg, vec_get(&stmt_ptr.then_stmts, ui), is_main, is_inner_tail);
            ui = ui + 1;
        }
        return;
    }

    if stmt_ptr.kind == stmt_if() {
        let cond_reg = emit_expr(cg, stmt_ptr.expr);
        let cmp_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, cmp_reg);
        emit_str(cg, " = icmp ne i64 %t");
        emit_i64(cg, cond_reg);
        emit_str(cg, ", 0\n");

        let then_lbl = alloc_label(cg);
        let else_lbl = alloc_label(cg);
        let merge_lbl = alloc_label(cg);

        emit_str(cg, "    br i1 %t");
        emit_i64(cg, cmp_reg);
        emit_str(cg, ", label %lbl_");
        emit_i64(cg, then_lbl);
        emit_str(cg, ", label %lbl_");
        emit_i64(cg, else_lbl);
        emit_str(cg, "\n");

        // Then block
        emit_str(cg, "lbl_");
        emit_i64(cg, then_lbl);
        emit_str(cg, ":\n");
        cg.terminated = false;
        let mut i: i64 = 0;
        while i < stmt_ptr.then_stmts.len {
            emit_stmt(cg, vec_get(&stmt_ptr.then_stmts, i), is_main, false);
            i = i + 1;
        }
        if !cg.terminated {
            emit_str(cg, "    br label %lbl_");
            emit_i64(cg, merge_lbl);
            emit_str(cg, "\n");
        }

        // Else block
        emit_str(cg, "lbl_");
        emit_i64(cg, else_lbl);
        emit_str(cg, ":\n");
        cg.terminated = false;
        i = 0;
        while i < stmt_ptr.else_stmts.len {
            emit_stmt(cg, vec_get(&stmt_ptr.else_stmts, i), is_main, false);
            i = i + 1;
        }
        if !cg.terminated {
            emit_str(cg, "    br label %lbl_");
            emit_i64(cg, merge_lbl);
            emit_str(cg, "\n");
        }

        // Merge block
        emit_str(cg, "lbl_");
        emit_i64(cg, merge_lbl);
        emit_str(cg, ":\n");
        cg.terminated = false;
        return;
    }

    if stmt_ptr.kind == stmt_while() {
        let cond_lbl = alloc_label(cg);
        let body_lbl = alloc_label(cg);
        let exit_lbl = alloc_label(cg);
        let prev_exit = cg.cur_loop_exit;
        cg.cur_loop_exit = exit_lbl;

        emit_str(cg, "    br label %lbl_");
        emit_i64(cg, cond_lbl);
        emit_str(cg, "\n");

        // Cond block
        emit_str(cg, "lbl_");
        emit_i64(cg, cond_lbl);
        emit_str(cg, ":\n");
        cg.terminated = false;
        let cond_reg = emit_expr(cg, stmt_ptr.expr);
        let cmp_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, cmp_reg);
        emit_str(cg, " = icmp ne i64 %t");
        emit_i64(cg, cond_reg);
        emit_str(cg, ", 0\n");
        emit_str(cg, "    br i1 %t");
        emit_i64(cg, cmp_reg);
        emit_str(cg, ", label %lbl_");
        emit_i64(cg, body_lbl);
        emit_str(cg, ", label %lbl_");
        emit_i64(cg, exit_lbl);
        emit_str(cg, "\n");

        // Body block
        emit_str(cg, "lbl_");
        emit_i64(cg, body_lbl);
        emit_str(cg, ":\n");
        cg.terminated = false;
        let mut i: i64 = 0;
        while i < stmt_ptr.then_stmts.len {
            emit_stmt(cg, vec_get(&stmt_ptr.then_stmts, i), is_main, false);
            i = i + 1;
        }
        if !cg.terminated {
            emit_str(cg, "    br label %lbl_");
            emit_i64(cg, cond_lbl);
            emit_str(cg, "\n");
        }

        // Exit block
        emit_str(cg, "lbl_");
        emit_i64(cg, exit_lbl);
        emit_str(cg, ":\n");
        cg.terminated = false;
        cg.cur_loop_exit = prev_exit;
        return;
    }
}

pub fn emit_function(cg: &mut Codegen, fn_ptr: *mut AstFn) {
    let interner_ref = cg.cg_interner as &Interner;
    let name = interner_lookup(interner_ref, fn_ptr.name_sym);
    let is_main = unsafe { strcmp(name as *const u8, "main" as *const u8) == 0 };

    cg.next_reg = 1;
    cg.allocated_vars = vec_new_in(cg.cg_arena);

    // Record parameter symbols
    let mut pi: i64 = 0;
    while pi < fn_ptr.params.len {
        let p_node = vec_get(&fn_ptr.params, pi);
        vec_push(&mut cg.allocated_vars, p_node.name_sym);
        pi = pi + 1;
    }

    // Emit function body into body_buf first, collecting all local variables in cg.allocated_vars
    let main_buf = cg.buf;
    cg.buf = string_buffer_new_in(cg.cg_arena);
    cg.terminated = false;

    let mut si: i64 = 0;
    while si < fn_ptr.body.len {
        let is_last = (si == fn_ptr.body.len - 1);
        emit_stmt(cg, vec_get(&fn_ptr.body, si), is_main, is_last);
        si = si + 1;
    }

    let body_buf = cg.buf;
    cg.buf = main_buf;

    if is_main {
        emit_str(cg, "define i32 @main() {\n");
    } else {
        emit_str(cg, "define i64 @");
        emit_str(cg, name);
        emit_str(cg, "(");
        let mut i: i64 = 0;
        while i < fn_ptr.params.len {
            if i > 0 {
                emit_str(cg, ", ");
            }
            emit_str(cg, "i64 %arg_");
            let p_node = vec_get(&fn_ptr.params, i);
            emit_sym(cg, p_node.name_sym);
            i = i + 1;
        }
        emit_str(cg, ") {\n");
    }

    emit_str(cg, "entry:\n");

    // Emit all alloca instructions at the very beginning of entry:
    let mut vi: i64 = 0;
    while vi < cg.allocated_vars.len {
        let sym = vec_get(&cg.allocated_vars, vi);
        emit_str(cg, "    %v_");
        emit_sym(cg, sym);
        emit_str(cg, " = alloca i64\n");
        vi = vi + 1;
    }

    // Spill parameters into local allocas
    pi = 0;
    while pi < fn_ptr.params.len {
        let p_node = vec_get(&fn_ptr.params, pi);
        emit_str(cg, "    store i64 %arg_");
        emit_sym(cg, p_node.name_sym);
        emit_str(cg, ", ptr %v_");
        emit_sym(cg, p_node.name_sym);
        emit_str(cg, "\n");
        pi = pi + 1;
    }

    // Append body statements
    string_buffer_push_str(&mut cg.buf, string_as_ptr(&body_buf), string_len(&body_buf));

    // Fallthrough return
    if !cg.terminated {
        if is_main {
            emit_str(cg, "    ret i32 0\n");
        } else {
            emit_str(cg, "    ret i64 0\n");
        }
    }
    emit_str(cg, "}\n\n");
}

fn get_str_id(cg: &mut Codegen, s: String) -> i64 {
    let mut i: i64 = 0;
    while i < cg.strings.len {
        let existing = vec_get(&cg.strings, i);
        if unsafe { strcmp(existing as *const u8, s as *const u8) == 0 } {
            return i;
        }
        i = i + 1;
    }
    let id = cg.strings.len;
    vec_push(&mut cg.strings, s);
    id
}

fn emit_block_label_ref(cg: &mut Codegen, block_id: i64) {
    if block_id <= 0 {
        emit_str(cg, "%entry");
    } else {
        emit_str(cg, "%bb_");
        emit_i64(cg, block_id);
    }
}

fn is_tir_byte_indexing(cg: &mut Codegen, base_op: *mut TirOperand, stride: i64) -> bool {
    if stride == 8 {
        return false;
    }
    if stride == 1 {
        return true;
    }
    if base_op != (0 as *mut TirOperand) {
        if base_op.sym != 0 {
            let interner_ref = cg.cg_interner as &Interner;
            let s = interner_lookup(interner_ref, base_op.sym);
            let p = s as *const u8;
            if unsafe {
                strcmp(p, "old_keys" as *const u8) == 0 ||
                strcmp(p, "old_vals" as *const u8) == 0 ||
                strcmp(p, "old_occ" as *const u8) == 0 ||
                strcmp(p, "ptr_slot" as *const u8) == 0 ||
                strcmp(p, "stmt_slot" as *const u8) == 0 ||
                strcmp(p, "my_numbers" as *const u8) == 0
            } {
                return false;
            }
        }
    }
    true
}

fn emit_tir_op(cg: &mut Codegen, op: *mut TirOperand) -> i64 {
    if op == (0 as *mut TirOperand) {
        return 0;
    }
    let kind = op.kind;
    if kind == tir_op_int() {
        let r = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, r);
        emit_str(cg, " = add i64 0, ");
        emit_i64(cg, op.int_val);
        emit_str(cg, "\n");
        return r;
    }
    if kind == tir_op_str() {
        let sid = get_str_id(cg, op.str_val);
        let r = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, r);
        emit_str(cg, " = ptrtoint ptr @str_");
        emit_i64(cg, sid);
        emit_str(cg, " to i64\n");
        return r;
    }
    if kind == tir_op_var() {
        let mut is_local = false;
        let mut vi: i64 = 0;
        while vi < cg.allocated_vars.len {
            if vec_get(&cg.allocated_vars, vi) == op.sym {
                is_local = true;
                break;
            }
            vi = vi + 1;
        }
        let r = alloc_reg(cg);
        if is_local {
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = load i64, ptr %v_");
            emit_sym(cg, op.sym);
            emit_str(cg, "\n");
        } else {
            emit_str(cg, "    %t");
            emit_i64(cg, r);
            emit_str(cg, " = ptrtoint ptr @");
            emit_sym(cg, op.sym);
            emit_str(cg, " to i64\n");
        }
        return r;
    }
    if kind == tir_op_reg() {
        return op.int_val;
    }
    0
}

fn emit_tir_inst(cg: &mut Codegen, inst: *mut TirInst) {
    if inst == (0 as *mut TirInst) {
        return;
    }
    let kind = inst.kind;

    if kind == tir_inst_assign() {
        if inst.op == 0 {
            if inst.left != (0 as *mut TirOperand) {
                if inst.left.kind == tir_op_int() {
                    emit_str(cg, "    %t");
                    emit_i64(cg, inst.sym);
                    emit_str(cg, " = add i64 0, ");
                    emit_i64(cg, inst.left.int_val);
                    emit_str(cg, "\n");
                    return;
                }
            }
            let lr = emit_tir_op(cg, inst.left);
            emit_str(cg, "    %t");
            emit_i64(cg, inst.sym);
            emit_str(cg, " = add i64 0, %t");
            emit_i64(cg, lr);
            emit_str(cg, "\n");
            return;
        }
        if inst.op == tok_minus() {
            if inst.right == (0 as *mut TirOperand) {
                let lr = emit_tir_op(cg, inst.left);
                emit_str(cg, "    %t");
                emit_i64(cg, inst.sym);
                emit_str(cg, " = sub i64 0, %t");
                emit_i64(cg, lr);
                emit_str(cg, "\n");
                return;
            }
        }
        if inst.op == tok_bang() {
            if inst.right == (0 as *mut TirOperand) {
                let lr = emit_tir_op(cg, inst.left);
                let cmp_reg = alloc_reg(cg);
                emit_str(cg, "    %t");
                emit_i64(cg, cmp_reg);
                emit_str(cg, " = icmp eq i64 %t");
                emit_i64(cg, lr);
                emit_str(cg, ", 0\n");

                emit_str(cg, "    %t");
                emit_i64(cg, inst.sym);
                emit_str(cg, " = zext i1 %t");
                emit_i64(cg, cmp_reg);
                emit_str(cg, " to i64\n");
                return;
            }
        }
        if inst.op == tok_amp() {
            if inst.right == (0 as *mut TirOperand) {
                let lr = emit_tir_op(cg, inst.left);
                emit_str(cg, "    %t");
                emit_i64(cg, inst.sym);
                emit_str(cg, " = add i64 0, %t");
                emit_i64(cg, lr);
                emit_str(cg, "\n");
                return;
            }
        }

        // Binary operation
        let left_reg = emit_tir_op(cg, inst.left);
        let right_reg = emit_tir_op(cg, inst.right);

        if inst.op == tok_plus() {
            emit_str(cg, "    %t");
            emit_i64(cg, inst.sym);
            emit_str(cg, " = add i64 %t");
            emit_i64(cg, left_reg);
            emit_str(cg, ", %t");
            emit_i64(cg, right_reg);
            emit_str(cg, "\n");
            return;
        }
        if inst.op == tok_minus() {
            emit_str(cg, "    %t");
            emit_i64(cg, inst.sym);
            emit_str(cg, " = sub i64 %t");
            emit_i64(cg, left_reg);
            emit_str(cg, ", %t");
            emit_i64(cg, right_reg);
            emit_str(cg, "\n");
            return;
        }
        if inst.op == tok_star() {
            emit_str(cg, "    %t");
            emit_i64(cg, inst.sym);
            emit_str(cg, " = mul i64 %t");
            emit_i64(cg, left_reg);
            emit_str(cg, ", %t");
            emit_i64(cg, right_reg);
            emit_str(cg, "\n");
            return;
        }
        if inst.op == tok_slash() {
            emit_str(cg, "    %t");
            emit_i64(cg, inst.sym);
            emit_str(cg, " = sdiv i64 %t");
            emit_i64(cg, left_reg);
            emit_str(cg, ", %t");
            emit_i64(cg, right_reg);
            emit_str(cg, "\n");
            return;
        }
        if inst.op == tok_and() {
            let l_cmp = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, l_cmp);
            emit_str(cg, " = icmp ne i64 %t");
            emit_i64(cg, left_reg);
            emit_str(cg, ", 0\n");

            let r_cmp = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r_cmp);
            emit_str(cg, " = icmp ne i64 %t");
            emit_i64(cg, right_reg);
            emit_str(cg, ", 0\n");

            let and_res = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, and_res);
            emit_str(cg, " = and i1 %t");
            emit_i64(cg, l_cmp);
            emit_str(cg, ", %t");
            emit_i64(cg, r_cmp);
            emit_str(cg, "\n");

            emit_str(cg, "    %t");
            emit_i64(cg, inst.sym);
            emit_str(cg, " = zext i1 %t");
            emit_i64(cg, and_res);
            emit_str(cg, " to i64\n");
            return;
        }
        if inst.op == tok_or() {
            let l_cmp = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, l_cmp);
            emit_str(cg, " = icmp ne i64 %t");
            emit_i64(cg, left_reg);
            emit_str(cg, ", 0\n");

            let r_cmp = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r_cmp);
            emit_str(cg, " = icmp ne i64 %t");
            emit_i64(cg, right_reg);
            emit_str(cg, ", 0\n");

            let or_res = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, or_res);
            emit_str(cg, " = or i1 %t");
            emit_i64(cg, l_cmp);
            emit_str(cg, ", %t");
            emit_i64(cg, r_cmp);
            emit_str(cg, "\n");

            emit_str(cg, "    %t");
            emit_i64(cg, inst.sym);
            emit_str(cg, " = zext i1 %t");
            emit_i64(cg, or_res);
            emit_str(cg, " to i64\n");
            return;
        }

        // Comparisons
        let cmp_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, cmp_reg);
        emit_str(cg, " = icmp ");
        if inst.op == tok_eqeq() {
            emit_str(cg, "eq");
        } else if inst.op == tok_neq() {
            emit_str(cg, "ne");
        } else if inst.op == tok_lt() {
            emit_str(cg, "slt");
        } else if inst.op == tok_lte() {
            emit_str(cg, "sle");
        } else if inst.op == tok_gt() {
            emit_str(cg, "sgt");
        } else if inst.op == tok_gte() {
            emit_str(cg, "sge");
        } else {
            emit_str(cg, "eq");
        }
        emit_str(cg, " i64 %t");
        emit_i64(cg, left_reg);
        emit_str(cg, ", %t");
        emit_i64(cg, right_reg);
        emit_str(cg, "\n");

        emit_str(cg, "    %t");
        emit_i64(cg, inst.sym);
        emit_str(cg, " = zext i1 %t");
        emit_i64(cg, cmp_reg);
        emit_str(cg, " to i64\n");
        return;
    }

    if kind == tir_inst_store() {
        let val_reg = emit_tir_op(cg, inst.left);
        emit_str(cg, "    store i64 %t");
        emit_i64(cg, val_reg);
        emit_str(cg, ", ptr %v_");
        emit_sym(cg, inst.sym);
        emit_str(cg, "\n");
        return;
    }

    if kind == tir_inst_load_field() {
        let target_reg = emit_tir_op(cg, inst.left);
        let ptr_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ptr_reg);
        emit_str(cg, " = inttoptr i64 %t");
        emit_i64(cg, target_reg);
        emit_str(cg, " to ptr\n");

        let mut offset: i64 = 0;
        if inst.op > 0 {
            offset = inst.op - 1;
        } else {
            offset = get_field_offset(cg, inst.int_val);
        }
        let gep_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, gep_reg);
        emit_str(cg, " = getelementptr inbounds i64, ptr %t");
        emit_i64(cg, ptr_reg);
        emit_str(cg, ", i64 ");
        emit_i64(cg, offset);
        emit_str(cg, "\n");

        emit_str(cg, "    %t");
        emit_i64(cg, inst.sym);
        emit_str(cg, " = load i64, ptr %t");
        emit_i64(cg, gep_reg);
        emit_str(cg, "\n");
        return;
    }

    if kind == tir_inst_store_field() {
        let target_reg = emit_tir_op(cg, inst.left);
        let val_reg = emit_tir_op(cg, inst.right);
        let ptr_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ptr_reg);
        emit_str(cg, " = inttoptr i64 %t");
        emit_i64(cg, target_reg);
        emit_str(cg, " to ptr\n");

        let mut offset: i64 = 0;
        if inst.op > 0 {
            offset = inst.op - 1;
        } else {
            offset = get_field_offset(cg, inst.int_val);
        }
        let gep_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, gep_reg);
        emit_str(cg, " = getelementptr inbounds i64, ptr %t");
        emit_i64(cg, ptr_reg);
        emit_str(cg, ", i64 ");
        emit_i64(cg, offset);
        emit_str(cg, "\n");

        emit_str(cg, "    store i64 %t");
        emit_i64(cg, val_reg);
        emit_str(cg, ", ptr %t");
        emit_i64(cg, gep_reg);
        emit_str(cg, "\n");
        return;
    }

    if kind == tir_inst_load_index() {
        let raw_ptr_reg = emit_tir_op(cg, inst.left);
        let idx_reg = emit_tir_op(cg, inst.right);
        let ptr_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ptr_reg);
        emit_str(cg, " = inttoptr i64 %t");
        emit_i64(cg, raw_ptr_reg);
        emit_str(cg, " to ptr\n");

        let is_byte = is_tir_byte_indexing(cg, inst.left, inst.op);
        let gep_reg = alloc_reg(cg);
        if is_byte {
            emit_str(cg, "    %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, " = getelementptr inbounds i8, ptr %t");
            emit_i64(cg, ptr_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, idx_reg);
            emit_str(cg, "\n");

            let b_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " = load i8, ptr %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, "\n");

            emit_str(cg, "    %t");
            emit_i64(cg, inst.sym);
            emit_str(cg, " = zext i8 %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " to i64\n");
        } else {
            emit_str(cg, "    %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, " = getelementptr inbounds i64, ptr %t");
            emit_i64(cg, ptr_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, idx_reg);
            emit_str(cg, "\n");

            let r = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, inst.sym);
            emit_str(cg, " = load i64, ptr %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, "\n");
        }
        return;
    }

    if kind == tir_inst_store_index() {
        let raw_ptr_reg = emit_tir_op(cg, inst.left);
        let idx_reg = emit_tir_op(cg, inst.right);
        let val_op = vec_get(&inst.args, 0);
        let val_reg = emit_tir_op(cg, val_op);
        let ptr_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ptr_reg);
        emit_str(cg, " = inttoptr i64 %t");
        emit_i64(cg, raw_ptr_reg);
        emit_str(cg, " to ptr\n");

        let is_byte = is_tir_byte_indexing(cg, inst.left, inst.op);
        let gep_reg = alloc_reg(cg);
        if is_byte {
            emit_str(cg, "    %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, " = getelementptr inbounds i8, ptr %t");
            emit_i64(cg, ptr_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, idx_reg);
            emit_str(cg, "\n");

            let trunc_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, trunc_reg);
            emit_str(cg, " = trunc i64 %t");
            emit_i64(cg, val_reg);
            emit_str(cg, " to i8\n");

            emit_str(cg, "    store i8 %t");
            emit_i64(cg, trunc_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, "\n");
        } else {
            emit_str(cg, "    %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, " = getelementptr inbounds i64, ptr %t");
            emit_i64(cg, ptr_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, idx_reg);
            emit_str(cg, "\n");

            emit_str(cg, "    store i64 %t");
            emit_i64(cg, val_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, "\n");
        }
        return;
    }

    if kind == tir_inst_struct_init() {
        let total_fields = inst.args.len;
        let mut field_regs: Vec<i64> = vec_new_in(cg.cg_arena);
        let mut fi: i64 = 0;
        while fi < total_fields {
            let farg = vec_get(&inst.args, fi);
            let fr = emit_tir_op(cg, farg);
            vec_push(&mut field_regs, fr);
            fi = fi + 1;
        }

        let struct_reg = alloc_reg(cg);
        let mut alloc_bytes = total_fields * 8;
        if alloc_bytes < 8 {
            alloc_bytes = 8;
        }
        emit_str(cg, "    %t");
        emit_i64(cg, struct_reg);
        emit_str(cg, " = call ptr @tungsten_alloc(i64 ");
        emit_i64(cg, alloc_bytes);
        emit_str(cg, ", i64 8)\n");

        fi = 0;
        while fi < total_fields {
            let gep_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, " = getelementptr inbounds i64, ptr %t");
            emit_i64(cg, struct_reg);
            emit_str(cg, ", i64 ");
            emit_i64(cg, fi);
            emit_str(cg, "\n");

            emit_str(cg, "    store i64 %t");
            emit_i64(cg, vec_get(&field_regs, fi));
            emit_str(cg, ", ptr %t");
            emit_i64(cg, gep_reg);
            emit_str(cg, "\n");
            fi = fi + 1;
        }

        emit_str(cg, "    %t");
        emit_i64(cg, inst.sym);
        emit_str(cg, " = ptrtoint ptr %t");
        emit_i64(cg, struct_reg);
        emit_str(cg, " to i64\n");
        return;
    }

    if kind == tir_inst_call() {
        let pstr = inst.str_val as *const u8;
        if unsafe { strcmp(pstr, "tungsten_region_enter" as *const u8) == 0 } {
            let reg_res = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, reg_res);
            emit_str(cg, " = call ptr @tungsten_region_enter()\n");

            let arena_i64 = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, arena_i64);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, reg_res);
            emit_str(cg, " to i64\n");

            emit_str(cg, "    store i64 %t");
            emit_i64(cg, arena_i64);
            emit_str(cg, ", ptr %v_");
            emit_sym(cg, inst.sym);
            emit_str(cg, "\n");
            return;
        }
        if unsafe { strcmp(pstr, "tungsten_region_leave" as *const u8) == 0 } {
            let loaded_arena = emit_tir_op(cg, vec_get(&inst.args, 0));
            let arena_p = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, arena_p);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, loaded_arena);
            emit_str(cg, " to ptr\n");

            emit_str(cg, "    call void @tungsten_region_exit(ptr %t");
            emit_i64(cg, arena_p);
            emit_str(cg, ")\n");
            return;
        }

        let interner_ref = cg.cg_interner as &Interner;
        let fn_name = interner_lookup(interner_ref, inst.int_val);

        if unsafe { strcmp(fn_name as *const u8, "println" as *const u8) == 0 } {
            let mut arg_reg: i64 = 0;
            if inst.args.len > 0 {
                let first_arg = vec_get(&inst.args, 0);
                arg_reg = emit_tir_op(cg, first_arg);
            }
            emit_str(cg, "    call void @tungsten_println_i64(i64 %t");
            emit_i64(cg, arg_reg);
            emit_str(cg, ")\n");
            if inst.sym != 0 {
                emit_str(cg, "    %t");
                emit_i64(cg, inst.sym);
                emit_str(cg, " = add i64 0, 0\n");
            }
            return;
        }

        let mut arg_regs: Vec<i64> = vec_new_in(cg.cg_arena);
        let mut i: i64 = 0;
        while i < inst.args.len {
            let arg_op = vec_get(&inst.args, i);
            let ar = emit_tir_op(cg, arg_op);
            vec_push(&mut arg_regs, ar);
            i = i + 1;
        }

        let mut dest_reg = inst.sym;
        if dest_reg == 0 {
            dest_reg = alloc_reg(cg);
        }

        if unsafe { strcmp(fn_name as *const u8, "puts" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let r32 = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r32);
            emit_str(cg, " = call i32 @puts(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ")\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = sext i32 %t");
            emit_i64(cg, r32);
            emit_str(cg, " to i64\n");
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "strlen" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = call i64 @strlen(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ")\n");
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "strcmp" as *const u8) == 0 } {
            let p1_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p1_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let p2_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p2_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, " to ptr\n");

            let r32 = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, r32);
            emit_str(cg, " = call i32 @strcmp(ptr %t");
            emit_i64(cg, p1_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, p2_reg);
            emit_str(cg, ")\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = sext i32 %t");
            emit_i64(cg, r32);
            emit_str(cg, " to i64\n");
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "memset" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let val32 = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, val32);
            emit_str(cg, " = trunc i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, " to i32\n");

            let ptr_res = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, ptr_res);
            emit_str(cg, " = call ptr @memset(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ", i32 %t");
            emit_i64(cg, val32);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 2));
            emit_str(cg, ")\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, ptr_res);
            emit_str(cg, " to i64\n");
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "free" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            emit_str(cg, "    call void @free(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ")\n");
            if inst.sym != 0 {
                emit_str(cg, "    %t");
                emit_i64(cg, inst.sym);
                emit_str(cg, " = add i64 0, 0\n");
            }
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "GetCommandLineA" as *const u8) == 0 } {
            let ptr_res = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, ptr_res);
            emit_str(cg, " = call ptr @GetCommandLineA()\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, ptr_res);
            emit_str(cg, " to i64\n");
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "tungsten_region_alloc" as *const u8) == 0 } {
            let a_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, a_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let res_ptr = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " = call ptr @tungsten_region_alloc(ptr %t");
            emit_i64(cg, a_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 2));
            emit_str(cg, ")\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " to i64\n");
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "tungsten_region_grow" as *const u8) == 0 } {
            let a_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, a_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, " to ptr\n");

            let res_ptr = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " = call ptr @tungsten_region_grow(ptr %t");
            emit_i64(cg, a_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 2));
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 3));
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 4));
            emit_str(cg, ")\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " to i64\n");
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "tungsten_alloc" as *const u8) == 0 } {
            let res_ptr = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " = call ptr @tungsten_alloc(i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, ")\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " to i64\n");
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "fs_read_to_string_in" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let a_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, a_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, " to ptr\n");

            let res_ptr = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " = call ptr @tungsten_fs_read_file_in(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, a_reg);
            emit_str(cg, ")\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = ptrtoint ptr %t");
            emit_i64(cg, res_ptr);
            emit_str(cg, " to i64\n");
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "fs_write_string" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let c_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, c_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, " to ptr\n");

            let b_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " = call i1 @tungsten_fs_write_file(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, c_reg);
            emit_str(cg, ")\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = zext i1 %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " to i64\n");
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "fs_exists" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let b_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " = call i1 @tungsten_fs_file_exists(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ")\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = zext i1 %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " to i64\n");
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "process_exec" as *const u8) == 0 } {
            let p_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, p_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let a_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, a_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, " to ptr\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = call i64 @tungsten_process_exec(ptr %t");
            emit_i64(cg, p_reg);
            emit_str(cg, ", ptr %t");
            emit_i64(cg, a_reg);
            emit_str(cg, ")\n");
            return;
        }

        if unsafe { strcmp(fn_name as *const u8, "report_err" as *const u8) == 0 } {
            let m_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, m_reg);
            emit_str(cg, " = inttoptr i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 0));
            emit_str(cg, " to ptr\n");

            let b_reg = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " = call i1 @tungsten_report_error(ptr %t");
            emit_i64(cg, m_reg);
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 1));
            emit_str(cg, ", i64 %t");
            emit_i64(cg, vec_get(&arg_regs, 2));
            emit_str(cg, ")\n");

            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = zext i1 %t");
            emit_i64(cg, b_reg);
            emit_str(cg, " to i64\n");
            return;
        }

        // Generic user function call
        emit_str(cg, "    %t");
        emit_i64(cg, dest_reg);
        emit_str(cg, " = call i64 @");
        emit_str(cg, fn_name);
        emit_str(cg, "(");
        i = 0;
        while i < arg_regs.len {
            if i > 0 {
                emit_str(cg, ", ");
            }
            emit_str(cg, "i64 %t");
            emit_i64(cg, vec_get(&arg_regs, i));
            i = i + 1;
        }
        emit_str(cg, ")\n");
        return;
    }

    if kind == tir_inst_continuation_resume() {
        let k_reg = emit_tir_op(cg, inst.left);
        let mut val_reg: i64 = 0;
        if inst.right != (0 as *mut TirOperand) {
            val_reg = emit_tir_op(cg, inst.right);
        }
        let k_ptr = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, k_ptr);
        emit_str(cg, " = inttoptr i64 %t");
        emit_i64(cg, k_reg);
        emit_str(cg, " to ptr\n");

        let res_reg = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, res_reg);
        emit_str(cg, " = call i64 @tungsten_continuation_resume(ptr %t");
        emit_i64(cg, k_ptr);
        emit_str(cg, ", i64 %t");
        emit_i64(cg, val_reg);
        emit_str(cg, ")\n");

        if inst.sym != 0 {
            emit_str(cg, "    %t");
            emit_i64(cg, inst.sym);
            emit_str(cg, " = add i64 0, %t");
            emit_i64(cg, res_reg);
            emit_str(cg, "\n");
        }
        return;
    }

    if kind == tir_inst_handler_push() {
        let h_id = inst.op;
        let eff_sym = inst.int_val;

        emit_str(cg, "    %hframe_");
        emit_i64(cg, h_id);
        emit_str(cg, " = alloca %TungstenHandlerFrame, align 16\n");

        emit_str(cg, "    %hres_");
        emit_i64(cg, h_id);
        emit_str(cg, " = alloca i64\n");

        emit_str(cg, "    call void @tungsten_effect_push_frame(ptr %hframe_");
        emit_i64(cg, h_id);
        emit_str(cg, ", i64 ");
        emit_i64(cg, eff_sym);
        emit_str(cg, ", ptr @__handler_dispatch_");
        emit_i64(cg, h_id);
        emit_str(cg, ")\n");

        let ab_buf = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ab_buf);
        emit_str(cg, " = getelementptr inbounds i8, ptr %hframe_");
        emit_i64(cg, h_id);
        emit_str(cg, ", i64 24\n");

        let sj_res = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, sj_res);
        emit_str(cg, " = call i32 @tungsten_setjmp(ptr %t");
        emit_i64(cg, ab_buf);
        emit_str(cg, ")\n");

        let is_ab = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, is_ab);
        emit_str(cg, " = icmp ne i32 %t");
        emit_i64(cg, sj_res);
        emit_str(cg, ", 0\n");

        emit_str(cg, "    br i1 %t");
        emit_i64(cg, is_ab);
        emit_str(cg, ", label %habort_");
        emit_i64(cg, h_id);
        emit_str(cg, ", label %hbody_");
        emit_i64(cg, h_id);
        emit_str(cg, "\n");

        emit_str(cg, "habort_");
        emit_i64(cg, h_id);
        emit_str(cg, ":\n");
        emit_str(cg, "    call void @tungsten_effect_pop_frame()\n");

        let ab_val_p = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ab_val_p);
        emit_str(cg, " = getelementptr inbounds i8, ptr %hframe_");
        emit_i64(cg, h_id);
        emit_str(cg, ", i64 536\n");

        let ab_val = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ab_val);
        emit_str(cg, " = load i64, ptr %t");
        emit_i64(cg, ab_val_p);
        emit_str(cg, "\n");

        emit_str(cg, "    store i64 %t");
        emit_i64(cg, ab_val);
        emit_str(cg, ", ptr %hres_");
        emit_i64(cg, h_id);
        emit_str(cg, "\n");

        emit_str(cg, "    br label %hafter_");
        emit_i64(cg, h_id);
        emit_str(cg, "\n");

        emit_str(cg, "hbody_");
        emit_i64(cg, h_id);
        emit_str(cg, ":\n");
        return;
    }

    if kind == tir_inst_handler_pop() {
        let h_id = inst.op;

        emit_str(cg, "    call void @tungsten_effect_pop_frame()\n");

        if inst.left != (0 as *mut TirOperand) {
            let b_reg = emit_tir_op(cg, inst.left);
            emit_str(cg, "    store i64 %t");
            emit_i64(cg, b_reg);
            emit_str(cg, ", ptr %hres_");
            emit_i64(cg, h_id);
            emit_str(cg, "\n");
        } else {
            emit_str(cg, "    store i64 0, ptr %hres_");
            emit_i64(cg, h_id);
            emit_str(cg, "\n");
        }

        emit_str(cg, "    br label %hafter_");
        emit_i64(cg, h_id);
        emit_str(cg, "\n");

        emit_str(cg, "hafter_");
        emit_i64(cg, h_id);
        emit_str(cg, ":\n");

        if inst.sym != 0 {
            let loaded = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, loaded);
            emit_str(cg, " = load i64, ptr %hres_");
            emit_i64(cg, h_id);
            emit_str(cg, "\n");

            emit_str(cg, "    %t");
            emit_i64(cg, inst.sym);
            emit_str(cg, " = add i64 0, %t");
            emit_i64(cg, loaded);
            emit_str(cg, "\n");
        }
        return;
    }

    if kind == tir_inst_effect_perform() {
        let eff_sym = inst.int_val;
        let op_sym = inst.op;
        let dest_reg = inst.sym;

        let mut arg_regs: Vec<i64> = vec_new_in(cg.cg_arena);
        let mut ai: i64 = 0;
        while ai < inst.args.len {
            let ar = emit_tir_op(cg, vec_get(&inst.args, ai));
            vec_push(&mut arg_regs, ar);
            ai = ai + 1;
        }

        let cont_ptr = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, cont_ptr);
        emit_str(cg, " = alloca %TungstenContinuation, align 16\n");

        let frame_ptr = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, frame_ptr);
        emit_str(cg, " = call ptr @tungsten_effect_find_handler(i64 ");
        emit_i64(cg, eff_sym);
        emit_str(cg, ")\n");

        emit_str(cg, "    store ptr %t");
        emit_i64(cg, frame_ptr);
        emit_str(cg, ", ptr %t");
        emit_i64(cg, cont_ptr);
        emit_str(cg, "\n");

        let is_res_gep = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, is_res_gep);
        emit_str(cg, " = getelementptr inbounds i8, ptr %t");
        emit_i64(cg, cont_ptr);
        emit_str(cg, ", i64 528\n");
        emit_str(cg, "    store i64 0, ptr %t");
        emit_i64(cg, is_res_gep);
        emit_str(cg, "\n");

        let jbuf_ptr = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, jbuf_ptr);
        emit_str(cg, " = getelementptr inbounds i8, ptr %t");
        emit_i64(cg, cont_ptr);
        emit_str(cg, ", i64 8\n");

        let sj_res = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, sj_res);
        emit_str(cg, " = call i32 @tungsten_setjmp(ptr %t");
        emit_i64(cg, jbuf_ptr);
        emit_str(cg, ")\n");

        let is_first = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, is_first);
        emit_str(cg, " = icmp eq i32 %t");
        emit_i64(cg, sj_res);
        emit_str(cg, ", 0\n");

        let lbl_call = alloc_reg(cg);
        let lbl_res = alloc_reg(cg);
        let lbl_ab = alloc_reg(cg);

        emit_str(cg, "    br i1 %t");
        emit_i64(cg, is_first);
        emit_str(cg, ", label %lbl_pcall_");
        emit_i64(cg, lbl_call);
        emit_str(cg, ", label %lbl_pres_");
        emit_i64(cg, lbl_res);
        emit_str(cg, "\n");

        // Block lbl_pcall: call handler dispatch function
        emit_str(cg, "lbl_pcall_");
        emit_i64(cg, lbl_call);
        emit_str(cg, ":\n");

        let mut num_args = arg_regs.len;
        if num_args == 0 { num_args = 1; }
        let args_buf = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, args_buf);
        emit_str(cg, " = alloca [");
        emit_i64(cg, num_args);
        emit_str(cg, " x i64], align 8\n");

        let mut si: i64 = 0;
        while si < arg_regs.len {
            let arg_gep = alloc_reg(cg);
            emit_str(cg, "    %t");
            emit_i64(cg, arg_gep);
            emit_str(cg, " = getelementptr inbounds i64, ptr %t");
            emit_i64(cg, args_buf);
            emit_str(cg, ", i64 ");
            emit_i64(cg, si);
            emit_str(cg, "\n");
            emit_str(cg, "    store i64 %t");
            emit_i64(cg, vec_get(&arg_regs, si));
            emit_str(cg, ", ptr %t");
            emit_i64(cg, arg_gep);
            emit_str(cg, "\n");
            si = si + 1;
        }

        let disp_gep = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, disp_gep);
        emit_str(cg, " = getelementptr inbounds i8, ptr %t");
        emit_i64(cg, frame_ptr);
        emit_str(cg, ", i64 16\n");
        let disp_fn = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, disp_fn);
        emit_str(cg, " = load ptr, ptr %t");
        emit_i64(cg, disp_gep);
        emit_str(cg, "\n");

        let arm_ret = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, arm_ret);
        emit_str(cg, " = call i64 %t");
        emit_i64(cg, disp_fn);
        emit_str(cg, "(i64 ");
        emit_i64(cg, op_sym);
        emit_str(cg, ", ptr %t");
        emit_i64(cg, cont_ptr);
        emit_str(cg, ", ptr %t");
        emit_i64(cg, args_buf);
        emit_str(cg, ")\n");

        let was_res_val = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, was_res_val);
        emit_str(cg, " = load i64, ptr %t");
        emit_i64(cg, is_res_gep);
        emit_str(cg, "\n");
        let did_res = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, did_res);
        emit_str(cg, " = icmp eq i64 %t");
        emit_i64(cg, was_res_val);
        emit_str(cg, ", 1\n");

        emit_str(cg, "    br i1 %t");
        emit_i64(cg, did_res);
        emit_str(cg, ", label %lbl_pres_");
        emit_i64(cg, lbl_res);
        emit_str(cg, ", label %lbl_pab_");
        emit_i64(cg, lbl_ab);
        emit_str(cg, "\n");

        // Block lbl_pab: abortive handler returned without resume!
        emit_str(cg, "lbl_pab_");
        emit_i64(cg, lbl_ab);
        emit_str(cg, ":\n");
        let ab_val_gep = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ab_val_gep);
        emit_str(cg, " = getelementptr inbounds i8, ptr %t");
        emit_i64(cg, frame_ptr);
        emit_str(cg, ", i64 536\n");
        emit_str(cg, "    store i64 %t");
        emit_i64(cg, arm_ret);
        emit_str(cg, ", ptr %t");
        emit_i64(cg, ab_val_gep);
        emit_str(cg, "\n");
        let ab_buf_gep = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, ab_buf_gep);
        emit_str(cg, " = getelementptr inbounds i8, ptr %t");
        emit_i64(cg, frame_ptr);
        emit_str(cg, ", i64 24\n");
        emit_str(cg, "    call void @tungsten_longjmp(ptr %t");
        emit_i64(cg, ab_buf_gep);
        emit_str(cg, ", i32 1)\n");
        emit_str(cg, "    unreachable\n");

        // Block lbl_pres: resumed via resume(k, val)
        emit_str(cg, "lbl_pres_");
        emit_i64(cg, lbl_res);
        emit_str(cg, ":\n");
        let rval_gep = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, rval_gep);
        emit_str(cg, " = getelementptr inbounds i8, ptr %t");
        emit_i64(cg, cont_ptr);
        emit_str(cg, ", i64 520\n");
        let final_res = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, final_res);
        emit_str(cg, " = load i64, ptr %t");
        emit_i64(cg, rval_gep);
        emit_str(cg, "\n");

        if dest_reg != 0 {
            emit_str(cg, "    %t");
            emit_i64(cg, dest_reg);
            emit_str(cg, " = add i64 0, %t");
            emit_i64(cg, final_res);
            emit_str(cg, "\n");
        }
        return;
    }
}

fn emit_tir_block(cg: &mut Codegen, b: *mut TirBlock, is_main: bool, is_last_block: bool, next_block_id: i64) {
    if b.kind > 0 {
        emit_str(cg, "bb_");
        emit_i64(cg, b.kind);
        emit_str(cg, ":\n");
    }
    let mut ii: i64 = 0;
    while ii < b.args.len {
        let inst = vec_get(&b.args, ii);
        emit_tir_inst(cg, inst);
        ii = ii + 1;
    }

    // Terminator
    let term = b.sym;
    if term == tir_term_return() {
        if b.right != (0 as *mut TirOperand) {
            let ret_reg = emit_tir_op(cg, b.right);
            if is_main {
                let r32 = alloc_reg(cg);
                emit_str(cg, "    %t");
                emit_i64(cg, r32);
                emit_str(cg, " = trunc i64 %t");
                emit_i64(cg, ret_reg);
                emit_str(cg, " to i32\n");
                emit_str(cg, "    ret i32 %t");
                emit_i64(cg, r32);
                emit_str(cg, "\n");
            } else {
                emit_str(cg, "    ret i64 %t");
                emit_i64(cg, ret_reg);
                emit_str(cg, "\n");
            }
        } else {
            if is_main {
                emit_str(cg, "    ret i32 0\n");
            } else {
                emit_str(cg, "    ret i64 0\n");
            }
        }
    } else if term == tir_term_branch() {
        emit_str(cg, "    br label ");
        emit_block_label_ref(cg, b.int_val);
        emit_str(cg, "\n");
    } else if term == tir_term_branch_cond() {
        let cond_reg = emit_tir_op(cg, b.left);
        let c1 = alloc_reg(cg);
        emit_str(cg, "    %t");
        emit_i64(cg, c1);
        emit_str(cg, " = icmp ne i64 %t");
        emit_i64(cg, cond_reg);
        emit_str(cg, ", 0\n");
        emit_str(cg, "    br i1 %t");
        emit_i64(cg, c1);
        emit_str(cg, ", label ");
        emit_block_label_ref(cg, b.int_val);
        emit_str(cg, ", label ");
        emit_block_label_ref(cg, b.op);
        emit_str(cg, "\n");
    } else {
        // Fallthrough
        if is_last_block {
            if is_main {
                emit_str(cg, "    ret i32 0\n");
            } else {
                emit_str(cg, "    ret i64 0\n");
            }
        } else {
            emit_str(cg, "    br label ");
            emit_block_label_ref(cg, next_block_id);
            emit_str(cg, "\n");
        }
    }
}

pub fn emit_tir_function(cg: &mut Codegen, tir_f: *mut TirFunction) {
    let ast_fn = tir_f.left;
    let interner_ref = cg.cg_interner as &Interner;
    let name = interner_lookup(interner_ref, tir_f.sym);
    let is_main = unsafe { strcmp(name as *const u8, "main" as *const u8) == 0 };

    cg.next_reg = tir_f.op + 100;
    cg.allocated_vars = vec_new_in(cg.cg_arena);

    // 1. Record parameter symbols
    let mut pi: i64 = 0;
    while pi < ast_fn.params.len {
        let p_node = vec_get(&ast_fn.params, pi);
        vec_push(&mut cg.allocated_vars, p_node.name_sym);
        pi = pi + 1;
    }

    // 2. Collect local variable symbols from all tir_inst_store and region enter
    let mut bi: i64 = 0;
    while bi < tir_f.args.len {
        let blk = vec_get(&tir_f.args, bi);
        let mut ii: i64 = 0;
        while ii < blk.args.len {
            let inst = vec_get(&blk.args, ii);
            if inst.kind == tir_inst_store() {
                let mut already = false;
                let mut vi: i64 = 0;
                while vi < cg.allocated_vars.len {
                    if vec_get(&cg.allocated_vars, vi) == inst.sym {
                        already = true;
                        break;
                    }
                    vi = vi + 1;
                }
                if !already {
                    vec_push(&mut cg.allocated_vars, inst.sym);
                }
            } else if inst.kind == tir_inst_call() {
                let pstr = inst.str_val as *const u8;
                if unsafe { strcmp(pstr, "tungsten_region_enter" as *const u8) == 0 } {
                    let mut already = false;
                    let mut vi: i64 = 0;
                    while vi < cg.allocated_vars.len {
                        if vec_get(&cg.allocated_vars, vi) == inst.sym {
                            already = true;
                            break;
                        }
                        vi = vi + 1;
                    }
                    if !already {
                        vec_push(&mut cg.allocated_vars, inst.sym);
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    // 3. Emit function signature
    if is_main {
        emit_str(cg, "define i32 @main() {\n");
    } else {
        emit_str(cg, "define i64 @");
        emit_str(cg, name);
        emit_str(cg, "(");
        let mut i: i64 = 0;
        while i < ast_fn.params.len {
            if i > 0 {
                emit_str(cg, ", ");
            }
            emit_str(cg, "i64 %arg_");
            let p_node = vec_get(&ast_fn.params, i);
            emit_sym(cg, p_node.name_sym);
            i = i + 1;
        }
        emit_str(cg, ") {\n");
    }

    // 4. Emit entry block header and allocas
    emit_str(cg, "entry:\n");
    let mut vi: i64 = 0;
    while vi < cg.allocated_vars.len {
        let sym = vec_get(&cg.allocated_vars, vi);
        emit_str(cg, "    %v_");
        emit_sym(cg, sym);
        emit_str(cg, " = alloca i64\n");
        vi = vi + 1;
    }

    // 5. Spill parameters
    pi = 0;
    while pi < ast_fn.params.len {
        let p_node = vec_get(&ast_fn.params, pi);
        emit_str(cg, "    store i64 %arg_");
        emit_sym(cg, p_node.name_sym);
        emit_str(cg, ", ptr %v_");
        emit_sym(cg, p_node.name_sym);
        emit_str(cg, "\n");
        pi = pi + 1;
    }

    // 6. Emit all basic blocks
    bi = 0;
    let total_blocks = tir_f.args.len;
    while bi < total_blocks {
        let blk = vec_get(&tir_f.args, bi);
        let is_last = (bi == total_blocks - 1);
        let mut next_id: i64 = 0;
        if !is_last {
            let next_blk = vec_get(&tir_f.args, bi + 1);
            next_id = next_blk.kind;
        }
        emit_tir_block(cg, blk, is_main, is_last, next_id);
        bi = bi + 1;
    }

    emit_str(cg, "}\n\n");
}

pub fn emit_llvm_ir(tir_mod: *mut TirModule, interner: &mut Interner, arena: *mut u8) -> StringBuffer {
    let mut cg = codegen_new_in(interner, arena);
    let prog_ptr = tir_mod.left;

    // Collect all string literals and handlers from AST
    let mut fi: i64 = 0;
    while fi < prog_ptr.functions.len {
        let f = vec_get(&prog_ptr.functions, fi);
        let mut bi: i64 = 0;
        while bi < f.body.len {
            let stmt = vec_get(&f.body, bi);
            collect_strings_stmt(&mut cg, stmt);
            collect_handlers_stmt(&mut cg, stmt);
            bi = bi + 1;
        }
        fi = fi + 1;
    }

    // Module Header
    emit_str(&mut cg, "; ModuleID = 'tungsten_bootstrap'\n");
    emit_str(&mut cg, "source_filename = \"tungsten_bootstrap.tg\"\n");
    emit_str(&mut cg, "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"\n");
    emit_str(&mut cg, "target triple = \"x86_64-pc-windows-gnu\"\n\n");

    emit_str(&mut cg, "%TungstenHandlerFrame = type { ptr, i64, ptr, [64 x i64], i64 }\n");
    emit_str(&mut cg, "%TungstenContinuation = type { ptr, [64 x i64], i64, i64 }\n");
    emit_str(&mut cg, "@tungsten_top_handler_frame = internal global ptr null\n\n");

    emit_str(&mut cg, "module asm \".globl tungsten_setjmp\"\n");
    emit_str(&mut cg, "module asm \"tungsten_setjmp:\"\n");
    emit_str(&mut cg, "module asm \"    movq (%rsp), %rax\"\n");
    emit_str(&mut cg, "module asm \"    movq %rax, 0(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movq %rsp, 8(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movq %rbp, 16(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movq %rbx, 24(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movq %r12, 32(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movq %r13, 40(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movq %r14, 48(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movq %r15, 56(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movq %rdi, 64(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movq %rsi, 72(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movdqu %xmm6, 80(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movdqu %xmm7, 96(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movdqu %xmm8, 112(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movdqu %xmm9, 128(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movdqu %xmm10, 144(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movdqu %xmm11, 160(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movdqu %xmm12, 176(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movdqu %xmm13, 192(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movdqu %xmm14, 208(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    movdqu %xmm15, 224(%rcx)\"\n");
    emit_str(&mut cg, "module asm \"    xorl %eax, %eax\"\n");
    emit_str(&mut cg, "module asm \"    retq\"\n\n");

    emit_str(&mut cg, "module asm \".globl tungsten_longjmp\"\n");
    emit_str(&mut cg, "module asm \"tungsten_longjmp:\"\n");
    emit_str(&mut cg, "module asm \"    movl %edx, %eax\"\n");
    emit_str(&mut cg, "module asm \"    testl %eax, %eax\"\n");
    emit_str(&mut cg, "module asm \"    jnz 1f\"\n");
    emit_str(&mut cg, "module asm \"    movl $1, %eax\"\n");
    emit_str(&mut cg, "module asm \"1:\"\n");
    emit_str(&mut cg, "module asm \"    movdqu 80(%rcx), %xmm6\"\n");
    emit_str(&mut cg, "module asm \"    movdqu 96(%rcx), %xmm7\"\n");
    emit_str(&mut cg, "module asm \"    movdqu 112(%rcx), %xmm8\"\n");
    emit_str(&mut cg, "module asm \"    movdqu 128(%rcx), %xmm9\"\n");
    emit_str(&mut cg, "module asm \"    movdqu 144(%rcx), %xmm10\"\n");
    emit_str(&mut cg, "module asm \"    movdqu 160(%rcx), %xmm11\"\n");
    emit_str(&mut cg, "module asm \"    movdqu 176(%rcx), %xmm12\"\n");
    emit_str(&mut cg, "module asm \"    movdqu 192(%rcx), %xmm13\"\n");
    emit_str(&mut cg, "module asm \"    movdqu 208(%rcx), %xmm14\"\n");
    emit_str(&mut cg, "module asm \"    movdqu 224(%rcx), %xmm15\"\n");
    emit_str(&mut cg, "module asm \"    movq 72(%rcx), %rsi\"\n");
    emit_str(&mut cg, "module asm \"    movq 64(%rcx), %rdi\"\n");
    emit_str(&mut cg, "module asm \"    movq 56(%rcx), %r15\"\n");
    emit_str(&mut cg, "module asm \"    movq 48(%rcx), %r14\"\n");
    emit_str(&mut cg, "module asm \"    movq 40(%rcx), %r13\"\n");
    emit_str(&mut cg, "module asm \"    movq 32(%rcx), %r12\"\n");
    emit_str(&mut cg, "module asm \"    movq 24(%rcx), %rbx\"\n");
    emit_str(&mut cg, "module asm \"    movq 16(%rcx), %rbp\"\n");
    emit_str(&mut cg, "module asm \"    movq 8(%rcx), %rsp\"\n");
    emit_str(&mut cg, "module asm \"    movq 0(%rcx), %rdx\"\n");
    emit_str(&mut cg, "module asm \"    movq %rdx, (%rsp)\"\n");
    emit_str(&mut cg, "module asm \"    retq\"\n\n");

    // Standard Library C External Declarations
    emit_str(&mut cg, "declare ptr @malloc(i64)\n");
    emit_str(&mut cg, "declare ptr @realloc(ptr, i64)\n");
    emit_str(&mut cg, "declare void @free(ptr)\n");
    emit_str(&mut cg, "declare ptr @memset(ptr, i32, i64)\n");
    emit_str(&mut cg, "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)\n");
    emit_str(&mut cg, "declare i64 @strlen(ptr)\n");
    emit_str(&mut cg, "declare i32 @strcmp(ptr, ptr)\n");
    emit_str(&mut cg, "declare i32 @strncmp(ptr, ptr, i64)\n");
    emit_str(&mut cg, "declare ptr @fopen(ptr, ptr)\n");
    emit_str(&mut cg, "declare i32 @fclose(ptr)\n");
    emit_str(&mut cg, "declare i64 @fread(ptr, i64, i64, ptr)\n");
    emit_str(&mut cg, "declare i64 @fwrite(ptr, i64, i64, ptr)\n");
    emit_str(&mut cg, "declare i32 @fseek(ptr, i64, i32)\n");
    emit_str(&mut cg, "declare i32 @tungsten_setjmp(ptr)\n");
    emit_str(&mut cg, "declare void @tungsten_longjmp(ptr, i32)\n");
    emit_str(&mut cg, "declare i64 @ftell(ptr)\n");
    emit_str(&mut cg, "declare i32 @system(ptr)\n");
    emit_str(&mut cg, "declare ptr @GetCommandLineA()\n");
    emit_str(&mut cg, "declare i32 @printf(ptr, ...)\n");
    emit_str(&mut cg, "declare i32 @puts(ptr)\n");
    emit_str(&mut cg, "declare i32 @fflush(ptr)\n\n");

    // User / Library External Function Declarations
    let mut declared_syms: Vec<i64> = vec_new_in(arena);
    let mut ei: i64 = 0;
    while ei < prog_ptr.extern_fns.len {
        let ef = vec_get(&prog_ptr.extern_fns, ei);
        let ef_name = interner_lookup(interner, ef.name_sym);
        let mut is_builtin = false;
        let pef = ef_name as *const u8;
        let l = unsafe { strlen(pef) } as i64;
        if l >= 9 {
            if unsafe { strncmp(pef, "tungsten_" as *const u8, 9) == 0 } {
                is_builtin = true;
            }
        }
        if !is_builtin {
            unsafe {
                if strcmp(pef, "malloc" as *const u8) == 0 ||
                   strcmp(pef, "realloc" as *const u8) == 0 ||
                   strcmp(pef, "free" as *const u8) == 0 ||
                   strcmp(pef, "memset" as *const u8) == 0 ||
                   strcmp(pef, "strlen" as *const u8) == 0 ||
                   strcmp(pef, "strcmp" as *const u8) == 0 ||
                   strcmp(pef, "strncmp" as *const u8) == 0 ||
                   strcmp(pef, "fopen" as *const u8) == 0 ||
                   strcmp(pef, "fclose" as *const u8) == 0 ||
                   strcmp(pef, "fread" as *const u8) == 0 ||
                   strcmp(pef, "fwrite" as *const u8) == 0 ||
                   strcmp(pef, "fseek" as *const u8) == 0 ||
                   strcmp(pef, "ftell" as *const u8) == 0 ||
                   strcmp(pef, "system" as *const u8) == 0 ||
                   strcmp(pef, "GetCommandLineA" as *const u8) == 0 ||
                   strcmp(pef, "printf" as *const u8) == 0 ||
                   strcmp(pef, "puts" as *const u8) == 0 ||
                   strcmp(pef, "fflush" as *const u8) == 0 {
                    is_builtin = true;
                }
            }
        }
        if !is_builtin {
            let mut already_declared = false;
            let mut di: i64 = 0;
            while di < declared_syms.len {
                if vec_get(&declared_syms, di) == ef.name_sym {
                    already_declared = true;
                    break;
                }
                di = di + 1;
            }
            if !already_declared {
                vec_push(&mut declared_syms, ef.name_sym);
                emit_str(&mut cg, "declare i64 @");
                emit_str(&mut cg, ef_name);
                emit_str(&mut cg, "(");
                let mut pi: i64 = 0;
                while pi < ef.params.len {
                    if pi > 0 {
                        emit_str(&mut cg, ", ");
                    }
                    emit_str(&mut cg, "i64");
                    pi = pi + 1;
                }
                emit_str(&mut cg, ")\n");
            }
        }
        ei = ei + 1;
    }
    emit_str(&mut cg, "\n");

    // Constants & Strings
    emit_str(&mut cg, "@fmt_int = internal constant [6 x i8] c\"%lld\\0A\\00\"\n");
    emit_str(&mut cg, "@fmt_diag_err = internal constant [34 x i8] c\"[ERROR] %s (line %lld, col %lld)\\0A\\00\"\n");
    emit_str(&mut cg, "@str_mode_rb = internal constant [3 x i8] c\"rb\\00\"\n");
    emit_str(&mut cg, "@str_mode_wb = internal constant [3 x i8] c\"wb\\00\"\n");
    emit_str(&mut cg, "@str_empty = internal constant [1 x i8] c\"\\00\"\n");
    emit_str(&mut cg, "@tungsten_diag_errors = internal global i64 0\n\n");


    let mut si: i64 = 0;
    while si < cg.strings.len {
        let s = vec_get(&cg.strings, si);
        let s_len = unsafe { strlen(s as *const u8) } as i64 + 1;
        emit_str(&mut cg, "@str_");
        emit_i64(&mut cg, si);
        emit_str(&mut cg, " = internal constant [");
        emit_i64(&mut cg, s_len);
        emit_str(&mut cg, " x i8] c\"");
        emit_escaped_string(&mut cg, s);
        emit_str(&mut cg, "\\00\"\n");
        si = si + 1;
    }
    emit_str(&mut cg, "\n");

    // Runtime Implementation
    emit_str(&mut cg, "define void @tungsten_println_i64(i64 %n) {\n");
    emit_str(&mut cg, "    call i32 (ptr, ...) @printf(ptr @fmt_int, i64 %n)\n");
    emit_str(&mut cg, "    call i32 @fflush(ptr null)\n");
    emit_str(&mut cg, "    ret void\n}\n\n");

    emit_str(&mut cg, "define i64 @tungsten_diag_reset() {\n");
    emit_str(&mut cg, "    store i64 0, ptr @tungsten_diag_errors\n");
    emit_str(&mut cg, "    ret i64 0\n}\n\n");

    emit_str(&mut cg, "define i64 @tungsten_diag_inc_error() {\n");
    emit_str(&mut cg, "    %cur = load i64, ptr @tungsten_diag_errors\n");
    emit_str(&mut cg, "    %inc = add i64 %cur, 1\n");
    emit_str(&mut cg, "    store i64 %inc, ptr @tungsten_diag_errors\n");
    emit_str(&mut cg, "    ret i64 %inc\n}\n\n");

    emit_str(&mut cg, "define i64 @tungsten_diag_get_errors() {\n");
    emit_str(&mut cg, "    %cur = load i64, ptr @tungsten_diag_errors\n");
    emit_str(&mut cg, "    ret i64 %cur\n}\n\n");

    emit_str(&mut cg, "define i1 @tungsten_report_error(ptr %msg, i64 %line, i64 %col) {\n");
    emit_str(&mut cg, "    call i64 @tungsten_diag_inc_error()\n");
    emit_str(&mut cg, "    call i32 @puts(ptr %msg)\n");
    emit_str(&mut cg, "    call i32 @fflush(ptr null)\n");
    emit_str(&mut cg, "    ret i1 true\n}\n\n");

    emit_str(&mut cg, "define ptr @tungsten_alloc(i64 %size, i64 %align) {\n");
    emit_str(&mut cg, "    %is_zero = icmp eq i64 %size, 0\n");
    emit_str(&mut cg, "    %alloc_sz = select i1 %is_zero, i64 8, i64 %size\n");
    emit_str(&mut cg, "    %p = call ptr @malloc(i64 %alloc_sz)\n");
    emit_str(&mut cg, "    ret ptr %p\n}\n\n");

    emit_str(&mut cg, "define ptr @tungsten_region_enter() {\n");
    emit_str(&mut cg, "    %arena = call ptr @malloc(i64 32)\n");
    emit_str(&mut cg, "    %init_cap = add i64 16777216, 0\n");
    emit_str(&mut cg, "    %chunk_total = add i64 %init_cap, 16\n");
    emit_str(&mut cg, "    %chunk = call ptr @malloc(i64 %chunk_total)\n");
    emit_str(&mut cg, "    store ptr null, ptr %chunk\n");
    emit_str(&mut cg, "    %data_buf = getelementptr inbounds i8, ptr %chunk, i64 16\n");
    emit_str(&mut cg, "    store ptr %data_buf, ptr %arena\n");
    emit_str(&mut cg, "    %offset_ptr = getelementptr inbounds i8, ptr %arena, i64 8\n");
    emit_str(&mut cg, "    store i64 0, ptr %offset_ptr\n");
    emit_str(&mut cg, "    %cap_ptr = getelementptr inbounds i8, ptr %arena, i64 16\n");
    emit_str(&mut cg, "    store i64 %init_cap, ptr %cap_ptr\n");
    emit_str(&mut cg, "    %chunk_list_ptr = getelementptr inbounds i8, ptr %arena, i64 24\n");
    emit_str(&mut cg, "    store ptr %chunk, ptr %chunk_list_ptr\n");
    emit_str(&mut cg, "    ret ptr %arena\n}\n\n");

    emit_str(&mut cg, "define ptr @tungsten_region_alloc(ptr %arena, i64 %size, i64 %align) {\n");
    emit_str(&mut cg, "entry:\n");
    emit_str(&mut cg, "    %is_null = icmp eq ptr %arena, null\n");
    emit_str(&mut cg, "    br i1 %is_null, label %null_arena, label %check_alloc\n");
    emit_str(&mut cg, "null_arena:\n");
    emit_str(&mut cg, "    %hp = call ptr @tungsten_alloc(i64 %size, i64 %align)\n");
    emit_str(&mut cg, "    ret ptr %hp\n");
    emit_str(&mut cg, "check_alloc:\n");
    emit_str(&mut cg, "    %align_cmp = icmp slt i64 %align, 8\n");
    emit_str(&mut cg, "    %eff_align = select i1 %align_cmp, i64 8, i64 %align\n");
    emit_str(&mut cg, "    %mask = sub i64 %eff_align, 1\n");
    emit_str(&mut cg, "    %off_ptr = getelementptr inbounds i8, ptr %arena, i64 8\n");
    emit_str(&mut cg, "    %cur_off = load i64, ptr %off_ptr\n");
    emit_str(&mut cg, "    %cur_buf_ptr = load ptr, ptr %arena\n");
    emit_str(&mut cg, "    %add_mask = add i64 %cur_off, %mask\n");
    emit_str(&mut cg, "    %not_mask = xor i64 %mask, -1\n");
    emit_str(&mut cg, "    %aligned_off = and i64 %add_mask, %not_mask\n");
    emit_str(&mut cg, "    %new_off = add i64 %aligned_off, %size\n");
    emit_str(&mut cg, "    %cap_ptr = getelementptr inbounds i8, ptr %arena, i64 16\n");
    emit_str(&mut cg, "    %cur_cap = load i64, ptr %cap_ptr\n");
    emit_str(&mut cg, "    %fits = icmp sle i64 %new_off, %cur_cap\n");
    emit_str(&mut cg, "    br i1 %fits, label %bump, label %new_chunk\n");
    emit_str(&mut cg, "bump:\n");
    emit_str(&mut cg, "    store i64 %new_off, ptr %off_ptr\n");
    emit_str(&mut cg, "    %res_ptr = getelementptr inbounds i8, ptr %cur_buf_ptr, i64 %aligned_off\n");
    emit_str(&mut cg, "    ret ptr %res_ptr\n");
    emit_str(&mut cg, "new_chunk:\n");
    emit_str(&mut cg, "    %double_cap = mul i64 %cur_cap, 2\n");
    emit_str(&mut cg, "    %req_cap = add i64 %size, 1024\n");
    emit_str(&mut cg, "    %is_double_bigger = icmp sgt i64 %double_cap, %req_cap\n");
    emit_str(&mut cg, "    %chunk_cap = select i1 %is_double_bigger, i64 %double_cap, i64 %req_cap\n");
    emit_str(&mut cg, "    %chunk_alloc_sz = add i64 %chunk_cap, 16\n");
    emit_str(&mut cg, "    %fresh_chunk = call ptr @malloc(i64 %chunk_alloc_sz)\n");
    emit_str(&mut cg, "    %chunk_list_ptr = getelementptr inbounds i8, ptr %arena, i64 24\n");
    emit_str(&mut cg, "    %old_chunk_list = load ptr, ptr %chunk_list_ptr\n");
    emit_str(&mut cg, "    store ptr %old_chunk_list, ptr %fresh_chunk\n");
    emit_str(&mut cg, "    store ptr %fresh_chunk, ptr %chunk_list_ptr\n");
    emit_str(&mut cg, "    %fresh_buf = getelementptr inbounds i8, ptr %fresh_chunk, i64 16\n");
    emit_str(&mut cg, "    store ptr %fresh_buf, ptr %arena\n");
    emit_str(&mut cg, "    store i64 %size, ptr %off_ptr\n");
    emit_str(&mut cg, "    store i64 %chunk_cap, ptr %cap_ptr\n");
    emit_str(&mut cg, "    ret ptr %fresh_buf\n}\n\n");

    emit_str(&mut cg, "define ptr @tungsten_region_grow(ptr %arena, ptr %ptr, i64 %old_sz, i64 %new_sz, i64 %align) {\n");
    emit_str(&mut cg, "entry:\n");
    emit_str(&mut cg, "    %is_null = icmp eq ptr %arena, null\n");
    emit_str(&mut cg, "    br i1 %is_null, label %heap_realloc, label %check_in_place\n");
    emit_str(&mut cg, "heap_realloc:\n");
    emit_str(&mut cg, "    %is_ptr_null = icmp eq ptr %ptr, null\n");
    emit_str(&mut cg, "    br i1 %is_ptr_null, label %heap_malloc, label %do_realloc\n");
    emit_str(&mut cg, "heap_malloc:\n");
    emit_str(&mut cg, "    %m_ptr = call ptr @malloc(i64 %new_sz)\n");
    emit_str(&mut cg, "    ret ptr %m_ptr\n");
    emit_str(&mut cg, "do_realloc:\n");
    emit_str(&mut cg, "    %r_ptr = call ptr @realloc(ptr %ptr, i64 %new_sz)\n");
    emit_str(&mut cg, "    ret ptr %r_ptr\n");
    emit_str(&mut cg, "check_in_place:\n");
    emit_str(&mut cg, "    %cur_buf = load ptr, ptr %arena\n");
    emit_str(&mut cg, "    %off_ptr = getelementptr inbounds i8, ptr %arena, i64 8\n");
    emit_str(&mut cg, "    %cur_off = load i64, ptr %off_ptr\n");
    emit_str(&mut cg, "    %cap_ptr = getelementptr inbounds i8, ptr %arena, i64 16\n");
    emit_str(&mut cg, "    %cur_cap = load i64, ptr %cap_ptr\n");
    emit_str(&mut cg, "    %cur_top = getelementptr inbounds i8, ptr %cur_buf, i64 %cur_off\n");
    emit_str(&mut cg, "    %end_of_alloc = getelementptr inbounds i8, ptr %ptr, i64 %old_sz\n");
    emit_str(&mut cg, "    %is_last = icmp eq ptr %end_of_alloc, %cur_top\n");
    emit_str(&mut cg, "    %is_ge_buf = icmp uge ptr %ptr, %cur_buf\n");
    emit_str(&mut cg, "    %can_in_place = and i1 %is_last, %is_ge_buf\n");
    emit_str(&mut cg, "    br i1 %can_in_place, label %check_capacity, label %fallback_alloc\n");
    emit_str(&mut cg, "check_capacity:\n");
    emit_str(&mut cg, "    %diff = sub i64 %new_sz, %old_sz\n");
    emit_str(&mut cg, "    %new_off = add i64 %cur_off, %diff\n");
    emit_str(&mut cg, "    %has_room = icmp sle i64 %new_off, %cur_cap\n");
    emit_str(&mut cg, "    br i1 %has_room, label %grow_in_place, label %fallback_alloc\n");
    emit_str(&mut cg, "grow_in_place:\n");
    emit_str(&mut cg, "    store i64 %new_off, ptr %off_ptr\n");
    emit_str(&mut cg, "    ret ptr %ptr\n");
    emit_str(&mut cg, "fallback_alloc:\n");
    emit_str(&mut cg, "    %new_buf = call ptr @tungsten_region_alloc(ptr %arena, i64 %new_sz, i64 %align)\n");
    emit_str(&mut cg, "    %not_null = icmp ne ptr %ptr, null\n");
    emit_str(&mut cg, "    br i1 %not_null, label %do_copy, label %done_grow\n");
    emit_str(&mut cg, "do_copy:\n");
    emit_str(&mut cg, "    %has_old = icmp sgt i64 %old_sz, 0\n");
    emit_str(&mut cg, "    br i1 %has_old, label %copy_bytes, label %done_grow\n");
    emit_str(&mut cg, "copy_bytes:\n");
    emit_str(&mut cg, "    call void @llvm.memcpy.p0.p0.i64(ptr %new_buf, ptr %ptr, i64 %old_sz, i1 false)\n");
    emit_str(&mut cg, "    br label %done_grow\n");
    emit_str(&mut cg, "done_grow:\n");
    emit_str(&mut cg, "    ret ptr %new_buf\n}\n\n");

    emit_str(&mut cg, "define void @tungsten_region_exit(ptr %arena) {\n");
    emit_str(&mut cg, "entry:\n");
    emit_str(&mut cg, "    %is_null = icmp eq ptr %arena, null\n");
    emit_str(&mut cg, "    br i1 %is_null, label %done, label %init_free\n");
    emit_str(&mut cg, "init_free:\n");
    emit_str(&mut cg, "    %chunk_list_ptr = getelementptr inbounds i8, ptr %arena, i64 24\n");
    emit_str(&mut cg, "    %first_chunk = load ptr, ptr %chunk_list_ptr\n");
    emit_str(&mut cg, "    br label %loop_cond\n");
    emit_str(&mut cg, "loop_cond:\n");
    emit_str(&mut cg, "    %cur_chunk = phi ptr [ %first_chunk, %init_free ], [ %next_chunk, %loop_body ]\n");
    emit_str(&mut cg, "    %chunk_is_null = icmp eq ptr %cur_chunk, null\n");
    emit_str(&mut cg, "    br i1 %chunk_is_null, label %free_arena, label %loop_body\n");
    emit_str(&mut cg, "loop_body:\n");
    emit_str(&mut cg, "    %next_chunk = load ptr, ptr %cur_chunk\n");
    emit_str(&mut cg, "    call void @free(ptr %cur_chunk)\n");
    emit_str(&mut cg, "    br label %loop_cond\n");
    emit_str(&mut cg, "free_arena:\n");
    emit_str(&mut cg, "    call void @free(ptr %arena)\n");
    emit_str(&mut cg, "    br label %done\n");
    emit_str(&mut cg, "done:\n");
    emit_str(&mut cg, "    ret void\n}\n\n");

    emit_str(&mut cg, "define ptr @tungsten_fs_read_file_in(ptr %path, ptr %arena) {\n");
    emit_str(&mut cg, "    %fp = call ptr @fopen(ptr %path, ptr @str_mode_rb)\n");
    emit_str(&mut cg, "    %is_null = icmp eq ptr %fp, null\n");
    emit_str(&mut cg, "    br i1 %is_null, label %ret_empty, label %read_content\n");
    emit_str(&mut cg, "ret_empty:\n");
    emit_str(&mut cg, "    ret ptr @str_empty\n");
    emit_str(&mut cg, "read_content:\n");
    emit_str(&mut cg, "    call i32 @fseek(ptr %fp, i64 0, i32 2)\n");
    emit_str(&mut cg, "    %sz = call i64 @ftell(ptr %fp)\n");
    emit_str(&mut cg, "    call i32 @fseek(ptr %fp, i64 0, i32 0)\n");
    emit_str(&mut cg, "    %buf_sz = add i64 %sz, 1\n");
    emit_str(&mut cg, "    %is_arena_null = icmp eq ptr %arena, null\n");
    emit_str(&mut cg, "    br i1 %is_arena_null, label %alloc_heap, label %alloc_arena\n");
    emit_str(&mut cg, "alloc_heap:\n");
    emit_str(&mut cg, "    %h_buf = call ptr @malloc(i64 %buf_sz)\n");
    emit_str(&mut cg, "    br label %do_read\n");
    emit_str(&mut cg, "alloc_arena:\n");
    emit_str(&mut cg, "    %a_buf = call ptr @tungsten_region_alloc(ptr %arena, i64 %buf_sz, i64 8)\n");
    emit_str(&mut cg, "    br label %do_read\n");
    emit_str(&mut cg, "do_read:\n");
    emit_str(&mut cg, "    %buf = phi ptr [ %h_buf, %alloc_heap ], [ %a_buf, %alloc_arena ]\n");
    emit_str(&mut cg, "    %n = call i64 @fread(ptr %buf, i64 1, i64 %sz, ptr %fp)\n");
    emit_str(&mut cg, "    call i32 @fclose(ptr %fp)\n");
    emit_str(&mut cg, "    %term = getelementptr inbounds i8, ptr %buf, i64 %n\n");
    emit_str(&mut cg, "    store i8 0, ptr %term\n");
    emit_str(&mut cg, "    ret ptr %buf\n}\n\n");

    emit_str(&mut cg, "define i1 @tungsten_fs_write_file(ptr %path, ptr %content) {\n");
    emit_str(&mut cg, "    %fp = call ptr @fopen(ptr %path, ptr @str_mode_wb)\n");
    emit_str(&mut cg, "    %is_null = icmp eq ptr %fp, null\n");
    emit_str(&mut cg, "    br i1 %is_null, label %fail, label %write_bytes\n");
    emit_str(&mut cg, "write_bytes:\n");
    emit_str(&mut cg, "    %len = call i64 @strlen(ptr %content)\n");
    emit_str(&mut cg, "    call i64 @fwrite(ptr %content, i64 1, i64 %len, ptr %fp)\n");
    emit_str(&mut cg, "    call i32 @fclose(ptr %fp)\n");
    emit_str(&mut cg, "    ret i1 true\n");
    emit_str(&mut cg, "fail:\n");
    emit_str(&mut cg, "    ret i1 false\n}\n\n");

    emit_str(&mut cg, "define i1 @tungsten_fs_file_exists(ptr %path) {\n");
    emit_str(&mut cg, "    %fp = call ptr @fopen(ptr %path, ptr @str_mode_rb)\n");
    emit_str(&mut cg, "    %is_null = icmp eq ptr %fp, null\n");
    emit_str(&mut cg, "    br i1 %is_null, label %not_exists, label %exists\n");
    emit_str(&mut cg, "exists:\n");
    emit_str(&mut cg, "    call i32 @fclose(ptr %fp)\n");
    emit_str(&mut cg, "    ret i1 true\n");
    emit_str(&mut cg, "not_exists:\n");
    emit_str(&mut cg, "    ret i1 false\n}\n\n");

    emit_str(&mut cg, "define i64 @tungsten_process_exec(ptr %cmd, ptr %args) {\n");
    emit_str(&mut cg, "    %is_args_null = icmp eq ptr %args, null\n");
    emit_str(&mut cg, "    br i1 %is_args_null, label %run_simple, label %check_args_empty\n");
    emit_str(&mut cg, "check_args_empty:\n");
    emit_str(&mut cg, "    %args_len = call i64 @strlen(ptr %args)\n");
    emit_str(&mut cg, "    %is_empty = icmp eq i64 %args_len, 0\n");
    emit_str(&mut cg, "    br i1 %is_empty, label %run_simple, label %build_cmd\n");
    emit_str(&mut cg, "build_cmd:\n");
    emit_str(&mut cg, "    %cmd_len = call i64 @strlen(ptr %cmd)\n");
    emit_str(&mut cg, "    %total = add i64 %cmd_len, %args_len\n");
    emit_str(&mut cg, "    %total_plus_2 = add i64 %total, 2\n");
    emit_str(&mut cg, "    %full_buf = call ptr @malloc(i64 %total_plus_2)\n");
    emit_str(&mut cg, "    call void @llvm.memcpy.p0.p0.i64(ptr %full_buf, ptr %cmd, i64 %cmd_len, i1 false)\n");
    emit_str(&mut cg, "    %space_ptr = getelementptr inbounds i8, ptr %full_buf, i64 %cmd_len\n");
    emit_str(&mut cg, "    store i8 32, ptr %space_ptr\n");
    emit_str(&mut cg, "    %args_dest = getelementptr inbounds i8, ptr %space_ptr, i64 1\n");
    emit_str(&mut cg, "    call void @llvm.memcpy.p0.p0.i64(ptr %args_dest, ptr %args, i64 %args_len, i1 false)\n");
    emit_str(&mut cg, "    %term_ptr = getelementptr inbounds i8, ptr %args_dest, i64 %args_len\n");
    emit_str(&mut cg, "    store i8 0, ptr %term_ptr\n");
    emit_str(&mut cg, "    %res_code = call i32 @system(ptr %full_buf)\n");
    emit_str(&mut cg, "    call void @free(ptr %full_buf)\n");
    emit_str(&mut cg, "    %res_i64 = sext i32 %res_code to i64\n");
    emit_str(&mut cg, "    ret i64 %res_i64\n");
    emit_str(&mut cg, "run_simple:\n");
    emit_str(&mut cg, "    %res_code_simple = call i32 @system(ptr %cmd)\n");
    emit_str(&mut cg, "    %res_simple_i64 = sext i32 %res_code_simple to i64\n");
    emit_str(&mut cg, "    ret i64 %res_simple_i64\n}\n\n");

    // Algebraic Effect Runtime Helpers
    emit_str(&mut cg, "define void @tungsten_effect_push_frame(ptr %frame, i64 %effect_sym, ptr %dispatch_fn) {\nentry:\n");
    emit_str(&mut cg, "    %prev = load ptr, ptr @tungsten_top_handler_frame\n");
    emit_str(&mut cg, "    store ptr %prev, ptr %frame\n");
    emit_str(&mut cg, "    %gep_eff = getelementptr inbounds i8, ptr %frame, i64 8\n");
    emit_str(&mut cg, "    store i64 %effect_sym, ptr %gep_eff\n");
    emit_str(&mut cg, "    %gep_disp = getelementptr inbounds i8, ptr %frame, i64 16\n");
    emit_str(&mut cg, "    store ptr %dispatch_fn, ptr %gep_disp\n");
    emit_str(&mut cg, "    store ptr %frame, ptr @tungsten_top_handler_frame\n");
    emit_str(&mut cg, "    ret void\n}\n\n");

    emit_str(&mut cg, "define void @tungsten_effect_pop_frame() {\nentry:\n");
    emit_str(&mut cg, "    %top = load ptr, ptr @tungsten_top_handler_frame\n");
    emit_str(&mut cg, "    %is_null = icmp eq ptr %top, null\n");
    emit_str(&mut cg, "    br i1 %is_null, label %done, label %pop\npop:\n");
    emit_str(&mut cg, "    %prev = load ptr, ptr %top\n");
    emit_str(&mut cg, "    store ptr %prev, ptr @tungsten_top_handler_frame\n");
    emit_str(&mut cg, "    br label %done\ndone:\n    ret void\n}\n\n");

    emit_str(&mut cg, "define ptr @tungsten_effect_find_handler(i64 %effect_sym) {\nentry:\n");
    emit_str(&mut cg, "    %cur = load ptr, ptr @tungsten_top_handler_frame\n");
    emit_str(&mut cg, "    br label %loop\nloop:\n");
    emit_str(&mut cg, "    %p = phi ptr [ %cur, %entry ], [ %next, %check_next ]\n");
    emit_str(&mut cg, "    %is_null = icmp eq ptr %p, null\n");
    emit_str(&mut cg, "    br i1 %is_null, label %not_found, label %check_eff\ncheck_eff:\n");
    emit_str(&mut cg, "    %gep_eff = getelementptr inbounds i8, ptr %p, i64 8\n");
    emit_str(&mut cg, "    %cur_eff = load i64, ptr %gep_eff\n");
    emit_str(&mut cg, "    %match = icmp eq i64 %cur_eff, %effect_sym\n");
    emit_str(&mut cg, "    br i1 %match, label %found, label %check_next\ncheck_next:\n");
    emit_str(&mut cg, "    %next = load ptr, ptr %p\n");
    emit_str(&mut cg, "    br label %loop\nfound:\n    ret ptr %p\nnot_found:\n    ret ptr null\n}\n\n");

    emit_str(&mut cg, "define i64 @tungsten_continuation_resume(ptr %cont, i64 %val) {\nentry:\n");
    emit_str(&mut cg, "    %gep_resumed = getelementptr inbounds i8, ptr %cont, i64 528\n");
    emit_str(&mut cg, "    store i64 1, ptr %gep_resumed\n");
    emit_str(&mut cg, "    %gep_rval = getelementptr inbounds i8, ptr %cont, i64 520\n");
    emit_str(&mut cg, "    store i64 %val, ptr %gep_rval\n");
    emit_str(&mut cg, "    %gep_jbuf = getelementptr inbounds i8, ptr %cont, i64 8\n");
    emit_str(&mut cg, "    call void @tungsten_longjmp(ptr %gep_jbuf, i32 1)\n");
    emit_str(&mut cg, "    ret i64 0\n}\n\n");

    // Handler dispatch functions
    let mut hi: i64 = 0;
    while hi < cg.handlers.len {
        let handler = vec_get(&cg.handlers, hi);
        emit_str(&mut cg, "define i64 @__handler_dispatch_");
        emit_i64(&mut cg, handler.id);
        emit_str(&mut cg, "(i64 %op_sym, ptr %cont, ptr %args) {\nentry:\n");
        emit_str(&mut cg, "    %k = ptrtoint ptr %cont to i64\n");
        let mut ai: i64 = 0;
        while ai < handler.arms.len {
            let arm = vec_get(&handler.arms, ai);
            emit_str(&mut cg, "    %match_");
            emit_i64(&mut cg, ai);
            emit_str(&mut cg, " = icmp eq i64 %op_sym, ");
            emit_i64(&mut cg, arm.op_sym);
            emit_str(&mut cg, "\n");
            emit_str(&mut cg, "    br i1 %match_");
            emit_i64(&mut cg, ai);
            emit_str(&mut cg, ", label %arm_");
            emit_i64(&mut cg, ai);
            emit_str(&mut cg, ", label %next_");
            emit_i64(&mut cg, ai);
            emit_str(&mut cg, "\n");

            emit_str(&mut cg, "arm_");
            emit_i64(&mut cg, ai);
            emit_str(&mut cg, ":\n");

            let mut arg_regs: Vec<i64> = vec_new_in(cg.cg_arena);
            let mut pi: i64 = 0;
            while pi < arm.params.len {
                let gep_r = alloc_reg(&mut cg);
                let r = alloc_reg(&mut cg);
                emit_str(&mut cg, "    %t");
                emit_i64(&mut cg, gep_r);
                emit_str(&mut cg, " = getelementptr inbounds i64, ptr %args, i64 ");
                emit_i64(&mut cg, pi);
                emit_str(&mut cg, "\n");
                emit_str(&mut cg, "    %t");
                emit_i64(&mut cg, r);
                emit_str(&mut cg, " = load i64, ptr %t");
                emit_i64(&mut cg, gep_r);
                emit_str(&mut cg, "\n");
                vec_push(&mut arg_regs, r);
                pi = pi + 1;
            }

            let res_r = alloc_reg(&mut cg);
            emit_str(&mut cg, "    %t");
            emit_i64(&mut cg, res_r);
            emit_str(&mut cg, " = call i64 @");
            emit_sym(&mut cg, arm.fn_sym);
            emit_str(&mut cg, "(i64 %k");
            let mut j: i64 = 0;
            while j < arg_regs.len {
                emit_str(&mut cg, ", i64 %t");
                emit_i64(&mut cg, vec_get(&arg_regs, j));
                j = j + 1;
            }
            emit_str(&mut cg, ")\n");
            emit_str(&mut cg, "    ret i64 %t");
            emit_i64(&mut cg, res_r);
            emit_str(&mut cg, "\n");

            emit_str(&mut cg, "next_");
            emit_i64(&mut cg, ai);
            emit_str(&mut cg, ":\n");
            ai = ai + 1;
        }
        emit_str(&mut cg, "    ret i64 0\n}\n\n");
        hi = hi + 1;
    }

    // Emit all functions from TIR module
    let mut i: i64 = 0;
    while i < tir_mod.args.len {
        emit_tir_function(&mut cg, vec_get(&tir_mod.args, i));
        i = i + 1;
    }

    cg.buf
}

// Tungsten Self-Hosting Compiler - Diagnostics Reporting
// Decoupled compiler warning and error handling via algebraic effects

extern "C" {
    fn puts(s: *const u8): i32;
    fn printf(fmt: *const u8, msg: *const u8, line: i64, col: i64): i32;
    fn fflush(f: *const u8): i32;
    fn morrow_diag_reset(): i64;
    fn morrow_diag_inc_error(): i64;
    fn morrow_diag_get_errors(): i64;
    fn morrow_diag_last_message(): *const u8;
}

// Primary (first) diagnostic of the current pass. The runtime reports summary
// errors last ("Module loading or parsing failed"), so tests assert on the first
// message to see the specific cause.
pub fn diag_primary_message() -> String {
    let p = unsafe { morrow_diag_last_message() };
    p as String
}

pub fn diag_reset() {
    unsafe {
        morrow_diag_reset();
    }
}

pub fn diag_errors(): i64 {
    unsafe {
        morrow_diag_get_errors()
    }
}

pub fn diag_has_errors(): bool {
    unsafe {
        morrow_diag_get_errors() > 0
    }
}

pub fn report_err(msg: String, line: i64, col: i64): bool yields [Diagnostics] {
    unsafe {
        morrow_diag_inc_error();
        printf("[ERROR] %s (line %lld, col %lld)\n" as *const u8, msg as *const u8, line, col);
        fflush(0 as *const u8);
    }
    true
}

pub fn report_warn(msg: String, line: i64, col: i64): bool yields [Diagnostics] {
    unsafe {
        printf("[WARN] %s (line %lld, col %lld)\n" as *const u8, msg as *const u8, line, col);
        fflush(0 as *const u8);
    }
    true
}

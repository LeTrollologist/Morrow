// Tungsten Self-Hosting Compiler - Unified Developer CLI (forge.tg)
// Pure Tungsten toolchain manager: check, build, run, test, fmt, lsp, new, clean

import std::collections;
import std::fs;
import std::process;
import compiler::diagnostics;
import compiler::interner;
import compiler::ast;
import compiler::lexer;
import compiler::parser;
import compiler::typeck;
import compiler::tir;
import compiler::opt;
import compiler::codegen;
import compiler::fmt;
import compiler::package;
import compiler::json;
import compiler::lsp;

extern "C" {
    fn strlen(s: *const u8) -> usize;
    fn strcmp(s1: *const u8, s2: *const u8) -> i32;
    fn puts(s: *const u8) -> i32;
    fn fflush(f: *const u8) -> i32;
    fn CreateDirectoryA(lpPathName: *const u8, lpSecurityAttributes: *const u8) -> i32;
    fn Sleep(dwMilliseconds: i32);
}

fn forge_print(msg: String) {
    unsafe {
        puts(msg as *const u8);
        fflush(0 as *const u8);
    }
}

pub fn normalize_path(path: String, arena: *mut u8) -> String {
    let p = path as *const u8;
    let len = unsafe { strlen(p) } as i64;
    let mut buf = string_buffer_new_in(arena);
    let mut i: i64 = 0;
    while i < len {
        let b = unsafe { p[i] };
        if b == 92 as u8 {
            string_buffer_push_byte(&mut buf, 47 as u8);
        } else {
            string_buffer_push_byte(&mut buf, b);
        }
        i = i + 1;
    }
    string_buffer_push_byte(&mut buf, 0 as u8);
    string_as_ptr(&buf) as String
}

pub fn resolve_import_path(imp: String, arena: *mut u8) -> String yields [FS] {
    let norm = normalize_path(imp, arena);
    if fs_exists(norm) {
        return norm;
    }
    let mut sbuf = string_buffer_new_in(arena);
    string_buffer_push_str(&mut sbuf, "src/" as *const u8, 4);
    string_buffer_push_str(&mut sbuf, norm as *const u8, unsafe { strlen(norm as *const u8) } as i64);
    string_buffer_push_byte(&mut sbuf, 0 as u8);
    let src_candidate = string_as_ptr(&sbuf) as String;
    if fs_exists(src_candidate) {
        return src_candidate;
    }
    norm
}

fn load_module_recursive(path: String, loaded_paths: &mut Vec<String>, prog: *mut AstProgram, interner: &mut Interner, arena: *mut u8) yields [FS, Diagnostics] {
    let norm_path = normalize_path(path, arena);

    // 1. Check if already visited
    let mut i: i64 = 0;
    while i < loaded_paths.len {
        let lp = vec_get(loaded_paths, i);
        if unsafe { strcmp(lp as *const u8, norm_path as *const u8) == 0 } {
            return;
        }
        i = i + 1;
    }

    // 2. Mark as visited to prevent cycles
    vec_push(loaded_paths, norm_path);

    // 3. Skip compiler intrinsics
    let p_norm = norm_path as *const u8;
    if unsafe { strcmp(p_norm, "std/fs.tg" as *const u8) == 0 ||
                strcmp(p_norm, "std/process.tg" as *const u8) == 0 } {
        return;
    }

    // 4. Verify existence and read source
    if !fs_exists(norm_path) {
        report_err("Failed to read source file or file is empty", 1, 1);
        return;
    }
    let src = fs_read_to_string_in(norm_path, arena);
    let src_len = unsafe { strlen(src as *const u8) } as i64;
    if src_len == 0 {
        report_err("Failed to read source file or file is empty", 1, 1);
        return;
    }

    // 5. Tokenize and parse this module
    let tokens = tokenize(src, interner, arena);
    if diag_has_errors() {
        return;
    }
    let file_prog = parse_program(tokens, interner, arena);
    if diag_has_errors() {
        return;
    }

    // 6. Recursively process imported modules first (bottom-up dependency order)
    let mut imp_idx: i64 = 0;
    while imp_idx < file_prog.imports.len {
        let raw_imp = vec_get(&file_prog.imports, imp_idx);
        let resolved = resolve_import_path(raw_imp, arena);
        load_module_recursive(resolved, loaded_paths, prog, interner, arena);
        if diag_has_errors() {
            return;
        }
        imp_idx = imp_idx + 1;
    }

    // 7. Merge structs with deduplication
    let mut s_idx: i64 = 0;
    while s_idx < file_prog.structs.len {
        let st = vec_get(&file_prog.structs, s_idx);
        let mut exists = false;
        let mut chk_idx: i64 = 0;
        while chk_idx < prog.structs.len {
            let existing = vec_get(&prog.structs, chk_idx);
            if existing.name_sym == st.name_sym {
                exists = true;
                break;
            }
            chk_idx = chk_idx + 1;
        }
        if !exists {
            vec_push(&mut prog.structs, st);
        }
        s_idx = s_idx + 1;
    }

    // 8. Merge extern_fns with deduplication
    let mut e_idx: i64 = 0;
    while e_idx < file_prog.extern_fns.len {
        let ef = vec_get(&file_prog.extern_fns, e_idx);
        let mut exists = false;
        let mut chk_idx: i64 = 0;
        while chk_idx < prog.extern_fns.len {
            let existing = vec_get(&prog.extern_fns, chk_idx);
            if existing.name_sym == ef.name_sym {
                exists = true;
                break;
            }
            chk_idx = chk_idx + 1;
        }
        if !exists {
            vec_push(&mut prog.extern_fns, ef);
        }
        e_idx = e_idx + 1;
    }

    // 9. Merge functions with deduplication
    let mut f_idx: i64 = 0;
    while f_idx < file_prog.functions.len {
        let fn_item = vec_get(&file_prog.functions, f_idx);
        let mut exists = false;
        let mut chk_idx: i64 = 0;
        while chk_idx < prog.functions.len {
            let existing = vec_get(&prog.functions, chk_idx);
            if existing.name_sym == fn_item.name_sym {
                exists = true;
                break;
            }
            chk_idx = chk_idx + 1;
        }
        if !exists {
            vec_push(&mut prog.functions, fn_item);
        }
        f_idx = f_idx + 1;
    }

    // 10. Merge type_aliases with deduplication
    let mut ta_idx: i64 = 0;
    while ta_idx < file_prog.vals.len {
        let ta = vec_get(&file_prog.vals, ta_idx);
        let mut exists = false;
        let mut chk_idx: i64 = 0;
        while chk_idx < prog.vals.len {
            let existing = vec_get(&prog.vals, chk_idx);
            if existing.name_sym == ta.name_sym {
                exists = true;
                break;
            }
            chk_idx = chk_idx + 1;
        }
        if !exists {
            vec_push(&mut prog.vals, ta);
        }
        ta_idx = ta_idx + 1;
    }

    // 11. Merge effects with deduplication
    let mut eff_idx: i64 = 0;
    while eff_idx < file_prog.effects.len {
        let eff_item = vec_get(&file_prog.effects, eff_idx);
        let mut exists = false;
        let mut chk_idx: i64 = 0;
        while chk_idx < prog.effects.len {
            let existing = vec_get(&prog.effects, chk_idx);
            if existing.name_sym == eff_item.name_sym {
                exists = true;
                break;
            }
            chk_idx = chk_idx + 1;
        }
        if !exists {
            vec_push(&mut prog.effects, eff_item);
        }
        eff_idx = eff_idx + 1;
    }
}

pub fn load_program_modules(root_path: String, interner: &mut Interner, arena: *mut u8) -> *mut AstProgram yields [FS, Diagnostics] {
    let prog = alloc_program(arena);
    let mut loaded_paths: Vec<String> = vec_new_in(arena);
    load_module_recursive(root_path, &mut loaded_paths, prog, interner, arena);
    prog
}

// =============================================================================
// Monomorphization Pre-Pass
// Expands all turbofish calls (foo::<i64>(x)) into concrete cloned functions
// before the typechecker runs. Generic templates are identified by type_param_sym != 0.
// =============================================================================

// Build the mangled name "base__concrete" and intern it, returning the new sym.
fn mangle_sym(interner: &mut Interner, arena: *mut u8, base_sym: i64, concrete_sym: i64) -> i64 {
    let interner_ref = interner as &Interner;
    let base_s = interner_lookup(interner_ref, base_sym);
    let conc_s = interner_lookup(interner_ref, concrete_sym);
    let mut buf = string_buffer_new_in(arena);
    let base_len = unsafe { strlen(base_s as *const u8) } as i64;
    let conc_len = unsafe { strlen(conc_s as *const u8) } as i64;
    string_buffer_push_str(&mut buf, base_s as *const u8, base_len);
    string_buffer_push_str(&mut buf, "__" as *const u8, 2);
    string_buffer_push_str(&mut buf, conc_s as *const u8, conc_len);
    string_buffer_push_byte(&mut buf, 0 as u8);
    let mangled = string_as_ptr(&buf) as String;
    interner_intern(interner, mangled)
}

// Clone an AstParam, substituting type_param_sym -> concrete_sym in its ty_sym.
fn clone_param_with_subst(arena: *mut u8, src: *mut AstParam, type_param_sym: i64, concrete_sym: i64) -> *mut AstParam {
    let mut ty = src.ty_sym;
    if ty == type_param_sym {
        ty = concrete_sym;
    }
    alloc_param(arena, src.name_sym, ty)
}

// Clone an AstField, substituting type_param_sym -> concrete_sym in its ty_sym.
fn clone_field_with_subst(arena: *mut u8, src: *mut AstField, type_param_sym: i64, concrete_sym: i64) -> *mut AstField {
    let mut ty = src.ty_sym;
    if ty == type_param_sym {
        ty = concrete_sym;
    }
    alloc_field(arena, src.name_sym, ty)
}

// Clone a generic AstFn template as a concrete monomorphization.
// The body is SHARED (not deep-cloned) — safe for simple pass-through generics.
fn clone_fn_concrete(arena: *mut u8, interner: &mut Interner, tmpl: *mut AstFn, concrete_sym: i64) -> *mut AstFn {
    let type_param_sym = tmpl.type_param_sym;
    let mangled_sym = mangle_sym(interner, arena, tmpl.name_sym, concrete_sym);

    let mut new_params: Vec<*mut AstParam> = vec_new_in(arena);
    let params_len = tmpl.params.len;
    let mut i: i64 = 0;
    while i < params_len {
        let src_p = vec_get(&tmpl.params, i);
        let cloned_p = clone_param_with_subst(arena, src_p, type_param_sym, concrete_sym);
        vec_push(&mut new_params, cloned_p);
        i = i + 1;
    }

    let mut ret_ty = tmpl.ret_ty_sym;
    if ret_ty == type_param_sym {
        ret_ty = concrete_sym;
    }

    alloc_fn(arena, mangled_sym, new_params, ret_ty, tmpl.body, 0, tmpl.yields_effects)
}

// Clone a generic AstStruct template as a concrete monomorphization.
fn clone_struct_concrete(arena: *mut u8, interner: &mut Interner, tmpl: *mut AstStruct, concrete_sym: i64) -> *mut AstStruct {
    let type_param_sym = tmpl.type_param_sym;
    let mangled_sym = mangle_sym(interner, arena, tmpl.name_sym, concrete_sym);

    let mut new_fields: Vec<*mut AstField> = vec_new_in(arena);
    let fields_len = tmpl.fields.len;
    let mut i: i64 = 0;
    while i < fields_len {
        let src_f = vec_get(&tmpl.fields, i);
        let cloned_f = clone_field_with_subst(arena, src_f, type_param_sym, concrete_sym);
        vec_push(&mut new_fields, cloned_f);
        i = i + 1;
    }

    alloc_struct(arena, mangled_sym, new_fields, 0, tmpl.is_linear)
}

// Walk an expression, expanding any turbofish calls/struct-inits it contains.
fn walk_expr_mono(arena: *mut u8, interner: &mut Interner, prog: *mut AstProgram, gf: &HashMap, gs: &HashMap, already_mono: &mut HashMap, expr: *mut AstExpr) {
    if expr == 0 as *mut AstExpr {
        return;
    }
    let kind = expr.kind;

    if kind == expr_call() {
        let turbo_sym = expr.int_val;
        if turbo_sym != 0 {
            let interner_ref = interner as &Interner;
            let base_s = interner_lookup(interner_ref, expr.sym);
            let val = hashmap_get(gf, base_s);
            if val != 0 - 1 {
                let tmpl = val as *mut AstFn;
                let concrete_sym = turbo_sym;
                let mangled_sym = mangle_sym(interner, arena, tmpl.name_sym, concrete_sym);
                let interner_ref2 = interner as &Interner;
                let mangled_s = interner_lookup(interner_ref2, mangled_sym);
                let already = hashmap_get(already_mono, mangled_s);
                if already == 0 - 1 {
                    let clone = clone_fn_concrete(arena, interner, tmpl, concrete_sym);
                    vec_push(&mut prog.functions, clone);
                    hashmap_insert(already_mono, mangled_s, 1);
                }
                unsafe {
                    expr.sym = mangled_sym;
                    expr.int_val = 0;
                }
            } else {
                unsafe { expr.int_val = 0; }
            }
        }
        let args_len = expr.args.len;
        let mut i: i64 = 0;
        while i < args_len {
            let arg = vec_get(&expr.args, i);
            walk_expr_mono(arena, interner, prog, gf, gs, already_mono, arg);
            i = i + 1;
        }
        return;
    }

    if kind == expr_struct_init() {
        let turbo_sym = expr.int_val;
        if turbo_sym != 0 {
            let interner_ref = interner as &Interner;
            let base_s = interner_lookup(interner_ref, expr.sym);
            let val = hashmap_get(gs, base_s);
            if val != 0 - 1 {
                let tmpl = val as *mut AstStruct;
                let concrete_sym = turbo_sym;
                let mangled_sym = mangle_sym(interner, arena, tmpl.name_sym, concrete_sym);
                let interner_ref2 = interner as &Interner;
                let mangled_s = interner_lookup(interner_ref2, mangled_sym);
                let already = hashmap_get(already_mono, mangled_s);
                if already == 0 - 1 {
                    let clone = clone_struct_concrete(arena, interner, tmpl, concrete_sym);
                    vec_push(&mut prog.structs, clone);
                    hashmap_insert(already_mono, mangled_s, 1);
                }
                unsafe {
                    expr.sym = mangled_sym;
                    expr.int_val = 0;
                }
            } else {
                unsafe { expr.int_val = 0; }
            }
        }
        let args_len = expr.args.len;
        let mut i: i64 = 0;
        while i < args_len {
            let arg = vec_get(&expr.args, i);
            walk_expr_mono(arena, interner, prog, gf, gs, already_mono, arg);
            i = i + 1;
        }
        return;
    }

    if expr.kind == expr_handle() {
        let bi_len = expr.stmts.len;
        let mut bi: i64 = 0;
        while bi < bi_len {
            let s = vec_get(&expr.stmts, bi);
            walk_stmt_mono(arena, interner, prog, gf, gs, already_mono, s);
            bi = bi + 1;
        }
        return;
    }

    // Recurse into sub-expressions for all other node kinds
    if expr.left != 0 as *mut AstExpr {
        walk_expr_mono(arena, interner, prog, gf, gs, already_mono, expr.left);
    }
    if expr.right != 0 as *mut AstExpr {
        walk_expr_mono(arena, interner, prog, gf, gs, already_mono, expr.right);
    }
    let args_len = expr.args.len;
    let mut i: i64 = 0;
    while i < args_len {
        let arg = vec_get(&expr.args, i);
        walk_expr_mono(arena, interner, prog, gf, gs, already_mono, arg);
        i = i + 1;
    }
}

// Walk a statement, expanding any turbofish calls inside it.
fn walk_stmt_mono(arena: *mut u8, interner: &mut Interner, prog: *mut AstProgram, gf: &HashMap, gs: &HashMap, already_mono: &mut HashMap, stmt: *mut AstStmt) {
    if stmt == 0 as *mut AstStmt {
        return;
    }
    if stmt.expr != 0 as *mut AstExpr {
        walk_expr_mono(arena, interner, prog, gf, gs, already_mono, stmt.expr);
    }
    if stmt.left != 0 as *mut AstExpr {
        walk_expr_mono(arena, interner, prog, gf, gs, already_mono, stmt.left);
    }
    if stmt.right != 0 as *mut AstExpr {
        walk_expr_mono(arena, interner, prog, gf, gs, already_mono, stmt.right);
    }
    let then_len = stmt.then_stmts.len;
    let mut i: i64 = 0;
    while i < then_len {
        let s = vec_get(&stmt.then_stmts, i);
        walk_stmt_mono(arena, interner, prog, gf, gs, already_mono, s);
        i = i + 1;
    }
    let else_len = stmt.else_stmts.len;
    let mut j: i64 = 0;
    while j < else_len {
        let s = vec_get(&stmt.else_stmts, j);
        walk_stmt_mono(arena, interner, prog, gf, gs, already_mono, s);
        j = j + 1;
    }
}

pub struct HandlerIdCounter {
    val: i64,
}

fn append_i64_to_buf(buf: &mut StringBuffer, n: i64) {
    if n >= 10 {
        append_i64_to_buf(buf, n / 10);
    }
    let digit = (n - (n / 10) * 10) as u8 + 48 as u8;
    string_buffer_push_byte(buf, digit);
}

fn desugar_one_handler(prog: *mut AstProgram, handler: *mut AstHandler, counter: *mut HandlerIdCounter, interner: &mut Interner, arena: *mut u8) {
    if handler == (0 as *mut AstHandler) {
        return;
    }
    if handler.id != 0 {
        return;
    }
    handler.id = counter.val;
    counter.val = counter.val + 1;

    let arm_len = handler.arms.len;
    let mut ai: i64 = 0;
    while ai < arm_len {
        let arm = vec_get(&handler.arms, ai);

        // Build function name: __handler_arm_<handler.id>_<op_name>
        let mut fn_name_buf = string_buffer_new_in(arena);
        string_buffer_push_str(&mut fn_name_buf, "__handler_arm_" as *const u8, 14);
        append_i64_to_buf(&mut fn_name_buf, handler.id);
        string_buffer_push_byte(&mut fn_name_buf, 95 as u8); // '_'
        let op_name = interner_lookup(interner, arm.op_sym);
        string_buffer_push_str(&mut fn_name_buf, op_name as *const u8, unsafe { strlen(op_name as *const u8) } as i64);
        string_buffer_push_byte(&mut fn_name_buf, 0 as u8);
        let fn_name_str = string_as_ptr(&fn_name_buf) as String;
        let arm_fn_sym = interner_intern(interner, fn_name_str);
        arm.fn_sym = arm_fn_sym;

        // Build parameter list: k + arm.params
        let mut fn_params: Vec<*mut AstParam> = vec_new_in(arena);
        let cont_sym = interner_intern(interner, "Continuation");
        let k_param = alloc_param(arena, arm.continuation_sym, cont_sym);
        vec_push(&mut fn_params, k_param);
        let mut pi: i64 = 0;
        while pi < arm.params.len {
            vec_push(&mut fn_params, vec_get(&arm.params, pi));
            pi = pi + 1;
        }

        // Find return type from effect definition
        let mut ret_ty_sym: i64 = 0;
        let mut ei: i64 = 0;
        while ei < prog.effects.len {
            let eff = vec_get(&prog.effects, ei);
            if eff.name_sym == handler.effect_sym {
                let mut oi: i64 = 0;
                while oi < eff.ops.len {
                    let op = vec_get(&eff.ops, oi);
                    if op.name_sym == arm.op_sym {
                        ret_ty_sym = op.ret_ty_sym;
                        break;
                    }
                    oi = oi + 1;
                }
                break;
            }
            ei = ei + 1;
        }

        let empty_yields: Vec<i64> = vec_new_in(arena);
        let arm_fn = alloc_fn(arena, arm_fn_sym, fn_params, ret_ty_sym, arm.body, 0, empty_yields);
        vec_push(&mut prog.functions, arm_fn);

        ai = ai + 1;
    }
}

fn walk_expr_desugar_handlers(prog: *mut AstProgram, expr: *mut AstExpr, counter: *mut HandlerIdCounter, interner: &mut Interner, arena: *mut u8) {
    if expr == (0 as *mut AstExpr) {
        return;
    }
    if expr.kind == expr_handle() {
        let handler = expr.left as *mut AstHandler;
        desugar_one_handler(prog, handler, counter, interner, arena);
        let mut bi: i64 = 0;
        while bi < expr.stmts.len {
            let s = vec_get(&expr.stmts, bi);
            walk_stmt_desugar_handlers(prog, s, counter, interner, arena);
            bi = bi + 1;
        }
        return;
    }
    if expr.left != (0 as *mut AstExpr) {
        walk_expr_desugar_handlers(prog, expr.left, counter, interner, arena);
    }
    if expr.right != (0 as *mut AstExpr) {
        walk_expr_desugar_handlers(prog, expr.right, counter, interner, arena);
    }
    let mut ai: i64 = 0;
    while ai < expr.args.len {
        let arg = vec_get(&expr.args, ai);
        walk_expr_desugar_handlers(prog, arg, counter, interner, arena);
        ai = ai + 1;
    }
}

fn walk_stmt_desugar_handlers(prog: *mut AstProgram, stmt: *mut AstStmt, counter: *mut HandlerIdCounter, interner: &mut Interner, arena: *mut u8) {
    if stmt == (0 as *mut AstStmt) {
        return;
    }
    if stmt.kind == stmt_handle() {
        desugar_one_handler(prog, stmt.handler, counter, interner, arena);
        let mut bi: i64 = 0;
        while bi < stmt.then_stmts.len {
            let s = vec_get(&stmt.then_stmts, bi);
            walk_stmt_desugar_handlers(prog, s, counter, interner, arena);
            bi = bi + 1;
        }
        return;
    }
    if stmt.expr != (0 as *mut AstExpr) {
        walk_expr_desugar_handlers(prog, stmt.expr, counter, interner, arena);
    }
    if stmt.left != (0 as *mut AstExpr) {
        walk_expr_desugar_handlers(prog, stmt.left, counter, interner, arena);
    }
    if stmt.right != (0 as *mut AstExpr) {
        walk_expr_desugar_handlers(prog, stmt.right, counter, interner, arena);
    }
    let mut ti: i64 = 0;
    while ti < stmt.then_stmts.len {
        let s = vec_get(&stmt.then_stmts, ti);
        walk_stmt_desugar_handlers(prog, s, counter, interner, arena);
        ti = ti + 1;
    }
    let mut ei: i64 = 0;
    while ei < stmt.else_stmts.len {
        let s = vec_get(&stmt.else_stmts, ei);
        walk_stmt_desugar_handlers(prog, s, counter, interner, arena);
        ei = ei + 1;
    }
}

pub fn desugar_handlers_program(prog: *mut AstProgram, interner: &mut Interner, arena: *mut u8) {
    let mut counter = HandlerIdCounter { val: 1 };
    let orig_fns_len = prog.functions.len;
    let mut fi: i64 = 0;
    while fi < orig_fns_len {
        let f = vec_get(&prog.functions, fi);
        let mut bi: i64 = 0;
        while bi < f.body.len {
            let s = vec_get(&f.body, bi);
            walk_stmt_desugar_handlers(prog, s, &mut counter as *mut HandlerIdCounter, interner, arena);
            bi = bi + 1;
        }
        fi = fi + 1;
    }
}

// Monomorphization pre-pass: expand all turbofish generic instantiations in prog.
pub fn monomorphize_program(prog: *mut AstProgram, interner: &mut Interner, arena: *mut u8) yields [Diagnostics] {
    // Build generic fn template map (name_str -> *mut AstFn)
    let mut gf: HashMap = hashmap_new_in(arena, 32);
    let fns_len = prog.functions.len;
    let mut i: i64 = 0;
    while i < fns_len {
        let f = vec_get(&prog.functions, i);
        if f.type_param_sym != 0 {
            let interner_ref = interner as &Interner;
            let s = interner_lookup(interner_ref, f.name_sym);
            hashmap_insert(&mut gf, s, f as i64);
        }
        i = i + 1;
    }

    // Build generic struct template map
    let mut gs: HashMap = hashmap_new_in(arena, 32);
    let structs_len = prog.structs.len;
    let mut j: i64 = 0;
    while j < structs_len {
        let st = vec_get(&prog.structs, j);
        if st.type_param_sym != 0 {
            let interner_ref = interner as &Interner;
            let s = interner_lookup(interner_ref, st.name_sym);
            hashmap_insert(&mut gs, s, st as i64);
        }
        j = j + 1;
    }

    // Dedup set: tracks already-monomorphized mangled names
    let mut already_mono: HashMap = hashmap_new_in(arena, 64);

    // Walk all non-generic function bodies expanding turbofish calls.
    // NOTE: fns_len is the pre-walk count; newly appended clones are not
    // walked here — their shared bodies contain no turbofish calls.
    let mut k: i64 = 0;
    while k < fns_len {
        let f = vec_get(&prog.functions, k);
        if f.type_param_sym == 0 {
            let body_len = f.body.len;
            let mut b: i64 = 0;
            while b < body_len {
                let s = vec_get(&f.body, b);
                walk_stmt_mono(arena, interner, prog, &gf, &gs, &mut already_mono, s);
                b = b + 1;
            }
        }
        k = k + 1;
    }

    // -----------------------------------------------------------------------
    // Acceptance Invariants — enforced by the post-pass below:
    //   (1) Each concrete specialization is created at most once.
    //       Enforced by: already_mono HashMap deduplication above.
    //   (2) All references to the same specialization resolve to that instance.
    //       Enforced by: expr.sym is set to the interned mangled sym; the
    //       interner guarantees that identical strings map to the same sym.
    //   (3) No unresolved type parameters reach final code generation.
    //       Enforced by: verify_no_unresolved_turbofish below — it walks
    //       all concrete function bodies and asserts that no call or struct_init
    //       expression retains a non-zero int_val turbofish marker.
    //       If this assertion fires, the codegen.tg compatibility fallback is
    //       load-bearing, which means Phase 9.3 has a monomorphization gap.
    // -----------------------------------------------------------------------
    verify_no_unresolved_turbofish(prog, interner, arena);
}

// Walk an expression asserting no turbofish marker remains (int_val == 0 on
// call/struct_init). Returns true if the invariant holds, false on violation.
fn verify_expr_concrete(expr: *mut AstExpr, interner: &Interner, arena: *mut u8) -> bool {
    if expr == 0 as *mut AstExpr {
        return true;
    }
    let kind = expr.kind;
    if kind == expr_call() {
        if expr.int_val != 0 {
            // Invariant (3) violated: a turbofish call whose template was not
            // found in the generic map. The interner still has the original sym.
            return false;
        }
        let args_len = expr.args.len;
        let mut i: i64 = 0;
        while i < args_len {
            let arg = vec_get(&expr.args, i);
            if !verify_expr_concrete(arg, interner, arena) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if kind == expr_struct_init() {
        if expr.int_val != 0 {
            return false;
        }
        let args_len = expr.args.len;
        let mut i: i64 = 0;
        while i < args_len {
            let arg = vec_get(&expr.args, i);
            if !verify_expr_concrete(arg, interner, arena) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if kind == expr_handle() {
        let bi_len = expr.stmts.len;
        let mut bi: i64 = 0;
        while bi < bi_len {
            let s = vec_get(&expr.stmts, bi);
            if !verify_stmt_concrete(s, interner, arena) {
                return false;
            }
            bi = bi + 1;
        }
        return true;
    }
    if expr.left != 0 as *mut AstExpr {
        if !verify_expr_concrete(expr.left, interner, arena) {
            return false;
        }
    }
    if expr.right != 0 as *mut AstExpr {
        if !verify_expr_concrete(expr.right, interner, arena) {
            return false;
        }
    }
    let args_len = expr.args.len;
    let mut i: i64 = 0;
    while i < args_len {
        let arg = vec_get(&expr.args, i);
        if !verify_expr_concrete(arg, interner, arena) {
            return false;
        }
        i = i + 1;
    }
    true
}

fn verify_stmt_concrete(stmt: *mut AstStmt, interner: &Interner, arena: *mut u8) -> bool {
    if stmt == 0 as *mut AstStmt {
        return true;
    }
    if stmt.expr != 0 as *mut AstExpr {
        if !verify_expr_concrete(stmt.expr, interner, arena) {
            return false;
        }
    }
    if stmt.left != 0 as *mut AstExpr {
        if !verify_expr_concrete(stmt.left, interner, arena) {
            return false;
        }
    }
    if stmt.right != 0 as *mut AstExpr {
        if !verify_expr_concrete(stmt.right, interner, arena) {
            return false;
        }
    }
    let then_len = stmt.then_stmts.len;
    let mut i: i64 = 0;
    while i < then_len {
        let s = vec_get(&stmt.then_stmts, i);
        if !verify_stmt_concrete(s, interner, arena) {
            return false;
        }
        i = i + 1;
    }
    let else_len = stmt.else_stmts.len;
    let mut j: i64 = 0;
    while j < else_len {
        let s = vec_get(&stmt.else_stmts, j);
        if !verify_stmt_concrete(s, interner, arena) {
            return false;
        }
        j = j + 1;
    }
    true
}

// Invariant (3) enforcement: scan all concrete function bodies and assert that
// no call or struct_init expression retains a turbofish marker (int_val != 0).
// Reports a diagnostic error if violated — this will cause compilation to fail,
// ensuring the codegen.tg compatibility fallback can never become load-bearing.
fn verify_no_unresolved_turbofish(prog: *mut AstProgram, interner: &Interner, arena: *mut u8) yields [Diagnostics] {
    let fns_len = prog.functions.len;
    let mut i: i64 = 0;
    while i < fns_len {
        let f = vec_get(&prog.functions, i);
        if f.type_param_sym == 0 {
            let body_len = f.body.len;
            let mut b: i64 = 0;
            while b < body_len {
                let s = vec_get(&f.body, b);
                if !verify_stmt_concrete(s, interner, arena) {
                    report_err("Generic Invariant Violation: turbofish call to unknown generic function; no concrete specialization was created. Check that the generic function is defined and has exactly one type parameter.", 1, 1);
                }
                b = b + 1;
            }
        }
        i = i + 1;
    }
}

pub fn compile_file(src_path: String, out_ll_path: String, out_exe_path: String) -> i64 yields [FS, Process, Diagnostics, IO] {
    return compile_file_target(src_path, out_ll_path, out_exe_path, "x86_64-pc-windows-gnu");
}

pub fn compile_file_target(src_path: String, out_ll_path: String, out_exe_path: String, target_triple: String) -> i64 yields [FS, Process, Diagnostics, IO] {
    let mut exit_code: i64 = 0;
    unsafe {
        CreateDirectoryA("target" as *const u8, 0 as *const u8);
    }
    forge_print("TGC: Entering compile_file region...");
    region comp_reg {
        forge_print("TGC: Creating interner...");
        let mut interner = interner_new_in(comp_reg);
        diag_reset();
        forge_print("TGC: Loading modules and parsing AST...");
        let prog = load_program_modules(src_path, &mut interner, comp_reg);
        if diag_has_errors() {
            report_err("Module loading or parsing failed", 1, 1);
            exit_code = 1;
        } else {
            forge_print("TGC: Type checking & solving refinements...");
            desugar_handlers_program(prog, &mut interner, comp_reg);
            monomorphize_program(prog, &mut interner, comp_reg);
            let tc_ok = typecheck_program(prog, &mut interner, comp_reg);
            if !tc_ok || diag_has_errors() {
                report_err("Type checking failed", 1, 1);
                exit_code = 1;
            } else {
                forge_print("TGC: Lowering to TIR & optimizing...");
                let tir_mod = lower_ast_program_to_tir(prog, &interner, comp_reg);
                let opt_count = tir_optimize_module(tir_mod, comp_reg);

                forge_print("TGC: Emitting LLVM IR...");
                let mut ir_buf = emit_llvm_ir_target(tir_mod, &mut interner, comp_reg, target_triple);
                string_buffer_push_byte(&mut ir_buf, 0 as u8);
                let ir_str = string_as_ptr(&ir_buf) as String;

                forge_print("TGC: Writing LLVM IR to disk...");
                let ok_write = fs_write_string(out_ll_path, ir_str);
                if !ok_write {
                    report_err("Failed to write LLVM IR file", 1, 1);
                    exit_code = 2;
                } else {
                    forge_print("TGC: Invoking clang...");
                    let is_linux = is_linux_target(target_triple);
                    let is_arm64 = is_aarch64_target(target_triple);
                    let mut cmd_args = string_buffer_new_in(comp_reg);
                    if is_arm64 {
                        let opt_prefix = "--target=aarch64-unknown-linux-gnu -o ";
                        let opt_suffix = " -lc -lpthread -lm -ldl";
                        string_buffer_push_str(&mut cmd_args, opt_prefix as *const u8, unsafe { strlen(opt_prefix as *const u8) } as i64);
                        string_buffer_push_str(&mut cmd_args, out_exe_path as *const u8, unsafe { strlen(out_exe_path as *const u8) } as i64);
                        string_buffer_push_byte(&mut cmd_args, 32 as u8);
                        string_buffer_push_str(&mut cmd_args, out_ll_path as *const u8, unsafe { strlen(out_ll_path as *const u8) } as i64);
                        string_buffer_push_str(&mut cmd_args, opt_suffix as *const u8, unsafe { strlen(opt_suffix as *const u8) } as i64);
                    } else if is_linux {
                        let opt_prefix = "--target=x86_64-unknown-linux-gnu -o ";
                        let opt_suffix = " -lc -lpthread -lm -ldl";
                        string_buffer_push_str(&mut cmd_args, opt_prefix as *const u8, unsafe { strlen(opt_prefix as *const u8) } as i64);
                        string_buffer_push_str(&mut cmd_args, out_exe_path as *const u8, unsafe { strlen(out_exe_path as *const u8) } as i64);
                        string_buffer_push_byte(&mut cmd_args, 32 as u8);
                        string_buffer_push_str(&mut cmd_args, out_ll_path as *const u8, unsafe { strlen(out_ll_path as *const u8) } as i64);
                        string_buffer_push_str(&mut cmd_args, opt_suffix as *const u8, unsafe { strlen(opt_suffix as *const u8) } as i64);
                    } else {
                        let opt_prefix = "--target=x86_64-pc-windows-gnu -nostartfiles -o ";
                        let opt_suffix = " lib/crt/crt2.o -Llib/crt -lmingw32 -lmingwex -lmsvcrt -lkernel32 -luser32 -lgdi32 -lwinmm -lws2_32 -lgcc";
                        string_buffer_push_str(&mut cmd_args, opt_prefix as *const u8, unsafe { strlen(opt_prefix as *const u8) } as i64);
                        string_buffer_push_str(&mut cmd_args, out_exe_path as *const u8, unsafe { strlen(out_exe_path as *const u8) } as i64);
                        string_buffer_push_byte(&mut cmd_args, 32 as u8);
                        string_buffer_push_str(&mut cmd_args, out_ll_path as *const u8, unsafe { strlen(out_ll_path as *const u8) } as i64);
                        string_buffer_push_str(&mut cmd_args, opt_suffix as *const u8, unsafe { strlen(opt_suffix as *const u8) } as i64);
                    }
                    string_buffer_push_byte(&mut cmd_args, 0 as u8);
                    let args_str = string_as_ptr(&cmd_args) as String;

                    let mut status = process_exec("clang", args_str);
                    if status != 0 && is_linux {
                        // If cross-compilation linking fails on host due to absent Linux sysroot,
                        // compile to relocatable ELF object file (-c)
                        let mut c_args = string_buffer_new_in(comp_reg);
                        if is_arm64 {
                            let c_prefix = "--target=aarch64-unknown-linux-gnu -c -o ";
                            string_buffer_push_str(&mut c_args, c_prefix as *const u8, unsafe { strlen(c_prefix as *const u8) } as i64);
                        } else {
                            let c_prefix = "--target=x86_64-unknown-linux-gnu -c -o ";
                            string_buffer_push_str(&mut c_args, c_prefix as *const u8, unsafe { strlen(c_prefix as *const u8) } as i64);
                        }
                        string_buffer_push_str(&mut c_args, out_exe_path as *const u8, unsafe { strlen(out_exe_path as *const u8) } as i64);
                        string_buffer_push_byte(&mut c_args, 32 as u8);
                        string_buffer_push_str(&mut c_args, out_ll_path as *const u8, unsafe { strlen(out_ll_path as *const u8) } as i64);
                        string_buffer_push_byte(&mut c_args, 0 as u8);
                        let c_str = string_as_ptr(&c_args) as String;
                        let c_status = process_exec("clang", c_str);
                        if c_status == 0 {
                            forge_print("TGC: Note: Emitted relocatable Linux ELF object (sysroot linking unavailable on host)");
                            status = 0;
                        }
                    }
                    if status != 0 {
                        report_err("Clang failed to link executable", 1, 1);
                        exit_code = 3;
                    }
                }
            }
        }
    }
    return exit_code;
}

pub fn forge_usage() {
    forge_print("forge - Tungsten Genesis Unified Developer CLI");
    forge_print("Usage: forge <command> [options]");
    forge_print("");
    forge_print("Commands:");
    forge_print("  check <file.tg>            Typecheck and verify refinement intervals without code generation");
    forge_print("  build <file.tg> [-o <out>] [--target <triple>] Full compilation with TIR optimization and Clang linking");
    forge_print("  run <file.tg>              Compile and execute the program immediately");
    forge_print("  test                       Run all native Tungsten test suites in tests/");
    forge_print("  fmt [--check] <file.tg>    Format Tungsten source code to canonical style");
    forge_print("  lsp                        Start Tungsten Language Server Protocol stdio daemon");
    forge_print("  new <project_name>         Scaffold a new Tungsten project with Forge.toml");
    forge_print("  clean                      Clean compilation artifacts in target/");
    forge_print("  version                    Print forge and compiler toolchain version");
    forge_print("  help                       Display this help message");
}

pub fn forge_run_check(path: String, arena: *mut u8) -> i64 yields [FS, Diagnostics, IO] {
    forge_print("forge: checking syntax and refinement types...");
    diag_reset();
    let mut interner = interner_new_in(arena);
    let prog = load_program_modules(path, &mut interner, arena);
    if diag_has_errors() {
        report_err("forge check failed: syntax errors detected", 1, 1);
        return 1;
    }
    let tc_ok = typecheck_program(prog, &mut interner, arena);
    if !tc_ok || diag_has_errors() {
        report_err("forge check failed: refinement or type violations detected", 1, 1);
        return 1;
    }

    forge_print("forge: check passed: 0 errors, refinement invariants statically proven");
    0
}

pub fn forge_run_build(args: &Vec<String>, arena: *mut u8) -> i64 yields [FS, Process, Diagnostics, IO] {
    if args.len < 3 {
        forge_print("Error: 'forge build' requires a target .tg file");
        forge_print("Usage: forge build <file.tg> [-o <out>] [--target <triple>]");
        return 1;
    }

    let src_path = vec_get(args, 2);
    let mut out_exe = "target/app.exe";
    let mut out_ll = "target/app.ll";
    let mut target_triple = "x86_64-pc-windows-gnu";

    let mut i: i64 = 3;
    while i < args.len {
        let opt_flag = vec_get(args, i);
        if unsafe { strcmp(opt_flag as *const u8, "-o" as *const u8) == 0 } {
            if i + 1 < args.len {
                i = i + 1;
                out_exe = vec_get(args, i);
                let mut sbuf = string_buffer_new_in(arena);
                let elen = unsafe { strlen(out_exe as *const u8) } as i64;
                string_buffer_push_str(&mut sbuf, out_exe as *const u8, elen);
                string_buffer_push_str(&mut sbuf, ".ll" as *const u8, 3);
                string_buffer_push_byte(&mut sbuf, 0 as u8);
                out_ll = string_as_ptr(&sbuf) as String;
            }
        } else if unsafe { strcmp(opt_flag as *const u8, "--target" as *const u8) == 0 } {
            if i + 1 < args.len {
                i = i + 1;
                target_triple = vec_get(args, i);
            }
        }
        i = i + 1;
    }

    forge_print("forge: compiling target...");
    let res = compile_file_target(src_path, out_ll, out_exe, target_triple);
    if res == 0 {
        forge_print("forge: build succeeded");
    } else {
        forge_print("forge: build failed with compilation errors");
    }
    res
}

pub fn forge_run_exec(path: String, arena: *mut u8) -> i64 yields [FS, Process, Diagnostics, IO] {
    forge_print("forge: building binary for execution...");
    let tmp_exe = ".\\target\\forge_run_tmp.exe";
    let tmp_ll = "target/forge_run_tmp.ll";

    let res = compile_file(path, tmp_ll, tmp_exe);
    if res != 0 {
        forge_print("forge: build failed before execution");
        return res;
    }

    forge_print("forge: running binary...");
    let status = process_exec(tmp_exe, "");
    status
}

pub fn forge_run_test(arena: *mut u8) -> i64 yields [FS, Process, Diagnostics, IO] {
    unsafe {
        CreateDirectoryA("target" as *const u8, 0 as *const u8);
        CreateDirectoryA("target/tests" as *const u8, 0 as *const u8);
    }
    forge_print("running tungsten native test suites...");
    let mut test_suites: Vec<String> = vec_new_in(arena);
    vec_push(&mut test_suites, "tests/typeck_refinements.tg");
    vec_push(&mut test_suites, "tests/tir_optimizer.tg");
    vec_push(&mut test_suites, "tests/formatter_tests.tg");
    vec_push(&mut test_suites, "tests/package_tests.tg");
    vec_push(&mut test_suites, "tests/bootstrap_tests.tg");
    vec_push(&mut test_suites, "tests/error_handling_tests.tg");
    vec_push(&mut test_suites, "tests/win32_gdi_callback_test.tg");
    vec_push(&mut test_suites, "tests/struct_field_layout_test.tg");
    vec_push(&mut test_suites, "tests/refinement_test.tg");
    vec_push(&mut test_suites, "tests/region_escape_test.tg");
    vec_push(&mut test_suites, "tests/generics_test.tg");
    vec_push(&mut test_suites, "tests/effects_test.tg");
    vec_push(&mut test_suites, "tests/formal_verification_test.tg");

    let mut passed: i64 = 0;
    let mut failed: i64 = 0;

    let mut i: i64 = 0;
    while i < test_suites.len {
        let t_path = vec_get(&test_suites, i);
        let mut out_exe_buf = string_buffer_new_in(arena);
        fmt_append_str(&mut out_exe_buf, ".\\target\\tests\\test_");
        fmt_append_i64(&mut out_exe_buf, i);
        fmt_append_str(&mut out_exe_buf, ".exe");
        string_buffer_push_byte(&mut out_exe_buf, 0 as u8);
        let out_exe = string_as_ptr(&out_exe_buf) as String;

        let mut out_ll_buf = string_buffer_new_in(arena);
        fmt_append_str(&mut out_ll_buf, out_exe);
        fmt_append_str(&mut out_ll_buf, ".ll");
        string_buffer_push_byte(&mut out_ll_buf, 0 as u8);
        let out_ll = string_as_ptr(&out_ll_buf) as String;

        let comp_status = compile_file(t_path, out_ll, out_exe);
        if comp_status != 0 {
            forge_print("[FAIL] Compilation failed for: ");
            forge_print(t_path);
            failed = failed + 1;
        } else {
            let mut run_status: i64 = 1;
            let mut attempts: i64 = 0;
            while attempts < 10 {
                unsafe { Sleep(200); }
                run_status = process_exec(out_exe, "");
                if run_status == 0 {
                    break;
                }
                attempts = attempts + 1;
            }
            if run_status != 0 {
                forge_print("[FAIL] Test suite failed: ");
                forge_print(t_path);
                failed = failed + 1;
            } else {
                passed = passed + 1;
            }
        }
        i = i + 1;
    }

    if failed == 0 {
        forge_print("test result: ok. all test suites passed!");
        return 0;
    }
    forge_print("test result: FAILED. some test suites failed.");
    1
}

pub fn forge_run_fmt(args: &Vec<String>, arena: *mut u8) -> i64 yields [FS, Diagnostics, IO] {
    if args.len < 3 {
        forge_print("Error: 'forge fmt' requires a path to a .tg file");
        forge_print("Usage: forge fmt [--check] <file.tg>");
        return 1;
    }

    let mut check_only = false;
    let mut file_path = vec_get(args, 2);

    if unsafe { strcmp(file_path as *const u8, "--check" as *const u8) == 0 } {
        check_only = true;
        if args.len < 4 {
            forge_print("Error: 'forge fmt --check' requires a file path");
            return 1;
        }
        file_path = vec_get(args, 3);
    }

    format_file_source(file_path, check_only, arena)
}

pub fn forge_run_new(name: String, arena: *mut u8) -> i64 yields [FS, IO] {
    forge_print("forge: creating new project...");

    let mut toml_buf = string_buffer_new_in(arena);
    fmt_append_str(&mut toml_buf, "[package]\nname = \"");
    fmt_append_str(&mut toml_buf, name);
    fmt_append_str(&mut toml_buf, "\"\nversion = \"0.1.0\"\nedition = \"2026\"\n\n[dependencies]\n");
    string_buffer_push_byte(&mut toml_buf, 0 as u8);
    let toml_str = string_as_ptr(&toml_buf) as String;

    let mut toml_path_buf = string_buffer_new_in(arena);
    fmt_append_str(&mut toml_path_buf, "Forge.toml");
    string_buffer_push_byte(&mut toml_path_buf, 0 as u8);
    let toml_path = string_as_ptr(&toml_path_buf) as String;

    fs_write_string(toml_path, toml_str);
    forge_print("forge: created Forge.toml");
    0
}

pub fn forge_main(args: Vec<String>, arena: *mut u8) -> i64 yields [FS, Process, Diagnostics, IO] {
    if args.len < 2 {
        forge_usage();
        return 0;
    }

    let cmd = vec_get(&args, 1);
    let p_cmd = cmd as *const u8;

    if unsafe { strcmp(p_cmd, "check" as *const u8) == 0 } {
        if args.len < 3 {
            forge_print("Error: 'forge check' requires a target .tg file");
            return 1;
        }
        let file = vec_get(&args, 2);
        return forge_run_check(file, arena);
    }

    if unsafe { strcmp(p_cmd, "build" as *const u8) == 0 } {
        return forge_run_build(&args, arena);
    }

    if unsafe { strcmp(p_cmd, "run" as *const u8) == 0 } {
        if args.len < 3 {
            forge_print("Error: 'forge run' requires a target .tg file");
            return 1;
        }
        let file = vec_get(&args, 2);
        return forge_run_exec(file, arena);
    }

    if unsafe { strcmp(p_cmd, "test" as *const u8) == 0 } {
        return forge_run_test(arena);
    }

    if unsafe { strcmp(p_cmd, "fmt" as *const u8) == 0 } {
        return forge_run_fmt(&args, arena);
    }

    if unsafe { strcmp(p_cmd, "lsp" as *const u8) == 0 } {
        return lsp_run_stdio(arena);
    }

    if unsafe { strcmp(p_cmd, "new" as *const u8) == 0 } {
        if args.len < 3 {
            forge_print("Error: 'forge new' requires a project name");
            return 1;
        }
        let name = vec_get(&args, 2);
        return forge_run_new(name, arena);
    }

    if unsafe { strcmp(p_cmd, "clean" as *const u8) == 0 } {
        process_exec("del /q /f /s target\\*.exe target\\*.ll target\\*.pdb >nul 2>nul", "");
        forge_print("forge: cleaned target/ artifacts");
        return 0;
    }

    if unsafe { strcmp(p_cmd, "version" as *const u8) == 0 || strcmp(p_cmd, "--version" as *const u8) == 0 || strcmp(p_cmd, "-V" as *const u8) == 0 } {
        forge_print("forge 0.2.0 (pure tungsten genesis 2026)");
        return 0;
    }

    if unsafe { strcmp(p_cmd, "help" as *const u8) == 0 || strcmp(p_cmd, "--help" as *const u8) == 0 || strcmp(p_cmd, "-h" as *const u8) == 0 } {
        forge_usage();
        return 0;
    }

    forge_print("forge: unknown command");
    forge_usage();
    1
}

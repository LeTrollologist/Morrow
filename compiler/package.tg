// Tungsten Self-Hosting Compiler - Package Resolver & Manifest Parser (package.tg)
// Parses Forge.toml manifests, validates package structure, and resolves dependencies

import std::collections;
import std::fs;
import compiler::diagnostics;
import compiler::interner;

extern "C" {
    fn strlen(s: *const u8) -> usize;
    fn strcmp(s1: *const u8, s2: *const u8) -> i32;
    fn puts(s: *const u8) -> i32;
    fn fflush(f: *const u8) -> i32;
    fn tungsten_region_alloc(arena: *mut u8, size: usize, align: usize) -> *mut u8;
}

// -----------------------------------------------------------------------------
// Package Manifest Structs (conforming to 8-field rectangular layout)
// -----------------------------------------------------------------------------
pub struct PackageDep {
    kind: i64,
    sym: i64,            // name_sym
    int_val: i64,
    str_val: String,     // path
    op: i64,             // version_sym
    left: *mut PackageDep,
    right: *mut PackageDep,
    args: Vec<*mut PackageDep>,
}

pub struct PackageManifest {
    kind: i64,
    sym: i64,            // name_sym
    int_val: i64,
    str_val: String,     // version
    op: i64,             // edition_sym
    left: *mut PackageDep,
    right: *mut PackageDep,
    args: Vec<*mut PackageDep>, // dependencies
}

pub fn alloc_package_dep(arena: *mut u8, name_sym: i64, version_sym: i64, path: String) -> *mut PackageDep {
    let p = unsafe {
        tungsten_region_alloc(arena, 64, 8) as *mut PackageDep
    };
    let null_dep = 0 as *mut PackageDep;
    let empty_vec: Vec<*mut PackageDep> = vec_new_in(arena);
    unsafe {
        p.kind = 1;
        p.sym = name_sym;
        p.int_val = 0;
        p.str_val = path;
        p.op = version_sym;
        p.left = null_dep;
        p.right = null_dep;
        p.args = empty_vec;
    }
    p
}

pub fn alloc_package_manifest(arena: *mut u8, name_sym: i64, version_str: String, edition_sym: i64) -> *mut PackageManifest {
    let p = unsafe {
        tungsten_region_alloc(arena, 64, 8) as *mut PackageManifest
    };
    let null_dep = 0 as *mut PackageDep;
    let deps: Vec<*mut PackageDep> = vec_new_in(arena);
    unsafe {
        p.kind = 2;
        p.sym = name_sym;
        p.int_val = 0;
        p.str_val = version_str;
        p.op = edition_sym;
        p.left = null_dep;
        p.right = null_dep;
        p.args = deps;
    }
    p
}

// -----------------------------------------------------------------------------
// Forge.toml Parser
// -----------------------------------------------------------------------------
fn extract_quoted_string(line: *const u8, line_len: i64, arena: *mut u8) -> String {
    let mut i: i64 = 0;
    while i < line_len && unsafe { line[i] } != 34 { // find first "
        i = i + 1;
    }
    if i >= line_len {
        return "";
    }
    i = i + 1; // skip "
    let start = i;
    while i < line_len && unsafe { line[i] } != 34 { // find closing "
        i = i + 1;
    }
    if i > start {
        let seg_len = i - start;
        let sub_ptr = (line as usize + start as usize) as *const u8;
        let mut sbuf = string_buffer_from_utf8_in(arena, sub_ptr, seg_len);
        string_buffer_push_byte(&mut sbuf, 0 as u8);
        return string_as_ptr(&sbuf) as String;
    }
    ""
}

fn starts_with(line: *const u8, line_len: i64, prefix: *const u8, prefix_len: i64) -> bool {
    if line_len < prefix_len {
        return false;
    }
    let mut i: i64 = 0;
    while i < prefix_len {
        if unsafe { line[i] != prefix[i] } {
            return false;
        }
        i = i + 1;
    }
    true
}

pub fn parse_manifest(toml_content: String, interner: &mut Interner, arena: *mut u8) -> *mut PackageManifest {
    let content_ptr = toml_content as *const u8;
    let total_len = unsafe { strlen(content_ptr) } as i64;

    let mut pkg_name_sym: i64 = 0;
    let mut pkg_version_str = "0.1.0";
    let mut pkg_edition_sym: i64 = 0;

    let manifest = alloc_package_manifest(arena, 0, pkg_version_str, 0);

    let mut current_section: i64 = 0; // 1 = [package], 2 = [dependencies]
    let mut line_start: i64 = 0;

    while line_start < total_len {
        // Find line end
        let mut line_end = line_start;
        while line_end < total_len && unsafe { content_ptr[line_end] } != 10 && unsafe { content_ptr[line_end] } != 13 {
            line_end = line_end + 1;
        }

        // Trim leading whitespace
        let mut p = line_start;
        while p < line_end && (unsafe { content_ptr[p] } == 32 || unsafe { content_ptr[p] } == 9) {
            p = p + 1;
        }

        let line_len = line_end - p;
        let line = (content_ptr as usize + p as usize) as *const u8;

        if line_len > 0 && unsafe { line[0] } != 35 { // skip empty and '#' comments
            if starts_with(line, line_len, "[package]" as *const u8, 9) {
                current_section = 1;
            } else if starts_with(line, line_len, "[dependencies]" as *const u8, 14) {
                current_section = 2;
            } else if current_section == 1 {
                // In [package]
                if starts_with(line, line_len, "name" as *const u8, 4) {
                    let s = extract_quoted_string(line, line_len, arena);
                    pkg_name_sym = interner_intern(interner, s);
                    manifest.sym = pkg_name_sym;
                } else if starts_with(line, line_len, "version" as *const u8, 7) {
                    pkg_version_str = extract_quoted_string(line, line_len, arena);
                    manifest.str_val = pkg_version_str;
                } else if starts_with(line, line_len, "edition" as *const u8, 7) {
                    let s = extract_quoted_string(line, line_len, arena);
                    pkg_edition_sym = interner_intern(interner, s);
                    manifest.op = pkg_edition_sym;
                }
            } else if current_section == 2 {
                // In [dependencies]
                // Parse: dep_name = ...
                let mut eq_pos: i64 = 0;
                while eq_pos < line_len && unsafe { line[eq_pos] } != 61 { // '='
                    eq_pos = eq_pos + 1;
                }
                if eq_pos < line_len {
                    // Extract dep_name
                    let mut name_end = eq_pos;
                    while name_end > 0 && (unsafe { line[name_end - 1] } == 32 || unsafe { line[name_end - 1] } == 9) {
                        name_end = name_end - 1;
                    }
                    let mut sbuf = string_buffer_from_utf8_in(arena, line, name_end);
                    string_buffer_push_byte(&mut sbuf, 0 as u8);
                    let dep_name = string_as_ptr(&sbuf) as String;
                    let dep_name_sym = interner_intern(interner, dep_name);

                    // Value part after '='
                    let val_ptr = (line as usize + (eq_pos + 1) as usize) as *const u8;
                    let val_len = line_len - (eq_pos + 1);

                    let mut dep_path = "";
                    let mut dep_ver = "1.0.0";

                    // Check if path is specified: path = "..."
                    let mut k: i64 = 0;
                    while k < val_len - 4 {
                        let sub = (val_ptr as usize + k as usize) as *const u8;
                        if starts_with(sub, val_len - k, "path" as *const u8, 4) {
                            dep_path = extract_quoted_string(sub, val_len - k, arena);
                            break;
                        }
                        k = k + 1;
                    }

                    // Check version
                    let v_str = extract_quoted_string(val_ptr, val_len, arena);
                    if unsafe { strlen(v_str as *const u8) } > 0 {
                        dep_ver = v_str;
                    }
                    let dep_ver_sym = interner_intern(interner, dep_ver);

                    let dep = alloc_package_dep(arena, dep_name_sym, dep_ver_sym, dep_path);
                    vec_push(&mut manifest.args, dep);
                }
            }
        }

        // Advance past newline
        while line_end < total_len && (unsafe { content_ptr[line_end] } == 10 || unsafe { content_ptr[line_end] } == 13) {
            line_end = line_end + 1;
        }
        line_start = line_end;
    }

    manifest
}

pub fn package_load_manifest(path: String, interner: &mut Interner, arena: *mut u8) -> *mut PackageManifest yields [FS, Diagnostics] {
    let toml = fs_read_to_string_in(path, arena);
    let toml_len = unsafe { strlen(toml as *const u8) } as i64;
    if toml_len == 0 {
        report_err("Failed to read Forge.toml manifest", 1, 1);
        return alloc_package_manifest(arena, 0, "", 0);
    }
    parse_manifest(toml, interner, arena)
}

pub fn package_print_info(manifest: *mut PackageManifest, interner: &Interner) {
    if manifest.sym == 0 {
        unsafe {
            puts("Package: (unnamed)" as *const u8);
            fflush(0 as *const u8);
        }
        return;
    }

    let name = interner_lookup(interner, manifest.sym);
    unsafe {
        puts("=== Package Manifest ===" as *const u8);
        puts(name as *const u8);
        puts(manifest.str_val as *const u8);
        fflush(0 as *const u8);
    }
}

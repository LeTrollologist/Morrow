// Tungsten Self-Hosting Compiler - Type Checker & Refinement Solver (compiler::typeck)
// Enforces Static Typing, Refinement Intervals, Algebraic Effect Rows, and Region Escape Safety

import std::collections;
import compiler::diagnostics;
import compiler::interner;
import compiler::ast;

extern "C" {
    fn strcmp(s1: *const u8, s2: *const u8) -> i32;
    fn strlen(s: *const u8) -> usize;
    fn tungsten_alloc(size: i64, align: i64) -> *mut u8;
}

// -----------------------------------------------------------------------------
// Type Representation
// -----------------------------------------------------------------------------
pub fn ty_unknown() -> i64 { 0 }
pub fn ty_int() -> i64 { 1 }
pub fn ty_byte() -> i64 { 2 }
pub fn ty_bool() -> i64 { 3 }
pub fn ty_string() -> i64 { 4 }
pub fn ty_unit() -> i64 { 5 }
pub fn ty_ptr() -> i64 { 6 }
pub fn ty_ref() -> i64 { 7 }
pub fn ty_struct() -> i64 { 8 }
pub fn ty_fn() -> i64 { 9 }
pub fn ty_continuation() -> i64 { 10 }

// Memory layout aligned with AstExpr (offsets 0..6)
pub struct TcType {
    kind: i64,          // 0: ty_int(), ty_byte(), etc.
    sym: i64,           // 1: Symbol ID of type name or struct name
    int_val: i64,       // 2: Refinement interval min
    is_refined: i64,    // 3: 1 if interval refined, 0 if unrefined
    op: i64,            // 4: Refinement interval max (-1 if unrefined)
    left: *mut TcType,  // 5: Inner type (for Ref/Ptr/Continuation)
    right: *mut TcType, // 6: Region info
}

pub fn alloc_tc_type(arena: *mut u8, kind: i64, sym: i64) -> *mut TcType {
    let t = unsafe { tungsten_alloc(64, 8) as *mut TcType };
    t.kind = kind;
    t.sym = sym;
    t.int_val = 0;
    t.is_refined = 0;
    t.op = 0 - 1; // -1 indicates no interval refinement
    t.left = 0 as *mut TcType;
    t.right = 0 as *mut TcType;
    t
}

pub fn alloc_tc_refined(arena: *mut u8, kind: i64, min_val: i64, max_val: i64) -> *mut TcType {
    let t = alloc_tc_type(arena, kind, 0);
    t.int_val = min_val;
    t.op = max_val;
    t.is_refined = 1;
    t
}

pub fn tc_is_refined(t: *mut TcType) -> bool {
    if t == (0 as *mut TcType) {
        return false;
    }
    t.is_refined == 1
}

pub fn tc_min2(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

pub fn tc_max2(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

pub fn tc_min4(a: i64, b: i64, c: i64, d: i64) -> i64 {
    tc_min2(tc_min2(a, b), tc_min2(c, d))
}

pub fn tc_max4(a: i64, b: i64, c: i64, d: i64) -> i64 {
    tc_max2(tc_max2(a, b), tc_max2(c, d))
}

pub fn alloc_tc_ref(arena: *mut u8, inner: *mut TcType) -> *mut TcType {
    let t = alloc_tc_type(arena, ty_ref(), 0);
    t.left = inner;
    t
}

pub fn alloc_tc_continuation(arena: *mut u8, op_ret_ty: *mut TcType) -> *mut TcType {
    let t = alloc_tc_type(arena, ty_continuation(), 0);
    t.left = op_ret_ty;
    t
}

// -----------------------------------------------------------------------------
// Type Checker State
// -----------------------------------------------------------------------------
pub struct TypeChecker {
    tokens: Vec<*mut Token>,        // 0: Unused
    pos: i64,                       // 1: Error count
    interner: *mut Interner,        // 2: Interner pointer
    arena: *mut u8,                 // 3: Scratch region arena
    effect_defs: *mut HashMap,      // 4: Map of effect name -> *mut AstEffect
    active_yields: *mut Vec<i64>,   // 5: Current function's declared yields
    handled_effects: *mut Vec<i64>, // 6: Stack of active handled effect symbols
    linear_vars: *mut HashMap,      // 7: Map of var name -> i64 status (1=active, 2=consumed, 3=leaked/reported)
    linear_names: *mut Vec<String>, // 8: Vec of active linear resource variable names
}

pub fn typechecker_new_in(interner: *mut Interner, arena: *mut u8) -> TypeChecker {
    let empty_tokens: Vec<*mut Token> = vec_new_in(arena);
    TypeChecker {
        tokens: empty_tokens,
        pos: 0,
        interner: interner,
        arena: arena,
        effect_defs: 0 as *mut HashMap,
        active_yields: 0 as *mut Vec<i64>,
        handled_effects: 0 as *mut Vec<i64>,
        linear_vars: 0 as *mut HashMap,
        linear_names: 0 as *mut Vec<String>,
    }
}

pub fn tc_is_linear_struct(tc: &TypeChecker, struct_defs: &HashMap, sym: i64) -> bool {
    if sym == 0 {
        return false;
    }
    let interner_ref = tc.interner as &Interner;
    let s = interner_lookup(interner_ref, sym);
    let st_val = hashmap_get(struct_defs, s);
    if st_val != 0 - 1 {
        let st = st_val as *mut AstStruct;
        return st.is_linear == 1;
    }
    false
}

pub fn tc_is_effect_covered(tc: &TypeChecker, eff_sym: i64) -> bool {
    // 1. Check active handled_effects stack
    if tc.handled_effects != (0 as *mut Vec<i64>) {
        let handled_ref = unsafe { tc.handled_effects as &Vec<i64> };
        let mut hi: i64 = 0;
        while hi < handled_ref.len {
            if vec_get(handled_ref, hi) == eff_sym {
                return true;
            }
            hi = hi + 1;
        }
    }
    // 2. Check active function yields contract
    if tc.active_yields != (0 as *mut Vec<i64>) {
        let yields_ref = unsafe { tc.active_yields as &Vec<i64> };
        let mut yi: i64 = 0;
        while yi < yields_ref.len {
            if vec_get(yields_ref, yi) == eff_sym {
                return true;
            }
            yi = yi + 1;
        }
    }
    false
}

pub fn tc_init_prelude(tc: &mut TypeChecker, types: &mut HashMap) {
    let t_int = alloc_tc_type(tc.arena, ty_int(), 0);
    let t_byte = alloc_tc_type(tc.arena, ty_byte(), 0);
    let t_bool = alloc_tc_type(tc.arena, ty_bool(), 0);
    let t_str = alloc_tc_type(tc.arena, ty_string(), 0);
    let t_unit = alloc_tc_type(tc.arena, ty_unit(), 0);

    hashmap_insert(types, "i64", t_int as i64);
    hashmap_insert(types, "usize", t_int as i64);
    hashmap_insert(types, "isize", t_int as i64);
    hashmap_insert(types, "int", t_int as i64);
    hashmap_insert(types, "u64", t_int as i64);
    hashmap_insert(types, "u32", t_int as i64);
    hashmap_insert(types, "i32", t_int as i64);
    hashmap_insert(types, "u16", t_int as i64);
    hashmap_insert(types, "i16", t_int as i64);
    hashmap_insert(types, "u8", t_byte as i64);
    hashmap_insert(types, "i8", t_byte as i64);
    hashmap_insert(types, "byte", t_byte as i64);
    hashmap_insert(types, "bool", t_bool as i64);
    hashmap_insert(types, "String", t_str as i64);
    hashmap_insert(types, "string", t_str as i64);
    hashmap_insert(types, "void", t_unit as i64);
    let t_cont = alloc_tc_type(tc.arena, ty_continuation(), 0);
    hashmap_insert(types, "Continuation", t_cont as i64);

    // Standard prelude refinements
    let t_pct = alloc_tc_refined(tc.arena, ty_byte(), 0, 100);
    t_pct.sym = 1;
    hashmap_insert(types, "Percentage", t_pct as i64);

    let t_port = alloc_tc_refined(tc.arena, ty_int(), 1, 65535);
    t_port.sym = 1;
    hashmap_insert(types, "Port", t_port as i64);

    let t_byte_val = alloc_tc_refined(tc.arena, ty_byte(), 0, 255);
    t_byte_val.sym = 1;
    hashmap_insert(types, "Byte", t_byte_val as i64);
}

pub fn tc_resolve_type(tc: &mut TypeChecker, types: &HashMap, struct_defs: &HashMap, sym: i64) -> *mut TcType {
    if sym == 0 {
        return alloc_tc_type(tc.arena, ty_unit(), 0);
    }
    let interner_ref = tc.interner as &Interner;
    let s = interner_lookup(interner_ref, sym);
    let val = hashmap_get(types, s);
    if val != 0 - 1 {
        return val as *mut TcType;
    }
    // Check if struct
    let s_val = hashmap_get(struct_defs, s);
    if s_val != 0 - 1 {
        return alloc_tc_type(tc.arena, ty_struct(), sym);
    }
    // Default fallback to Int for scalar types
    alloc_tc_type(tc.arena, ty_int(), sym)
}

// -----------------------------------------------------------------------------
// Type Checking Expressions
// -----------------------------------------------------------------------------
pub fn tc_expr(tc: &mut TypeChecker, vars: &HashMap, fn_defs: &HashMap, ext_defs: &HashMap, types: &HashMap, struct_defs: &HashMap, expr: *mut AstExpr) -> *mut TcType yields [Diagnostics] {
    if expr == (0 as *mut AstExpr) {
        return alloc_tc_type(tc.arena, ty_unit(), 0);
    }
    let kind = expr.kind;

    if kind == expr_int() {
        let val = expr.int_val;
        return alloc_tc_refined(tc.arena, ty_int(), val, val);
    }

    if kind == expr_str() {
        return alloc_tc_type(tc.arena, ty_string(), 0);
    }

    if kind == expr_var() {
        let sym = expr.sym;
        let interner_ref = tc.interner as &Interner;
        let s = interner_lookup(interner_ref, sym);

        if tc.linear_vars != (0 as *mut HashMap) {
            let status = hashmap_get(tc.linear_vars, s);
            if status == 2 {
                report_err("Linear Resource Violation: use-after-consume of resource variable", 1, 1);
                tc.pos = tc.pos + 1;
            }
        }

        if unsafe { strcmp(s as *const u8, "true" as *const u8) == 0 || strcmp(s as *const u8, "false" as *const u8) == 0 } {
            return alloc_tc_type(tc.arena, ty_bool(), 0);
        }
        if unsafe { strcmp(s as *const u8, "null" as *const u8) == 0 } {
            return alloc_tc_type(tc.arena, ty_ptr(), 0);
        }

        let ty_val = hashmap_get(vars, s);
        if ty_val != 0 - 1 {
            return ty_val as *mut TcType;
        }

        // Check if global function
        let fn_val = hashmap_get(fn_defs, s);
        if fn_val != 0 - 1 {
            return alloc_tc_type(tc.arena, ty_fn(), sym);
        }

        let ext_val = hashmap_get(ext_defs, s);
        if ext_val != 0 - 1 {
            return alloc_tc_type(tc.arena, ty_fn(), sym);
        }

        report_err("Undefined variable identifier", 1, 1);
        tc.pos = tc.pos + 1; // Increment error count
        return alloc_tc_type(tc.arena, ty_unknown(), 0);
    }

    if kind == expr_unary() {
        let inner_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, expr.left);
        let op = expr.op;
        if op == tok_bang() {
            return alloc_tc_type(tc.arena, ty_bool(), 0);
        }
        if op == tok_minus() {
            if tc_is_refined(inner_ty) {
                let min = 0 - inner_ty.op;
                let max = 0 - inner_ty.int_val;
                return alloc_tc_refined(tc.arena, inner_ty.kind, min, max);
            }
            return inner_ty;
        }
        if op == tok_amp() {
            return alloc_tc_ref(tc.arena, inner_ty);
        }
        return inner_ty;
    }

    if kind == expr_binop() {
        let l_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, expr.left);
        let r_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, expr.right);
        let op = expr.op;

        // Comparison operators return bool
        if op == tok_eqeq() || op == tok_neq() || op == tok_lt() || op == tok_lte() || op == tok_gt() || op == tok_gte() {
            return alloc_tc_type(tc.arena, ty_bool(), 0);
        }
        if op == tok_and() || op == tok_or() {
            return alloc_tc_type(tc.arena, ty_bool(), 0);
        }

        if r_ty != (0 as *mut TcType) {
            if op == tok_slash() {
                if tc_is_refined(r_ty) {
                    if r_ty.int_val <= 0 && r_ty.op >= 0 {
                        report_err("Refinement Violation: potential division by zero (divisor interval spans 0)", 1, 1);
                        tc.pos = tc.pos + 1;
                    }
                }
            }
            if op == tok_percent() {
                if r_ty.int_val <= 0 && r_ty.op >= 0 {
                    report_err("Refinement Violation: potential division by zero in modulo operation", 1, 1);
                    tc.pos = tc.pos + 1;
                }
            }
        }

        // Arithmetic operators compute refinement intervals if both operands are refined
        if l_ty != (0 as *mut TcType) {
            if r_ty != (0 as *mut TcType) {
                if tc_is_refined(l_ty) && tc_is_refined(r_ty) {
                    if op == tok_plus() {
                        return alloc_tc_refined(tc.arena, ty_int(), l_ty.int_val + r_ty.int_val, l_ty.op + r_ty.op);
                    }
                    if op == tok_minus() {
                        return alloc_tc_refined(tc.arena, ty_int(), l_ty.int_val - r_ty.op, l_ty.op - r_ty.int_val);
                    }
                    if op == tok_star() {
                        let p1 = l_ty.int_val * r_ty.int_val;
                        let p2 = l_ty.int_val * r_ty.op;
                        let p3 = l_ty.op * r_ty.int_val;
                        let p4 = l_ty.op * r_ty.op;
                        let min_prod = tc_min4(p1, p2, p3, p4);
                        let max_prod = tc_max4(p1, p2, p3, p4);
                        return alloc_tc_refined(tc.arena, ty_int(), min_prod, max_prod);
                    }
                    if op == tok_slash() {
                        if !(r_ty.int_val <= 0 && r_ty.op >= 0) {
                            let q1 = l_ty.int_val / r_ty.int_val;
                            let q2 = l_ty.int_val / r_ty.op;
                            let q3 = l_ty.op / r_ty.int_val;
                            let q4 = l_ty.op / r_ty.op;
                            let min_q = tc_min4(q1, q2, q3, q4);
                            let max_q = tc_max4(q1, q2, q3, q4);
                            return alloc_tc_refined(tc.arena, ty_int(), min_q, max_q);
                        }
                    }
                    if op == tok_percent() {
                        if !(r_ty.int_val <= 0 && r_ty.op >= 0) {
                            if r_ty.int_val > 0 {
                                let rem_max = r_ty.op - 1;
                                let mut rem_min: i64 = 0;
                                if l_ty.int_val < 0 {
                                    rem_min = 0 - rem_max;
                                }
                                return alloc_tc_refined(tc.arena, ty_int(), rem_min, rem_max);
                            }
                        }
                    }
                }
            }
        }

        return alloc_tc_type(tc.arena, ty_int(), 0);
    }

    if kind == expr_call() {
        let fn_sym = expr.sym;
        let interner_ref = tc.interner as &Interner;
        let s = interner_lookup(interner_ref, fn_sym);

        if unsafe { strcmp(s as *const u8, "consume" as *const u8) == 0 || strcmp(s as *const u8, "drop" as *const u8) == 0 } {
            if expr.args.len > 0 {
                let arg0 = vec_get(&expr.args, 0);
                if arg0 != (0 as *mut AstExpr) && arg0.kind == expr_var() {
                    let arg_s = interner_lookup(interner_ref, arg0.sym);
                    if tc.linear_vars != (0 as *mut HashMap) {
                        let st = hashmap_get(tc.linear_vars, arg_s);
                        if st == 1 {
                            hashmap_insert(tc.linear_vars, arg_s, 2);
                        }
                    }
                }
            }
            return alloc_tc_type(tc.arena, ty_unit(), 0);
        }

        let fn_val = hashmap_get(fn_defs, s);
        let mut target_fn: *mut AstFn = 0 as *mut AstFn;
        if fn_val != 0 - 1 {
            target_fn = fn_val as *mut AstFn;
        }

        // Type check argument expressions and verify parameter refinement constraints
        let args_len = expr.args.len;
        let mut i: i64 = 0;
        while i < args_len {
            let arg_expr = vec_get(&expr.args, i);
            let arg_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, arg_expr);

            // Linear consumption: passing a linear resource variable to a function consumes it
            if arg_expr != (0 as *mut AstExpr) && arg_expr.kind == expr_var() {
                let arg_s = interner_lookup(interner_ref, arg_expr.sym);
                if tc.linear_vars != (0 as *mut HashMap) {
                    let st = hashmap_get(tc.linear_vars, arg_s);
                    if st == 1 {
                        hashmap_insert(tc.linear_vars, arg_s, 2);
                    }
                }
            }

            if target_fn != (0 as *mut AstFn) {
                if i < target_fn.params.len {
                    let p = vec_get(&target_fn.params, i);
                    let param_ty = tc_resolve_type(tc, types, struct_defs, p.ty_sym);
                    if param_ty != (0 as *mut TcType) {
                        if arg_ty != (0 as *mut TcType) {
                            if param_ty.sym != 0 {
                                if tc_is_refined(param_ty) {
                                    if tc_is_refined(arg_ty) {
                                        if arg_ty.int_val < param_ty.int_val || arg_ty.op > param_ty.op {
                                            report_err("Refinement Constraint Violation: argument out of bounds for refined parameter", 1, 1);
                                            tc.pos = tc.pos + 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }

        // Check user function return
        if target_fn != (0 as *mut AstFn) {
            // Static Invariant: Check effect propagation
            let mut ei: i64 = 0;
            while ei < target_fn.yields_effects.len {
                let eff_sym = vec_get(&target_fn.yields_effects, ei);
                if !tc_is_effect_covered(tc, eff_sym) {
                    report_err("Unhandled effect in function call; must be declared in yields contract or handled", 1, 1);
                    tc.pos = tc.pos + 1;
                }
                ei = ei + 1;
            }
            let ret_sym = target_fn.ret_ty_sym;
            return tc_resolve_type(tc, types, struct_defs, ret_sym);
        }

        // Check extern function
        let ext_val = hashmap_get(ext_defs, s);
        if ext_val != 0 - 1 {
            let ext = ext_val as *mut AstExternFn;
            let ret_sym = ext.ret_ty_sym;
            return tc_resolve_type(tc, types, struct_defs, ret_sym);
        }

        return alloc_tc_type(tc.arena, ty_int(), 0);
    }

    if kind == expr_field() {
        let base_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, expr.left);
        let field_sym = expr.sym;
        if base_ty != (0 as *mut TcType) && base_ty.sym != 0 {
            let interner_ref = tc.interner as &Interner;
            let s = interner_lookup(interner_ref, base_ty.sym);
            let st_val = hashmap_get(struct_defs, s);
            if st_val != 0 - 1 {
                let st = st_val as *mut AstStruct;
                let mut fi: i64 = 0;
                while fi < st.fields.len {
                    let f = vec_get(&st.fields, fi);
                    if f.name_sym == field_sym {
                        expr.op = fi + 1;
                        return tc_resolve_type(tc, types, struct_defs, f.ty_sym);
                    }
                    fi = fi + 1;
                }
            }
        }
        return alloc_tc_type(tc.arena, ty_int(), field_sym);
    }

    if kind == expr_index() {
        let base_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, expr.left);
        let idx_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, expr.right);
        if base_ty != (0 as *mut TcType) {
            if base_ty.kind == ty_byte() {
                expr.op = 1;
                return alloc_tc_type(tc.arena, ty_byte(), 0);
            }
            if base_ty.kind == ty_int() || base_ty.kind == ty_struct() || base_ty.kind == ty_ptr() || base_ty.kind == ty_ref() {
                expr.op = 8;
                return alloc_tc_type(tc.arena, ty_int(), 0);
            }
        }
        return alloc_tc_type(tc.arena, ty_byte(), 0);
    }

    if kind == expr_cast() {
        let inner_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, expr.left);
        let target_sym = expr.sym;
        let target_ty = tc_resolve_type(tc, types, struct_defs, target_sym);
        if target_ty != (0 as *mut TcType) {
            if inner_ty != (0 as *mut TcType) {
                if target_ty.op >= 0 {
                    if inner_ty.op >= 0 {
                        if inner_ty.int_val < target_ty.int_val || inner_ty.op > target_ty.op {
                            report_err("Refinement Constraint Violation: value out of bounds for refined type", 1, 1);
                            tc.pos = tc.pos + 1;
                        }
                    }
                }
            }
        }
        return target_ty;
    }

    if kind == expr_struct_init() {
        let struct_sym = expr.sym;
        let args_len = expr.args.len;
        let mut i: i64 = 0;
        while i < args_len {
            let arg_expr = vec_get(&expr.args, i);
            tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, arg_expr);
            i = i + 1;
        }
        return alloc_tc_type(tc.arena, ty_struct(), struct_sym);
    }

    if kind == expr_perform() {
        let eff_sym = expr.sym;
        let op_sym = expr.op;
        let interner_ref = tc.interner as &Interner;
        let eff_name = interner_lookup(interner_ref, eff_sym);
        let eff_val = hashmap_get(tc.effect_defs as &HashMap, eff_name);
        if eff_val == 0 - 1 {
            report_err("Unknown effect in perform", 1, 1);
            tc.pos = tc.pos + 1;
            return alloc_tc_type(tc.arena, ty_int(), 0);
        }
        let eff = eff_val as *mut AstEffect;
        let mut target_op = 0 as *mut AstEffectOp;
        let mut oi: i64 = 0;
        while oi < eff.ops.len {
            let candidate = vec_get(&eff.ops, oi);
            if candidate.name_sym == op_sym {
                target_op = candidate;
                break;
            }
            oi = oi + 1;
        }
        if target_op == (0 as *mut AstEffectOp) {
            report_err("Unknown effect operation in perform", 1, 1);
            tc.pos = tc.pos + 1;
            return alloc_tc_type(tc.arena, ty_int(), 0);
        }

        // Validate argument count and types
        if expr.args.len != target_op.params.len {
            report_err("Effect operation argument count mismatch", 1, 1);
            tc.pos = tc.pos + 1;
        } else {
            let mut ai: i64 = 0;
            while ai < expr.args.len {
                let arg_node = vec_get(&expr.args, ai);
                let _arg_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, arg_node);
                ai = ai + 1;
            }
        }

        // Enforce Static Invariant 1:
        if !tc_is_effect_covered(tc, eff_sym) {
            report_err("Unhandled perform effect; must be declared in yields contract or handled", 1, 1);
            tc.pos = tc.pos + 1;
        }

        return tc_resolve_type(tc, types, struct_defs, target_op.ret_ty_sym);
    }

    if kind == expr_resume() {
        let k_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, expr.left);
        let val_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, expr.right);
        if k_ty.kind != ty_continuation() {
            report_err("First argument to resume must be a continuation", 1, 1);
            tc.pos = tc.pos + 1;
        } else {
            if k_ty.left != (0 as *mut TcType) {
                if val_ty.kind != ty_unknown() && k_ty.left.kind != ty_unknown() {
                    if val_ty.kind != k_ty.left.kind {
                        report_err("Resume value type does not match continuation expected type", 1, 1);
                        tc.pos = tc.pos + 1;
                    }
                }
            }
        }
        return alloc_tc_type(tc.arena, ty_unit(), 0);
    }

    if kind == expr_handle() {
        let eff_sym = expr.sym;
        let handler = expr.left as *mut AstHandler;
        let interner_ref = tc.interner as &Interner;
        let eff_name = interner_lookup(interner_ref, eff_sym);
        let eff_val = hashmap_get(tc.effect_defs as &HashMap, eff_name);
        if eff_val == 0 - 1 {
            report_err("Handler references undefined effect", 1, 1);
            tc.pos = tc.pos + 1;
            return alloc_tc_type(tc.arena, ty_int(), 0);
        }
        let eff = eff_val as *mut AstEffect;

        // Invariant 2: Check all operations in eff are implemented by handler
        let mut oi: i64 = 0;
        while oi < eff.ops.len {
            let required_op = vec_get(&eff.ops, oi);
            let mut found = false;
            let mut ai: i64 = 0;
            while ai < handler.arms.len {
                let arm = vec_get(&handler.arms, ai);
                if arm.op_sym == required_op.name_sym {
                    found = true;
                    if arm.params.len != required_op.params.len {
                        report_err("Handler arm parameter count mismatch", 1, 1);
                        tc.pos = tc.pos + 1;
                    }
                    break;
                }
                ai = ai + 1;
            }
            if !found {
                report_err("Handler does not implement all operations of effect", 1, 1);
                tc.pos = tc.pos + 1;
            }
            oi = oi + 1;
        }

        // Typecheck each handler arm
        let mut arm_idx: i64 = 0;
        while arm_idx < handler.arms.len {
            let arm = vec_get(&handler.arms, arm_idx);
            let mut arm_vars = hashmap_new_in(tc.arena, 32);
            let mut vi: i64 = 0;
            while vi < vars.occupied.len {
                let idx = vec_get(&vars.occupied, vi);
                let k = vec_get(&vars.keys, idx);
                let v = vec_get(&vars.vals, idx);
                hashmap_insert(&mut arm_vars, k, v);
                vi = vi + 1;
            }
            let k_name = interner_lookup(interner_ref, arm.continuation_sym);
            let mut op_ret_ty = alloc_tc_type(tc.arena, ty_int(), 0);
            let mut op_i: i64 = 0;
            while op_i < eff.ops.len {
                let op = vec_get(&eff.ops, op_i);
                if op.name_sym == arm.op_sym {
                    op_ret_ty = tc_resolve_type(tc, types, struct_defs, op.ret_ty_sym);
                    break;
                }
                op_i = op_i + 1;
            }
            let k_ty = alloc_tc_continuation(tc.arena, op_ret_ty);
            hashmap_insert(&mut arm_vars, k_name, k_ty as i64);

            let mut pi: i64 = 0;
            while pi < arm.params.len {
                let p = vec_get(&arm.params, pi);
                let p_name = interner_lookup(interner_ref, p.name_sym);
                let p_ty = tc_resolve_type(tc, types, struct_defs, p.ty_sym);
                hashmap_insert(&mut arm_vars, p_name, p_ty as i64);
                pi = pi + 1;
            }

            let mut si: i64 = 0;
            while si < arm.body.len {
                let s = vec_get(&arm.body, si);
                tc_stmt(tc, &mut arm_vars, fn_defs, ext_defs, types, struct_defs, op_ret_ty, 0, 0, s);
                si = si + 1;
            }
            arm_idx = arm_idx + 1;
        }

        // Push effect onto handled_effects stack
        let handled_vec = unsafe { tc.handled_effects as &mut Vec<i64> };
        vec_push(handled_vec, eff_sym);

        // Typecheck handled body statements
        let mut body_ty = alloc_tc_type(tc.arena, ty_unit(), 0);
        let mut bi: i64 = 0;
        let mut body_vars = hashmap_new_in(tc.arena, 32);
        let mut vi: i64 = 0;
        while vi < vars.occupied.len {
            let idx = vec_get(&vars.occupied, vi);
            let k = vec_get(&vars.keys, idx);
            let v = vec_get(&vars.vals, idx);
            hashmap_insert(&mut body_vars, k, v);
            vi = vi + 1;
        }
        while bi < expr.stmts.len {
            let s = vec_get(&expr.stmts, bi);
            if bi == expr.stmts.len - 1 {
                if s.kind == stmt_expr() {
                    body_ty = tc_expr(tc, &body_vars, fn_defs, ext_defs, types, struct_defs, s.expr);
                } else {
                    tc_stmt(tc, &mut body_vars, fn_defs, ext_defs, types, struct_defs, body_ty, 0, 0, s);
                }
            } else {
                tc_stmt(tc, &mut body_vars, fn_defs, ext_defs, types, struct_defs, body_ty, 0, 0, s);
            }
            bi = bi + 1;
        }

        // Pop effect from handled_effects stack
        handled_vec.len = handled_vec.len - 1;

        return body_ty;
    }

    alloc_tc_type(tc.arena, ty_unit(), 0)
}

// -----------------------------------------------------------------------------
// Path-Sensitive Interval Narrowing
// -----------------------------------------------------------------------------
pub fn tc_narrow_condition(tc: &mut TypeChecker, vars: &mut HashMap, cond: *mut AstExpr, modified_syms: &mut Vec<i64>, original_types: &mut Vec<*mut TcType>) {
    if cond == (0 as *mut AstExpr) {
        return;
    }
    if cond.kind == expr_binop() {
        let op = cond.op;
        if op == tok_and() {
            tc_narrow_condition(tc, vars, cond.left, modified_syms, original_types);
            tc_narrow_condition(tc, vars, cond.right, modified_syms, original_types);
            return;
        }

        let mut var_sym: i64 = 0;
        let mut int_val: i64 = 0;
        let mut cmp_op: i64 = 0;

        if cond.left != (0 as *mut AstExpr) && cond.right != (0 as *mut AstExpr) {
            if cond.left.kind == expr_var() && cond.right.kind == expr_int() {
                var_sym = cond.left.sym;
                int_val = cond.right.int_val;
                cmp_op = op;
            } else if cond.left.kind == expr_int() && cond.right.kind == expr_var() {
                var_sym = cond.right.sym;
                int_val = cond.left.int_val;
                if op == tok_lt() { cmp_op = tok_gt(); }
                else if op == tok_lte() { cmp_op = tok_gte(); }
                else if op == tok_gt() { cmp_op = tok_lt(); }
                else if op == tok_gte() { cmp_op = tok_lte(); }
                else if op == tok_eqeq() { cmp_op = tok_eqeq(); }
            }
        }

        if var_sym != 0 {
            let interner_ref = tc.interner as &Interner;
            let s = interner_lookup(interner_ref, var_sym);
            let old_ty_val = hashmap_get(vars, s);
            if old_ty_val != 0 - 1 {
                let old_ty = old_ty_val as *mut TcType;
                let mut min_bound: i64 = 0 - 2147483647;
                let mut max_bound: i64 = 2147483647;
                if tc_is_refined(old_ty) {
                    min_bound = old_ty.int_val;
                    max_bound = old_ty.op;
                }

                let mut handled = false;
                if cmp_op == tok_gte() {
                    min_bound = tc_max2(min_bound, int_val);
                    handled = true;
                } else if cmp_op == tok_gt() {
                    min_bound = tc_max2(min_bound, int_val + 1);
                    handled = true;
                } else if cmp_op == tok_lte() {
                    max_bound = tc_min2(max_bound, int_val);
                    handled = true;
                } else if cmp_op == tok_lt() {
                    max_bound = tc_min2(max_bound, int_val - 1);
                    handled = true;
                } else if cmp_op == tok_eqeq() {
                    min_bound = tc_max2(min_bound, int_val);
                    max_bound = tc_min2(max_bound, int_val);
                    handled = true;
                } else if cmp_op == tok_neq() {
                    if int_val == 0 {
                        if min_bound == 0 {
                            min_bound = 1;
                            handled = true;
                        }
                        if max_bound == 0 {
                            max_bound = 0 - 1;
                            handled = true;
                        }
                    }
                }

                if handled && min_bound <= max_bound {
                    let mut already_saved = false;
                    let mut k: i64 = 0;
                    while k < modified_syms.len {
                        if vec_get(modified_syms, k) == var_sym {
                            already_saved = true;
                            break;
                        }
                        k = k + 1;
                    }
                    if !already_saved {
                        vec_push(modified_syms, var_sym);
                        vec_push(original_types, old_ty);
                    }
                    let narrowed_ty = alloc_tc_refined(tc.arena, old_ty.kind, min_bound, max_bound);
                    narrowed_ty.sym = old_ty.sym;
                    narrowed_ty.left = old_ty.left;
                    narrowed_ty.right = old_ty.right;
                    hashmap_insert(vars, s, narrowed_ty as i64);
                }
            }
        }
    }
}

// -----------------------------------------------------------------------------
// Type Checking Statements & Region Escape Analysis
// -----------------------------------------------------------------------------
pub fn tc_stmt(tc: &mut TypeChecker, vars: &mut HashMap, fn_defs: &HashMap, ext_defs: &HashMap, types: &HashMap, struct_defs: &HashMap, ret_ty: *mut TcType, region_depth: i64, cur_region_sym: i64, stmt: *mut AstStmt) -> bool yields [Diagnostics] {
    if stmt == (0 as *mut AstStmt) {
        return true;
    }
    let kind = stmt.kind;

    if kind == stmt_let() {
        let sym = stmt.sym;
        let interner_ref = tc.interner as &Interner;
        let s = interner_lookup(interner_ref, sym);
        let expr_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, stmt.expr);

        let var_ty = alloc_tc_type(tc.arena, expr_ty.kind, expr_ty.sym);
        if expr_ty != (0 as *mut TcType) {
            if tc_is_refined(expr_ty) {
                var_ty.int_val = expr_ty.int_val;
                var_ty.op = expr_ty.op;
                var_ty.is_refined = 1;
            }
            // Track linear struct resources
            if expr_ty.kind == ty_struct() && tc_is_linear_struct(tc, struct_defs, expr_ty.sym) {
                if tc.linear_vars != (0 as *mut HashMap) {
                    hashmap_insert(tc.linear_vars, s, 1);
                    vec_push(tc.linear_names, s);
                }
            }
        }
        // Region escape tagging: if inside a region block and the type is a pointer
        // or reference, mark it as region-scoped using the right field as a sentinel.
        if region_depth > 0 {
            if var_ty.kind == ty_ptr() || var_ty.kind == ty_ref() {
                var_ty.right = cur_region_sym as *mut TcType;
            }
        }
        hashmap_insert(vars, s, var_ty as i64);
        return true;
    }

    if kind == stmt_assign() {
        let sym = stmt.sym;
        let interner_ref = tc.interner as &Interner;
        let s = interner_lookup(interner_ref, sym);

        let var_ty_val = hashmap_get(vars, s);
        if var_ty_val == 0 - 1 {
            report_err("Assignment to undeclared variable", 1, 1);
            tc.pos = tc.pos + 1;
            return false;
        }

        let var_ty = var_ty_val as *mut TcType;
        let expr_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, stmt.expr);

        // Refinement Constraint Check: Verify RHS is within LHS intervals
        if var_ty != (0 as *mut TcType) {
            if expr_ty != (0 as *mut TcType) {
                if var_ty.sym != 0 {
                    if tc_is_refined(var_ty) {
                        if tc_is_refined(expr_ty) {
                            if expr_ty.int_val < var_ty.int_val || expr_ty.op > var_ty.op {
                                report_err("Refinement Constraint Violation: value out of bounds for refined type", 1, 1);
                                tc.pos = tc.pos + 1;
                                return false;
                            }
                        }
                    }
                }
            }
        }

        // Region escape check: reject assigning a region-scoped pointer to an outer variable.
        // A region-scoped value has right != null; an outer variable has right == null.
        if region_depth > 0 {
            if expr_ty != (0 as *mut TcType) {
                if expr_ty.right != (0 as *mut TcType) {
                    if var_ty != (0 as *mut TcType) {
                        if var_ty.right == (0 as *mut TcType) {
                            report_err("Region Escape Violation: region-scoped pointer assigned to outer-scope variable", 1, 1);
                            tc.pos = tc.pos + 1;
                            return false;
                        }
                    }
                }
            }
        }

        return true;
    }

    if kind == stmt_field_assign() {
        let base_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, stmt.left);
        tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, stmt.expr);
        if base_ty != (0 as *mut TcType) && base_ty.sym != 0 {
            let interner_ref = tc.interner as &Interner;
            let s = interner_lookup(interner_ref, base_ty.sym);
            let st_val = hashmap_get(struct_defs, s);
            if st_val != 0 - 1 {
                let st = st_val as *mut AstStruct;
                let mut fi: i64 = 0;
                while fi < st.fields.len {
                    let f = vec_get(&st.fields, fi);
                    if f.name_sym == stmt.sym {
                        stmt.right = (fi + 1) as *mut AstExpr;
                        break;
                    }
                    fi = fi + 1;
                }
            }
        }
        return true;
    }

    if kind == stmt_index_assign() {
        let base_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, stmt.left);
        tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, stmt.right);
        tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, stmt.expr);
        if base_ty != (0 as *mut TcType) {
            if base_ty.kind == ty_byte() {
                stmt.sym = 1;
            }
            if base_ty.kind == ty_int() || base_ty.kind == ty_struct() || base_ty.kind == ty_ptr() || base_ty.kind == ty_ref() {
                stmt.sym = 8;
            }
        }
        return true;
    }

    if kind == stmt_return() {
        let ret_expr = stmt.expr;
        if ret_expr != (0 as *mut AstExpr) {
            let actual_ty = tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, ret_expr);

            // Check if returning a linear resource
            if ret_expr.kind == expr_var() {
                let ret_sym = ret_expr.sym;
                let interner_ref = tc.interner as &Interner;
                let ret_s = interner_lookup(interner_ref, ret_sym);
                if tc.linear_vars != (0 as *mut HashMap) {
                    let st = hashmap_get(tc.linear_vars, ret_s);
                    if st == 1 {
                        hashmap_insert(tc.linear_vars, ret_s, 2); // Transferred ownership to caller
                    }
                }
            }

            // Check for linear resource leaks on return
            if tc.linear_names != (0 as *mut Vec<String>) && tc.linear_vars != (0 as *mut HashMap) {
                let l_len = tc.linear_names.len;
                let mut li: i64 = 0;
                while li < l_len {
                    let name_str = vec_get(tc.linear_names, li);
                    let st = hashmap_get(tc.linear_vars, name_str);
                    if st == 1 {
                        report_err("Linear Resource Violation: resource dropped without being consumed (potential resource leak)", 1, 1);
                        tc.pos = tc.pos + 1;
                        hashmap_insert(tc.linear_vars, name_str, 3);
                    }
                    li = li + 1;
                }
            }
            if ret_ty != (0 as *mut TcType) {
                if actual_ty != (0 as *mut TcType) {
                    if ret_ty.sym != 0 {
                        if tc_is_refined(ret_ty) {
                            if tc_is_refined(actual_ty) {
                                if actual_ty.int_val < ret_ty.int_val || actual_ty.op > ret_ty.op {
                                    report_err("Refinement Constraint Violation: return value out of bounds for refined return type", 1, 1);
                                    tc.pos = tc.pos + 1;
                                    return false;
                                }
                            }
                        }
                    }
                }
            }
            // Region escape check: reject returning a region-scoped pointer.
            // actual_ty.right != null means it was tagged inside a region block.
            if region_depth > 0 {
                if actual_ty != (0 as *mut TcType) {
                    if actual_ty.right != (0 as *mut TcType) {
                        report_err("Region Escape Violation: region-scoped pointer returned from function", 1, 1);
                        tc.pos = tc.pos + 1;
                        return false;
                    }
                }
            }
        }
        return true;
    }

    if kind == stmt_expr() {
        tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, stmt.expr);
        return true;
    }

    if kind == stmt_if() {
        tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, stmt.expr);

        // Path-sensitive interval narrowing for then-branch
        let mut modified_syms: Vec<i64> = vec_new_in(tc.arena);
        let mut original_types: Vec<*mut TcType> = vec_new_in(tc.arena);
        tc_narrow_condition(tc, vars, stmt.expr, &mut modified_syms, &mut original_types);

        let then_len = stmt.then_stmts.len;
        let mut i: i64 = 0;
        while i < then_len {
            let s = vec_get(&stmt.then_stmts, i);
            tc_stmt(tc, vars, fn_defs, ext_defs, types, struct_defs, ret_ty, region_depth, cur_region_sym, s);
            i = i + 1;
        }

        // Restore narrowed variables
        let restore_len = modified_syms.len;
        let mut r: i64 = 0;
        while r < restore_len {
            let sym = vec_get(&modified_syms, r);
            let orig_ty = vec_get(&original_types, r);
            let interner_ref = tc.interner as &Interner;
            let s = interner_lookup(interner_ref, sym);
            hashmap_insert(vars, s, orig_ty as i64);
            r = r + 1;
        }

        let else_len = stmt.else_stmts.len;
        let mut j: i64 = 0;
        while j < else_len {
            let s = vec_get(&stmt.else_stmts, j);
            tc_stmt(tc, vars, fn_defs, ext_defs, types, struct_defs, ret_ty, region_depth, cur_region_sym, s);
            j = j + 1;
        }
        return true;
    }

    if kind == stmt_while() {
        tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, stmt.expr);
        let body_len = stmt.then_stmts.len;
        let mut i: i64 = 0;
        while i < body_len {
            let s = vec_get(&stmt.then_stmts, i);
            tc_stmt(tc, vars, fn_defs, ext_defs, types, struct_defs, ret_ty, region_depth, cur_region_sym, s);
            i = i + 1;
        }
        return true;
    }

    if kind == stmt_block() {
        // Determine the region depth and sym for this block.
        // stmt.sym != 0 means it is a named region block: enter a new region scope.
        let mut blk_depth = region_depth;
        let mut blk_region_sym = cur_region_sym;
        if stmt.sym != 0 {
            let sym = stmt.sym;
            let interner_ref = tc.interner as &Interner;
            let s = interner_lookup(interner_ref, sym);
            let reg_ty = alloc_tc_type(tc.arena, ty_ptr(), 0);
            hashmap_insert(vars, s, reg_ty as i64);
            blk_depth = region_depth + 1;
            blk_region_sym = stmt.sym;
        }
        let body_len = stmt.then_stmts.len;
        let mut i: i64 = 0;
        while i < body_len {
            let s = vec_get(&stmt.then_stmts, i);
            tc_stmt(tc, vars, fn_defs, ext_defs, types, struct_defs, ret_ty, blk_depth, blk_region_sym, s);
            i = i + 1;
        }
        return true;
    }

    if kind == stmt_break() {
        return true;
    }

    if kind == stmt_handle() {
        if stmt.handler != (0 as *mut AstHandler) {
            let handle_expr = alloc_expr_handle(tc.arena, stmt.sym, stmt.then_stmts, stmt.handler);
            tc_expr(tc, vars, fn_defs, ext_defs, types, struct_defs, handle_expr);
        }
        return true;
    }

    true
}

// -----------------------------------------------------------------------------
// Type Checking Functions & Program
// -----------------------------------------------------------------------------
pub fn tc_function(tc: &mut TypeChecker, fn_defs: &HashMap, ext_defs: &HashMap, types: &HashMap, struct_defs: &HashMap, f: *mut AstFn) -> bool yields [Diagnostics] {
    tc.active_yields = &mut f.yields_effects as *mut Vec<i64>;
    let interner_ref = tc.interner as &Interner;
    let fn_name = interner_lookup(interner_ref, f.name_sym);
    let mut vars = hashmap_new_in(tc.arena, 64);
    let mut linear_vars = hashmap_new_in(tc.arena, 32);
    let mut linear_names: Vec<String> = vec_new_in(tc.arena);
    tc.linear_vars = &mut linear_vars as *mut HashMap;
    tc.linear_names = &mut linear_names as *mut Vec<String>;

    let params_len = f.params.len;
    let mut i: i64 = 0;
    while i < params_len {
        let p = vec_get(&f.params, i);
        let sym = p.name_sym;
        let ty_sym = p.ty_sym;
        let interner_ref = tc.interner as &Interner;
        let s = interner_lookup(interner_ref, sym);
        let p_ty = tc_resolve_type(tc, types, struct_defs, ty_sym);
        hashmap_insert(&mut vars, s, p_ty as i64);
        if p_ty != (0 as *mut TcType) && p_ty.kind == ty_struct() && tc_is_linear_struct(tc, struct_defs, p_ty.sym) {
            hashmap_insert(&mut linear_vars, s, 1);
            vec_push(&mut linear_names, s);
        }
        i = i + 1;
    }

    let ret_ty = tc_resolve_type(tc, types, struct_defs, f.ret_ty_sym);

    let body_len = f.body.len;
    let mut j: i64 = 0;
    while j < body_len {
        let stmt = vec_get(&f.body, j);
        tc_stmt(tc, &mut vars, fn_defs, ext_defs, types, struct_defs, ret_ty, 0, 0, stmt);
        j = j + 1;
    }

    let l_len = linear_names.len;
    let mut li: i64 = 0;
    while li < l_len {
        let name_str = vec_get(&linear_names, li);
        let st = hashmap_get(&linear_vars, name_str);
        if st == 1 {
            report_err("Linear Resource Violation: resource dropped without being consumed (potential resource leak)", 1, 1);
            tc.pos = tc.pos + 1;
            hashmap_insert(&mut linear_vars, name_str, 3);
        }
        li = li + 1;
    }

    true
}

pub fn typecheck_program(prog: *mut AstProgram, interner: *mut Interner, arena: *mut u8) -> bool yields [Diagnostics] {
    let mut tc = typechecker_new_in(interner, arena);
    let mut types = hashmap_new_in(arena, 64);
    let mut struct_defs = hashmap_new_in(arena, 64);
    let mut fn_defs = hashmap_new_in(arena, 128);
    let mut ext_defs = hashmap_new_in(arena, 64);

    // Register effect definitions
    let mut effect_defs = hashmap_new_in(arena, 32);
    let effs_len = prog.effects.len;
    let mut ei: i64 = 0;
    while ei < effs_len {
        let eff = vec_get(&prog.effects, ei);
        let sym = eff.name_sym;
        let interner_ref = interner as &Interner;
        let s = interner_lookup(interner_ref, sym);
        hashmap_insert(&mut effect_defs, s, eff as i64);
        ei = ei + 1;
    }
    tc.effect_defs = &mut effect_defs as *mut HashMap;
    let mut handled_vec: Vec<i64> = vec_new_in(arena);
    tc.handled_effects = &mut handled_vec as *mut Vec<i64>;

    tc_init_prelude(&mut tc, &mut types);

    // Register type aliases & user-defined refinements
    let aliases_len = prog.vals.len;
    let mut a: i64 = 0;
    while a < aliases_len {
        let alias: *mut AstTypeAlias = vec_get(&prog.vals, a);
        let interner_ref = interner as &Interner;
        let name_s = interner_lookup(interner_ref, alias.name_sym);
        let base_s = interner_lookup(interner_ref, alias.ty_sym);
        let base_entry = hashmap_get(&types, base_s);
        let mut kind = ty_int();
        if base_entry != 0 - 1 {
            let base_ty = base_entry as *mut TcType;
            kind = base_ty.kind;
        }
        let t_alias = alloc_tc_type(tc.arena, kind, alias.name_sym);
        t_alias.int_val = alias.int_val;
        t_alias.op = alias.op;
        t_alias.is_refined = alias.is_refined;
        hashmap_insert(&mut types, name_s, t_alias as i64);
        a = a + 1;
    }

    // Register structs
    let structs_len = prog.structs.len;
    let mut i: i64 = 0;
    while i < structs_len {
        let st = vec_get(&prog.structs, i);
        let sym = st.name_sym;
        let interner_ref = interner as &Interner;
        let s = interner_lookup(interner_ref, sym);
        hashmap_insert(&mut struct_defs, s, st as i64);
        i = i + 1;
    }

    // Register extern functions
    let ext_len = prog.extern_fns.len;
    let mut j: i64 = 0;
    while j < ext_len {
        let ext = vec_get(&prog.extern_fns, j);
        let sym = ext.name_sym;
        let interner_ref = interner as &Interner;
        let s = interner_lookup(interner_ref, sym);
        hashmap_insert(&mut ext_defs, s, ext as i64);
        j = j + 1;
    }

    // Register functions (skip generic templates — they are expanded by monomorphize_program)
    let fns_len = prog.functions.len;
    let mut k: i64 = 0;
    while k < fns_len {
        let f = vec_get(&prog.functions, k);
        if f.type_param_sym == 0 {
            let sym = f.name_sym;
            let interner_ref = interner as &Interner;
            let s = interner_lookup(interner_ref, sym);
            hashmap_insert(&mut fn_defs, s, f as i64);
        }
        k = k + 1;
    }

    // Typecheck each concrete function body.
    //
    // DESIGN: Option B — Monomorphization-First
    //
    // Generic templates (type_param_sym != 0) are deliberately skipped here.
    // The monomorphize_program pre-pass has already cloned each template into
    // one or more concrete specializations (e.g., identity__i64, identity__u8)
    // and pushed them into prog.functions with type_param_sym = 0. Those
    // concrete clones ARE typechecked below.
    //
    // Consequence: errors inside a generic body are only reported when the
    // template is actually instantiated. An uninstantiated generic with a
    // type error in its body will pass typechecking silently. This is an
    // accepted tradeoff for this phase. A future Option A pass could typecheck
    // generic bodies symbolically (with T as an abstract type sentinel) to
    // catch such errors earlier.
    let mut m: i64 = 0;
    while m < fns_len {
        let f = vec_get(&prog.functions, m);
        if f.type_param_sym == 0 {
            tc_function(&mut tc, &fn_defs, &ext_defs, &types, &struct_defs, f);
        }
        m = m + 1;
    }

    tc.pos == 0
}

// ==========================================================
// Tungsten v0.9 — FFI & The "Stable Bridge" Demo
// ==========================================================
// Note: #[repr(C)] attribute is not supported in Morrow syntax;
// C-ABI compatibility is achieved structurally. Pointer dereference
// via *ptr is also not supported; use ptr[0] indexing instead.

struct NativePoint {
    x: i64,
    y: i64,
}

extern "C" {
    fn strlen(s: *const u8) -> usize;
    fn puts(s: *const u8) -> i32;
}

fn main() {
    let greeting = "Hello from Tungsten v0.9 C-ABI Bridge!\0";

    // 1. Calling extern "C" functions inside unsafe { ... }
    let len = unsafe {
        strlen(greeting as *const u8)
    } as i64;

    unsafe {
        puts(greeting as *const u8);
    }

    // 2. Raw pointer creation, mutation, and indexing inside unsafe { ... }
    let mut counter: i64 = 42;
    let ptr: *mut i64 = &mut counter;

    unsafe {
        ptr[0] = 100;
    }

    let updated = unsafe { ptr[0] };

    println(len);
    println(updated);
}

// Tungsten Colorless Networking & Concurrency Demo
// Demonstrating socket I/O multiplexed over M:N fibers via Net algebraic effect

effect Net {
    fn read(fd: i64, size: i64) -> i64;
    fn write(fd: i64, data: i64) -> i64;
    fn close(fd: i64) -> i64;
    fn listen(port: i64) -> i64;
    fn accept(listener: i64) -> i64;
    fn connect(host: i64, port: i64) -> i64;
}

effect IO {
    fn print(msg: i64) -> i64;
}

effect Async {
    fn spawn(func: i64, arg: i64) -> i64;
}

extern "C" {
    fn puts(s: *const u8) -> i32;
}

fn handle_connection(conn_fd: i64) yields [Net, IO] {
    let req = perform Net.read(conn_fd, 1024);
    perform IO.print(0);
    let resp: i64 = 0;
    perform Net.write(conn_fd, resp);
    perform Net.close(conn_fd);
    perform IO.print(0);
}

fn main() yields [Net, Async, IO] {
    unsafe { puts("=== Tungsten Colorless Networking Server ===\0" as *const u8); }
    unsafe { puts("Zero async/await divide - network I/O naturally yields to fiber scheduler\0" as *const u8); }

    let listener_id = perform Net.listen(8080);
    unsafe { puts("Listening on port 8080\0" as *const u8); }

    let conn = perform Net.accept(listener_id);
    unsafe { puts("Accepted client connection\0" as *const u8); }

    unsafe { puts("Spawning connection handler fiber...\0" as *const u8); }
    let worker = perform Async.spawn(0, conn);

    unsafe { puts("Server loop cycle completed.\0" as *const u8); }
}

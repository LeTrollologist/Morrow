// row_polymorphism_and_unified_handlers.mw
// Algebraic Effects Architectural Demonstration
// Demonstrating:
// 1. Effect declarations with multiple operations
// 2. Nested handler blocks (each handles one effect)
// 3. Single-shot continuation resumption
//
// Note: Unified multi-effect handlers in a single 'with' block are a
// planned feature. The currently supported pattern is nested handlers.

effect Db {
    fn query(sql: i64, args: i64) -> i64;
}

effect Logger {
    fn log(msg: i64) -> i64;
}

fn fetch_user_data(user_id: i64) -> i64 yields [Db, Logger] {
    perform Logger.log(user_id);
    let query_res = perform Db.query(0, user_id);
    query_res
}

fn main() {
    // Outer Logger handler wraps inner Db handler
    let profile = handle {
        handle {
            fetch_user_data(42)
        } with Db {
            fn query(k, sql: i64, args: i64) {
                let res: i64 = 99;
                resume(k, res);
            }
        }
    } with Logger {
        fn log(k, msg: i64) {
            println(msg);
            resume(k, 0);
        }
    };

    println(profile);
}
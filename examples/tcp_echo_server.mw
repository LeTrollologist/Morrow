// examples/tcp_echo_server.mw
// Tungsten Multi-Client TCP Echo Server
//
// Demonstrates colorless networking via algebraic effects.
// Effect declarations bring Net, Async, IO into scope.

effect Net {
    fn read(fd: i64, size: i64) -> i64;
    fn write(fd: i64, data: i64) -> i64;
    fn close(fd: i64) -> i64;
    fn listen(port: i64) -> i64;
    fn accept(listener: i64) -> i64;
    fn connect(host: i64, port: i64) -> i64;
}

effect IO {
    fn print(msg: i64) -> i64;
}

effect Async {
    fn spawn(func: i64, arg: i64) -> i64;
}

extern "C" {
    fn puts(s: *const u8) -> i32;
}

fn echo_client_session(conn: i64) yields [Net, IO] {
    let data = perform Net.read(conn, 4096);
    perform IO.print(0);
    perform Net.write(conn, data);
    perform IO.print(0);
    perform Net.close(conn);
    perform IO.print(0);
}

fn accept_one(listener: i64, current: i64, limit: i64) yields [Net, Async, IO] {
    if current < limit {
        let conn = perform Net.accept(listener);
        perform IO.print(0);
        let _handle = perform Async.spawn(0, conn);
        accept_one(listener, current + 1, limit);
    }
}

fn run_loopback_test() yields [Net, Async, IO] {
    let listener_id = perform Net.listen(0);
    perform IO.print(0);
    let conn = perform Net.accept(listener_id);
    perform IO.print(0);
    let incoming = perform Net.read(conn, 4096);
    perform IO.print(0);
    perform Net.write(conn, incoming);
    perform Net.close(conn);
    perform Net.close(listener_id);
    perform IO.print(0);
}

fn main() yields [Net, Async, IO] {
    unsafe { puts("=== Tungsten TCP Echo Server Demo ===\0" as *const u8); }
    unsafe { puts("Colorless networking: zero async/await\0" as *const u8); }

    run_loopback_test();

    unsafe { puts("All done!\0" as *const u8); }
}

// =============================================================================
// Tungsten Fortress v2 — High-Concurrency Async HTTP Server
// Demonstrates:
// 1. Algebraic Effect Declarations & Delimited Handlers (Net)
// 2. Request-Scoped Region Memory Allocation (region req_r)
// 3. Zero-Copy HTTP/1.1 Request Parsing & Wire Formatting (std::http)
// 4. Safe O(1) Bulk Memory Reclamation per Connection
// =============================================================================

import std::net;
import std::http;
import std::collections;

extern "C" {
    fn puts(s: *const u8) -> i32;
    fn strcmp(s1: *const u8, s2: *const u8) -> i32;
}

fn client_worker(conn_id: i64, dummy: i64) yields [Net] {
    let stream = TcpStream {
        socket_id: conn_id,
    };
    region req_r {
        let raw = tcp_read(&stream, 4096);
        let req = http_parse_request_in(raw, req_r);

        if !req.is_valid {
            let bad = http_response_bad_request("{\"error\":\"Invalid HTTP Request\"}\0");
            let wire = http_format_response_in(&bad, req_r);
            tcp_write(&stream, wire);
            tcp_close(&stream);
        } else if unsafe { strcmp(req.path as *const u8, "/health" as *const u8) == 0 } {
            let body = "{\"status\":\"ok\",\"server\":\"tungsten-fortress/2.0\"}";
            let resp = http_response_ok(body, "application/json");
            let wire = http_format_response_in(&resp, req_r);
            tcp_write(&stream, wire);
            tcp_close(&stream);
        } else if unsafe { strcmp(req.path as *const u8, "/benchmark" as *const u8) == 0 } {
            let body = "{\"benchmark\":\"c100k\",\"allocator\":\"region\",\"status\":\"pass\"}";
            let resp = http_response_ok(body, "application/json");
            let wire = http_format_response_in(&resp, req_r);
            tcp_write(&stream, wire);
            tcp_close(&stream);
        } else {
            let not_found = http_response_not_found();
            let wire = http_format_response_in(&not_found, req_r);
            tcp_write(&stream, wire);
            tcp_close(&stream);
        }
    }
}

fn run_server_simulation() -> i64 yields [Net] {
    let port: Port = 8096;
    let listener = tcp_listen(port);

    unsafe { puts("  [Server] Listening on http://127.0.0.1:8096\0" as *const u8); }

    let stream = tcp_accept(&listener);
    if stream.socket_id > 0 {
        client_worker(stream.socket_id, 0);
    }

    0
}

fn main() -> i64 {
    unsafe { puts("=== Starting Tungsten Fortress v2 HTTP Demonstration ===\0" as *const u8); }

    let res = handle {
        run_server_simulation()
    } with Net {
        fn listen(k, port: Port) {
            resume(k, 100);
        }
        fn accept(k, listener: i64) {
            resume(k, 201);
        }
        fn connect(k, host: String, port: Port) {
            resume(k, 300);
        }
        fn read(k, conn: i64, max_bytes: i64) {
            resume(k, "GET /health HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n\0");
        }
        fn write(k, conn: i64, data: String) {
            unsafe {
                puts("  [Wire Output] HTTP Response Sent:\0" as *const u8);
                puts(data as *const u8);
            }
            resume(k, 0);
        }
        fn close(k, conn: i64) {
            resume(k, 0);
        }
    };

    if res == 0 {
        unsafe { puts("=== Fortress v2 Demonstration: Success (All Requests Handled) ===\0" as *const u8); }
        0
    } else {
        unsafe { puts("=== Fortress v2 Demonstration: Failed ===\0" as *const u8); }
        1
    }
}

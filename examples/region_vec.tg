// ==========================================================
// Tungsten v1.0 Genesis — Region Collections & In-Place Growth Demo
// ==========================================================

fn while_push(v: &mut Vec<i64>, i: i64, limit: i64) {
    if i < limit {
        vec_push(v, i * 10);
        while_push(v, i + 1, limit);
    }
}

fn sum_vec(v: &Vec<i64>, i: i64, limit: i64) -> i64 {
    if i >= limit {
        return 0;
    }
    vec_get(v, i) + sum_vec(v, i + 1, limit)
}

fn test_push_and_tail_growth(r: *mut u8) -> i64 {
    let mut v = vec_new_in(r);
    
    // Initial capacity is 8. Pushing 32 elements will trigger:
    // 8 -> 16 (in-place tail growth)
    // 16 -> 32 (in-place tail growth)
    // 32 -> 64 (in-place tail growth)
    while_push(&mut v, 0, 32);

    println!("Pushed 32 items. Vec len: {}, cap: {}", vec_len(&v), vec_cap(&v));

    // Verify elements
    let sum = sum_vec(&v, 0, 32);

    // Verify element mutation
    vec_set(&mut v, 5, 999);
    let elem5 = vec_get(&v, 5);
    println!("Mutated element at index 5: {}", elem5);

    // Verify pop
    let popped = vec_pop(&mut v);
    println!("Popped last element: {}", popped);
    println!("Vec len after pop: {}", vec_len(&v));

    sum
}

fn test_region_string(r: *mut u8) {
    let mut s = string_new_in(r);
    string_push_byte(&mut s, 72 as u8); // 'H'
    string_push_byte(&mut s, 105 as u8); // 'i'
    string_push_byte(&mut s, 33 as u8); // '!'
    println!("String length: {}, cap: {}", string_len(&s), string_cap(&s));

    // UTF-8 validation test
    let valid = string_validate_utf8(string_as_ptr(&s), string_len(&s));
    println!("String UTF-8 valid: {}", valid);
}

fn main() {
    println!("=== Tungsten v1.0 Genesis: Region Collections Validation ===");

    let total_sum = region request_arena {
        let s = test_push_and_tail_growth(request_arena);
        test_region_string(request_arena);
        s
    };

    println!("Sum of elements: {}", total_sum);
    println!("All region memory bulk-reclaimed in O(1) with zero leaks!");
    println!("Genesis Milestone 1 verified successfully!");
}

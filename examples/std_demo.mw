// std_demo.mw
// Demonstrates: algebraic effects (Random), struct field access,
// delimited handler blocks with perform syntax.
// Handler arms use 'fn op(k, param: T) { ... resume(k, val); }' syntax.

struct ServerConfig {
    port: i64,
    max_load: i64,
    workers: i64,
}

effect Random {
    fn between(min: i64, max_val: i64) -> i64;
    fn next_u64() -> i64;
}

fn roll_dice() -> i64 yields [Random] {
    let roll = perform Random.between(1, 6);
    roll
}

fn log_server_start(port: i64, workers: i64) {
    println(port);
    println(workers);
}

fn main() {
    let config = ServerConfig {
        port: 8080,
        max_load: 85,
        workers: 8,
    };

    log_server_start(config.port, config.workers);

    let sum = handle {
        let d1 = roll_dice();
        let d2 = roll_dice();
        d1 + d2
    } with Random {
        fn between(k, min: i64, max_val: i64) {
            resume(k, 4);
        }
        fn next_u64(k) {
            resume(k, 42);
        }
    };

    println(sum);
}

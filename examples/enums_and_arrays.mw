enum Shape {
    Circle(i64),
    Rectangle(i64, i64),
    Point,
}

fn compute_area(s: Shape) -> i64 {
    match s {
        Shape::Circle(r) => r * r * 3,
        Shape::Rectangle(w, h) => w * h,
        Shape::Point => 0,
    }
}

fn main() {
    let c = Shape::Circle(10);
    let r = Shape::Rectangle(4, 5);
    let p = Shape::Point;

    let a1 = compute_area(c);
    let a2 = compute_area(r);
    let a3 = compute_area(p);

    let areas: [i64; 3] = [a1, a2, a3];
    let total_area = areas[0] + areas[1] + areas[2];

    println!("Shape areas: Circle={}, Rectangle={}, Point={}", areas[0], areas[1], areas[2]);
    println!("Total combined area: {}", total_area);

    // Stride-aware byte array
    let bytes: [u8; 4] = [72, 101, 121, 33];
    println!("Byte buffer header: {}, {}, {}, {}", bytes[0], bytes[1], bytes[2], bytes[3]);
}

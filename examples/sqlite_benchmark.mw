// =============================================================================
// Tungsten v1.0 Genesis — Safe SQLite Driver & Region Benchmark
// Demonstrates:
// 1. Safe SQLite Driver (std::sqlite) over C-ABI FFI
// 2. The 'Column Name' Schema Optimization (zero duplicate schema allocations)
// 3. 10,000-Row Query Stream into a Scoped Region with O(1) Bulk Deallocation
// 4. The Database Algebraic Effect (asynchronous runtime offload)
// =============================================================================

import std::sqlite;
import std::effects;

fn verify(cond: bool, msg: String) {
    if cond {
        println!("  [PASS] ", msg);
    } else {
        println!("  [FAIL] ", msg);
    }
}

fn test_region_query(db: &mut SqliteDb, r: *mut u8) {
    println!("Executing 10,000-row region-locked query: SELECT id, name, email FROM users...");
    let rs = sqlite_query_in(db, "SELECT id, name, email FROM users ORDER BY id ASC", r);

    println!("Result set retrieved successfully!");
    println!("Rows count: ", rs.num_rows);
    println!("Cols count: ", rs.num_cols);

    verify(rs.num_rows == 10000, "Row count is exactly 10,000");
    verify(rs.num_cols == 3, "Column count is exactly 3");

    // Schema inspection
    let col0 = sqlite_col_name(&rs, 0);
    let col1 = sqlite_col_name(&rs, 1);
    let col2 = sqlite_col_name(&rs, 2);
    println!("Schema: ", col0, ", ", col1, ", ", col2);
    verify(col0 == "id", "Column 0 is 'id'");
    verify(col1 == "name", "Column 1 is 'name'");
    verify(col2 == "email", "Column 2 is 'email'");

    // Sample record inspection: First record (row 0)
    let first_id = sqlite_get(&rs, 0, 0);
    let first_name = sqlite_get(&rs, 0, 1);
    let first_email = sqlite_get(&rs, 0, 2);
    println!("Row 0: id=", first_id, ", name=", first_name, ", email=", first_email);
    verify(first_id == "1", "First row id is 1");
    verify(first_name == "User_1", "First row name is User_1");
    verify(first_email == "user_1@tungsten.lang", "First row email matches");

    // Sample record inspection: Mid record (row 5000)
    let mid_id = sqlite_get(&rs, 5000, 0);
    let mid_name = sqlite_get_by_name(&rs, 5000, "name");
    let mid_email = sqlite_get_by_name(&rs, 5000, "email");
    println!("Row 5000: id=", mid_id, ", name=", mid_name, ", email=", mid_email);
    verify(mid_id == "5001", "Mid row id is 5001");
    verify(mid_name == "User_5001", "Mid row name is User_5001");
    verify(mid_email == "user_5001@tungsten.lang", "Mid row email matches");

    // Sample record inspection: Last record (row 9999)
    let last_id = sqlite_get(&rs, 9999, 0);
    let last_name = sqlite_get_by_name(&rs, 9999, "name");
    let last_email = sqlite_get_by_name(&rs, 9999, "email");
    println!("Row 9999: id=", last_id, ", name=", last_name, ", email=", last_email);
    verify(last_id == "10000", "Last row id is 10000");
    verify(last_name == "User_10000", "Last row name is User_10000");
    verify(last_email == "user_10000@tungsten.lang", "Last row email matches");

    // Lightweight row accessor view
    let row_view = sqlite_row(&rs, 42);
    let r_name = sqlite_row_get(&row_view, 1);
    let r_email = sqlite_row_get_by_name(&row_view, "email");
    println!("Row 42 view: name=", r_name, ", email=", r_email);
    verify(r_name == "User_43", "Row 42 view name is User_43");
    verify(r_email == "user_43@tungsten.lang", "Row 42 view email matches");
}

fn test_database_effect() yields [Database] {
    println!("Testing Database Algebraic Effect execution...");
    let rows_affected = Database::execute("CREATE TABLE IF NOT EXISTS effect_items (id INTEGER PRIMARY KEY, title TEXT);");
    println!("Table created, status/changes: ", rows_affected);

    let ins_changes = Database::execute("INSERT INTO effect_items VALUES (1, 'FiberConcurrency');");
    println!("Insert executed via Database effect, changes: ", ins_changes);
    verify(ins_changes == 1, "Database effect insert affected 1 row");

    let val = Database::query("SELECT title FROM effect_items WHERE id = 1;");
    println!("Query via Database effect returned: ", val);
    verify(val == "FiberConcurrency", "Database effect query returned FiberConcurrency");
}

fn main() yields [Database] {
    println!("=== Tungsten Genesis Phase C: Safe SQLite Driver & Region Benchmark ===");

    println!("Opening in-memory SQLite database (:memory:)...");
    let mut db = sqlite_open(":memory:");
    verify(db.is_open, "SQLite database opened successfully");

    println!("Creating table 'users' (id INTEGER, name TEXT, email TEXT)...");
    let rc_create = sqlite_execute(&mut db, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, email TEXT);");
    verify(rc_create >= 0, "CREATE TABLE succeeded");

    println!("Populating 10,000 user rows...");
    let rc_pop = sqlite_execute(&mut db, "WITH RECURSIVE cnt(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM cnt WHERE x < 10000) INSERT INTO users SELECT x, 'User_' || x, 'user_' || x || '@tungsten.lang' FROM cnt;");
    verify(rc_pop == 10000, "Inserted 10,000 rows in single operation");

    // Scoped region allocation for query results
    println!("Entering scoped region 'db_query' for 10,000-row result set...");
    region db_query {
        test_region_query(&mut db, db_query);
    }
    println!("Exited region 'db_query' — 10,000 rows (30,000 cells) bulk-freed in O(1)!");

    // Close SQLite database
    sqlite_close(&mut db);
    verify(db.is_open == false, "Database closed cleanly");

    // Run Database Algebraic Effect test
    println!("");
    test_database_effect();

    println!("");
    println!("=== All Phase C SQLite & Database Effect Benchmarks PASSED! ===");
}

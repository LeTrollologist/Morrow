// examples/player.tg
// Demonstrates:
// 1. User-Defined Refinement Types (u8[0..100])
// 2. Algebraic Effect Contracts (yields [Db, Logger])
// 3. Delimited Effect Handling & Single-Shot Resumption
// 4. Nested Handlers for Distinct Architectural Concerns

import std::collections;

extern "C" {
    fn puts(s: *const u8) -> i32;
}

type Health = u8[0..100];

struct Player {
    name: String,
    hp: Health,
}

effect Db {
    fn query(id: i64) -> i64;
}

effect Logger {
    fn log(msg: String) -> i64;
}

fn fetch_player(id: i64) -> Player yields [Db, Logger] {
    perform Logger.log("  [DB] Fetching player record...\0");
    let initial_hp = perform Db.query(id);
    Player {
        name: "Arthur\0",
        hp: initial_hp as Health,
    }
}

fn heal_player(player: &mut Player, amount: u8) yields [Logger] {
    perform Logger.log("  [HEAL] Applying restorative potion...\0");
    let cur = player.hp as i64;
    let next = cur + (amount as i64);
    if next > 100 {
        player.hp = 100 as Health;
    } else {
        player.hp = next as Health;
    }
}

fn main() -> i64 {
    unsafe { puts("=== Starting Player Demonstration ===\0" as *const u8); }

    let final_hp = handle {
        handle {
            let mut player = fetch_player(42);
            heal_player(&mut player, 20 as u8);
            player.hp as i64
        } with Logger {
            fn log(k, msg: String) {
                unsafe { puts(msg as *const u8); }
                resume(k, 0);
            }
        }
    } with Db {
        fn query(k, id: i64) {
            // Simulated database record retrieval: ID 42 has 75 HP
            resume(k, 75);
        }
    };

    if final_hp == 95 {
        unsafe { puts("=== Player Demonstration: Success (HP = 95) ===\0" as *const u8); }
        0
    } else {
        unsafe { puts("=== Player Demonstration: Failed ===\0" as *const u8); }
        1
    }
}

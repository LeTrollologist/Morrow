// Morrow Collections & Relational Slices Demo
// Standard Library Collections operating seamlessly across Region memory

import std::collections;

extern "C" {
    fn puts(s: *const u8) -> i32;
    fn fflush(f: *const u8) -> i32;
}

fn print_msg(msg: String) {
    unsafe {
        puts(msg as *const u8);
        fflush(0 as *const u8);
    }
}

fn main() -> i64 {
    region main_scope {
        print_msg("=== Morrow Standard Library Collections Demo ===");

        // 1. Vector Operations within Region Memory
        let mut v: Vec<i64> = vec_new_in(main_scope);
        vec_push(&mut v, 10);
        vec_push(&mut v, 20);
        vec_push(&mut v, 30);
        print_msg("Initialized Vector with 3 elements, count:");
        println(v.len);

        // 2. HashMap Operations within Sub-Region
        let mut map_count: i64 = 0;
        region map_scope {
            let mut map = hashmap_new_in(map_scope);
            hashmap_insert(&mut map, "alpha", 100, map_scope);
            hashmap_insert(&mut map, "beta", 200, map_scope);
            let val = hashmap_get(&map, "alpha");
            print_msg("Retrieved value from map inside sub-region:");
            println(val);
            map_count = map.len;
        }
        print_msg("HashMap element count after region scope:");
        println(map_count);

        print_msg("Collections demo completed successfully!");
        0
    }
}

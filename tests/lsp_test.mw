// Phase 13.1 — LSP Harness Tests (lsp_test.mw)
// Exercises lsp_handle_request() end-to-end without a live stdio pipe.
// All JSON-RPC messages are crafted inline; responses are validated by
// searching for expected substrings in the serialised output.

import compiler::lsp;
import compiler::json;
import compiler::diagnostics;

extern "C" {
    fn puts(s: *const u8) -> i32;
    fn fflush(f: *const u8) -> i32;
    fn strlen(s: *const u8) -> usize;
    fn strstr(haystack: *const u8, needle: *const u8) -> *const u8;
    fn strcmp(s1: *const u8, s2: *const u8) -> i32;
    fn morrow_region_alloc(arena: *mut u8, size: usize, align: usize) -> *mut u8;
}

fn lsp_test_print(msg: String) {
    unsafe {
        puts(msg as *const u8);
        fflush(0 as *const u8);
    }
}

// Returns true if |needle| is found anywhere in |haystack|.
fn contains(haystack: String, needle: String) -> bool {
    let p = unsafe { strstr(haystack as *const u8, needle as *const u8) };
    (p as usize) != 0
}

// ─── test runner state ───────────────────────────────────────────────────────

fn lsp_assert(label: String, cond: bool) -> bool yields [Diagnostics] {
    if cond {
        // ok — silent
        true
    } else {
        report_err(label, 1, 1);
        false
    }
}

// ─── individual tests ────────────────────────────────────────────────────────

fn test_initialize(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    let req = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}";
    let resp = lsp_handle_request(req, arena);
    let mut ok = true;
    ok = ok && lsp_assert("init: has jsonrpc",      contains(resp, "\"jsonrpc\""));
    ok = ok && lsp_assert("init: id=1",             contains(resp, "\"id\""));
    ok = ok && lsp_assert("init: has result",        contains(resp, "\"result\""));
    ok = ok && lsp_assert("init: has capabilities", contains(resp, "\"capabilities\""));
    ok = ok && lsp_assert("init: morrow-lsp name",  contains(resp, "morrow-lsp"));
    ok = ok && lsp_assert("init: version 0.3.0",    contains(resp, "0.3.0"));
    ok = ok && lsp_assert("init: textDocumentSync", contains(resp, "textDocumentSync"));
    ok = ok && lsp_assert("init: hoverProvider",    contains(resp, "hoverProvider"));
    ok = ok && lsp_assert("init: completionProvider", contains(resp, "completionProvider"));
    ok
}

fn test_initialized_notification(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    // "initialized" is a notification — must produce no response (empty string)
    let req  = "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}";
    let resp = lsp_handle_request(req, arena);
    let resp_len = unsafe { strlen(resp as *const u8) } as i64;
    lsp_assert("initialized: empty response", resp_len == 0)
}

fn test_did_open_clean(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    // Valid Morrow source — should publish empty diagnostics
    let req = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///test.mw\",\"languageId\":\"morrow\",\"version\":1,\"text\":\"fn add(a: i64, b: i64) -> i64 { a + b }\"}}}";
    let resp = lsp_handle_request(req, arena);
    let mut ok = true;
    ok = ok && lsp_assert("didOpen clean: publishDiagnostics", contains(resp, "publishDiagnostics"));
    ok = ok && lsp_assert("didOpen clean: uri preserved",      contains(resp, "file:///test.mw"));
    ok = ok && lsp_assert("didOpen clean: empty diags array",  contains(resp, "\"diagnostics\""));
    ok
}

fn test_did_open_error(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    // Source with an undefined variable — should produce a non-empty diagnostics list
    let req = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///bad.mw\",\"languageId\":\"morrow\",\"version\":1,\"text\":\"fn f() -> i64 { undefined_var }\"}}}";
    diag_reset();
    let resp = lsp_handle_request(req, arena);
    // We check that we get diagnostics back (regardless of exact error location)
    let mut ok = true;
    ok = ok && lsp_assert("didOpen err: publishDiagnostics",  contains(resp, "publishDiagnostics"));
    ok = ok && lsp_assert("didOpen err: has severity",        contains(resp, "\"severity\""));
    ok = ok && lsp_assert("didOpen err: morrow-typeck source", contains(resp, "morrow-typeck"));
    ok
}

fn test_did_change(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    // Verify contentChanges[0].text is used (not textDocument.text)
    let req = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\"file:///change.mw\",\"version\":2},\"contentChanges\":[{\"text\":\"fn g() -> i64 { 42 }\"}]}}";
    let resp = lsp_handle_request(req, arena);
    let mut ok = true;
    ok = ok && lsp_assert("didChange: publishDiagnostics", contains(resp, "publishDiagnostics"));
    ok = ok && lsp_assert("didChange: uri preserved",      contains(resp, "file:///change.mw"));
    ok
}

fn test_hover(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    let req = "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"file:///x.mw\"},\"position\":{\"line\":0,\"character\":0}}}";
    let resp = lsp_handle_request(req, arena);
    let mut ok = true;
    ok = ok && lsp_assert("hover: has result",   contains(resp, "\"result\""));
    ok = ok && lsp_assert("hover: has contents", contains(resp, "\"contents\""));
    ok = ok && lsp_assert("hover: morrow fence",  contains(resp, "morrow"));
    ok
}

fn test_completion(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    let req = "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/completion\",\"params\":{\"textDocument\":{\"uri\":\"file:///x.mw\"},\"position\":{\"line\":0,\"character\":2}}}";
    let resp = lsp_handle_request(req, arena);
    // Should return an empty list, not a method-not-found error
    let mut ok = true;
    ok = ok && lsp_assert("completion: has result", contains(resp, "\"result\""));
    ok = ok && lsp_assert("completion: no error",   !contains(resp, "\"error\""));
    ok
}

fn test_formatting(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    let req = "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"textDocument/formatting\",\"params\":{\"textDocument\":{\"uri\":\"file:///x.mw\"},\"options\":{}}}";
    let resp = lsp_handle_request(req, arena);
    let mut ok = true;
    ok = ok && lsp_assert("formatting: has result", contains(resp, "\"result\""));
    ok = ok && lsp_assert("formatting: no error",   !contains(resp, "\"error\""));
    ok
}

fn test_shutdown(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    let req = "{\"jsonrpc\":\"2.0\",\"id\":99,\"method\":\"shutdown\"}";
    let resp = lsp_handle_request(req, arena);
    let mut ok = true;
    ok = ok && lsp_assert("shutdown: has result",  contains(resp, "\"result\""));
    ok = ok && lsp_assert("shutdown: no error",    !contains(resp, "\"error\""));
    ok
}

fn test_exit_notification(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    // "exit" returns the internal sentinel — must NOT be empty (we need to detect it)
    let req  = "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}";
    let resp = lsp_handle_request(req, arena);
    let resp_len = unsafe { strlen(resp as *const u8) } as i64;
    lsp_assert("exit: sentinel non-empty", resp_len > 0)
}

fn test_method_not_found(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    let req  = "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/definition\"}";
    let resp = lsp_handle_request(req, arena);
    let mut ok = true;
    ok = ok && lsp_assert("not found: has error",  contains(resp, "\"error\""));
    ok = ok && lsp_assert("not found: code -32601", contains(resp, "-32601"));
    ok
}

fn test_empty_payload(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    let resp = lsp_handle_request("", arena);
    let mut ok = true;
    ok = ok && lsp_assert("empty: has error",   contains(resp, "\"error\""));
    ok = ok && lsp_assert("empty: code -32700", contains(resp, "-32700"));
    ok
}

fn test_missing_method(arena: *mut u8) -> bool yields [FS, Diagnostics] {
    let req  = "{\"jsonrpc\":\"2.0\",\"id\":2}";
    let resp = lsp_handle_request(req, arena);
    let mut ok = true;
    ok = ok && lsp_assert("missing method: has error",   contains(resp, "\"error\""));
    ok = ok && lsp_assert("missing method: code -32600", contains(resp, "-32600"));
    ok
}

// ─── main ────────────────────────────────────────────────────────────────────

fn main() -> i64 yields [FS, Diagnostics] {
    region lsp_test_arena {
        lsp_test_print("[lsp_test] running Phase 13.1 LSP harness tests");

        let mut passed: i64 = 0;
        let mut failed: i64 = 0;

        let run = |name: String, ok: bool| {
            if ok {
                passed = passed + 1;
            } else {
                failed = failed + 1;
                lsp_test_print(name);
            }
        };

        run("initialize",              test_initialize(lsp_test_arena));
        run("initialized_notif",       test_initialized_notification(lsp_test_arena));
        run("didOpen_clean",           test_did_open_clean(lsp_test_arena));
        run("didOpen_error",           test_did_open_error(lsp_test_arena));
        run("didChange",               test_did_change(lsp_test_arena));
        run("hover",                   test_hover(lsp_test_arena));
        run("completion",              test_completion(lsp_test_arena));
        run("formatting",              test_formatting(lsp_test_arena));
        run("shutdown",                test_shutdown(lsp_test_arena));
        run("exit_notification",       test_exit_notification(lsp_test_arena));
        run("method_not_found",        test_method_not_found(lsp_test_arena));
        run("empty_payload",           test_empty_payload(lsp_test_arena));
        run("missing_method",          test_missing_method(lsp_test_arena));

        if failed == 0 {
            lsp_test_print("[lsp_test] ALL PASSED");
            0
        } else {
            lsp_test_print("[lsp_test] FAILURES — see above");
            1
        }
    }
}

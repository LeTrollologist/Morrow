// Logical operators must short-circuit: the right operand is not evaluated when
// the left operand determines the result.
fn bump(n: *mut i64) -> i64 {
    n[0] = n[0] + 1;
    1
}

fn main() -> i64 {
    let mut n: i64 = 0;

    let a = false && (bump(&mut n) != 0);
    if n != 0 { return 1; }
    if a != 0 { return 2; }

    let b = true || (bump(&mut n) != 0);
    if n != 0 { return 3; }
    if b != 1 { return 4; }

    let c = true && (bump(&mut n) != 0);
    if n != 1 { return 5; }
    if c != 1 { return 6; }

    let d = false || (bump(&mut n) != 0);
    if n != 2 { return 7; }
    if d != 1 { return 8; }

    if false && (bump(&mut n) != 0) { return 9; }
    if n != 2 { return 10; }
    if true || (bump(&mut n) != 0) { } else { return 11; }
    if n != 2 { return 12; }

    return 0;
}

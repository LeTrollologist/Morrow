// tests/generics_test.tg
// Phase 9.3 - Parametric Generics and Call-Site Monomorphization
//
// ACCEPTANCE INVARIANTS verified by this suite:
//   (1) Each (template, concrete-type) pair produces exactly one specialization.
//       Tested by: repeated identity::<i64> calls all returning correctly.
//   (2) All references to the same specialization resolve to one instance.
//       Tested by: two call sites of identity::<i64> returning distinct values.
//   (3) No unresolved type parameters reach codegen.
//       Enforced at compile time by verify_no_unresolved_turbofish in forge.tg.
//       If T were still unresolved at codegen, struct field accesses below would
//       return wrong values due to incorrect offsets, and these tests would fail.

import std::collections;

extern "C" {
    fn puts(s: *const u8) -> i32;
}

fn tprint(msg: String) {
    unsafe {
        puts(msg as *const u8);
    }
}

// ===========================================================================
// Generic function templates
// ===========================================================================

fn identity<T>(x: T): T {
    x
}

fn first<T>(a: T, b: T): T {
    a
}

fn second<T>(a: T, b: T): T {
    b
}

// ===========================================================================
// Generic struct templates
// Box<T> has a layout sentinel (tag: i64) as its second field.
// If T is not substituted before codegen, field offsets will be wrong
// and tag will return garbage - this is the active codegen-fallback detector.
// ===========================================================================

pub struct Box<T> {
    value: T,
    tag: i64,
}

pub struct Pair<T> {
    fst: T,
    snd: T,
}

// ===========================================================================
// Group 1: Basic function generics - return i64 (0=pass)
// ===========================================================================

fn test_identity_basic() -> i64 {
    let r = identity::<i64>(42);
    if r != 42 { return 1; }
    0
}

fn test_identity_negative() -> i64 {
    let r = identity::<i64>(0 - 7);
    if r != 0 - 7 { return 2; }
    0
}

fn test_identity_zero() -> i64 {
    let r = identity::<i64>(0);
    if r != 0 { return 3; }
    0
}

fn test_first_basic() -> i64 {
    let r = first::<i64>(10, 20);
    if r != 10 { return 4; }
    0
}

fn test_second_basic() -> i64 {
    let r = second::<i64>(100, 200);
    if r != 200 { return 5; }
    0
}

// ===========================================================================
// Group 2: Deduplication - invariant (1)
// Calling identity::<i64> three times must each produce correct results.
// ===========================================================================

fn test_dedup_repeated() -> i64 {
    let a = identity::<i64>(1);
    let b = identity::<i64>(2);
    let c = identity::<i64>(3);
    if a != 1 { return 10; }
    if b != 2 { return 11; }
    if c != 3 { return 12; }
    0
}

// ===========================================================================
// Group 3: Multiple distinct specializations - invariant (2)
// ===========================================================================

fn test_multiple_specializations() -> i64 {
    let f = first::<i64>(7, 8);
    let s = second::<i64>(7, 8);
    if f != 7 { return 20; }
    if s != 8 { return 21; }
    0
}

// ===========================================================================
// Group 4: Chained generic calls
// ===========================================================================

fn test_chained_calls() -> i64 {
    let r = identity::<i64>(first::<i64>(10, 20));
    if r != 10 { return 30; }
    0
}

fn test_chained_second() -> i64 {
    let r = identity::<i64>(second::<i64>(30, 40));
    if r != 40 { return 31; }
    0
}

// ===========================================================================
// Group 5: Generic struct layout - invariant (3)
// Box::<i64> { value: V, tag: T }
//   field 0 (value): i64 at byte offset 0
//   field 1 (tag):   i64 at byte offset 8 (sentinel)
// Wrong offsets mean T was not substituted and codegen used the fallback.
// ===========================================================================

fn test_box_layout() -> i64 {
    let b = Box::<i64> { value: 99, tag: 42 };
    if b.value != 99 { return 40; }
    if b.tag != 42 { return 41; }
    0
}

fn test_box_two_instances() -> i64 {
    let b1 = Box::<i64> { value: 1, tag: 100 };
    let b2 = Box::<i64> { value: 2, tag: 200 };
    if b1.value != 1 { return 50; }
    if b1.tag != 100 { return 51; }
    if b2.value != 2 { return 52; }
    if b2.tag != 200 { return 53; }
    0
}

fn test_pair_layout() -> i64 {
    let p = Pair::<i64> { fst: 3, snd: 7 };
    if p.fst != 3 { return 60; }
    if p.snd != 7 { return 61; }
    0
}

fn test_pair_arithmetic() -> i64 {
    let p = Pair::<i64> { fst: 10, snd: 20 };
    let sum = p.fst + p.snd;
    let diff = p.snd - p.fst;
    if sum != 30 { return 70; }
    if diff != 10 { return 71; }
    0
}

// ===========================================================================
// Group 6: Generic fn + struct fields
// ===========================================================================

fn test_generic_fn_with_struct_fields() -> i64 {
    let p = Pair::<i64> { fst: 55, snd: 66 };
    let got_fst = identity::<i64>(p.fst);
    let got_snd = identity::<i64>(p.snd);
    if got_fst != 55 { return 80; }
    if got_snd != 66 { return 81; }
    0
}

// ===========================================================================
// Group 7: Specialization independence (sym collision guard)
// first::<i64> and second::<i64> must not alias.
// ===========================================================================

fn test_specialization_independence() -> i64 {
    let a = first::<i64>(1, 2);
    let b = second::<i64>(1, 2);
    if a != 1 { return 90; }
    if b != 2 { return 91; }
    0
}

// ===========================================================================
// Group 8: Struct field isolation under mutation
// Verifies that field stride is correct for i64 (8 bytes).
// ===========================================================================

fn test_struct_field_isolation() -> i64 {
    let mut p = Pair::<i64> { fst: 100, snd: 200 };
    p.fst = 999;
    if p.fst != 999 { return 100; }
    if p.snd != 200 { return 101; }
    0
}

// ===========================================================================
// Main
// ===========================================================================

pub fn main() -> i64 {
    let r1 = test_identity_basic();
    if r1 != 0 {
        tprint("FAILED: test_identity_basic\0");
        return r1;
    }
    tprint("  test identity basic ... ok\0");

    let r2 = test_identity_negative();
    if r2 != 0 {
        tprint("FAILED: test_identity_negative\0");
        return r2;
    }
    tprint("  test identity negative ... ok\0");

    let r3 = test_identity_zero();
    if r3 != 0 {
        tprint("FAILED: test_identity_zero\0");
        return r3;
    }
    tprint("  test identity zero ... ok\0");

    let r4 = test_first_basic();
    if r4 != 0 {
        tprint("FAILED: test_first_basic\0");
        return r4;
    }
    tprint("  test first basic ... ok\0");

    let r5 = test_second_basic();
    if r5 != 0 {
        tprint("FAILED: test_second_basic\0");
        return r5;
    }
    tprint("  test second basic ... ok\0");

    let r6 = test_dedup_repeated();
    if r6 != 0 {
        tprint("FAILED: test_dedup_repeated (invariant 1)\0");
        return r6;
    }
    tprint("  test dedup repeated calls ... ok");

    let r7 = test_multiple_specializations();
    if r7 != 0 {
        tprint("FAILED: test_multiple_specializations (invariant 2)\0");
        return r7;
    }
    tprint("  test multiple specializations ... ok\0");

    let r8 = test_chained_calls();
    if r8 != 0 {
        tprint("FAILED: test_chained_calls\0");
        return r8;
    }
    tprint("  test chained generic calls ... ok\0");

    let r9 = test_chained_second();
    if r9 != 0 {
        tprint("FAILED: test_chained_second\0");
        return r9;
    }
    tprint("  test chained second+identity ... ok\0");

    let r10 = test_box_layout();
    if r10 != 0 {
        tprint("FAILED: test_box_layout (invariant 3 - codegen fallback detector)\0");
        return r10;
    }
    tprint("  test Box layout [invariant 3] ... ok\0");

    let r11 = test_box_two_instances();
    if r11 != 0 {
        tprint("FAILED: test_box_two_instances\0");
        return r11;
    }
    tprint("  test Box two instances ... ok\0");

    let r12 = test_pair_layout();
    if r12 != 0 {
        tprint("FAILED: test_pair_layout\0");
        return r12;
    }
    tprint("  test Pair layout ... ok\0");

    let r13 = test_pair_arithmetic();
    if r13 != 0 {
        tprint("FAILED: test_pair_arithmetic\0");
        return r13;
    }
    tprint("  test Pair arithmetic ... ok\0");

    let r14 = test_generic_fn_with_struct_fields();
    if r14 != 0 {
        tprint("FAILED: test_generic_fn_with_struct_fields\0");
        return r14;
    }
    tprint("  test generic fn with struct fields ... ok\0");

    let r15 = test_specialization_independence();
    if r15 != 0 {
        tprint("FAILED: test_specialization_independence (sym collision guard)\0");
        return r15;
    }
    tprint("  test specialization independence ... ok\0");

    let r16 = test_struct_field_isolation();
    if r16 != 0 {
        tprint("FAILED: test_struct_field_isolation\0");
        return r16;
    }
    tprint("  test struct field isolation ... ok\0");

    tprint("All Generics Tests Passed (100% OK)\0");
    return 0;
}

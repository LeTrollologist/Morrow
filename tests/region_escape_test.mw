// tests/region_escape_test.tg
// Compile-Time Region Escape Analysis Tests
// Verifies that the typechecker correctly accepts safe region use and
// rejects region-scoped pointer escapes.

import std::collections;

extern "C" {
    fn puts(s: *const u8) -> i32;
    fn morrow_region_alloc(arena: *mut u8, size: i64, align: i64) -> *mut u8;
}

// -----------------------------------------------------------------------
// Test 1: Safe region use ? pointer allocated and consumed inside region.
// The pointer is tagged by the typechecker but never escapes.
// -----------------------------------------------------------------------
fn test_region_safe_use(): i64 {
    let result: i64 = 0;
    region r {
        let ptr = morrow_region_alloc(r, 8, 8) as *mut i64;
        // Use result inside region ? scalar assignment, allowed
        result = 42;
    }
    result
}

// -----------------------------------------------------------------------
// Test 2: Scalar escape is always allowed ? i64 has no region tag.
// -----------------------------------------------------------------------
fn test_scalar_escape_allowed(): i64 {
    let val: i64 = 0;
    region r {
        let inner: i64 = 99;
        val = inner;
    }
    val
}

// -----------------------------------------------------------------------
// Test 3: A region-allocated Vec that never leaves the region is accepted.
// vec_new_in results are tagged as region-scoped (v2.2.0); this pins that the
// tag alone does not reject region-confined use.
// -----------------------------------------------------------------------
fn test_region_vec_confined(): i64 {
    let total: i64 = 0;
    region r {
        let mut v = vec_new_in(r);
        vec_push(&mut v, 5);
        vec_push(&mut v, 7);
        total = vec_len(&v);
    }
    total
}


// -----------------------------------------------------------------------
// Main test runner ? returns 0 on full pass (exit code convention)
// -----------------------------------------------------------------------
pub fn main(): i64 {
    let mut passed: i64 = 0;
    let mut failed: i64 = 0;

    let r1 = test_region_safe_use();
    if r1 == 42 {
        passed = passed + 1;
        puts("  test region safe use ... ok");
    } else {
        failed = failed + 1;
        puts("  test region safe use ... FAIL");
    }

    let r2 = test_scalar_escape_allowed();
    if r2 == 99 {
        passed = passed + 1;
        puts("  test scalar escape allowed ... ok");
    } else {
        failed = failed + 1;
        puts("  test scalar escape allowed ... FAIL");
    }

    let r3 = test_region_vec_confined();
    if r3 == 2 {
        passed = passed + 1;
        puts("  test region vec confined ... ok");
    } else {
        failed = failed + 1;
        puts("  test region vec confined ... FAIL");
    }


    if failed == 0 {
        puts("All Region Escape Tests Passed (100% OK)");
        return 0;
    }
    1
}

// ARGKINDS CORPUS — case 4
// Nested reference: `&&Probe` against a by-value `Probe`. One level of implicit
// deref is applied, so this must REMAIN reported (conservative by design).
struct Probe {
    x: i64,
}

fn take(p: Probe) -> i64 {
    p.x
}

fn run() -> i64 {
    let p = Probe { x: 1 };
    let r = &p;
    take(&r)
}

fn main() -> i64 {
    0
}

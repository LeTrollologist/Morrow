// ─── tcp_accept tests ─────────────────────────────────────────────────────────

fn test_tcp_accept_returns_stream(arena: *mut u8) -> bool yields [Diagnostics] {
    let mut stream_id: i64 = 0;
    handle {
        let l = tcp_listen(9000 as Port);
        let s = tcp_accept(&l);
        stream_id = s.socket_id;
    } with Net {
        listen(_port)   => resume(100),
        accept(fd)      => resume(fd + 1000),
        connect(_h, _p) => resume(0),
        read(_fd, _n)   => resume(""),
        write(_fd, _d)  => resume(0),
        close(_fd)      => resume(0),
    }
    // accept was called with fd=100, returned 1100
    net_assert("accept: stream fd = listener_fd + 1000", stream_id == 1100)
}


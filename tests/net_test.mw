fn test_tcp_accept_returns_stream(arena: *mut u8) -> bool yields [Diagnostics] {
    let sid = handle {
        net_accept_socket_id()
    } with Net {
        fn listen(k, p: Port) { resume(k, 100); }
        fn accept(k, fd: i64) { resume(k, fd + 1000); }
        fn connect(k, h: String, p: Port) { resume(k, 0); }
        fn read(k, fd: i64, n: i64) { resume(k, ""); }
        fn write(k, fd: i64, d: String) { resume(k, 0); }
        fn close(k, fd: i64) { resume(k, 0); }
    };
    net_assert("accept: stream fd = listener_fd + 1000", sid == 1100)
}


// ---------------------------------------------------------------------------
// tcp_read tests
// ---------------------------------------------------------------------------

fn test_tcp_read_returns_mock_data(arena: *mut u8) -> bool yields [Diagnostics] {
    let n = handle {
        net_read_len()
    } with Net {
        fn listen(k, p: Port) { resume(k, 0); }
        fn accept(k, fd: i64) { resume(k, 0); }
        fn connect(k, h: String, p: Port) { resume(k, 42); }
        fn read(k, fd: i64, n: i64) { resume(k, "MOCK_DATA"); }
        fn write(k, fd: i64, d: String) { resume(k, 0); }
        fn close(k, fd: i64) { resume(k, 0); }
    };
    net_assert("read: returns MOCK_DATA", n == 9)
}

fn test_tcp_read_propagates_max_len(arena: *mut u8) -> bool yields [Diagnostics] {
    // The mock answers with "MAXLEN" (6 bytes) only when max_bytes == 1024.
    let n = handle {
        net_read_maxlen_marker()
    } with Net {
        fn listen(k, p: Port) { resume(k, 0); }
        fn accept(k, fd: i64) { resume(k, 0); }
        fn connect(k, h: String, p: Port) { resume(k, 1); }
        fn read(k, fd: i64, n: i64) {
            if n == 1024 {
                resume(k, "MAXLEN");
            } else {
                resume(k, "");
            }
        }
        fn write(k, fd: i64, d: String) { resume(k, 0); }
        fn close(k, fd: i64) { resume(k, 0); }
    };
    net_assert("read: max_len=1024 propagated", n == 6)
}

// ---------------------------------------------------------------------------
// tcp_write tests
// ---------------------------------------------------------------------------

fn test_tcp_write_returns_length(arena: *mut u8) -> bool yields [Diagnostics] {
    let n = handle {
        net_write_len()
    } with Net {
        fn listen(k, p: Port) { resume(k, 0); }
        fn accept(k, fd: i64) { resume(k, 0); }
        fn connect(k, h: String, p: Port) { resume(k, 1); }
        fn read(k, fd: i64, n: i64) { resume(k, ""); }
        fn write(k, fd: i64, d: String) { resume(k, strlen(d as *const u8) as i64); }
        fn close(k, fd: i64) { resume(k, 0); }
    };
    net_assert("write: returned byte count == 6", n == 6)
}

fn test_tcp_write_propagates_data(arena: *mut u8) -> bool yields [Diagnostics] {
    // The mock echoes 1 only when it receives the exact request bytes.
    let n = handle {
        net_write_match()
    } with Net {
        fn listen(k, p: Port) { resume(k, 0); }
        fn accept(k, fd: i64) { resume(k, 0); }
        fn connect(k, h: String, p: Port) { resume(k, 2); }
        fn read(k, fd: i64, n: i64) { resume(k, ""); }
        fn write(k, fd: i64, d: String) {
            if str_eq(d, "GET / HTTP/1.1\r\n\r\n") {
                resume(k, 1);
            } else {
                resume(k, 0);
            }
        }
        fn close(k, fd: i64) { resume(k, 0); }
    };
    net_assert("write: data propagated to handler", n == 1)
}


// ---------------------------------------------------------------------------
// tcp_close tests
// ---------------------------------------------------------------------------

fn test_tcp_close_calls_effect(arena: *mut u8) -> bool yields [Diagnostics] {
    // Abortive handler: the arm never resumes, so its value (7001) becomes the
    // value of the handle expression once close observes fd == 55.
    let code = handle {
        net_close_code()
    } with Net {
        fn listen(k, p: Port) { resume(k, 0); }
        fn accept(k, fd: i64) { resume(k, 0); }
        fn connect(k, h: String, p: Port) { resume(k, 55); }
        fn read(k, fd: i64, n: i64) { resume(k, ""); }
        fn write(k, fd: i64, d: String) { resume(k, 0); }
        fn close(k, fd: i64) {
            let mut c: i64 = 7002;
            if fd == 55 {
                c = 7001;
            }
            c
        }
    };
    net_assert("close: called with conn fd=55", code == 7001)
}

// ---------------------------------------------------------------------------
// Full client / server simulations
// ---------------------------------------------------------------------------

fn test_full_client_exchange(arena: *mut u8) -> bool yields [Diagnostics] {
    // connect -> write -> read -> close, each step scripted by the mock.
    let mask = handle {
        net_client_mask()
    } with Net {
        fn listen(k, p: Port) { resume(k, 0); }
        fn accept(k, fd: i64) { resume(k, 0); }
        fn connect(k, h: String, p: Port) { resume(k, 99); }
        fn read(k, fd: i64, n: i64) { resume(k, "MOCK_DATA"); }
        fn write(k, fd: i64, d: String) { resume(k, 8); }
        fn close(k, fd: i64) { resume(k, 0); }
    };

    let mut ok = true;
    // Bit mask: 1 = connect fd, 2 = write bytes, 4 = read payload length.
    ok = ok && net_assert("exchange: connect/write/read observed", mask == 7);
    ok
}

fn test_full_server_accept(arena: *mut u8) -> bool yields [Diagnostics] {
    // listen -> accept -> read -> write -> close with descriptor chaining.
    let mask = handle {
        net_server_mask()
    } with Net {
        fn listen(k, p: Port) { resume(k, 10); }
        fn accept(k, fd: i64) { resume(k, fd + 10); }
        fn connect(k, h: String, p: Port) { resume(k, 0); }
        fn read(k, fd: i64, n: i64) { resume(k, "GET / HTTP/1.1\r\n\r\n"); }
        fn write(k, fd: i64, d: String) { resume(k, 19); }
        fn close(k, fd: i64) { resume(k, 0); }
    };
    net_assert("server: listener fd 10, accept 20, read+write observed", mask == 15)
}


// ---------------------------------------------------------------------------
// Struct field plumbing
// ---------------------------------------------------------------------------

fn test_tcp_listener_struct_fields(arena: *mut u8) -> bool yields [Diagnostics] {
    let port_val = handle {
        net_listen_port(8888)
    } with Net {
        fn listen(k, p: Port) { resume(k, p as i64); }
        fn accept(k, fd: i64) { resume(k, 0); }
        fn connect(k, h: String, p: Port) { resume(k, 0); }
        fn read(k, fd: i64, n: i64) { resume(k, ""); }
        fn write(k, fd: i64, d: String) { resume(k, 0); }
        fn close(k, fd: i64) { resume(k, 0); }
    };

    let fd = handle {
        net_listener_fd(8888)
    } with Net {
        fn listen(k, p: Port) { resume(k, p as i64 * 2); }
        fn accept(k, fd: i64) { resume(k, 0); }
        fn connect(k, h: String, p: Port) { resume(k, 0); }
        fn read(k, fd: i64, n: i64) { resume(k, ""); }
        fn write(k, fd: i64, d: String) { resume(k, 0); }
        fn close(k, fd: i64) { resume(k, 0); }
    };

    let mut ok = true;
    ok = ok && net_assert("listener.port == 8888", port_val == 8888);
    ok = ok && net_assert("listener.socket_id == 8888*2", fd == 17776);
    ok
}

fn test_tcp_stream_struct_field(arena: *mut u8) -> bool yields [Diagnostics] {
    let fd = handle {
        net_stream_fd()
    } with Net {
        fn listen(k, p: Port) { resume(k, 0); }
        fn accept(k, fd: i64) { resume(k, 0); }
        fn connect(k, h: String, p: Port) { resume(k, 9999); }
        fn read(k, fd: i64, n: i64) { resume(k, ""); }
        fn write(k, fd: i64, d: String) { resume(k, 0); }
        fn close(k, fd: i64) { resume(k, 0); }
    };
    net_assert("stream.socket_id == 9999", fd == 9999)
}


// ---------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------

fn net_case(name: String, ok: bool) -> i64 {
    if ok {
        net_test_print(name);
        return 0;
    }
    net_test_print("[FAIL] ");
    net_test_print(name);
    1
}

fn main() -> i64 yields [Diagnostics] {
    let mut exit_code: i64 = 0;
    region net_arena {
        net_test_print("=== Running std::net Test Suite ===");

        let mut failed: i64 = 0;

        failed = failed + net_case("  test tcp_listen returns correct listener ... ok",           test_tcp_listen_returns_listener(net_arena));
        failed = failed + net_case("  test tcp_listen port boundary low (1) ... ok",              test_tcp_listen_port_boundary_low(net_arena));
        failed = failed + net_case("  test tcp_listen port boundary high (65535) ... ok",         test_tcp_listen_port_boundary_high(net_arena));
        failed = failed + net_case("  test tcp_accept returns stream with conn fd ... ok",        test_tcp_accept_returns_stream(net_arena));
        failed = failed + net_case("  test tcp_connect returns stream fd from handler ... ok",    test_tcp_connect_returns_stream(net_arena));
        failed = failed + net_case("  test tcp_read returns handler data ... ok",                 test_tcp_read_returns_mock_data(net_arena));
        failed = failed + net_case("  test tcp_read propagates max_len ... ok",                   test_tcp_read_propagates_max_len(net_arena));
        failed = failed + net_case("  test tcp_write returns byte count ... ok",                  test_tcp_write_returns_length(net_arena));
        failed = failed + net_case("  test tcp_write propagates data to handler ... ok",          test_tcp_write_propagates_data(net_arena));
        failed = failed + net_case("  test tcp_close calls effect with correct fd ... ok",        test_tcp_close_calls_effect(net_arena));
        failed = failed + net_case("  test Full client connect/write/read/close sequence ... ok", test_full_client_exchange(net_arena));
        failed = failed + net_case("  test Full server listen/accept/read/write/close ... ok",    test_full_server_accept(net_arena));
        failed = failed + net_case("  test TcpListener struct fields correct ... ok",             test_tcp_listener_struct_fields(net_arena));
        failed = failed + net_case("  test TcpStream struct field correct ... ok",                test_tcp_stream_struct_field(net_arena));

        if failed == 0 {
            net_test_print("All std::net tests passed!");
            exit_code = 0;
        } else {
            net_test_print("[net_test] FAILURES detected");
            exit_code = 1;
        }
    }
    return exit_code;
}

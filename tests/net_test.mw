// Phase 13.2 — std::net Test Suite (net_test.mw)
// Tests the std::net algebraic-effects API by providing a mock Net handler.
// No real sockets are opened; all operations are simulated deterministically.

import std::net;
import std::collections;
import compiler::diagnostics;

extern "C" {
    fn puts(s: *const u8) -> i32;
    fn fflush(f: *const u8) -> i32;
    fn strlen(s: *const u8) -> usize;
    fn strcmp(s1: *const u8, s2: *const u8) -> i32;
    fn strstr(haystack: *const u8, needle: *const u8) -> *const u8;
}

fn net_test_print(msg: String) {
    unsafe {
        puts(msg as *const u8);
        fflush(0 as *const u8);
    }
}

fn str_eq(a: String, b: String) -> bool {
    unsafe { strcmp(a as *const u8, b as *const u8) == 0 }
}

fn contains(haystack: String, needle: String) -> bool {
    let p = unsafe { strstr(haystack as *const u8, needle as *const u8) };
    (p as usize) != 0
}

fn net_assert(label: String, cond: bool) -> bool yields [Diagnostics] {
    if !cond {
        report_err(label, 1, 1);
    }
    cond
}

// ─── Mock Net handler ─────────────────────────────────────────────────────────
// Intercepts every Net effect operation and returns deterministic fake values.
// listen(port)    -> synthetic fd 100 + port (so we can assert the port was passed)
// accept(fd)      -> synthetic conn fd = fd + 1000
// connect(h, p)   -> synthetic conn fd 7777
// read(fd, n)     -> returns "MOCK_DATA"
// write(fd, data) -> returns strlen(data)
// close(fd)       -> returns 0

// We test each api function by calling it inside a handler { Net ... } block
// and asserting the return value.

// ─── tcp_listen tests ─────────────────────────────────────────────────────────

fn test_tcp_listen_returns_listener(arena: *mut u8) -> bool yields [Diagnostics] {
    let mut listener_port: i64 = 0;
    let mut socket_id: i64 = 0;

    handle {
        let l = tcp_listen(8080 as Port);
        listener_port = l.port as i64;
        socket_id     = l.socket_id;
    } with Net {
        listen(port) => resume(100 + port as i64),
        accept(_fd)  => resume(0),
        connect(_h, _p) => resume(0),
        read(_fd, _n)   => resume(""),
        write(_fd, _d)  => resume(0),
        close(_fd)      => resume(0),
    }

    let mut ok = true;
    ok = ok && net_assert("listen: port preserved", listener_port == 8080);
    ok = ok && net_assert("listen: socket_id == 100+8080", socket_id == 8180);
    ok
}

fn test_tcp_listen_port_boundary_low(arena: *mut u8) -> bool yields [Diagnostics] {
    let mut got_port: i64 = 0;
    handle {
        let l = tcp_listen(1 as Port);

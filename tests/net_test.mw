// Phase 13.2 - std::net Test Suite (net_test.mw)
// Exercises the std::net algebraic-effects API through mock Net handlers that
// hand back deterministic synthetic descriptors. No real sockets are opened.
//
// Handler syntax used here (the only form the self-hosted compiler accepts):
//   handle { body } with Net {
//       fn op(k, arg: T) { resume(k, value); }
//   }
// Operations that never resume abort the continuation and become the value of
// the whole `handle` expression, which is how argument plumbing is observed.
// Handler arms are desugared into ordinary top-level functions, so they cannot
// capture enclosing locals - every observation flows through return values.

import std::net;
import std::collections;
import compiler::diagnostics;

extern "C" {
    fn puts(s: *const u8) -> i32;
    fn fflush(f: *const u8) -> i32;
    fn strlen(s: *const u8) -> usize;
    fn strcmp(s1: *const u8, s2: *const u8) -> i32;
    fn strstr(haystack: *const u8, needle: *const u8) -> *const u8;
}

fn net_test_print(msg: String) {
    unsafe {
        puts(msg as *const u8);
        fflush(0 as *const u8);
    }
}

fn str_eq(a: String, b: String) -> bool {
    unsafe { strcmp(a as *const u8, b as *const u8) == 0 }
}

fn contains(haystack: String, needle: String) -> bool {
    let p = unsafe { strstr(haystack as *const u8, needle as *const u8) };
    (p as usize) != 0
}

fn net_assert(label: String, cond: bool) -> bool yields [Diagnostics] {
    if !cond {
        report_err(label, 1, 1);
    }
    cond
}

// ---------------------------------------------------------------------------
// Effectful probes: each runs a tcp_* sequence and returns an observable i64.
// ---------------------------------------------------------------------------

fn net_listen_socket_id(p: i64) -> i64 yields [Net] {
    let l = tcp_listen(p as Port);
    return l.socket_id;
}

fn net_listen_port(p: i64) -> i64 yields [Net] {
    let l = tcp_listen(p as Port);
    return l.port as i64;
}

fn net_accept_socket_id() -> i64 yields [Net] {
    let l = tcp_listen(9000 as Port);
    let s = tcp_accept(&l);
    return s.socket_id;
}

fn net_connect_socket_id() -> i64 yields [Net] {
    let s = tcp_connect("localhost", 8080 as Port);
    return s.socket_id;
}

fn net_read_len() -> i64 yields [Net] {
    let s = tcp_connect("host", 80 as Port);
    let data = tcp_read(&s, 512);
    return unsafe { strlen(data as *const u8) } as i64;
}

fn net_read_maxlen_marker() -> i64 yields [Net] {
    let s = tcp_connect("host", 80 as Port);
    let data = tcp_read(&s, 1024);
    return unsafe { strlen(data as *const u8) } as i64;
}

fn net_write_len() -> i64 yields [Net] {
    let s = tcp_connect("host", 80 as Port);
    let n = tcp_write(&s, "Hello!");
    return n;
}

fn net_write_match() -> i64 yields [Net] {
    let s = tcp_connect("host", 443 as Port);
    let n = tcp_write(&s, "GET / HTTP/1.1\r\n\r\n");
    return n;
}

fn net_close_code() -> i64 yields [Net] {
    let s = tcp_connect("host", 80 as Port);
    tcp_close(&s);
    return 0;
}

fn net_listener_fd(p: i64) -> i64 yields [Net] {
    let l = tcp_listen(p as Port);
    return l.socket_id;
}

fn net_stream_fd() -> i64 yields [Net] {
    let s = tcp_connect("h", 1234 as Port);
    return s.socket_id;
}


// Multi-operation probes used by the client/server simulation tests.
fn net_client_mask() -> i64 yields [Net] {
    let mut mask: i64 = 0;
    let s = tcp_connect("api.morrow.dev", 443 as Port);
    if s.socket_id == 99 {
        mask = mask + 1;
    }
    let sent = tcp_write(&s, "GET /version HTTP/1.1\r\n\r\n");
    if sent == 8 {
        mask = mask + 2;
    }
    let resp = tcp_read(&s, 4096);
    let resp_len = unsafe { strlen(resp as *const u8) } as i64;
    if resp_len == 9 {
        mask = mask + 4;
    }
    tcp_close(&s);
    return mask;
}

fn net_server_mask() -> i64 yields [Net] {
    let mut mask: i64 = 0;
    let l = tcp_listen(3000 as Port);
    if l.socket_id == 10 {
        mask = mask + 1;
    }
    let s = tcp_accept(&l);
    if s.socket_id == 20 {
        mask = mask + 2;
    }
    let msg = tcp_read(&s, 1024);
    if contains(msg, "GET /") {
        mask = mask + 4;
    }
    let sent = tcp_write(&s, "HTTP/1.1 200 OK\r\n\r\n");
    if sent == 19 {
        mask = mask + 8;
    }
    tcp_close(&s);
    return mask;
}

// ---------------------------------------------------------------------------
// tcp_listen tests
// ---------------------------------------------------------------------------

fn test_tcp_listen_returns_listener(arena: *mut u8) -> bool yields [Diagnostics] {
    let sid = handle {
        net_listen_socket_id(8080)
    } with Net {
        fn listen(k, p: Port) { resume(k, 100 + p as i64); }
        fn accept(k, fd: i64) { resume(k, 0); }
        fn connect(k, h: String, p: Port) { resume(k, 0); }
        fn read(k, fd: i64, n: i64) { resume(k, ""); }
        fn write(k, fd: i64, d: String) { resume(k, 0); }
        fn close(k, fd: i64) { resume(k, 0); }
    };

    let port_val = handle {
        net_listen_port(8080)
    } with Net {
        fn listen(k, p: Port) { resume(k, 100 + p as i64); }
        fn accept(k, fd: i64) { resume(k, 0); }
        fn connect(k, h: String, p: Port) { resume(k, 0); }
        fn read(k, fd: i64, n: i64) { resume(k, ""); }
        fn write(k, fd: i64, d: String) { resume(k, 0); }
        fn close(k, fd: i64) { resume(k, 0); }
    };

    let mut ok = true;
    ok = ok && net_assert("listen: port preserved", port_val == 8080);
    ok = ok && net_assert("listen: socket_id == 100+8080", sid == 8180);
    ok
}


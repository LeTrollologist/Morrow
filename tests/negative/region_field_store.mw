// NEGATIVE TEST: a region-scoped value must not be stored in a field of a value
// that outlives the region. This is the store-shaped form of the escape that
// `region_return` covers for `return`.
import std::collections;

extern "C" {
    fn morrow_region_alloc(arena: *mut u8, size: i64, align: i64) -> *mut u8;
}

struct Holder {
    p: *mut u8,
}

fn store() -> i64 {
    let mut h: Holder = Holder { p: 0 as *mut u8 };
    region r {
        let p = morrow_region_alloc(r, 8, 8);
        h.p = p;
    }
    0
}

fn main() -> i64 {
    0
}

extern "C" {
    fn morrow_region_alloc(arena: *mut u8, size: i64, align: i64) -> *mut u8;
}

fn choose(p: *mut i64, q: *mut i64, cond: i64) -> *mut i64 {
    let mut r = p;
    if cond > 0 {
        r = q;
    }
    r
}

fn escape() -> *mut i64 {
    region r {
        let p = unsafe { morrow_region_alloc(r, 8, 8) } as *mut i64;
        let q = 0 as *mut i64;
        return choose(p, q, 0);
    }
    0 as *mut i64
}

fn main() -> i64 {
    0
}

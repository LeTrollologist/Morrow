extern "C" {
    fn morrow_region_alloc(arena: *mut u8, size: i64, align: i64) -> *mut u8;
}

effect Move {
    fn stash_op(dst: *mut *mut i64, src: *mut i64) -> i64;
}

fn escape() -> i64 {
    let mut out: *mut i64 = 0 as *mut i64;
    handle {
        region r {
            let p = unsafe { morrow_region_alloc(r, 8, 8) } as *mut i64;
            perform Move.stash_op(&mut out, p)
        }
    } with Move {
        fn stash_op(k, dst: *mut *mut i64, src: *mut i64) {
            dst[0] = src;
            0
        }
    };
    0
}

fn main() -> i64 {

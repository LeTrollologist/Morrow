// Syntax feature suite: block comments, hex/underscore literals, null, continue,
// and println with a single {} placeholder.
import std::test;

extern "C" {
    fn morrow_alloc(size: usize, align: usize) -> *mut u8;
    fn strlen(s: *const u8) -> usize;
}

struct Pair {
    x: i64,
    y: i64,
}

fn pointer_write_read() -> i64 {
    let mut counter = 42;
    let p: *mut i64 = &mut counter;
    p[0] = 100;
    counter
}

fn pointer_field_roundtrip() -> i64 {
    let mut p = Pair { x: 1, y: 2 };
    let q: *mut Pair = &mut p;
    q.x = 10;
    q.y = 20;
    p.x * 100 + p.y
}

fn pointer_byte_roundtrip() -> i64 {
    let buf = unsafe { morrow_alloc(4, 1) as *mut u8 };
    buf[0] = 72; // 'H'
    buf[1] = 105; // 'i'
    buf[2] = 0;
    if unsafe { strlen(buf as *const u8) } == 2 {
        return 1;
    }
    0
}


fn count_with_continue() -> i64 {
    let mut i: i64 = 0;
    let mut sum: i64 = 0;
    while i < 6 {
        i = i + 1;
        if i == 3 {
            continue;
        }
        sum = sum + i;
    }
    sum
}

fn main() -> i64 {
    test_print("=== Running Syntax Features Test Suite ===");

    /* block comments
       may span several lines */
    assert_eq(1, 1, "block comment parsed");

    assert_eq(0xFF, 255, "hex literal 0xFF");
    assert_eq(0x10, 16, "hex literal 0x10");
    assert_eq(100_000, 100000, "underscore digit separator");
    assert_eq(1_000_000, 1000000, "multiple underscore separators");

    let p: *mut u8 = null;
    assert_eq(p as i64, 0, "null is the zero pointer constant");

    assert_eq(pointer_write_read(), 100, "&mut scalar returns real storage");
    assert_eq(pointer_field_roundtrip(), 1020, "pointer field stores use struct offsets");
    assert_eq(pointer_byte_roundtrip(), 1, "u8 pointee indexing uses byte stride");

    assert_eq((300 as u8) as i64, 44, "u8 cast truncates");
    assert_eq(((0 - 1) as u8) as i64, 255, "u8 cast wraps negative values");
    assert_eq((200 as i8) as i64, 0 - 56, "i8 cast sign-extends");
    assert_eq((70000 as u16) as i64, 4464, "u16 cast truncates");

    assert_eq(count_with_continue(), 18, "continue skips the rest of an iteration");

    println("println placeholder value = {}", 42);
    println("println placeholder string = {}", "ok");

    test_print("All syntax feature tests passed!");
    0
}
